---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Psicóloga Valentina Orellana — Psicología de adultos, terapia de pareja y trauma en Santiago, Chile. Atención online y presencial.',
  image = '/images/og-default.jpg',
  noindex = false,
  ogType = 'website',
} = Astro.props;

const canonicalPath = Astro.url.pathname !== '/' ? Astro.url.pathname.replace(/\/$/, '') : '/';
const canonicalURL = new URL(canonicalPath, Astro.site);
// WhatsApp, Facebook y LinkedIn exigen una URL absoluta para la imagen de vista previa.
const ogImage = new URL(image, Astro.site).href;

// Datos estructurados (Google): solo en la portada.
const jsonLd = Astro.url.pathname === '/' ? {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Ps. Valentina Orellana — Psicóloga Clínica',
  description,
  url: 'https://www.valentinaorellana.cl/',
  image: ogImage,
  telephone: '+56972735696',
  areaServed: [{ '@type': 'City', name: 'Las Condes' }, { '@type': 'Country', name: 'Chile' }],
  address: { '@type': 'PostalAddress', addressLocality: 'Las Condes', addressRegion: 'Región Metropolitana', addressCountry: 'CL' },
  priceRange: '$60.000 – $75.000',
  sameAs: ['https://www.instagram.com/psicologa.valentinaorellana/'],
  availableLanguage: 'es',
} : null;
// Botones flotantes: en /agenda el de WhatsApp sube para no tapar el sello de
// reCAPTCHA; el de "Agendar sesión" (solo celular) no aparece en el flujo de
// reserva/pago ni en páginas privadas.
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const enAgenda = ruta === '/agenda';
const mostrarAgendarFlotante = !['/agenda', '/reagendar', '/confirmacion', '/recuperar'].includes(ruta)
  && !/^\/(pagar|consentimiento|pasos-a-seguir)\//.test(ruta) && !noindex;
// Google Tag Manager (Analytics/Meta) NO se carga en páginas con datos de una
// paciente o con claves en el link: pago, consentimiento (nombre y RUT), pasos
// a seguir, reagendar (clave firmada) y recuperar (token). Re-auditoría 4 oct 2026.
const cargarGTM = !['/reagendar', '/recuperar'].includes(ruta)
  && !/^\/(pagar|consentimiento|pasos-a-seguir)(\/|$)/.test(ruta);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="facebook-domain-verification" content="jvyq3gto3vw9mqgkpvusajy6srs890" />
    <!-- Google Tag Manager -->
    {cargarGTM && <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WQHZZSPS');</script>}
    <!-- End Google Tag Manager -->
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {image === '/images/og-default.jpg' && <meta property="og:image:width" content="1200" />}
    {image === '/images/og-default.jpg' && <meta property="og:image:height" content="630" />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Ps. Valentina Orellana" />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Ps. Valentina Orellana</title>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    {cargarGTM && <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WQHZZSPS"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>}
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Botón flotante "Agendar sesión" solo en celular (en el menú del celular
         el botón queda escondido tras la hamburguesa). No en las páginas del
         propio flujo de reserva/pago. -->
    {mostrarAgendarFlotante && (
      <a href="/agenda"
         class="md:hidden fixed bottom-6 left-6 z-50 h-14 px-6 rounded-full shadow-lg flex items-center font-body text-sm font-medium tracking-wide text-white"
         style="background-color:#576352;">
        Agendar sesión
      </a>
    )}

    <!-- Botón flotante WhatsApp (en /agenda más arriba: no tapa el sello de reCAPTCHA) -->
    <a
      href="https://wa.me/56972735696?text=Hola%20Valentina%2C%20me%20gustar%C3%ADa%20saber%20m%C3%A1s%20sobre%20las%20sesiones."
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contactar por WhatsApp"
      class={`fixed ${enAgenda ? 'bottom-24' : 'bottom-6'} right-6 z-50 w-14 h-14 rounded-full shadow-lg flex items-center justify-center transition-transform duration-200 hover:scale-110`}
      style="background-color: #25D366;"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="white">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
    </a>
  </body>
</html>
