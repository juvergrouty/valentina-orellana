---
import { DIRECCION, GOOGLE_MAPS_URL, PERFILES } from '../../data/consulta';
const year = new Date().getFullYear();
// Perfiles públicos (solo visibilidad; la reserva es siempre en este sitio).
const perfiles: [string, string][] = [
  [GOOGLE_MAPS_URL, 'Google Maps'],
  [PERFILES.doctoralia, 'Doctoralia'],
  [PERFILES.psychologyToday, 'Psychology Today'],
  [PERFILES.instagram, 'Instagram'],
];
---

<footer class="bg-ink text-sand/60 font-body texture-grain">
  <div class="container-site pt-16 pb-10" data-nosnippet>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-12 border-b border-sand/10">

      <!-- Marca -->
      <div class="md:col-span-4">
        <p class="font-heading font-semibold text-2xl text-sand tracking-tight mb-1">
          Valentina Orellana
        </p>
        <p class="font-body text-xs text-sand/60 mb-5">Psicóloga · Reg. Superintendencia de Salud N° 360070</p>
        <p class="text-sm text-sand/50 leading-relaxed max-w-xs">
          Acompaño a adultos y parejas en procesos de cambio, sanación y crecimiento personal.
          Atención presencial en Santiago y online para todo Chile.
        </p>
      </div>

      <!-- Navegación -->
      <div class="md:col-span-3 md:col-start-6">
        <p class="label text-sand/40 mb-5">Navegación</p>
        <ul class="space-y-3">
          {[
            ['/', 'Inicio'],
            ['/sobre-mi', 'Sobre mí'],
            ['/servicios', 'Servicios'],
            ['/precios', 'Preguntas frecuentes'],
            ['/opiniones', 'Opiniones'],
            ['/blog', 'Blog'],
            ['/contacto', 'Contacto'],
            ['/agenda', 'Agendar sesión'],
            ['/condiciones', 'Condiciones'],
          ].map(([href, label]) => (
            <li>
              <a href={href} class="text-sm text-sand/50 hover:text-sand transition-colors duration-200">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contacto -->
      <div class="md:col-span-4 md:col-start-9">
        <p class="label text-sand/40 mb-5">Contacto</p>
        <ul class="space-y-4">
          <li>
            <a href="tel:+56972735696" class="text-sm text-sand/50 hover:text-sand transition-colors duration-200 block">
              +56 9 7273 5696
            </a>
          </li>
          <li class="text-sm text-sand/50 leading-relaxed">
            <address class="not-italic">
              {DIRECCION.calle}, {DIRECCION.detalle}<br />
              {DIRECCION.comuna} · Online para todo Chile
            </address>
            <a href={GOOGLE_MAPS_URL} target="_blank" rel="noopener"
               class="inline-block mt-1 text-sand/70 underline underline-offset-4 hover:text-sand transition-colors duration-200">
              Cómo llegar · Ver en Google Maps
            </a>
          </li>
          <li>
            <a
              href="https://wa.me/56972735696"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-sand/50 hover:text-sand transition-colors duration-200"
            >
              WhatsApp
            </a>
          </li>
        </ul>

        <a href="/agenda" class="btn-ghost mt-8 inline-flex text-[10px] py-3 px-6">
          Agendar sesión
        </a>
      </div>
    </div>

    <!-- Perfiles públicos -->
    <div class="pt-8 text-xs text-sand/60 text-center md:text-left">
      <span>También me encuentras en:</span>{' '}
      {perfiles.map(([href, label], i) => (
        <>
          {i > 0 && <span aria-hidden="true"> · </span>}
          <a href={href} target="_blank" rel="noopener" class="hover:text-sand underline-offset-4 hover:underline transition-colors duration-200">{label}</a>
        </>
      ))}
    </div>

    <!-- pb-20 en celular: el botón flotante "Agendar sesión" no tapa esta línea -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-3 pt-8 pb-20 md:pb-0 text-xs text-sand/60">
      <p>© {year} Ps. Valentina Orellana. Todos los derechos reservados.</p>
      <p>Diseño por <a href="https://grouty.cl" class="hover:text-sand transition-colors">Grouty</a></p>
    </div>
  </div>
</footer>
