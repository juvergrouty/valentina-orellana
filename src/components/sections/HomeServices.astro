---
import { supabase } from '../../lib/supabase';
import { imagenUrl, imagenSrcset } from '../../lib/imagenOptimizada';

const SELECT = 'id, name, description, modality, location, image_url, type, price, duration_min';

// 1º: servicios marcados para el inicio (⭐). 2º: si no hay, los visibles reales.
let { data: dbServices, error: errServicios } = await supabase
  .from('services_catalog').select(SELECT)
  .eq('show_home', true).eq('visible', true)
  .order('sort_order').limit(10);
// Sin datos de la base, la página no se guarda en la caché pública (middleware).
if (errServicios) Astro.response.headers.set('Cache-Control', 'no-store');

if (!dbServices || dbServices.length === 0) {
  const { data: visibles } = await supabase
    .from('services_catalog').select(SELECT)
    .eq('visible', true)
    .order('sort_order').limit(6);
  dbServices = visibles ?? [];
}

const formatCLP = (n: number) =>
  new Intl.NumberFormat('es-CL', { style:'currency', currency:'CLP', maximumFractionDigits:0 }).format(n);

// Fotos reales de la consulta en Estoril 50 (12 oct 2026) para los servicios
// presenciales: las de Supabase eran de banco de imágenes, con personas que no
// son Valentina. Los online siguen con la imagen que se sube en el panel.
const FOTOS_CONSULTA = {
  individual: { base: '/images/consulta-puerta', alt: 'Sala de atención de la consulta en Estoril 50, Las Condes, vista desde la puerta: sillón, mesa de centro y ventana' },
  pareja:     { base: '/images/consulta-sala',   alt: 'Sala de atención de la consulta en Estoril 50, Las Condes: sofá para dos, sillón y mesa de centro junto a la ventana' },
};
const fotoConsulta = (s: { modality: string; type: string | null; name: string }) => {
  if (s.modality !== 'presencial') return null;
  const esPareja = s.type === 'pareja' || /pareja/i.test(s.name);
  return esPareja ? FOTOS_CONSULTA.pareja : FOTOS_CONSULTA.individual;
};

const cards = (dbServices ?? []).map(s => ({
  ...s,
  foto:       fotoConsulta(s),
  href:       `/agenda?servicio=${s.id}`,
  badge:      s.modality === 'online' ? 'Online' : s.modality === 'presencial' ? 'Presencial' : 'Online · Presencial',
  priceLabel: formatCLP(s.price),
}));
---

{cards.length > 0 && (
<section class="py-14 md:py-section bg-sand">
  <div class="container-site">

    <!-- Encabezado + controles en la misma fila -->
    <div class="flex items-end justify-between mb-10 gap-4">
      <div>
        <p class="label text-stone mb-3">¿En qué puedo ayudarte?</p>
        <h2 class="section-title">Terapia para crecer,<br class="hidden md:block" /> sanar y avanzar.</h2>
      </div>
      <!-- Flechas de navegación -->
      <div class="hidden md:flex gap-2 flex-shrink-0">
        <button id="svc-prev" aria-label="Servicio anterior"
          class="w-10 h-10 rounded-full border border-dust flex items-center justify-center text-stone hover:border-ink hover:text-ink transition-all duration-200">
          ‹
        </button>
        <button id="svc-next" aria-label="Servicio siguiente"
          class="w-10 h-10 rounded-full border border-dust flex items-center justify-center text-stone hover:border-ink hover:text-ink transition-all duration-200">
          ›
        </button>
      </div>
    </div>

    <p class="body-text max-w-xl mb-10 md:hidden">
      Acompañamiento psicológico para adultos y parejas que desean comprenderse,
      mejorar su bienestar y construir relaciones más conscientes.
    </p>

  </div>

  <!-- Carrusel contenido — mismo padding que container-site en ambos lados -->
  <div class="px-6 md:px-12 lg:px-20 xl:px-[max(5rem,calc((100vw-1600px)/2+5rem))]">
    <div id="svc-track"
      class="flex gap-5 overflow-x-auto pb-4"
      style="scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;cursor:grab;">

      {cards.map(card => (
        <!-- flex-col + mt-auto en el pie: precio y botón quedan a la misma altura en
             todas las tarjetas aunque el nombre o la descripción ocupen más líneas. -->
        <div class="svc-card flex-shrink-0 w-[80vw] sm:w-[calc(50%-10px)] lg:w-[calc(25%-15px)] flex flex-col bg-white border border-dust rounded-[10px] overflow-hidden group hover:shadow-lg transition-all duration-300"
             style="scroll-snap-align:start;scroll-snap-stop:always;">

          <!-- Imagen -->
          <div class="relative h-[340px] overflow-hidden flex-shrink-0">
            <!-- Optimizada por Vercel y diferida: el carrusel está bajo el hero, no es
                 lo primero que se ve (8 oct 2026). Presenciales: foto propia en WebP. -->
            {card.foto ? (
            <img
              src={`${card.foto.base}-800.webp`}
              srcset={`${card.foto.base}-800.webp 800w, ${card.foto.base}-1600.webp 1600w`}
              sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 80vw"
              width="800" height="1000"
              loading="lazy" decoding="async"
              alt={card.foto.alt}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            ) : (
            <img
              src={imagenUrl(card.image_url ?? '/images/consultorio-individual.jpg', 828)}
              srcset={imagenSrcset(card.image_url ?? '/images/consultorio-individual.jpg', [384, 640, 828])}
              sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 80vw"
              width="1200" height="1200"
              loading="lazy" decoding="async"
              alt={card.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-ink/40 to-transparent"></div>
            <span class="absolute top-3 left-3 text-xs font-body font-medium px-3 py-1 rounded-full bg-white/90 text-ink">
              {card.badge}
            </span>
          </div>

          <!-- Contenido -->
          <div class="p-5 flex flex-col flex-1" style="min-height:180px;">
            <h3 class="font-heading font-semibold text-lg text-ink leading-tight mb-1">{card.name}</h3>
            {card.location && (
              <p class="font-body text-xs text-stone mb-2">📍 {card.location}</p>
            )}
            <p class="font-body text-sm text-stone font-light leading-relaxed mb-4 line-clamp-3">{card.description}</p>

            <div class="mt-auto flex items-center justify-between pt-3 border-t border-dust">
              <div>
                <p class="font-heading font-semibold text-base text-ink leading-none">{card.priceLabel}</p>
                <p class="font-body text-xs text-stone mt-0.5">{card.duration_min} minutos</p>
              </div>
              <a href={card.href}
                class="font-body text-xs tracking-widest uppercase whitespace-nowrap px-4 py-2 border border-forest text-forest hover:bg-forest hover:text-white transition-all duration-200 rounded-[4px]">
                Agendar sesión
              </a>
            </div>
          </div>

        </div>
      ))}

    </div>
  </div>

  <!-- Dots -->
  <div id="svc-dots" class="flex justify-center mt-4 container-site"></div>

</section>
)}

<script>
(function() {
  const track = document.getElementById('svc-track');
  const prev  = document.getElementById('svc-prev');
  const next  = document.getElementById('svc-next');
  const dots  = document.getElementById('svc-dots');

  if (!track) return;

  const cardW = () => {
    const c = track.querySelector('.svc-card') as HTMLElement;
    if (!c) return 320;
    // gap-5 = 20px; usar offsetWidth del card real para snap exacto
    const gap = parseInt(getComputedStyle(track).gap) || 20;
    return c.offsetWidth + gap;
  };

  // Flechas
  prev?.addEventListener('click', () => track.scrollBy({ left: -cardW(), behavior: 'smooth' }));
  next?.addEventListener('click', () => track.scrollBy({ left:  cardW(), behavior: 'smooth' }));

  // Drag to scroll
  let dragging = false, startX = 0, scrollLeft = 0;
  track.addEventListener('mousedown',  e => { dragging = true; startX = e.pageX; scrollLeft = track.scrollLeft; track.style.cursor = 'grabbing'; });
  track.addEventListener('mouseup',    () => { dragging = false; track.style.cursor = 'grab'; });
  track.addEventListener('mouseleave', () => { dragging = false; track.style.cursor = 'grab'; });
  track.addEventListener('mousemove',  e => { if (!dragging) return; e.preventDefault(); track.scrollLeft = scrollLeft - (e.pageX - startX); });

  // Dots
  const cards = track.querySelectorAll('.svc-card:not(:last-child)');
  cards.forEach((_, i) => {
    const dot = document.createElement('button');
    dot.setAttribute('aria-label', `Ir al servicio ${i+1}`);
    // Área táctil de 24×24 px (WCAG 2.5.8) con el punto de 7 px dibujado al centro
    // por un span; el fondo del botón es transparente.
    dot.className = 'svc-dot';
    dot.style.cssText = 'width:24px;height:24px;padding:0;border:none;background:transparent;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;';
    const punto = document.createElement('span');
    punto.setAttribute('aria-hidden', 'true');
    punto.style.cssText = `display:block;width:7px;height:7px;border-radius:50%;transition:all .2s;background:${i===0?'#576352':'#DDD8CF'}`;
    dot.appendChild(punto);
    dot.addEventListener('click', () => track.scrollTo({ left: i * cardW(), behavior: 'smooth' }));
    dots?.appendChild(dot);
  });

  // Actualizar dots y flechas en scroll
  track.addEventListener('scroll', () => {
    const idx = Math.round(track.scrollLeft / cardW());
    dots?.querySelectorAll('button > span').forEach((d, i) => {
      (d as HTMLElement).style.background = i === idx ? '#576352' : '#DDD8CF';
      (d as HTMLElement).style.transform  = i === idx ? 'scale(1.3)' : 'scale(1)';
    });
    if (prev) (prev as HTMLButtonElement).style.opacity = track.scrollLeft < 10 ? '0.3' : '1';
    if (next) (next as HTMLButtonElement).style.opacity = track.scrollLeft + track.clientWidth >= track.scrollWidth - 10 ? '0.3' : '1';
  }, { passive: true });

  // Ocultar scrollbar CSS
  const style = document.createElement('style');
  style.textContent = '#svc-track::-webkit-scrollbar { display:none; }';
  document.head.appendChild(style);
})();
</script>
