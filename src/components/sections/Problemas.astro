---
// "¿Te pasa algo de esto?" (12 oct 2026, auditoría de pacientes y marketing):
// quien llega buscando "psicóloga ansiedad Las Condes" no encontraba nada que
// nombrara lo que le pasa. Cada tarjeta lleva a la agenda con el grupo elegido.
const items = [
  { titulo: 'Ansiedad que no se apaga', texto: 'Te cuesta desconectarte, duermes mal o sientes que algo malo va a pasar.', href: '/agenda?grupo=individual', donde: 'problema_ansiedad' },
  { titulo: 'Una pareja que ya no se entiende', texto: 'Discusiones que se repiten, distancia o la sensación de estar solos aunque estén juntos.', href: '/terapia-de-pareja-las-condes', donde: 'problema_pareja' },
  { titulo: 'Tu historia te sigue pesando', texto: 'Patrones de tu infancia que se repiten aunque ya los entiendas.', href: '/agenda?grupo=individual', donde: 'problema_historia' },
  { titulo: 'Una crisis que te desordenó la vida', texto: 'Una pérdida, un cambio o una decisión difícil que no sabes cómo enfrentar.', href: '/agenda?grupo=individual', donde: 'problema_crisis' },
];
---

<section class="bg-sand py-16 md:py-24" aria-labelledby="problemas-titulo">
  <div class="container-site">
    <p class="label mb-3">Lo que trabajamos</p>
    <h2 id="problemas-titulo" class="section-title mb-10 md:mb-14 max-w-xl">¿Te pasa algo de esto?</h2>
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {items.map((it) => (
        <li>
          <a href={it.href} data-cta={it.donde}
             class="group flex flex-col h-full bg-white border border-dust rounded-[6px] p-6 md:p-7 transition-colors duration-300 hover:border-forest focus-visible:outline focus-visible:outline-2 focus-visible:outline-forest">
            <span class="card-title text-xl mb-3">{it.titulo}</span>
            <span class="body-sm text-[#55524b] mb-6">{it.texto}</span>
            <span class="mt-auto font-body text-xs tracking-widest uppercase text-forest">
              Ver horarios <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
