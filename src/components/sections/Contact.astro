---
import { DIRECCION, GOOGLE_MAPS_URL } from '../../data/consulta';
import CamposContacto from '../CamposContacto.astro';
import { supabase } from '../../lib/supabase';

// reCAPTCHA v3 igual que en /agenda (8 oct 2026): el formulario de contacto
// solo tenía el campo trampa y el tiempo mínimo. Si no hay clave configurada
// en Configuración, no se carga nada y el servidor tampoco lo exige.
const { data: recaptchaRow } = await supabase.from('settings').select('value').eq('key', 'recaptcha_site_key').maybeSingle();
const recaptchaSiteKey = recaptchaRow?.value ?? '';
---

<section class="py-14 md:py-section bg-white">
  <div class="container-site grid grid-cols-1 md:grid-cols-2 gap-16 lg:gap-24">

    <!-- Info -->
    <div>
      <p class="label text-stone mb-4">Contacto</p>
      <div class="divider mb-6"></div>
      <h2 class="section-title mb-8">¿Tienes alguna<br />consulta?</h2>

      <p class="body-text mb-10 max-w-sm">
        Puedes escribirme por WhatsApp o completar el formulario.
        Respondo en un plazo máximo de 24 horas hábiles.
      </p>

      <ul class="space-y-6">
        <li>
          <p class="label text-stone mb-1">Teléfono</p>
          <a href="tel:+56972735696" class="font-heading font-light text-xl text-ink hover:text-gold transition-colors">
            +56 9 7273 5696
          </a>
        </li>
        <li>
          <p class="label text-stone mb-1">Consulta presencial</p>
          <address class="not-italic font-body text-sm font-light text-stone leading-relaxed">
            {DIRECCION.calle}, {DIRECCION.detalle}<br />
            {DIRECCION.comuna}, {DIRECCION.region}
          </address>
          <a href={GOOGLE_MAPS_URL} target="_blank" rel="noopener"
             class="inline-block mt-2 font-body text-sm text-forest underline underline-offset-4 hover:text-gold transition-colors">
            Ver en Google Maps
          </a>
        </li>
        <li>
          <p class="label text-stone mb-1">Online</p>
          <p class="font-body text-sm font-light text-stone leading-relaxed">
            Sesiones por videollamada para todo Chile
          </p>
        </li>
        <li>
          <p class="label text-stone mb-2">WhatsApp</p>
          <a
            href="https://wa.me/56972735696?text=Hola%20Valentina%2C%20me%20gustar%C3%ADa%20consultar%20sobre%20una%20sesi%C3%B3n"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-dark text-[10px] py-3 px-6"
          >
            Escribir por WhatsApp
          </a>
        </li>
      </ul>
    </div>

    <!-- Formulario -->
    <!-- method="post": si el JavaScript falla, el navegador nunca pone nombre y
         correo en la dirección de la página (8 oct 2026). -->
    <form id="contact-form" method="post" class="flex flex-col gap-8" novalidate>
      <!-- Campo trampa anti-spam: las personas no lo ven ni lo llenan -->
      <div aria-hidden="true" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;">
        <label for="website">No completar</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        <div>
          <label class="label text-stone block mb-2" for="nombre">Nombre</label>
          <input id="nombre" name="nombre" type="text" required placeholder="Tu nombre"
            class="field" />
        </div>
        <div>
          <label class="label text-stone block mb-2" for="email">Correo</label>
          <input id="email" name="email" type="email" required placeholder="tu@correo.cl"
            class="field" />
        </div>
      </div>

      <div>
        <label class="label text-stone block mb-2" for="motivo">Motivo de consulta</label>
        <select id="motivo" name="motivo"
          class="field appearance-none bg-transparent cursor-pointer">
          <option value="">Selecciona una opción</option>
          <option>Psicología de adultos</option>
          <option>Terapia de pareja</option>
          <option>Trauma / PAS</option>
          <option>Parentalidad</option>
          <option>Información general</option>
        </select>
      </div>

      <div>
        <label class="label text-stone block mb-2" for="mensaje">Mensaje</label>
        <textarea id="mensaje" name="mensaje" rows="4"
          placeholder="Cuéntame brevemente en qué puedo ayudarte..."
          class="field resize-none"></textarea>
      </div>

      <div>
        <button type="submit" class="btn-dark text-[10px] py-3.5 px-8">
          Enviar mensaje
        </button>
        <p id="form-status" class="label text-stone mt-4 hidden"></p>
      </div>
    </form>

  </div>
</section>

<!-- Sugerencias de dominio y aviso "no recibe correos" en el campo correo, igual que en la agenda -->
<CamposContacto />

<script is:inline define:vars={{ recaptchaSiteKey }}>
  window.__RECAPTCHA_SITE_KEY__ = recaptchaSiteKey;
</script>
{recaptchaSiteKey && (
  <script src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`} is:inline async defer></script>
)}

<script>
  const form   = document.getElementById('contact-form') as HTMLFormElement;
  // Desde la carga de la página: una persona nunca envía en menos de 3 s
  // (medirlo desde el primer foco descartaba a quien usa el autocompletado).
  let abiertoEn = Date.now();
  const status = document.getElementById('form-status');
  const button = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !button) return;

    const data = new FormData(form);
    if (!data.get('nombre') || !data.get('email')) {
      status.textContent = 'Ingresa al menos tu nombre y correo.';
      status.classList.remove('hidden');
      return;
    }

    button.disabled = true;
    status.textContent = 'Enviando...';
    status.classList.remove('hidden');

    // reCAPTCHA v3 (si está configurado): mismo patrón que /agenda.
    let recaptchaToken = '';
    const w = window as any;
    if (w.__RECAPTCHA_SITE_KEY__ && w.grecaptcha) {
      try {
        // Con tope de 6 s: si el script de Google está bloqueado o lento, se
        // envía igual sin token en vez de quedar "Enviando..." para siempre.
        recaptchaToken = await Promise.race([
          new Promise<string>((resolve, reject) => {
            w.grecaptcha.ready(() => {
              w.grecaptcha.execute(w.__RECAPTCHA_SITE_KEY__, { action: 'submit_contact' }).then(resolve).catch(reject);
            });
          }),
          new Promise<string>((resolve) => setTimeout(() => resolve(''), 6000)),
        ]);
      } catch (err) {
        console.error('[recaptcha] error obteniendo token', err);
      }
    }

    try {
      const res = await fetch('/api/contacto', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...Object.fromEntries(data),
          t: Date.now() - abiertoEn,
          recaptcha_token: recaptchaToken,
        }),
      });
      const result = await res.json();
      if (result.ok) {
        status.textContent = 'Mensaje enviado — te responderé a la brevedad.';
        // Medición (GTM): el envío del formulario es un contacto/lead.
        try { (window.dataLayer = window.dataLayer || []).push({ event: 'contacto_formulario', page_path: location.pathname }); } catch (e) {}
        form.reset();
        abiertoEn = Date.now();
      } else {
        status.textContent = result.error || 'No se pudo enviar el mensaje. Intenta por WhatsApp.';
      }
    } catch {
      status.textContent = 'No se pudo enviar el mensaje. Intenta por WhatsApp.';
    } finally {
      button.disabled = false;
    }
  });
</script>
