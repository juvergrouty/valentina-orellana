<script>
  // Rueda del mouse (12 oct 2026): el área principal se desplaza entera (avisos
  // arriba + página). Si la rueda está sobre algo con scroll propio (calendario,
  // lista de pacientes…), primero baja la PÁGINA hasta el final —los avisos
  // suben y la página queda de pantalla completa— y recién ahí se recorre lo de
  // adentro. Al subir, el navegador ya encadena solo (adentro primero, después
  // la página). No aplica a paneles y ventanas flotantes (position: fixed),
  // ni al zoom con pellizco/Ctrl+rueda.
  const encMain = document.querySelector<HTMLElement>('.enc-main');
  encMain?.addEventListener('wheel', (e) => {
    if (e.ctrlKey || e.deltaY <= 0) return;
    const falta = encMain.scrollHeight - encMain.clientHeight - encMain.scrollTop;
    if (falta <= 1) return;
    let el = e.target as HTMLElement | null;
    let interno = false;
    while (el && el !== encMain) {
      const cs = getComputedStyle(el);
      if (cs.position === 'fixed') return;
      if (/(auto|scroll)/.test(cs.overflowY) && el.scrollHeight > el.clientHeight) interno = true;
      el = el.parentElement;
    }
    if (!interno) return; // sin scroll propio: el navegador ya desplaza la página
    e.preventDefault();
    encMain.scrollBy({ top: Math.min(e.deltaY, falta) });
  }, { passive: false });
</script>

