<script>
  // Comprobantes de transferencia por confirmar: "Confirmar pago" usa el mismo
  // "Marcar como pagado" de siempre (pago, calendario, boleta, Pasos a seguir),
  // una vez por cada sesión que cubre el comprobante.
  document.querySelectorAll<HTMLElement>('#comprobantes-alert li').forEach((li) => {
    const ids = (li.dataset.ids ?? '').split(',').filter(Boolean);
    const estado = li.querySelector<HTMLElement>('.cmp-estado')!;
    const botones = li.querySelectorAll<HTMLButtonElement>('button');

    li.querySelector('.cmp-confirmar')?.addEventListener('click', async () => {
      const nombre = li.querySelector('strong')?.textContent ?? '';
      if (!confirm(`¿Confirmas que la transferencia de ${nombre} está en tu banco?\n\nLa sesión queda pagada y se emite y envía la boleta.`)) return;
      botones.forEach(b => (b.disabled = true));
      estado.textContent = 'Confirmando y emitiendo boleta…';
      const errores: string[] = [];
      for (const id of ids) {
        const fd = new FormData();
        fd.set('action', 'mark_paid');
        fd.set('id', id);
        fd.set('medio', 'Transferencia');
        fd.set('emitir_boleta', 'on');
        fd.set('redirect', '/robots.txt?ok=1');
        try {
          const res = await fetch('/api/admin/bookings', { method: 'POST', body: fd });
          const q = new URL(res.url).searchParams;
          const err = q.get('error');
          // boleta_failed: el pago SÍ quedó registrado; solo falló la boleta
          // (queda en el aviso rojo de boletas y se reintenta si fue el SII).
          if (err === 'boleta_failed') errores.push(`pago confirmado, pero la boleta no se emitió: ${q.get('detail') ?? ''}`);
          // boleta_reintento: quedó en la cola de envíos y se reintenta sola cada 5 min (20 oct 2026).
          else if (err === 'boleta_reintento') errores.push(`pago confirmado; la boleta no salió todavía y se reintenta sola cada 5 minutos${q.get('detail') ? ` (${q.get('detail')})` : ''}`);
          else if (!res.ok || err) errores.push(q.get('detail') || err || `HTTP ${res.status}`);
        } catch { errores.push('error de conexión'); }
      }
      if (errores.length) {
        estado.textContent = `⚠ ${errores.join(' · ')}`;
        botones.forEach(b => (b.disabled = false));
      } else {
        estado.textContent = '✓ Pago confirmado. La boleta se envía sola.';
        setTimeout(() => location.reload(), 1500);
      }
    });

    li.querySelector('.cmp-descartar')?.addEventListener('click', async () => {
      if (!confirm('¿Quitar este aviso? Las sesiones siguen sin pagar y el comprobante deja de aparecer.')) return;
      botones.forEach(b => (b.disabled = true));
      const res = await fetch('/api/admin/comprobante', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'descartar', ids }),
      }).then(r => r.json()).catch(() => ({ ok: false }));
      if (res.ok) li.remove(); else { estado.textContent = `⚠ ${res.error || 'No se pudo quitar el aviso'}`; botones.forEach(b => (b.disabled = false)); }
    });
  });
</script>

<script>
  // "Registrar folio": la boleta quedó emitida en el SII pero no registrada en
  // la sesión. Se anota el folio (sin emitir nada) y, si Valentina quiere, se
  // envía a la paciente.
  document.querySelectorAll<HTMLButtonElement>('.btn-registrar-folio').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const valor = prompt('Número de folio de la boleta (como aparece en el SII):', btn.dataset.folio ?? '');
      if (valor === null) return;
      const folio = parseInt(valor.trim(), 10);
      if (!Number.isInteger(folio) || folio <= 0) { alert('Ese número de folio no es válido.'); return; }
      const enviar = confirm(`¿Enviar la boleta Folio ${folio} por correo a la paciente?\n\nAceptar = registrar y enviar · Cancelar = solo registrar`);
      btn.disabled = true; btn.textContent = 'Guardando…';
      const res = await fetch('/api/admin/apigateway', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'registrar_folio', booking_id: btn.dataset.booking, folio, enviar }),
      }).then(r => r.json()).catch(() => ({ ok: false, error: 'Error de conexión' }));
      if (res.ok) {
        btn.closest('li')!.textContent = res.enviada
          ? `✓ Folio ${folio} registrado y enviado a ${res.enviadaA}.`
          : enviar ? `✓ Folio ${folio} registrado. El correo no salió (${res.errorEnvio ?? 'error'}); se reintentará solo.` : `✓ Folio ${folio} registrado.`;
      } else {
        alert(res.error ?? 'No se pudo registrar el folio.');
        btn.disabled = false; btn.textContent = 'Registrar folio';
      }
    });
  });
</script>
