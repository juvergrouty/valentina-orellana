---
// Bloque de consentimientos de la ficha (decisiones D y E de docs/transcriptor/02-decisiones-16oct-noche.md):
//   D. "Consentimiento de la pareja": en toda ficha que pide 2 firmas para grabar (misma regla que
//      consentimiento.ts: reserva de pareja — session_type 'pareja-*' o servicio de pareja —, etc.), un link propio para la SEGUNDA persona (consents.persona = 2, 0021) y su
//      estado (Falta / Firmado por X el …). Uso real: la persona no agendada firma en la consulta en
//      SU celular (botón "Mostrar código QR": QR grande generado en el servidor, sin servicios
//      externos; mientras está abierto se revisa sola la firma) o en su casa antes de la primera
//      sesión ("Enviar por WhatsApp" con texto prellenado y sin número, "Copiar link" y "Enviar por
//      correo": el correo solo se usa para ese envío y no queda en la ficha).
//   E. Anexos: la copia fiel del correo con el aviso de cambio de herramienta (consent_anexos, 0021).
// Componente aparte para tocar lo mínimo de pacientes/[id].astro. Sin la migración 0021 el bloque
// avisa que falta y el resto de la ficha queda igual.
import { consentUrl, FaltaMigracion0021, getOrCreatePendingConsent } from '../../lib/consent';
import { estadoPareja, fichaConReservaPareja, urlWhatsAppPareja, type ReservaMinima } from '../../lib/transcriptor/pareja';
import { fichaEsPareja, fichaEsParejaEnBase } from '../../lib/transcriptor/consentimiento';
import { anexosDeConsentimientos, TITULO_ANEXO, type AnexoConsentimiento } from '../../lib/transcriptor/avisoV2';
import { qrSvg } from '../../lib/transcriptor/qr';

interface Props {
  patient: { id: string; name: string; rut?: string | null };
  bookings: ReservaMinima[];
  consentRows: any[];
  /** Solo `astro dev` (?demo=ia): datos de prueba, sin base de datos. */
  demo?: boolean;
}
const { patient, bookings, consentRows, demo = false } = Astro.props;
const esDemo = import.meta.env.DEV && demo;
const demoFalta = esDemo && Astro.url.searchParams.get('pareja') === 'falta';

const fmtCL = (iso: string) => new Date(iso).toLocaleString('es-CL', { timeZone: 'America/Santiago', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });

// ── D: ¿la ficha es de pareja? MISMA regla que exige 2 firmas para grabar (86-revisión B1:
//    consentimiento.ts fichaEsParejaEnBase — reserva de pareja, grabación de pareja, 2 personas que
//    firmaron o nombre "X y Y"). Si para grabar se piden 2 firmas, aquí siempre está el link. ──
let esPareja = false;
let errorReservas = false;
if (esDemo) {
  esPareja = true;
} else {
  try {
    esPareja = await fichaEsParejaEnBase(patient.id);
  } catch {
    // Sin la base completa: con lo que trae la ficha (no se esconde el bloque de una pareja).
    errorReservas = true;
    esPareja = fichaConReservaPareja(bookings, new Map()) || fichaEsPareja({
      sessionTypes: bookings.map((b) => b.session_type), tiposGrabaciones: [], filas: consentRows, nombre: patient.name,
    });
  }
}

const filas = esDemo && demoFalta ? consentRows.filter((r) => r.id.endsWith('c1')) : consentRows;
const estado = estadoPareja(filas, patient.rut, patient.name);
let link: string | null = null;
let errorLink: string | null = null;
if (esPareja && !estado.firma) {
  if (esDemo) {
    link = consentUrl(Astro.url.origin, 'demo-pareja-Xx7Qm2LpR4vN9sKe1Tz0aB3c');
  } else if (estado.pendiente?.token) {
    link = consentUrl(Astro.url.origin, estado.pendiente.token);
  } else {
    // Se crea al abrir la ficha (una vez; después se reutiliza) para que el link esté a la vista en la consulta.
    try { link = consentUrl(Astro.url.origin, (await getOrCreatePendingConsent(patient.id, 2)).token); }
    catch (e) { errorLink = e instanceof FaltaMigracion0021 ? e.message : 'No se pudo preparar el link de la pareja. Recarga la página.'; }
  }
}
const pilaFicha = String(patient.name ?? '').trim().split(/\s+/)[0] ?? '';
const waHref = link ? urlWhatsAppPareja(pilaFicha, link) : null;
// QR en el servidor (qrcode-generator, sin red): el link no pasa por ningún servicio externo.
let qr: string | null = null;
if (link) { try { qr = qrSvg(link, { titulo: 'Código QR del consentimiento de la pareja' }); } catch { qr = null; } }
const enviado = estado.pendiente?.sent_at ? { at: String(estado.pendiente.sent_at), via: String((estado.pendiente as { sent_via?: string | null }).sent_via ?? '') } : null;
const nombreFirma = estado.firma ? (String(estado.firma.signer_name ?? '').trim() || 'la pareja') : '';

// ── E: anexos (copia fiel del correo con el aviso v2) de las firmas de esta ficha ──
const firmadas = filas.filter((r) => r.signed_at);
const nombrePorConsent = new Map<string, string>(firmadas.map((r) => [String(r.id), String(r.signer_name ?? '').trim() || 'Sin nombre']));
let anexos: AnexoConsentimiento[] = [];
if (esDemo) {
  const v2 = firmadas.find((r) => String(r.version).endsWith('v2'));
  if (v2) anexos = [{ id: '00000000-0000-4000-8000-0000000000e1', consent_id: v2.id, tipo: 'aviso_v2', asunto: 'Sesión confirmada — Ps. Valentina Orellana', destinatario: 'tomas@example.com', enviado_at: '2026-10-14T13:20:00Z', resend_id: 'demo', html_sha256: '0'.repeat(64) }];
} else {
  anexos = await anexosDeConsentimientos(firmadas.map((r) => String(r.id)));
}
---

{esPareja && (
  <section class="card cp" aria-labelledby="cp-titulo" data-patient-id={patient.id}>
    <div class="cp-cab">
      <div class="cp-cab-txt">
        <p id="cp-titulo" class="cp-titulo">Consentimiento de la pareja</p>
        {estado.firma
          ? <p class="cp-estado">Firmado por {nombreFirma} el {fmtCL(String(estado.firma.signed_at))}</p>
          : <p class="cp-estado">Falta la firma de la segunda persona</p>}
      </div>
      <span class={`cp-chip ${estado.firma ? 'cp-chip-ok' : 'cp-chip-falta'}`}>{estado.firma ? '✓ Firmado' : 'Falta'}</span>
    </div>

    {estado.firma ? (
      <p class="cp-sub">
        Versión {estado.firma.version} · Grabación: {estado.firma.recording_revoked_at
          ? <strong class="cp-no">retirada</strong>
          : estado.firma.accept_recording ? <strong class="cp-si">sí autoriza</strong> : <strong class="cp-no">no autoriza</strong>}
        {' · '}<a href={`/admin/pacientes/${patient.id}/consentimiento/${estado.firma.id}`} target="_blank">ver constancia</a>
      </p>
    ) : (
      <>
        <p class="cp-sub">
          {estado.retirada ? `${String(estado.retirada.signer_name ?? 'La pareja').trim()} retiró su consentimiento el ${fmtCL(String(estado.retirada.revoked_at))}. ` : ''}
          Cada persona firma el suyo, en su propio celular. Sin las dos firmas no se puede grabar.
          {enviado && <> Link enviado {enviado.via === 'email' ? 'por correo' : enviado.via === 'whatsapp' ? 'por WhatsApp' : ''} el {fmtCL(enviado.at)}.</>}
        </p>
        {link ? (
          <div class="cp-grupos">
            <div class="cp-grupo">
              <p class="cp-grupo-t">En la consulta</p>
              <button type="button" class="btn btn-dark cp-btn cp-qr-abrir" disabled={!qr} aria-haspopup="dialog">
                <svg class="cp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4z"/><path d="M14 14h2v2h-2zM18 14h2M14 18v2M17 17h3v3h-3z"/></svg>
                Mostrar código QR
              </button>
              <p class="cp-ayuda">La persona lo escanea con la cámara de su celular y firma ahí mismo. Esta tarjeta se actualiza sola cuando firma.</p>
            </div>
            <div class="cp-grupo">
              <p class="cp-grupo-t">Antes de la sesión</p>
              <div class="cp-botones">
                <a class="btn btn-outline cp-btn cp-wa" href={waHref} target="_blank" rel="noopener">
                  <svg class="cp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.6a8.4 8.4 0 0 1-12.4 7.4L3.5 20.5l1.6-4.4a8.4 8.4 0 1 1 15.4-4.5z"/></svg>
                  Enviar por WhatsApp
                </a>
                <button type="button" class="btn btn-outline cp-btn cp-copiar" data-url={link}>
                  <svg class="cp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
                  <span class="cp-copiar-txt">Copiar link</span>
                </button>
                <button type="button" class="btn btn-outline cp-btn cp-correo-abrir" aria-expanded="false" aria-controls={`cp-correo-${patient.id}`}>
                  <svg class="cp-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>
                  Enviar por correo
                </button>
              </div>
              <form class="cp-correo" id={`cp-correo-${patient.id}`} hidden novalidate>
                <label class="cp-label" for={`cp-correo-in-${patient.id}`}>Correo de la segunda persona</label>
                <div class="cp-correo-fila">
                  <input id={`cp-correo-in-${patient.id}`} class="cp-correo-in" type="email" inputmode="email" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="120" placeholder="nombre@correo.cl" />
                  <button type="submit" class="btn btn-dark cp-btn cp-correo-enviar">Enviar</button>
                </div>
                <p class="cp-ayuda">Solo se usa para mandar el link: no queda guardado en la ficha.</p>
              </form>
              <p class="cp-msg" role="status" aria-live="polite"></p>
              <p class="cp-url-fila"><span class="cp-url-k">Link:</span> <a class="cp-url" href={link} target="_blank" rel="noopener">{link}</a></p>
            </div>

            {qr && (
              <dialog class="cp-dialogo" aria-labelledby={`cp-qr-t-${patient.id}`}>
                <div class="cp-dialogo-in">
                  <p class="cp-dialogo-t" id={`cp-qr-t-${patient.id}`}>Escanea con la cámara de tu celular</p>
                  <div class="cp-qr" set:html={qr} />
                  <p class="cp-dialogo-sub">Se abre tu consentimiento informado para la terapia de pareja. Lo lees, marcas lo que autorizas y firmas. Toma unos 2 minutos.</p>
                  <p class="cp-dialogo-estado" role="status" aria-live="polite">Esperando la firma…</p>
                  <button type="button" class="btn btn-outline cp-btn cp-qr-cerrar">Cerrar</button>
                </div>
              </dialog>
            )}
          </div>
        ) : (
          <p class="cp-sub cp-no">{errorLink}</p>
        )}
      </>
    )}
    {errorReservas && <p class="cp-sub">No se pudieron revisar todas las reservas: se usó lo que muestra la ficha. Recarga en un momento.</p>}
  </section>
)}

{anexos.length > 0 && (
  <section class="card cp" aria-labelledby="cp-anexos-titulo">
    <p id="cp-anexos-titulo" class="cp-titulo">Anexos de los consentimientos</p>
    <ul class="cp-anexos">
      {anexos.map((a) => {
        const base = `/admin/pacientes/${patient.id}/consentimiento/${a.consent_id}/anexo/${a.id}`;
        return (
          <li class="cp-anexo">
            <p class="cp-anexo-txt">
              <strong>Anexo: {(TITULO_ANEXO[a.tipo] ?? 'anexo').toLowerCase()}</strong> (enviado el {fmtCL(a.enviado_at)})
              <span class="cp-sub"> · consentimiento de {nombrePorConsent.get(String(a.consent_id)) ?? '—'} · a {a.destinatario}</span>
            </p>
            <div class="cp-botones">
              <a class="btn btn-outline btn-sm" href={base} target="_blank" rel="noopener">Ver</a>
              <a class="btn btn-outline btn-sm" href={`${base}?descargar=1`}>Descargar</a>
            </div>
          </li>
        );
      })}
    </ul>
  </section>
)}

<style>
  .cp { margin: -0.75rem 0 1.5rem; padding: 1.1rem 1.2rem; }
  .cp-cab { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; }
  .cp-cab-txt { min-width: 0; }
  .cp-titulo { font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; color: var(--enc-text-3, #6b7280); margin-bottom: 0.3rem; }
  .cp-estado { font-weight: 600; font-size: 0.95rem; color: var(--enc-text-1, #111827); line-height: 1.4; overflow-wrap: anywhere; }
  .cp-chip { flex-shrink: 0; font-size: 0.72rem; font-weight: 600; border-radius: 99px; padding: 0.2rem 0.65rem; border: 1px solid; white-space: nowrap; }
  .cp-chip-ok { color: #15803d; background: #f0fdf4; border-color: #86efac; }
  .cp-chip-falta { color: #92400e; background: #fffbeb; border-color: #fcd34d; }
  .cp-sub { font-size: 0.8rem; color: var(--enc-text-3, #6b7280); margin-top: 0.35rem; line-height: 1.55; }
  .cp-sub a { color: var(--enc-blue-dark, #1d4ed8); }
  .cp-si { color: var(--enc-green-dark, #16a34a); }
  .cp-no { color: var(--enc-red, #ef4444); }

  .cp-grupos { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 1rem; margin-top: 0.9rem; }
  .cp-grupo { border: 1px solid var(--enc-border, #e5e7eb); border-radius: var(--enc-radius-lg, 10px); padding: 0.9rem; background: var(--enc-body-bg, #f9fafb); min-width: 0; display: flex; flex-direction: column; gap: 0.55rem; }
  .cp-grupo-t { font-size: 0.78rem; font-weight: 600; color: var(--enc-text-2, #374151); }
  .cp-ayuda { font-size: 0.76rem; color: var(--enc-text-3, #6b7280); line-height: 1.5; }
  .cp-botones { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .btn.cp-btn { min-height: 48px; padding: 0 1rem !important; font-size: 0.875rem !important; gap: 0.5rem; }
  .cp-ico { width: 18px; height: 18px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .btn.cp-copiar.cp-hecho { color: #15803d !important; border-color: #86efac !important; background: #f0fdf4 !important; }

  .cp-correo { display: flex; flex-direction: column; gap: 0.35rem; }
  .cp-correo[hidden] { display: none; }
  .cp-label { font-size: 0.76rem; font-weight: 600; color: var(--enc-text-2, #374151); }
  .cp-correo-fila { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .cp-correo-fila input { min-height: 48px; flex: 1 1 10rem; width: auto; min-width: 0; font-size: 1rem !important; }
  /* Sugerencias de dominio (CamposContacto.astro) debajo, a lo ancho, sin romper la fila. */
  .cp-correo-fila :global(.cc-sugerencias) { order: 3; flex: 1 1 100%; }
  .cp-msg { font-size: 0.8rem; line-height: 1.45; }
  .cp-msg:empty { display: none; }
  .cp-url-fila { font-size: 0.72rem; color: var(--enc-text-3, #6b7280); overflow-wrap: anywhere; word-break: break-all; line-height: 1.45; }
  .cp-url-k { font-weight: 600; }
  .cp-url { color: var(--enc-blue-dark, #1d4ed8); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }

  .cp-dialogo { margin: auto; border: none; border-radius: 16px; padding: 0; width: min(440px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); box-shadow: 0 20px 50px rgba(0,0,0,.25); }
  .cp-dialogo::backdrop { background: rgba(17, 24, 39, 0.55); }
  .cp-dialogo-in { padding: 1.4rem 1.25rem 1.25rem; display: flex; flex-direction: column; align-items: center; gap: 0.8rem; text-align: center; }
  .cp-dialogo-t { font-size: 1.15rem; font-weight: 600; color: var(--enc-text-1, #111827); }
  .cp-qr { width: min(340px, calc(100vw - 80px)); aspect-ratio: 1; }
  .cp-qr :global(svg) { width: 100%; height: 100%; display: block; }
  .cp-dialogo-sub { font-size: 0.85rem; color: var(--enc-text-2, #374151); line-height: 1.55; max-width: 34ch; }
  .cp-dialogo-estado { font-size: 0.85rem; color: var(--enc-text-3, #6b7280); min-height: 1.3em; }
  .cp-dialogo-estado.cp-firmo { color: #15803d; font-weight: 600; font-size: 1rem; }
  .cp-dialogo .cp-btn { width: 100%; }

  .cp-anexos { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .cp-anexo { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; align-items: center; justify-content: space-between; }
  .cp-anexo-txt { font-size: 0.82rem; flex: 1 1 14rem; min-width: 0; overflow-wrap: anywhere; }

  @media (max-width: 720px) {
    .cp-grupos { grid-template-columns: minmax(0, 1fr); }
    .cp-grupo .cp-btn, .cp-botones .cp-btn { width: 100%; }
  }
</style>

<script>
  // Consentimiento de la pareja: QR (con revisión automática de la firma), WhatsApp, copiar link y correo.
  const post = async (cuerpo: Record<string, unknown>) => {
    const r = await fetch('/api/admin/consent', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'X-Panel': '1' }, body: JSON.stringify(cuerpo) });
    let d: { ok?: boolean; error?: string; [k: string]: unknown } = {};
    try { d = await r.json(); } catch { /* respuesta sin JSON */ }
    if (!r.ok || !d.ok) throw new Error(d.error || 'No se pudo completar. Intenta de nuevo.');
    return d;
  };
  const tarjeta = (el: Element) => el.closest<HTMLElement>('.cp[data-patient-id]');
  const pinta = (caja: HTMLElement | null, txt: string, color: string) => {
    const msg = caja?.querySelector<HTMLElement>('.cp-msg');
    if (msg) { msg.textContent = txt; msg.style.color = color; }
  };

  // ── QR: abrir/cerrar y revisar la firma cada 4 s mientras está abierto (máx. 20 min) ──
  const sondeos = new WeakMap<HTMLDialogElement, number>();
  const detener = (d: HTMLDialogElement) => { const t = sondeos.get(d); if (t) clearInterval(t); sondeos.delete(d); };
  function abrirQr(card: HTMLElement) {
    const d = card.querySelector<HTMLDialogElement>('.cp-dialogo');
    if (!d) return;
    if (typeof d.showModal === 'function') d.showModal(); else d.setAttribute('open', '');
    const estado = d.querySelector<HTMLElement>('.cp-dialogo-estado');
    const pid = card.dataset.patientId;
    const fin = Date.now() + 20 * 60_000;
    detener(d);
    const revisar = async () => {
      if (!d.open || Date.now() > fin) { detener(d); if (estado && d.open) estado.textContent = 'Si ya firmó, cierra y recarga la página.'; return; }
      try {
        const r = await post({ action: 'pareja_estado', patient_id: pid });
        if (r.firmado) {
          detener(d);
          d.dataset.firmo = '1';
          if (estado) { estado.textContent = `✓ Listo: ${r.nombre ? `firmó ${r.nombre}` : 'ya firmó'}.`; estado.classList.add('cp-firmo'); }
          const cerrar = d.querySelector<HTMLButtonElement>('.cp-qr-cerrar');
          if (cerrar) cerrar.textContent = 'Listo';
        }
      } catch { /* sin conexión: se reintenta en el próximo ciclo */ }
    };
    sondeos.set(d, window.setInterval(revisar, 4000));
  }
  document.querySelectorAll<HTMLDialogElement>('.cp-dialogo').forEach((d) => {
    d.addEventListener('close', () => { detener(d); if (d.dataset.firmo === '1') location.reload(); });
    // Tocar fuera del cuadro cierra.
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  });

  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement | null;
    if (!t) return;
    const card = tarjeta(t);
    if (!card) return;

    if (t.closest('.cp-qr-abrir')) { abrirQr(card); return; }
    if (t.closest('.cp-qr-cerrar')) { t.closest<HTMLDialogElement>('dialog')?.close(); return; }

    const copiar = t.closest<HTMLButtonElement>('.cp-copiar');
    if (copiar) {
      const url = copiar.dataset.url ?? '';
      const txt = copiar.querySelector<HTMLElement>('.cp-copiar-txt');
      try {
        await navigator.clipboard.writeText(url);
        copiar.classList.add('cp-hecho');
        if (txt) txt.textContent = '✓ Copiado';
        pinta(card, 'Link copiado. Pégalo en el mensaje que quieras.', '#15803d');
        setTimeout(() => { copiar.classList.remove('cp-hecho'); if (txt) txt.textContent = 'Copiar link'; }, 2500);
      } catch { prompt('Copia este link:', url); }
      return;
    }

    const abrirCorreo = t.closest<HTMLButtonElement>('.cp-correo-abrir');
    if (abrirCorreo) {
      const f = card.querySelector<HTMLFormElement>('.cp-correo');
      if (!f) return;
      f.hidden = !f.hidden;
      abrirCorreo.setAttribute('aria-expanded', String(!f.hidden));
      if (!f.hidden) f.querySelector<HTMLInputElement>('input')?.focus();
      return;
    }

    // WhatsApp: el enlace abre wa.me con el mensaje listo (Vale elige el contacto). Se registra el
    // envío sin bloquear la apertura.
    if (t.closest('.cp-wa')) {
      pinta(card, 'WhatsApp abierto con el mensaje listo: elige a la persona y envía.', '#15803d');
      post({ action: 'pareja_whatsapp', patient_id: card.dataset.patientId }).catch(() => undefined);
    }
  });

  document.addEventListener('submit', async (e) => {
    const f = (e.target as HTMLElement | null)?.closest<HTMLFormElement>('.cp-correo');
    if (!f) return;
    e.preventDefault();
    const card = tarjeta(f);
    const input = f.querySelector<HTMLInputElement>('.cp-correo-in');
    const boton = f.querySelector<HTMLButtonElement>('.cp-correo-enviar');
    const correo = (input?.value ?? '').trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(correo)) { pinta(card, 'Escribe un correo válido.', '#dc2626'); input?.focus(); return; }
    if (boton) { boton.disabled = true; boton.textContent = 'Enviando…'; }
    try {
      await post({ action: 'pareja_email', patient_id: card?.dataset.patientId, email: correo });
      pinta(card, `✓ Enviado a ${correo}. El correo no quedó guardado en la ficha.`, '#15803d');
      if (input) input.value = '';
      f.hidden = true;
      card?.querySelector('.cp-correo-abrir')?.setAttribute('aria-expanded', 'false');
    } catch (err) {
      pinta(card, `✕ ${err instanceof Error ? err.message : 'No se pudo enviar.'}`, '#dc2626');
    } finally {
      if (boton) { boton.disabled = false; boton.textContent = 'Enviar'; }
    }
  });
</script>
