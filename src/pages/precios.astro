---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero   from '../components/sections/PageHero.astro';
import { supabase } from '../lib/supabase';

const { data: services } = await supabase
  .from('services_catalog')
  .select('name, price, duration_min, type, modality, price_online, price_presencial, duration_min_online, duration_min_presencial')
  .eq('visible', true)
  .order('sort_order')
  .order('created_at');

const formatCLP = (n: number) =>
  new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);

const formatDuration = (min: number) =>
  min >= 60 ? `${Math.floor(min / 60)} hora${min >= 120 ? 's' : ''}${min % 60 ? ` ${min % 60} min` : ''}` : `${min} minutos`;

const serviceLines = (services ?? [])
  .map(s => {
    if (s.modality === 'ambos' && s.price_online && s.price_presencial) {
      return `• ${s.name} — Online: ${formatCLP(s.price_online)} (${formatDuration(s.duration_min_online ?? s.duration_min)}) · Presencial: ${formatCLP(s.price_presencial)} (${formatDuration(s.duration_min_presencial ?? s.duration_min)})`;
    }
    return `• ${s.name} — ${formatCLP(s.price)} · ${formatDuration(s.duration_min)}`;
  })
  .join('\n');

const priceAnswer = serviceLines
  ? `Los valores de las sesiones son:\n\n${serviceLines}`
  : 'Consulta los valores directamente en la agenda o escríbeme por WhatsApp.';

const faq = [
  {
    q: '¿Cuáles son los valores de las sesiones?',
    a: priceAnswer,
  },
  {
    q: '¿Cómo puedo pagar?',
    a: 'Acepto Webpay, MACH y tarjetas de crédito y débito a través de Flow (plataforma segura). El pago se realiza al momento de confirmar la reserva.',
  },
  {
    q: '¿Qué pasa si necesito reprogramar?',
    a: 'Las sesiones no se cancelan: solo puedes reagendar tu hora avisando con al menos 24 horas de anticipación. Si soy yo quien debe cancelar, reagendamos tu sesión sin costo.',
  },
  {
    q: '¿Atiendes con Fonasa o Isapre?',
    a: 'La atención es particular. No tengo convenio con Fonasa, por lo que no es posible usar bono Fonasa. Por cada sesión te entrego boleta de honorarios para que pidas reembolso en tu Isapre o en tu seguro complementario de salud, según tu plan.',
  },
  {
    q: '¿Mi Isapre me reembolsa las sesiones?',
    a: 'Puede que la terapia esté más a tu alcance de lo que crees. Por cada sesión te entrego boleta de honorarios para que pidas reembolso en tu Isapre. La Ley 21.331 de Salud Mental prohíbe que las Isapres discriminen la salud mental en sus coberturas, así que tu plan no debería cubrir una sesión de psicoterapia peor que una atención de salud física.\n\nCuánto te devuelven depende de tu plan: antes de empezar, revisa en tu Isapre la cobertura de "consulta psicológica". En terapia de pareja, consulta en tu Isapre cómo la cubre.\n\nSi te rechazan el reembolso o te pagan menos de lo que corresponde, reclama por escrito en tu Isapre. Si no responde en 15 días hábiles o no estás de acuerdo con su respuesta, puedes reclamar en la Superintendencia de Salud.',
    link: { href: 'https://www.superdesalud.gob.cl/tramites/reclamo-contra-fonasa-o-isapres/', label: 'Reclamar en la Superintendencia de Salud' },
  },
  {
    q: '¿La sesión online es igual de efectiva?',
    a: 'Sí. La modalidad online ha demostrado ser igualmente efectiva para la mayoría de los procesos terapéuticos. Es cómoda, accesible y completamente privada.',
  },
  {
    q: '¿Cuántas sesiones necesito?',
    a: 'Depende de cada persona y proceso. Algunas personas notan cambios significativos en pocas semanas, otras prefieren un acompañamiento más prolongado. Lo conversamos juntos en la primera sesión.',
  },
  {
    q: '¿Dónde se realizan las sesiones presenciales?',
    a: 'La consulta está en Lo Fontecilla 201, Torre B, oficina 334, Las Condes. Al confirmar tu reserva recibirás las indicaciones para llegar.',
  },
  {
    q: '¿Cómo es la primera sesión?',
    a: 'La primera sesión es de evaluación y conocimiento mutuo. Me cuentas lo que te trae, cuáles son tus objetivos y así definimos juntos cómo continuar. No hay presión ni compromisos.',
  },
];
---

<BaseLayout title="Precios y preguntas frecuentes" description="Valores de las sesiones, pago seguro con Flow, reembolso con tu Isapre o seguro complementario y cómo reagendar con 24 horas de anticipación.">

  <PageHero
    label="Todo lo que necesitas saber"
    title="Preguntas frecuentes"
    description="Aquí encontrarás respuesta a las dudas más comunes sobre las sesiones, precios y cómo funciona el proceso terapéutico."
    image="/images/banner-preguntas.jpg"
    imageMobile="/images/banner-preguntas-mobile.jpg"
  />

  <!-- Acordeón FAQ -->
  <section class="py-section bg-sand">
    <div class="container-site max-w-4xl">
      <div class="divide-y divide-dust border-b border-dust">
        {faq.map(({ q, a, link }) => (
          <details class="group py-5 md:py-7 cursor-pointer">
            <summary class="font-heading font-semibold text-card text-ink list-none [&::-webkit-details-marker]:hidden flex justify-between items-start gap-4 md:gap-6">
              <span>{q}</span>
              <span class="text-forest group-open:rotate-45 transition-transform duration-300 text-2xl font-light flex-shrink-0 mt-0.5">+</span>
            </summary>
            <div class="mt-4 md:mt-5 space-y-3">
              {a.split('\n\n').map((block) =>
                block.startsWith('•') || block.includes('\n•')
                  ? (
                    <ul class="space-y-1.5">
                      {block.split('\n').filter(l => l.trim()).map(line => (
                        <li class="body-text flex gap-2">
                          <span class="text-forest mt-1 flex-shrink-0">·</span>
                          <span>{line.replace('• ', '')}</span>
                        </li>
                      ))}
                    </ul>
                  )
                  : <p class="body-text">{block}</p>
              )}
              {link && (
                <p class="body-text">
                  <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-forest underline underline-offset-4">{link.label}</a>
                </p>
              )}
            </div>
          </details>
        ))}
      </div>

      <!-- CTA final -->
      <div class="mt-10 md:mt-14 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div>
          <p class="font-heading font-light text-card text-ink mb-1">¿Tienes otra duda?</p>
          <p class="body-sm">Escríbeme directamente por WhatsApp.</p>
        </div>
        <a
          href="https://wa.me/56972735696?text=Hola%20Valentina%2C%20tengo%20una%20consulta."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-dark py-3.5 px-7 flex-shrink-0"
        >
          Escribir por WhatsApp
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
