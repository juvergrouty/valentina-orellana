---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero   from '../components/sections/PageHero.astro';
import { supabase } from '../lib/supabase';

const { data: services, error: errServicios } = await supabase
  .from('services_catalog')
  .select('name, price, duration_min, type, modality, price_online, price_presencial, duration_min_online, duration_min_presencial')
  .eq('visible', true)
  .order('sort_order')
  .order('created_at');
// Sin datos de la base, la página no se guarda en la caché pública (middleware).
if (errServicios) Astro.response.headers.set('Cache-Control', 'no-store');

const formatCLP = (n: number) =>
  new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);

const formatDuration = (min: number) =>
  min >= 60 ? `${Math.floor(min / 60)} hora${min >= 120 ? 's' : ''}${min % 60 ? ` ${min % 60} min` : ''}` : `${min} minutos`;

const serviceLines = (services ?? [])
  .map(s => {
    if (s.modality === 'ambos' && s.price_online && s.price_presencial) {
      return `• ${s.name} — Online: ${formatCLP(s.price_online)} (${formatDuration(s.duration_min_online ?? s.duration_min)}) · Presencial: ${formatCLP(s.price_presencial)} (${formatDuration(s.duration_min_presencial ?? s.duration_min)})`;
    }
    return `• ${s.name} — ${formatCLP(s.price)} · ${formatDuration(s.duration_min)}`;
  })
  .join('\n');

const priceAnswer = serviceLines
  ? `Los valores de las sesiones son:\n\n${serviceLines}`
  : 'Consulta los valores directamente en la agenda o escríbeme por WhatsApp.';

const faq = [
  {
    q: '¿Qué temas trabajas?',
    a: 'Estos son algunos de los motivos por los que las personas llegan a consulta:\n\n• Me cuesta decir que no\n• Siento culpa al descansar o poner límites\n• Nunca es suficiente\n• Lo entiendo todo y aun así no cambio\n• Lo que viví en mi infancia me sigue pesando\n• Ansiedad y estrés\n• Ánimo bajo\n• Duelos y pérdidas\n• Siento que tengo que ser otra persona para que me quieran\n• Mi pareja y yo nos estamos alejando\n• Siempre me las he arreglado sin ayuda\n• Soy una persona altamente sensible (PAS)\n• La crianza me está desbordando\n\nSi lo tuyo no está aquí, escríbeme y lo conversamos.',
  },
  {
    q: '¿Cómo es la terapia individual?',
    a: 'Es un espacio para ti. En la primera sesión me cuentas qué te trae y qué te gustaría que cambiara, y definimos juntos cómo seguir, sin presión ni compromisos. No se trata solo de hablar de lo que duele: buscamos entender los patrones que se repiten y construir herramientas concretas para tu día a día.',
  },
  {
    q: '¿Cómo es la terapia de pareja?',
    a: 'Las sesiones son con ambos, de 50 minutos, presenciales en Las Condes u online. En la primera sesión los escucho a los dos, sin buscar culpables, y definimos juntos cómo seguir. El objetivo es que puedan comunicarse mejor y decidir con más claridad, ya sea para reencontrarse o para separarse de una manera más cuidada.\n\nSi tu pareja no quiere ir, puedes empezar tú en terapia individual. Si en la relación hay violencia, la terapia de pareja no es el primer paso: escríbeme y te oriento.',
    link: { href: '/terapia-de-pareja-las-condes', label: 'Más sobre terapia de pareja' },
  },
  {
    q: '¿Cuáles son los valores de las sesiones?',
    a: priceAnswer,
  },
  {
    q: '¿Cómo puedo pagar?',
    a: 'Acepto Webpay, MACH y tarjetas de crédito y débito a través de Flow (plataforma segura). El pago se realiza al momento de confirmar la reserva.',
  },
  {
    q: '¿Qué pasa si necesito reprogramar?',
    a: 'Puedes reagendar tu sesión sin costo avisando con al menos 24 horas de anticipación. Las sesiones no se cancelan: se reagendan. Si avisas con menos de 24 horas, la sesión se considera realizada. Si soy yo quien debe cancelar, reagendamos tu sesión sin costo.',
  },
  {
    q: '¿Atiendes con Fonasa o Isapre?',
    a: 'La atención es particular. No tengo convenio con Fonasa, por lo que no es posible usar bono Fonasa. Por cada sesión te entrego boleta de honorarios para que pidas reembolso en tu Isapre o en tu seguro complementario de salud, según tu plan.',
  },
  {
    q: '¿Mi Isapre me reembolsa las sesiones?',
    a: 'Puede que la terapia esté más a tu alcance de lo que crees. Por cada sesión te entrego boleta de honorarios para que pidas reembolso en tu Isapre. La Ley 21.331 de Salud Mental prohíbe que las Isapres discriminen la salud mental en sus coberturas, así que tu plan no debería cubrir una sesión de psicoterapia peor que una atención de salud física.\n\nCuánto te devuelven depende de tu plan: antes de empezar, revisa en tu Isapre la cobertura de "consulta psicológica". En terapia de pareja, consulta en tu Isapre cómo la cubre.\n\nSi te rechazan el reembolso o te pagan menos de lo que corresponde, reclama por escrito en tu Isapre. Si no responde en 15 días hábiles o no estás de acuerdo con su respuesta, puedes reclamar en la Superintendencia de Salud.',
    link: { href: 'https://www.superdesalud.gob.cl/tramites/reclamo-contra-fonasa-o-isapres/', label: 'Reclamar en la Superintendencia de Salud' },
  },
  {
    q: '¿Online o presencial: cuál me conviene?',
    a: 'Las dos duran lo mismo y tienen el mismo nivel de cuidado. Si te cuesta encontrar tiempo para trasladarte, lo online suele ser más fácil de sostener. Si prefieres salir de tu casa y tener un lugar distinto para la terapia, lo presencial en Las Condes puede acomodarte mejor. Si tienes dudas, lo conversamos.',
  },
  {
    q: '¿La sesión online es igual de efectiva?',
    a: 'Sí. La modalidad online ha demostrado ser igualmente efectiva para la mayoría de los procesos terapéuticos. Es cómoda, accesible y completamente privada.',
  },
  {
    q: '¿Cuántas sesiones necesito?',
    a: 'Depende de cada persona y proceso. Algunas personas notan cambios significativos en pocas semanas, otras prefieren un acompañamiento más prolongado. Lo conversamos juntos en la primera sesión.',
  },
  {
    q: '¿Dónde se realizan las sesiones presenciales?',
    a: 'La consulta está en Estoril 50, oficina 811b, Las Condes. Al confirmar tu reserva recibirás las indicaciones para llegar.',
  },
  {
    q: '¿Cada cuánto son las sesiones?',
    a: 'Al comienzo, lo habitual es una sesión a la semana. A medida que avanza el proceso podemos espaciarlas cada dos semanas. Lo vamos definiendo juntos según lo que necesites.',
  },
  {
    q: 'En terapia de pareja, ¿tenemos que ir los dos siempre?',
    a: 'Sí, las sesiones de pareja son con ambos. Si en algún momento es útil, puedo proponer alguna sesión individual dentro del proceso.',
  },
  {
    q: '¿Qué necesito para la sesión online?',
    a: 'Un lugar privado y tranquilo, audífonos y una conexión a internet estable. El enlace de Google Meet te llega a tu correo en la invitación de calendario de tu sesión.',
  },
  {
    q: '¿Lo que hablamos es confidencial?',
    a: 'Sí. Todo lo que conversamos está protegido por el secreto profesional. Las únicas excepciones son un riesgo grave para tu vida o la de otras personas, la vulneración de derechos de niños, niñas o adolescentes, una orden judicial y los demás casos que establece la ley. En esos casos compartiré solo lo estrictamente necesario y, cuando sea posible, te lo diré antes.',
  },
  {
    q: '¿Trabajas con otros profesionales?',
    a: 'Sí. Creo en un trabajo multidisciplinario: si durante el proceso considero que te ayudaría el apoyo de otro profesional (por ejemplo, psiquiatría u otra especialidad), te lo voy a sugerir. Y si en algún momento veo que la terapia no está siendo efectiva para ti, también te propondré una derivación a otro profesional calificado.',
  },
  {
    q: '¿Atiendes urgencias?',
    a: 'No. Este espacio no atiende urgencias. Si estás en crisis o piensas en hacerte daño, llama al *4141 (gratis, 24/7), a Salud Responde 600 360 7777 o al SAMU 131, o acude al servicio de urgencia más cercano.',
  },
  {
    q: '¿Cómo es la primera sesión?',
    a: 'La primera sesión es de evaluación y conocimiento mutuo. Me cuentas lo que te trae, cuáles son tus objetivos y así definimos juntos cómo continuar. No hay presión ni compromisos.',
  },
];
// Datos estructurados para Google (12 oct 2026): las mismas preguntas como FAQPage.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout title="Precios y preguntas frecuentes" description="Valores de las sesiones, pago seguro con Flow, reembolso con tu Isapre o seguro complementario y cómo reagendar con 24 horas de anticipación.">
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} />

  <PageHero
    label="Todo lo que necesitas saber"
    title="Preguntas frecuentes"
    description="Aquí encontrarás respuesta a las dudas más comunes sobre las sesiones, precios y cómo funciona el proceso terapéutico."
    image="/images/banner-preguntas.webp"
    imageMobile="/images/banner-preguntas-mobile.webp"
  />

  <!-- Acordeón FAQ -->
  <section class="py-section bg-sand">
    <div class="container-site max-w-4xl">
      <div class="divide-y divide-dust border-b border-dust">
        {faq.map(({ q, a, link }) => (
          <details class="group py-5 md:py-7 cursor-pointer">
            <summary class="font-heading font-semibold text-card text-ink list-none [&::-webkit-details-marker]:hidden flex justify-between items-start gap-4 md:gap-6">
              <span>{q}</span>
              <span class="text-forest group-open:rotate-45 transition-transform duration-300 text-2xl font-light flex-shrink-0 mt-0.5">+</span>
            </summary>
            <div class="mt-4 md:mt-5 space-y-3">
              {a.split('\n\n').map((block) =>
                block.startsWith('•') || block.includes('\n•')
                  ? (
                    <ul class="space-y-1.5">
                      {block.split('\n').filter(l => l.trim()).map(line => (
                        <li class="body-text flex gap-2">
                          <span class="text-forest mt-1 flex-shrink-0">·</span>
                          <span>{line.replace('• ', '')}</span>
                        </li>
                      ))}
                    </ul>
                  )
                  : <p class="body-text">{block}</p>
              )}
              {link && (
                <p class="body-text">
                  <a href={link.href} {...(link.href.startsWith('/') ? {} : { target: '_blank', rel: 'noopener noreferrer' })} class="text-forest underline underline-offset-4">{link.label}</a>
                </p>
              )}
            </div>
          </details>
        ))}
      </div>

      <!-- CTA final -->
      <div class="mt-10 md:mt-14 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div>
          <p class="font-heading font-light text-card text-ink mb-1">¿Tienes otra duda?</p>
          <p class="body-sm">Escríbeme directamente por WhatsApp.</p>
        </div>
        <a
          href="https://wa.me/56972735696?text=Hola%20Valentina%2C%20tengo%20una%20consulta."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-dark py-3.5 px-7 flex-shrink-0"
        >
          Escribir por WhatsApp
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
