---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero   from '../components/sections/PageHero.astro';
import { supabase } from '../lib/supabase';
import { imagenUrl, imagenSrcset } from '../lib/imagenOptimizada';
import { DIRECCION } from '../data/consulta';

// Leer servicios visibles desde la base de datos
const { data: dbServices, error: errServicios } = await supabase
  .from('services_catalog')
  .select('id, name, description, type, modality, location, duration_min, price, image_url, sort_order')
  .eq('visible', true)
  .order('sort_order')
  .order('created_at');
// Sin datos de la base, la página no se guarda en la caché pública (middleware).
if (errServicios) Astro.response.headers.set('Cache-Control', 'no-store');

// Fallback si la BD está vacía
const fallback = [
  {
    id: 'psicologia-adultos',
    name: 'Psicología de Adultos',
    description: 'Acompañamiento terapéutico individual para el manejo de ansiedad, depresión, estrés, duelo y bienestar emocional en general.',
    type: 'individual', modality: 'ambos', location: null,
    duration_min: 50, price: 65000,
    image_url: '/images/servicio-adultos.jpg', sort_order: 0,
  },
  {
    id: 'terapia-pareja',
    name: 'Terapia de Pareja',
    description: 'Espacio de escucha y trabajo conjunto para mejorar la comunicación, resolver conflictos y fortalecer el vínculo.',
    type: 'pareja', modality: 'ambos', location: null,
    duration_min: 50, price: 75000,
    image_url: '/images/servicio-pareja.jpg', sort_order: 1,
  },
  {
    id: 'trauma',
    name: 'Trauma y PAS',
    description: 'Tratamiento especializado para personas que han vivido experiencias traumáticas o que se reconocen como Personas Altamente Sensibles (PAS).',
    type: 'individual', modality: 'ambos', location: null,
    duration_min: 50, price: 65000,
    image_url: '/images/servicio-trauma.jpg', sort_order: 2,
  },
  {
    id: 'parentalidad',
    name: 'Parentalidad y Apego',
    description: 'Orientación para padres y madres que buscan fortalecer el vínculo con sus hijos y desarrollar una crianza consciente.',
    type: 'individual', modality: 'ambos', location: null,
    duration_min: 50, price: 65000,
    image_url: '/images/servicio-parentalidad.jpg', sort_order: 3,
  },
];

const services = (dbServices && dbServices.length > 0 ? dbServices : fallback);

// Fotos reales de la consulta en Estoril 50 (12 oct 2026) para los servicios
// presenciales: las de Supabase eran de banco de imágenes, con personas que no
// son Valentina. Misma regla que en la portada (HomeServices.astro).
const FOTOS_CONSULTA = {
  individual: { base: '/images/consulta-puerta', alt: 'Sala de atención de la consulta en Estoril 50, Las Condes, vista desde la puerta: sillón, mesa de centro y ventana' },
  pareja:     { base: '/images/consulta-sala',   alt: 'Sala de atención de la consulta en Estoril 50, Las Condes: sofá para dos, sillón y mesa de centro junto a la ventana' },
};
const fotoConsulta = (s: { modality: string; type: string | null; name: string }) => {
  // Valentina (12 oct 2026) prefiere las fotos referenciales del panel en las
  // tarjetas: se desactiva la foto de la consulta (queda el código por si se retoma).
  return null;
  if (s.modality !== 'presencial') return null;
  const esPareja = s.type === 'pareja' || /pareja/i.test(s.name);
  return esPareja ? FOTOS_CONSULTA.pareja : FOTOS_CONSULTA.individual;
};

const formatCLP = (n: number) =>
  new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);

const modalityLabel = (m: string) =>
  m === 'online' ? 'Online' : m === 'presencial' ? 'Presencial' : 'Online · Presencial';
---

<BaseLayout title="Terapia Individual y de Pareja" description="Terapia individual para adultos y terapia de pareja, online o presencial en Las Condes. Sesiones de 50 minutos con la Ps. Valentina Orellana.">

  <PageHero label="¿En qué puedo ayudarte?" title="Servicios" image="/images/sala-espera-ancho-1600.webp" imageMobile="/images/sala-espera-800.webp" />

  <section class="py-section bg-sand">
    <div class="container-site">
      <!-- Introducción (SEO, 16 oct 2026) -->
      <p class="body-lead max-w-2xl mb-10 md:mb-14">
        Acompaño a adultos y parejas desde un enfoque sistémico: miramos lo que te pasa en relación con tu historia,
        tus vínculos y el momento que estás viviendo. Puedes elegir sesiones online, desde cualquier lugar de Chile,
        o presenciales en mi consulta en Las Condes. Todas duran 50 minutos. Si no sabes cuál es la opción para ti,
        más abajo te cuento cómo es cada una.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {services.map((service, i) => { const foto = fotoConsulta(service); return (
          <div class="relative overflow-hidden rounded-[10px] group min-h-[420px] flex flex-col justify-end">

            <!-- Imagen de fondo -->
            <!-- Optimizada por Vercel y diferida: va bajo el banner, el LCP es el
                 banner de PageHero (8 oct 2026). Presenciales: foto propia en WebP. -->
            {foto ? (
            <img
              src={`${foto.base}-800.webp`}
              srcset={`${foto.base}-800.webp 800w, ${foto.base}-1600.webp 1600w`}
              sizes="(min-width: 768px) 50vw, 100vw"
              width="800" height="1000"
              loading="lazy" decoding="async"
              alt={foto.alt}
              class="absolute inset-0 w-full h-full object-cover object-[50%_65%] group-hover:scale-105 transition-transform duration-700"
            />
            ) : (
            <img
              src={imagenUrl(service.image_url ?? '/images/consultorio-individual.jpg', 1200)}
              srcset={imagenSrcset(service.image_url ?? '/images/consultorio-individual.jpg', [640, 828, 1200])}
              sizes="(min-width: 768px) 50vw, 100vw"
              width="1200" height="1200"
              loading="lazy" decoding="async"
              alt={service.name}
              class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
            />
            )}

            <!-- Degradado inferior para legibilidad: más oscuro donde va el texto
                 (antes from-ink/90 via-ink/40 dejaba la descripción bajo 4,5:1 sobre
                 fotos claras como la de la consulta). -->
            <div class="absolute inset-0 bg-gradient-to-t from-ink/95 via-ink/75 via-55% to-ink/10"></div>

            <!-- Badge modalidad -->
            <div class="absolute top-4 left-4 z-10">
              <span class="font-body text-xs font-medium px-3 py-1 rounded-full bg-white/15 backdrop-blur-sm text-white border border-white/20">
                {modalityLabel(service.modality)}
              </span>
            </div>

            <!-- Contenido sobre la imagen -->
            <div class="relative z-10 px-6 pb-6 pt-16 sm:p-8 md:p-10">
              <p class="label text-white/80 mb-3">{String(i + 1).padStart(2, '0')}</p>
              <h2 class="font-heading font-semibold text-3xl md:text-4xl text-white leading-tight mb-3">
                {service.name}
              </h2>
              <p class="font-body text-sm text-white/90 leading-relaxed mb-6 max-w-sm">
                {service.description}
              </p>
              {service.location && (
                <p class="font-body text-xs text-white/85 mb-4">📍 {service.location}</p>
              )}
              <div class="flex flex-wrap items-end justify-between gap-4 pt-5 border-t border-white/20">
                <div>
                  <p class="label text-white/80 mb-0.5">Duración · Valor</p>
                  <p class="font-heading text-lg text-white whitespace-nowrap">
                    {service.duration_min} min · {formatCLP(service.price)}
                  </p>
                </div>
                <a href={`/agenda?servicio=${service.id}`}
                  class="font-body text-xs tracking-widest uppercase whitespace-nowrap py-2.5 px-5 border border-white/40 text-white hover:bg-white hover:text-ink transition-all duration-200">
                  Agendar sesión
                </a>
              </div>
            </div>

          </div>
        ); })}
      </div>
    </div>
  </section>

  <!-- Cómo es cada terapia (SEO, 16 oct 2026): texto útil antes del cierre, mismas clases del sitio. -->
  <section class="bg-warm border-t border-dust py-16 md:py-24">
    <div class="container-site max-w-3xl space-y-12">

      <div>
        <p class="label mb-3">Terapia individual</p>
        <div class="divider mb-6"></div>
        <h2 class="card-title text-2xl md:text-3xl mb-5">¿Cómo es la terapia individual?</h2>
        <div class="space-y-4 body-text">
          <p>La terapia individual es un espacio para ti. En la primera sesión me cuentas qué te trae y qué te gustaría que cambiara, y definimos juntos cómo seguir, sin presión ni compromisos.</p>
          <p>Trabajo con temas como ansiedad, estrés, duelo, autoestima, autoexigencia, límites y vínculos, entre otros. No se trata solo de hablar de lo que duele: buscamos entender los patrones que se repiten y construir herramientas concretas para tu día a día. Al comienzo lo habitual es una sesión a la semana; a medida que avanza el proceso, podemos espaciarlas.</p>
          <p>También acompaño procesos de trauma, a Personas Altamente Sensibles (PAS) y a madres y padres que quieren fortalecer el vínculo con sus hijos.</p>
        </div>
      </div>

      <div>
        <p class="label mb-3">Terapia de pareja</p>
        <div class="divider mb-6"></div>
        <h2 class="card-title text-2xl md:text-3xl mb-5">¿Cómo es la terapia de pareja?</h2>
        <div class="space-y-4 body-text">
          <p>Las sesiones de pareja son con ambos. En la primera escucho a cada uno, sin buscar culpables, y desde ahí miramos qué dinámica se repite entre ustedes y de dónde viene.</p>
          <p>El objetivo es que puedan comunicarse mejor, cuidarse y decidir con más claridad, ya sea para reencontrarse o para separarse de una manera más cuidada. Si tu pareja no quiere ir, puedes empezar tú en terapia individual: muchas veces el cambio de uno mueve la relación completa. Si en la relación hay violencia, la terapia de pareja no es el primer paso: escríbeme y te oriento. Te cuento más en <a href="/terapia-de-pareja-las-condes" class="text-forest underline underline-offset-4">terapia de pareja en Las Condes y online</a>.</p>
        </div>
      </div>

      <div>
        <p class="label mb-3">Modalidad</p>
        <div class="divider mb-6"></div>
        <h2 class="card-title text-2xl md:text-3xl mb-5">Online o presencial: ¿cuál elegir?</h2>
        <div class="space-y-4 body-text">
          <p>Las dos modalidades duran lo mismo y tienen el mismo cuidado. La sesión online es por Google Meet: solo necesitas un lugar privado y tranquilo, audífonos y una buena conexión, y puedes conectarte desde cualquier parte de Chile. La presencial es en {DIRECCION.calle}, {DIRECCION.detalle}, {DIRECCION.comuna}.</p>
          <p>Si te cuesta encontrar tiempo para trasladarte, lo online suele ser más fácil de sostener. Si prefieres salir de tu casa y tener un lugar distinto para la terapia, lo presencial puede acomodarte mejor. Si tienes dudas, lo conversamos.</p>
        </div>
      </div>

      <div>
        <p class="label mb-3">Valores</p>
        <div class="divider mb-6"></div>
        <h2 class="card-title text-2xl md:text-3xl mb-5">Valores y reembolso</h2>
        <div class="space-y-4 body-text">
          <p>Cada servicio muestra arriba su duración y su valor. La atención es particular: no tengo convenio con Fonasa ni Isapre, pero por cada sesión te entrego boleta de honorarios para que pidas reembolso en tu Isapre o seguro complementario, según tu plan. El pago se hace en línea al reservar, y puedes reagendar sin costo avisando con al menos 24 horas de anticipación. Todo el detalle está en <a href="/precios" class="text-forest underline underline-offset-4">precios y preguntas frecuentes</a>.</p>
          <p>Si quieres conocer mi formación y mi forma de trabajar, puedes leer <a href="/sobre-mi" class="text-forest underline underline-offset-4">sobre mí</a>. Y cuando quieras dar el paso, <a href="/agenda" class="text-forest underline underline-offset-4">elige día y hora en la agenda</a>.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA final -->
  <section class="py-14 md:py-20 bg-ink text-center">
    <div class="container-site max-w-xl">
      <p class="label text-sand/60 mb-4">¿No sabes por dónde empezar?</p>
      <div class="divider-center bg-sand/20 mb-8"></div>
      <h2 class="font-heading font-light text-3xl md:text-4xl text-sand mb-6">
        Escríbeme y lo<br />descubrimos juntos.
      </h2>
      <a href="/contacto" class="btn bg-sand text-ink hover:bg-gold hover:text-white text-[10px] tracking-widest2 uppercase py-3.5 px-8 transition-all duration-300">
        Contactar a Valentina
      </a>
    </div>
  </section>

</BaseLayout>
