---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero   from '../components/sections/PageHero.astro';
import { supabase } from '../lib/supabase';
import { DIRECCION } from '../data/consulta';

// Página de destino de terapia de pareja (12 oct 2026, auditoría de marketing):
// los anuncios de pareja llevaban directo a la agenda de pago; quien busca
// "terapia de pareja Las Condes" necesita leer antes de reservar $75.000.
const { data: servicios } = await supabase
  .from('services_catalog')
  .select('name, price, price_online, price_presencial, modality, duration_min')
  .eq('visible', true)
  .ilike('name', '%pareja%')
  .order('sort_order');

const clp = (n: number) => new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);
const precios = (servicios ?? []).flatMap(s => [s.price_presencial, s.price_online, s.price_presencial || s.price_online ? null : s.price]).filter((n): n is number => typeof n === 'number' && n > 0);
const precioDesde = precios.length ? Math.min(...precios) : null;

const senales = [
  'Discuten por lo mismo una y otra vez, sin llegar a nada.',
  'Sienten distancia: conviven, pero ya no se encuentran.',
  'Hubo una infidelidad o algo que rompió la confianza.',
  'Les cuesta hablar sin herirse, o uno de los dos ya no habla.',
  'Están frente a una decisión grande: hijos, convivencia, separación.',
];

const temas = [
  { t: 'Peleas que se repiten', d: 'Cuando discuten siempre por lo mismo, casi nunca el problema es el tema de la pelea. Miramos qué se activa en cada uno y por qué la conversación termina siempre en el mismo lugar.' },
  { t: 'Distancia emocional', d: 'Conviven, se organizan bien con la casa y los hijos, pero hace tiempo que no se sienten cerca. Trabajamos en recuperar el interés por el otro y los momentos que son solo de ustedes.' },
  { t: 'Infidelidad y confianza rota', d: 'Después de una infidelidad aparecen la rabia, la culpa y muchas preguntas. La terapia ordena ese proceso para que puedan decidir si quieren reconstruir la relación y cómo hacerlo.' },
  { t: 'Comunicación difícil', d: 'Uno insiste y el otro se cierra, o cada conversación importante termina en reproche. Buscamos formas de decir lo que necesitan sin herirse.' },
  { t: 'Cambios de etapa', d: 'La llegada de un hijo, una mudanza, irse a vivir juntos, la pérdida de un trabajo o la salida de los hijos de la casa cambian el equilibrio de la pareja y suelen remover cosas que estaban guardadas.' },
  { t: 'Decidir si seguir o separarse', d: 'Cuando no saben si quieren seguir juntos, la terapia les da un espacio para pensarlo con calma. Si deciden separarse, también se puede hacer de una manera más cuidada, sobre todo cuando hay hijos.' },
];

const lecturas = [
  { href: '/blog/ya-no-nos-amamos', t: '¿Ya no nos amamos?' },
  { href: '/blog/nadie-nos-ensena-a-ser-pareja', t: 'Nadie nos enseña a ser pareja' },
  { href: '/blog/volver-a-elegirse', t: 'Volver a elegirse' },
  { href: '/blog/por-que-se-pelea-mas-en-vacaciones', t: 'Por qué se pelea más en vacaciones' },
];

const pasos = [
  { n: '01', t: 'Escucharlos a los dos', d: 'En la primera sesión cada uno cuenta qué le pasa y qué espera. Sin buscar culpables.' },
  { n: '02', t: 'Entender el patrón', d: 'Miramos qué dinámica se repite entre ustedes y de dónde viene, desde la historia de cada uno.' },
  { n: '03', t: 'Cambiar cómo se relacionan', d: 'Trabajamos herramientas concretas para comunicarse, cuidarse y decidir juntos.' },
];

const faq = [
  { q: '¿Cuánto cuesta la terapia de pareja?', a: `Cada sesión de pareja dura 50 minutos${precioDesde ? ` y tiene un valor ${new Set(precios).size > 1 ? 'desde' : 'de'} ${clp(precioDesde)}` : ''}. Se paga en línea al reservar y por cada sesión recibes una boleta de honorarios.` },
  { q: '¿Mi Isapre me reembolsa la terapia de pareja?', a: 'Con la boleta de honorarios puedes pedir el reembolso en tu Isapre o en tu seguro complementario. En terapia de pareja la cobertura cambia mucho de un plan a otro, así que conviene consultar en tu Isapre cómo la cubre antes de empezar.' },
  { q: '¿Cuántas sesiones vamos a necesitar?', a: 'Depende de lo que traigan y de cuánto tiempo lleva instalado el problema. En las primeras sesiones conversamos qué quieren lograr y armamos un plan claro de terapia, que vamos revisando juntos a medida que avanzamos.' },
  { q: '¿Lo que digo en la terapia es confidencial?', a: 'Sí. Todo lo que se conversa en las sesiones es confidencial. Las únicas excepciones son un riesgo grave para la vida de alguien, la vulneración de derechos de niños, niñas o adolescentes, una orden judicial y los demás casos que establece la ley.' },
  { q: '¿Tenemos que ir los dos siempre?', a: 'Sí, las sesiones de pareja son con ambos. Si en algún momento es útil, puedo proponer alguna sesión individual dentro del proceso.' },
  { q: '¿Y si mi pareja no quiere ir?', a: 'Puedes empezar tú en terapia individual: muchas veces el cambio de uno mueve la relación completa.' },
  { q: '¿La terapia de pareja es para separarse o para seguir juntos?', a: 'Para entender qué les pasa y decidir con más claridad. A veces eso significa reencontrarse, y otras, separarse de una manera más cuidada.' },
  { q: '¿Se puede hacer online?', a: 'Sí, por Google Meet, desde cualquier lugar de Chile. Solo necesitan un espacio privado y una buena conexión.' },
  { q: '¿Y si en la relación hay violencia?', a: 'Si hay violencia física, sexual, amenazas o control, la terapia de pareja no es el primer paso. Escríbeme para orientarte o llama al 1455 (fono de orientación en violencias de género, gratuito). Si hay peligro inmediato, llama al 133.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.valentinaorellana.cl/' },
        { '@type': 'ListItem', position: 2, name: 'Servicios', item: 'https://www.valentinaorellana.cl/servicios' },
        { '@type': 'ListItem', position: 3, name: 'Terapia de pareja', item: 'https://www.valentinaorellana.cl/terapia-de-pareja-las-condes' },
      ],
    },
    {
      '@type': 'Service',
      name: 'Terapia de pareja',
      serviceType: 'Terapia de pareja',
      url: 'https://www.valentinaorellana.cl/terapia-de-pareja-las-condes',
      areaServed: [{ '@type': 'City', name: 'Las Condes' }, { '@type': 'Country', name: 'Chile' }],
      provider: { '@type': 'Person', name: 'Valentina Orellana Jaramillo', url: 'https://www.valentinaorellana.cl/sobre-mi' },
      ...(precioDesde ? { offers: { '@type': 'Offer', price: precioDesde, priceCurrency: 'CLP' } } : {}),
    },
  ],
};
---

<BaseLayout
  title="Terapia de pareja en Las Condes y online"
  description={`Terapia de pareja con la Ps. Valentina Orellana en ${DIRECCION.calle}, Las Condes, y online. Sesiones de 50 minutos${precioDesde ? `, ${clp(precioDesde)}` : ''}. Boleta para reembolso Isapre.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

  <PageHero
    label="Terapia de pareja · Las Condes y online"
    title="Terapia de pareja"
    description="Un espacio para entender qué les está pasando y volver a encontrarse, o decidir con claridad."
    image="/images/sala-espera-ancho-1600.webp"
    imageMobile="/images/sala-espera-800.webp"
  />

  <section class="bg-sand py-16 md:py-24">
    <div class="container-site grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16">
      <div class="md:col-span-5">
        <p class="label mb-3">¿Cuándo consultar?</p>
        <h2 class="section-title">Señales de que puede ser el momento</h2>
      </div>
      <ul class="md:col-span-7 space-y-4">
        {senales.map(s => (
          <li class="flex gap-4 border-b border-dust pb-4 body-text text-[#4a4842] font-normal"><span aria-hidden="true" class="text-forest">—</span><span>{s}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-white border-t border-dust py-16 md:py-24">
    <div class="container-site">
      <p class="label mb-3">Qué trabajamos</p>
      <h2 class="section-title mb-6 max-w-2xl">Lo que suelen traer las parejas a la consulta</h2>
      <p class="body-text text-[#4a4842] font-normal mb-10 md:mb-14 max-w-3xl">
        Soy psicóloga de adultos y parejas y trabajo con un enfoque sistémico: en vez de buscar quién tiene la culpa, miro la relación como un sistema en que lo que hace uno provoca una respuesta en el otro. Estas son algunas de las situaciones que más se trabajan en terapia de pareja.
      </p>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
        {temas.map(t => (
          <li class="flex gap-4">
            <span aria-hidden="true" class="mt-2 h-2 w-2 shrink-0 rounded-full bg-gold"></span>
            <div>
              <h3 class="card-title text-xl mb-2">{t.t}</h3>
              <p class="body-sm text-[#55524b] font-normal">{t.d}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-warm border-y border-dust py-16 md:py-24">
    <div class="container-site">
      <p class="label mb-3">Cómo trabajo</p>
      <h2 class="section-title mb-10 md:mb-14 max-w-2xl">Un proceso con dirección, no solo un lugar para discutir</h2>
      <ol class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {pasos.map(p => (
          <li class="bg-white border border-dust rounded-[6px] p-7">
            <p class="font-heading text-3xl text-gold mb-4">{p.n}</p>
            <p class="card-title text-xl mb-3">{p.t}</p>
            <p class="body-sm text-[#55524b] font-normal">{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-sand py-16 md:py-24">
    <div class="container-site grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16">
      <div>
        <p class="label mb-3">Primera sesión</p>
        <h2 class="section-title mb-6">Cómo empezamos</h2>
        <p class="body-text text-[#4a4842] font-normal mb-4">
          Sesiones de 50 minutos, presenciales en {DIRECCION.calle}, {DIRECCION.detalle}, {DIRECCION.comuna}, u online.
          En la primera sesión los escucho a los dos y definimos juntos cómo seguir. Sin presión ni compromisos.
        </p>
        {precioDesde && (
          <p class="body-text text-ink font-medium mb-2">
            {new Set(precios).size > 1
              ? `Valor: desde ${clp(precioDesde)} por sesión (según modalidad).`
              : `Valor: ${clp(precioDesde)} por sesión.`}
          </p>
        )}
        <p class="body-sm text-[#55524b] font-normal">Por cada sesión recibes boleta de honorarios para pedir reembolso en tu Isapre o seguro complementario, según tu plan.</p>
      </div>
      <div class="flex flex-col justify-center gap-4 md:items-start">
        <a href="/agenda?grupo=pareja" class="btn-dark justify-center" data-cta="pareja_landing_agenda">Ver horarios para pareja</a>
        <a href="https://wa.me/56972735696?text=Hola%20Valentina%2C%20quiero%20consultar%20por%20terapia%20de%20pareja." target="_blank" rel="noopener" class="btn-outline justify-center" data-cta="pareja_landing_whatsapp">Escribir por WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="bg-warm border-t border-dust py-16 md:py-24">
    <div class="container-site max-w-3xl">
      <p class="label mb-3">Preguntas frecuentes</p>
      <h2 class="section-title mb-8">Lo que suelen preguntarme</h2>
      <div class="divide-y divide-dust border-y border-dust">
        {faq.map(f => (
          <details class="group py-5">
            <summary class="cursor-pointer list-none flex justify-between gap-4 font-body text-base text-ink font-medium">
              {f.q}<span aria-hidden="true" class="text-forest transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="body-sm text-[#55524b] font-normal mt-3">{f.a}</p>
          </details>
        ))}
      </div>
      <div class="mt-12">
        <h2 class="card-title text-xl mb-4">Para leer antes de la primera sesión</h2>
        <ul class="space-y-3">
          {lecturas.map(l => (
            <li class="flex gap-3 body-sm"><span aria-hidden="true" class="text-forest">•</span><a href={l.href} class="text-forest underline underline-offset-4 hover:text-ink">{l.t}</a></li>
          ))}
        </ul>
      </div>
      <p class="body-sm mt-8">Este espacio no atiende urgencias. Si estás en crisis, llama al *4141 (gratis, 24/7) o acude al servicio de urgencia más cercano.</p>
    </div>
  </section>
</BaseLayout>
