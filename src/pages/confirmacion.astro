---
/**
 * /confirmacion
 *
 * Flow vuelve a /api/flow/return, que guarda el token en la cookie vo_pago
 * y redirige aquí sin nada en la URL (8 oct 2026: con ?token= en la URL, GTM
 * —GA4, Google Ads, Meta— recibía un enlace que mostraba los datos de la
 * paciente). Un ?token= antiguo se acepta igual, pero se pasa a la cookie y se
 * redirige a la URL limpia antes de mostrar nada.
 * Esta página consulta el estado real a la API de Flow y muestra el resultado.
 */
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { supabase } from '../lib/supabase';
import { getPaymentStatus } from '../lib/flow';
import { todayCL } from '../lib/dateUtils';
import { createHash } from 'node:crypto';

// Los antiguos ?manual=1 / ?transferencia=1 (pago en consulta / transferencia
// desde la agenda) ya no existen: esta página solo muestra pagos de Flow.
const COOKIE_PAGO  = 'vo_pago'; // la misma que escribe src/pages/api/flow/return.ts
const tokenUrl     = Astro.url.searchParams.get('token') ?? '';
if (tokenUrl) {
  Astro.cookies.set(COOKIE_PAGO, tokenUrl, {
    path: '/confirmacion', httpOnly: true, secure: import.meta.env.PROD, sameSite: 'lax', maxAge: 60 * 60,
  });
  return Astro.redirect('/confirmacion', 302);
}
const token        = Astro.cookies.get(COOKIE_PAGO)?.value ?? '';
// Depende de una cookie: que ningún caché la guarde ni la muestre a otra persona.
Astro.response.headers.set('Cache-Control', 'private, no-store');

const MONTHS_ES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];

function formatDateEs(iso: string) {
  const [y, m, d] = iso.split('-');
  return `${parseInt(d)} de ${MONTHS_ES[parseInt(m) - 1]} de ${y}`;
}

const formatCLP = (n: number) =>
  new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);

const SESSION_LABELS: Record<string, string> = {
  'online':            'Sesión Individual Online',
  'presencial':        'Sesión Individual Presencial',
  'pareja-online':     'Sesión de Pareja Online',
  'pareja-presencial': 'Sesión de Pareja Presencial',
};

// ── Determinar estado del pago ────────────────────────────────────────────────
type PageState = 'paid' | 'rejected' | 'pending' | 'error';
let pageState: PageState = 'error';
let booking: Record<string, string | number> | null = null;
let allBookings: Record<string, string | number>[] = [];
let paymentMedia: string | null = null;

if (!token) {
  pageState = 'error';
} else {
  try {
    // Leer entorno desde settings
    const { data: settingsRows } = await supabase.from('settings').select('key, value');
    const cfg: Record<string, string> = {};
    (settingsRows ?? []).forEach(({ key, value }: { key: string; value: string }) => { cfg[key] = value; });
    const flowBaseUrl = cfg['flow_env'] === 'production'
      ? 'https://www.flow.cl/api'
      : cfg['flow_env'] === 'sandbox'
      ? 'https://sandbox.flow.cl/api'
      : undefined;

    const flowStatus = await getPaymentStatus(token, flowBaseUrl);

    // Mapear estado de Flow
    if      (flowStatus.status === 2) pageState = 'paid';
    else if (flowStatus.status === 3 || flowStatus.status === 4) pageState = 'rejected';
    else                               pageState = 'pending';

    paymentMedia = flowStatus.paymentData?.media ?? null;

    // Buscar la(s) reserva(s) cubiertas por este token. Normalmente es una sola
    // (el flujo de siempre), pero un pago de deuda combinada (/pagar/[id]) puede
    // cubrir varias a la vez — todas comparten el mismo mp_preference_id.
    const { data: rows } = await supabase
      .from('bookings')
      .select('id, service_id, mp_payment_id, session_type, session_date, session_time, patient_name, amount, status, created_by_admin')
      .eq('mp_preference_id', token);

    allBookings = rows ?? [];
    booking = (allBookings[0] as typeof booking) ?? null;

    // Esta página SOLO muestra el resultado; no escribe en la base. Antes
    // marcaba la reserva como 'confirmed' por su cuenta, y cuando llegaba el
    // aviso de pago de Flow (webhook) ya no la veía como reserva nueva y se
    // saltaba el correo de confirmación, el aviso a Valentina y el evento de
    // Google Calendar. Todo eso lo hace /api/flow/confirm, que Flow reintenta
    // hasta recibir respuesta.

  } catch (err) {
    console.error('[confirmacion] Error consultando Flow:', err);
    pageState = 'pending'; // Si hay error al consultar, mostrar como pendiente
  }
}

// ── Datos para la conversión "purchase" (GA4 / Google Ads vía GTM) ─────────────
// Solo para una COMPRA real online (pago Flow acreditado). No aplica a pago en
// consulta / transferencia (no hay cargo online que atribuir).
interface PurchaseData {
  transaction_id: string;
  value:          number;
  currency:       string;
  coupon:         string;
  items:          Array<{ item_id: string; item_name: string; item_category: string; price: number; quantity: number; discount: number }>;
}
let purchase: PurchaseData | null = null;

// El pago se hizo, pero la reserva había vencido (pagó tarde) o se anuló: el
// aviso de Flow la confirma solo si la hora sigue disponible. No se le dice
// "¡Reserva confirmada!" hasta que eso pase (re-auditoría 4 oct 2026).
const porRevisar = pageState === 'paid' && allBookings.some(b => b.status === 'expired' || b.status === 'cancelled');
// Pago de sesiones pasadas o de un cobro manual (no hay una sesión que esperar).
const hoyCL = todayCL();
const esCobro = allBookings.length > 1 || allBookings.some(b => String(b.session_date) === '2099-12-31' || String(b.session_date) < hoyCL);

// Solo cuenta como conversión (Google Ads / Meta / GA4) una reserva nueva hecha
// en la web: un cobro que Valentina generó o el pago de sesiones pasadas no es
// un paciente nuevo que trajo el sitio (auditoría 8 oct 2026).
const esReservaWeb = allBookings.some(b => !b.created_by_admin && String(b.session_date) !== '2099-12-31' && String(b.session_date) >= hoyCL);
if (pageState === 'paid' && allBookings.length && esReservaWeb) {
  const items = [];
  for (const b of allBookings) {
    const sessionType = String(b.session_type ?? '');
    let itemName = SESSION_LABELS[sessionType] ?? sessionType;
    if (b.service_id) {
      const { data: svc } = await supabase
        .from('services_catalog').select('name').eq('id', b.service_id as string).maybeSingle();
      if (svc?.name) itemName = svc.name as string;
    }
    items.push({
      item_id:       String(b.service_id ?? sessionType ?? 'sesion'),
      item_name:     itemName,
      item_category: sessionType.includes('online') ? 'online' : 'presencial',
      price:         Number(b.amount) || 0,
      quantity:      1,
      discount:      0, // sin descuentos por ahora
    });
  }
  purchase = {
    // Huella del token (no el token): estable para no duplicar la compra al
    // recargar, pero no sirve para abrir esta página desde los datos de
    // Google/Meta (auditoría de privacidad 8 oct 2026).
    transaction_id: createHash('sha256').update(String(token)).digest('hex').slice(0, 32),
    value:          items.reduce((s, i) => s + i.price, 0),
    currency: 'CLP',
    coupon:   '', // no hay sistema de cupones aún → sin descuento
    items,
  };
}

// Solo el primer nombre de la paciente (8 oct 2026): en esta página cargan
// GTM / GA4 / Google Ads / Meta; no hace falta mostrar su nombre completo.
const primerNombre = String(booking?.patient_name ?? '').trim().split(/\s+/)[0];

const titles: Record<PageState, string> = {
  paid:     porRevisar || esCobro ? 'Pago recibido' : '¡Reserva confirmada!',
  rejected: 'Pago no procesado',
  pending:  'Pago en proceso',
  error:    'Error inesperado',
};
---

<BaseLayout title={titles[pageState]} noindex>
  <section class="py-section bg-sand min-h-[80vh] flex items-center">
    <div class="container-site max-w-lg mx-auto">

      <!-- ── PAGADO ─────────────────────────────────────────────────────────── -->
      {pageState === 'paid' && (
        <div class="flex flex-col items-center text-center gap-8">

          <div class="icon-circle w-20 h-20 rounded-full">
            <Icon name="shield" size={36} />
          </div>

          <div>
            <h1 class="font-heading font-semibold text-3xl md:text-4xl text-ink mb-2">
              {porRevisar || esCobro ? '¡Pago recibido!' : '¡Reserva confirmada!'}
            </h1>
            <p class="font-body text-stone font-light text-base">
              {porRevisar
                ? 'Estoy confirmando que tu hora siga disponible y te llegará un correo de confirmación. Si esa hora ya no estaba disponible, te escribo para reagendar o devolverte el dinero.'
                : esCobro
                ? 'Gracias, tu pago quedó registrado.'
                : 'Recibirás un recordatorio antes de tu sesión.'}
            </p>
          </div>

          {allBookings.length > 1 ? (
            <div class="w-full bg-white border border-dust p-6 md:p-8 text-left space-y-3">
              {allBookings.map((b) => (
                <div class="flex justify-between items-baseline gap-4">
                  <span class="font-body text-sm text-stone">
                    {SESSION_LABELS[b.session_type as string] ?? b.session_type}
                    {b.session_date !== '2099-12-31' && ` · ${formatDateEs(b.session_date as string)}`}
                  </span>
                  <span class="font-body text-sm text-ink font-medium text-right whitespace-nowrap">{formatCLP(b.amount as number)}</span>
                </div>
              ))}
              <div class="border-t border-dust pt-3 flex justify-between items-baseline">
                <span class="label text-stone">Total pagado</span>
                <span class="font-heading font-semibold text-xl text-forest">
                  {formatCLP(allBookings.reduce((s, b) => s + (Number(b.amount) || 0), 0))}
                </span>
              </div>
              {paymentMedia && (
                <p class="label text-stone/60 text-right">Vía {paymentMedia}</p>
              )}
            </div>
          ) : booking && (
            <div class="w-full bg-white border border-dust p-6 md:p-8 text-left space-y-3">
              {([
                ['Paciente',  primerNombre],
                ['Sesión',    SESSION_LABELS[booking.session_type as string] ?? booking.session_type],
                ...(String(booking.session_date) === '2099-12-31' ? [] : [
                  ['Fecha',   formatDateEs(booking.session_date as string)],
                  ['Hora',    (booking.session_time as string).slice(0, 5)],
                ]),
              ]).map(([label, value]) => (
                <div class="flex justify-between items-baseline gap-4">
                  <span class="label text-stone">{label}</span>
                  <span class="font-body text-sm text-ink font-medium text-right">{value}</span>
                </div>
              ))}
              <div class="border-t border-dust pt-3 flex justify-between items-baseline">
                <span class="label text-stone">Total pagado</span>
                <span class="font-heading font-semibold text-xl text-forest">
                  {formatCLP(booking.amount as number)}
                </span>
              </div>
              {paymentMedia && (
                <p class="label text-stone/60 text-right">Vía {paymentMedia}</p>
              )}
            </div>
          )}

          <p class="font-body text-sm text-stone font-light">
            ¿Necesitas reprogramar? Escríbeme con al menos 24 horas de anticipación.
          </p>

          <a
            href="https://wa.me/56972735696"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline text-[10px] py-3 px-6"
          >
            Contactar por WhatsApp
          </a>
        </div>
      )}

      <!-- ── RECHAZADO / ANULADO ────────────────────────────────────────────── -->
      {pageState === 'rejected' && (
        <div class="flex flex-col items-center text-center gap-8">

          <div class="w-20 h-20 rounded-full border border-dust flex items-center justify-center text-stone">
            <Icon name="clock" size={32} />
          </div>

          <div>
            <h1 class="font-heading font-semibold text-3xl text-ink mb-2">
              El pago no fue procesado
            </h1>
            <p class="font-body text-stone font-light text-base">
              No se realizó ningún cargo. Tu horario quedó disponible.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 w-full">
            <a href="/agenda" class="btn-dark text-[10px] py-3.5 px-6 text-center flex-1">
              Intentar nuevamente
            </a>
            <a
              href="https://wa.me/56972735696"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-outline text-[10px] py-3.5 px-6 text-center flex-1"
            >
              Coordinar por WhatsApp
            </a>
          </div>
        </div>
      )}

      <!-- ── PENDIENTE ──────────────────────────────────────────────────────── -->
      {pageState === 'pending' && (
        <div class="flex flex-col items-center text-center gap-8">

          <div class="w-20 h-20 rounded-full border border-dust flex items-center justify-center text-stone">
            <Icon name="calendar" size={32} />
          </div>

          <div>
            <h1 class="font-heading font-semibold text-3xl text-ink mb-2">
              Pago en proceso
            </h1>
            <p class="font-body text-stone font-light text-base max-w-sm mx-auto">
              Tu pago está siendo verificado. Te confirmaremos por correo
              en cuanto se acredite. Puede tardar unos minutos.
            </p>
          </div>

          <a
            href="https://wa.me/56972735696"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline text-[10px] py-3 px-6"
          >
            Consultar por WhatsApp
          </a>
        </div>
      )}

      <!-- ── ERROR ──────────────────────────────────────────────────────────── -->
      {pageState === 'error' && (
        <div class="flex flex-col items-center text-center gap-8">

          <div class="w-20 h-20 rounded-full border border-dust flex items-center justify-center text-stone">
            <Icon name="chat" size={32} />
          </div>

          <div>
            <h1 class="font-heading font-semibold text-3xl text-ink mb-2">
              Algo salió mal
            </h1>
            <p class="font-body text-stone font-light text-base max-w-sm mx-auto">
              No pudimos verificar el estado de tu pago.
              Por favor contáctanos directamente.
            </p>
          </div>

          <a
            href="https://wa.me/56972735696"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-dark text-[10px] py-3 px-6"
          >
            Contactar por WhatsApp
          </a>
        </div>
      )}

    </div>
  </section>

  {purchase && (
    <script is:inline define:vars={{ purchase }}>
      // Conversión de compra para GTM (GA4 / Google Ads). Se dispara al cargar la
      // página de confirmación — el usuario ya aterrizó aquí, la atribución no se
      // interrumpe. La deduplicación por transaction_id evita contar doble si se
      // recarga la página (configúralo así en la etiqueta de conversión de GTM).
      window.dataLayer = window.dataLayer || [];
      try {
        var _key = 'vo_purchase_' + purchase.transaction_id;
        if (!sessionStorage.getItem(_key)) {
          window.dataLayer.push({ ecommerce: null }); // limpiar objeto previo
          window.dataLayer.push({
            event: 'purchase',
            ecommerce: {
              transaction_id: purchase.transaction_id,
              value:          purchase.value,
              currency:       purchase.currency,
              coupon:         purchase.coupon,
              items:          purchase.items,
            },
          });
          sessionStorage.setItem(_key, '1');
        }
      } catch (e) {
        // Si sessionStorage no está disponible, empujar igual (mejor medir que perder la conversión)
        window.dataLayer.push({ ecommerce: null });
        window.dataLayer.push({ event: 'purchase', ecommerce: {
          transaction_id: purchase.transaction_id, value: purchase.value,
          currency: purchase.currency, coupon: purchase.coupon, items: purchase.items,
        }});
      }
    </script>
  )}
</BaseLayout>
