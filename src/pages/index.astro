---
export const prerender = false;
import BaseLayout     from '../layouts/BaseLayout.astro';
import Hero           from '../components/sections/Hero.astro';
import TrustBar       from '../components/sections/TrustBar.astro';
import HomeServices   from '../components/sections/HomeServices.astro';
import About          from '../components/sections/About.astro';
import Testimonials   from '../components/sections/Testimonials.astro';
import InstagramFeed  from '../components/sections/InstagramFeed.astro';
import Contact        from '../components/sections/Contact.astro';
import Enfoque        from '../components/sections/Enfoque.astro';
---

<BaseLayout
  title="Psicóloga en Las Condes y Online"
  description="Psicóloga para adultos y parejas, online a todo Chile o presencial en Las Condes. Terapia con enfoque sistémico. Boleta para reembolso en Isapre."
>
  <Hero />
  <TrustBar />
  <HomeServices />
  <Enfoque />
  <About />
  <Testimonials />
  <InstagramFeed />
  <Contact />
</BaseLayout>
