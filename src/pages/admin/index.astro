---
export const prerender = false;
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabase } from '../../lib/supabase';
import { SESSION_LABELS } from '../../data/services';
import { nowCL, todayCL, hoursUntilSessionCL } from '../../lib/dateUtils';
import { origenTexto } from '../../lib/origen';

// Reservas del día de hoy
const today = todayCL();

const { data: todayBookings } = await supabase
  .from('bookings')
  .select('*')
  .eq('session_date', today)
  .neq('status', 'cancelled')
  .order('session_time');

// Próximas reservas confirmadas (7 días)
const weekEnd = nowCL();
weekEnd.setDate(weekEnd.getDate() + 7);
const weekEndStr = weekEnd.toISOString().slice(0, 10);

// Se pide de a poco más de 10 y se filtra después: una sesión de hoy que ya
// terminó cumple session_date >= today (la columna solo tiene la fecha, no la
// hora) y aparecía igual en "Próximas" aunque ya haya pasado — filtrar por
// hora real evita eso sin dejar de mostrar 10 sesiones futuras cuando existen.
const { data: upcomingRaw } = await supabase
  .from('bookings')
  .select('*')
  .eq('status', 'confirmed')
  .gte('session_date', today)
  .lte('session_date', weekEndStr)
  .order('session_date')
  .order('session_time')
  .limit(40);

const upcoming = (upcomingRaw ?? [])
  .filter((b) => {
    const durationHrs = (b.duration_min ?? 55) / 60;
    return hoursUntilSessionCL(b.session_date, b.session_time) > -durationHrs;
  })
  .slice(0, 10);

// Reservas pendientes de pago
const { count: pendingCount } = await supabase
  .from('bookings')
  .select('*', { count: 'exact', head: true })
  .eq('status', 'pending_payment')
  .gte('session_date', today)
  .neq('session_date', '2099-12-31'); // cobros manuales sin sesión (no son reservas)

// Reservas confirmadas totales del mes
const monthStartD = nowCL();
const monthStart = new Date(monthStartD.getFullYear(), monthStartD.getMonth(), 1).toISOString().slice(0, 10);
const { count: monthCount } = await supabase
  .from('bookings')
  .select('*', { count: 'exact', head: true })
  .eq('status', 'confirmed')
  .gte('session_date', monthStart);

// Reservas por origen (últimos 90 días, por fecha en que se reservó): solo
// confirmadas. select('*') para no fallar si la migración 0008 aún no corre.
const hace90 = new Date(Date.now() - 90 * 24 * 60 * 60 * 1000).toISOString();
const { data: recientes } = await supabase
  .from('bookings')
  .select('*')
  .eq('status', 'confirmed')
  .gte('created_at', hace90)
  .neq('session_date', '2099-12-31');
const porCanal = new Map<string, { n: number; monto: number }>();
let sinOrigen = 0;
for (const b of recientes ?? []) {
  const canal = b.origen?.canal as string | undefined;
  if (!canal) { sinOrigen++; continue; }
  const acc = porCanal.get(canal) ?? { n: 0, monto: 0 };
  acc.n++; acc.monto += Number(b.amount) || 0;
  porCanal.set(canal, acc);
}
const origenes = [...porCanal.entries()].sort((a, b) => b[1].n - a[1].n);
const formatCLP = (n: number) => '$' + Math.round(n).toLocaleString('es-CL');

const formatTime = (t: string) => t.slice(0, 5);
const MONTHS_ES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
const formatDate = (iso: string) => {
  const [y, m, d] = iso.split('-');
  return `${parseInt(d)} ${MONTHS_ES[parseInt(m)-1]}`;
};
---

<AdminLayout title="Dashboard" current="/admin">

  <!-- Métricas -->
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:2rem;">
    <div class="stat-card" style="text-align:center;">
      <p class="stat-label">Sesiones hoy</p>
      <p class="stat-value">{todayBookings?.length ?? 0}</p>
      <p class="stat-sub">{formatDate(today)}</p>
    </div>
    <div class="stat-card" style="text-align:center;">
      <p class="stat-label">Este mes</p>
      <p class="stat-value">{monthCount ?? 0}</p>
      <p class="stat-sub">confirmadas</p>
    </div>
    <div class="stat-card" style="text-align:center;">
      <p class="stat-label">Pago pendiente</p>
      <p class="stat-value" style={(pendingCount ?? 0) > 0 ? 'color:var(--gold)' : ''}>{pendingCount ?? 0}</p>
      <p class="stat-sub">reservas</p>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;">

    <!-- Sesiones de hoy -->
    <div class="card">
      <div class="section-header">
        <p class="label">Hoy — {formatDate(today)}</p>
        <a href="/admin/agenda" class="btn btn-outline btn-sm">Ver agenda</a>
      </div>
      {!todayBookings?.length ? (
        <p style="font-size:0.875rem;color:var(--stone);padding:1rem 0;">Sin sesiones para hoy.</p>
      ) : (
        <div style="display:flex;flex-direction:column;gap:0.5rem;">
          {todayBookings.map((b) => (
            <div style="display:flex;align-items:center;justify-content:space-between;padding:0.75rem;background:var(--sand);border-radius:var(--radius);">
              <div>
                <p style="font-size:0.9rem;font-weight:500;">{b.patient_name}</p>
                <p style="font-size:0.78rem;color:var(--stone);margin-top:0.15rem;">
                  {SESSION_LABELS[b.session_type as keyof typeof SESSION_LABELS] ?? b.session_type}
                </p>
                {origenTexto(b.origen) && <p style="font-size:0.72rem;color:var(--stone);margin-top:0.1rem;">Origen: {origenTexto(b.origen)}</p>}
              </div>
              <div style="text-align:right;">
                <p style="font-family:'Cormorant Garamond',serif;font-size:1.2rem;font-weight:400;">{formatTime(b.session_time)}</p>
                <span class={`badge badge-${b.status === 'confirmed' ? 'confirmed' : 'pending'}`} style="margin-top:0.25rem;">
                  {b.status === 'confirmed' ? 'Confirmada' : 'Por pagar'}
                </span>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Próximas sesiones -->
    <div class="card">
      <div class="section-header">
        <p class="label">Próximos 7 días</p>
        <a href="/admin/agenda" class="btn btn-dark btn-sm">+ Nueva reserva</a>
      </div>
      {!upcoming?.length ? (
        <p style="font-size:0.875rem;color:var(--stone);padding:1rem 0;">Sin sesiones próximas confirmadas.</p>
      ) : (
        <table>
          <thead>
            <tr>
              <th>Paciente</th>
              <th>Fecha</th>
              <th>Hora</th>
              <th>Tipo</th>
            </tr>
          </thead>
          <tbody>
            {upcoming.map((b) => (
              <tr>
                <td style="font-weight:500;">
                  {b.patient_name}
                  {b.origen?.canal && <span style="display:block;font-size:0.72rem;font-weight:400;color:var(--stone);">{b.origen.canal}</span>}
                </td>
                <td>{formatDate(b.session_date)}</td>
                <td style="font-family:'Cormorant Garamond',serif;font-size:1.1rem;">{formatTime(b.session_time)}</td>
                <td style="color:var(--stone);">
                  {b.session_type === 'online' ? 'Ind. Online' :
                   b.session_type === 'presencial' ? 'Ind. Presencial' :
                   b.session_type === 'pareja-online' ? 'Pareja Online' : 'Pareja Presencial'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>

  </div>

  <!-- Reservas por origen -->
  <div class="card" style="margin-top:1.5rem;">
    <div class="section-header">
      <p class="label">Reservas por origen (últimos 90 días)</p>
    </div>
    {!origenes.length ? (
      <p style="font-size:0.875rem;color:var(--stone);padding:1rem 0;">Aún no hay reservas confirmadas con origen registrado.</p>
    ) : (
      <table>
        <thead>
          <tr>
            <th>Origen</th>
            <th>Reservas</th>
            <th>Monto</th>
          </tr>
        </thead>
        <tbody>
          {origenes.map(([canal, v]) => (
            <tr>
              <td style="font-weight:500;">{canal}</td>
              <td>{v.n}</td>
              <td>{formatCLP(v.monto)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
    {sinOrigen > 0 && (
      <p style="font-size:0.78rem;color:var(--stone);margin-top:0.75rem;">
        {sinOrigen} {sinOrigen === 1 ? 'reserva confirmada' : 'reservas confirmadas'} sin origen registrado (creadas en el panel o antes de activar esto).
      </p>
    )}
  </div>

</AdminLayout>
