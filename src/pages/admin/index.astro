---
export const prerender = false;
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabase } from '../../lib/supabase';
import { todayCL, nowCL, hoursUntilSessionCL } from '../../lib/dateUtils';
import { cargarAvisosPanel } from '../../lib/avisosPanel';
import { sesionesPorCobrar, sesionesQueTeDeben } from '../../lib/porCobrar';
import { getValidAccessToken } from '../../lib/syncCalendar';
import { pacienteDeTitulo } from '../../lib/boxCala';
import { mismaPersona as mismaPersonaNombre } from '../../lib/mismaPersona';
import { URL_SII } from '../../lib/impuestos';
import { ETIQUETA_PAGO_EN_CONSULTA, esPagoEnConsulta } from '../../lib/pagoEnConsulta';
import { textoPagoPorDevolver } from '../../lib/pagosPorDevolver';

// Inicio del panel (rediseño aprobado por Valentina, 14 oct 2026): TODO lleva
// directo a donde está la acción. Arriba el día que se mira (‹ › para moverse,
// /admin?dia=YYYY-MM-DD), la próxima sesión, la lista "Para hacer" ordenada por
// plazo, las sesiones del día, los números de la semana y los próximos 7 días.
// La lista "Para hacer" usa los mismos avisos del layout (src/lib/avisosPanel.ts):
// se cargan una vez aquí y se le pasan al layout, que en esta página no repite
// esas franjas.

const META_SEMANA = 28; // meta 28–29 sesiones por semana

// ── Día que se mira ──────────────────────────────────────────────────────────
const hoy = todayCL();
const diaParam = Astro.url.searchParams.get('dia') ?? '';
const fechaValida = (iso: string) => {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(iso)) return false;
  const x = new Date(iso + 'T12:00:00Z');
  return !Number.isNaN(x.getTime()) && x.toISOString().slice(0, 10) === iso;
};
const dia = fechaValida(diaParam) ? diaParam : hoy;
const esHoy = dia === hoy;
const sumarDias = (iso: string, n: number) => { const x = new Date(iso + 'T12:00:00Z'); if (Number.isNaN(x.getTime())) return iso; x.setUTCDate(x.getUTCDate() + n); return x.toISOString().slice(0, 10); };
const diaSemana = (iso: string) => new Date(iso + 'T12:00:00Z').getUTCDay();
const lunes = sumarDias(dia, diaSemana(dia) === 0 ? -6 : 1 - diaSemana(dia));
const domingo = sumarDias(lunes, 6);
const fin7 = sumarDias(dia, 7);
const hasta = domingo > fin7 ? domingo : fin7;

// ── Sesiones de Google Calendar (Encuadrado) ─────────────────────────────────
// Las sesiones agendadas en Encuadrado solo están en Google Calendar (no en la
// tabla de reservas). Se suman a las del día y de la semana para que el conteo
// sea el real; una sesión con evento de la página y de Encuadrado (intencional)
// se cuenta una vez por horario. null = no se pudo leer.
type EventoGoogle = { fecha: string; hora: string; dur: number; titulo: string };
async function sesionesGoogle(desde: string, hastaIso: string): Promise<EventoGoogle[] | null> {
  const auth = await getValidAccessToken();
  if (!auth) return null;
  const tMin = new Date(Date.parse(desde + 'T00:00:00Z') - 86400000).toISOString();
  const tMax = new Date(Date.parse(hastaIso + 'T00:00:00Z') + 2 * 86400000).toISOString();
  const url = `https://www.googleapis.com/calendar/v3/calendars/${encodeURIComponent(auth.calendarId)}/events`
    + `?timeMin=${tMin}&timeMax=${tMax}&singleEvents=true&orderBy=startTime&maxResults=250&timeZone=America%2FSantiago`;
  const res = await fetch(url, { headers: { Authorization: `Bearer ${auth.token}` }, signal: AbortSignal.timeout(5000) });
  if (!res.ok) return null;
  const data = await res.json();
  const out: EventoGoogle[] = [];
  for (const ev of (data.items ?? []) as Array<{ summary?: string; status?: string; start?: { dateTime?: string }; end?: { dateTime?: string } }>) {
    const inicio = ev.start?.dateTime;
    const titulo = ev.summary ?? '';
    // Solo sesiones (página: "… Sesión Individual …"; Encuadrado: "Nombre Sesión individual …").
    if (!inicio || ev.status === 'cancelled' || !/sesi[oó]n/i.test(titulo)) continue;
    // Con timeZone=America/Santiago, dateTime viene en hora de Chile.
    const fecha = inicio.slice(0, 10);
    if (fecha < desde || fecha > hastaIso) continue;
    const dur = ev.end?.dateTime ? Math.max(20, Math.round((Date.parse(ev.end.dateTime) - Date.parse(inicio)) / 60000)) : 50;
    out.push({ fecha, hora: inicio.slice(11, 16), dur, titulo });
  }
  return out;
}

// "Te deben": misma regla y agrupación por paciente que /admin/deudas (sesiones
// sin pagar que ya empezaron, ver src/lib/porCobrar.ts).
async function teDeben(): Promise<{ personas: number; total: number }> {
  const claves = new Set<string>();
  let total = 0;
  for (const b of await sesionesQueTeDeben()) {
    claves.add(String(b.patient_email ?? '').toLowerCase() || `${b.patient_name}|${b.patient_phone ?? ''}`);
    total += Number(b.amount) || 0;
  }
  return { personas: claves.size, total };
}

type Reserva = {
  id: string; patient_name: string; session_type: string; session_date: string; session_time: string;
  status: string; amount: number | null; duration_min: number | null; paid_at: string | null; debt_voided: boolean | null;
  patient_email?: string | null;
};

const hace90 = new Date(Date.now() - 90 * 24 * 60 * 60 * 1000).toISOString();
const [avisos, reservasRes, google, porCobrar, deben, recientesRes] = await Promise.all([
  cargarAvisosPanel(Astro.url.origin),
  // Sesiones desde el lunes de la semana del día mirado hasta 7 días después
  // (o el domingo, lo que llegue más lejos). Sin canceladas NI vencidas.
  supabase.from('bookings')
    .select('id, patient_name, patient_email, session_type, session_date, session_time, status, amount, duration_min, paid_at, debt_voided, notes, payment_method')
    .gte('session_date', lunes).lte('session_date', hasta)
    .not('status', 'in', '(cancelled,expired)')
    .order('session_date').order('session_time'),
  sesionesGoogle(lunes, hasta).catch(() => null),
  sesionesPorCobrar().catch(() => null),
  teDeben().catch(() => null),
  // Reservas por origen (últimos 90 días, por fecha en que se reservó): solo
  // confirmadas. select('*') para no fallar si la migración 0008 aún no corre.
  supabase.from('bookings').select('*').eq('status', 'confirmed').gte('created_at', hace90).neq('session_date', '2099-12-31'),
]);
const errorReservas = !!reservasRes.error;
const reservas = (reservasRes.data ?? []) as Reserva[];

// ── Sesiones (página + Google/Encuadrado) ───────────────────────────────────
type Sesion = {
  id: string | null; fecha: string; hora: string; dur: number; paciente: string;
  online: boolean; tipo: string; pago: 'pagada' | 'por-pagar' | 'en-consulta' | 'anulada' | 'sin-cobro' | 'externa'; href: string;
  email?: string | null;
  fichaId?: string | null; // ficha del paciente (para "Preparar" en las sesiones del día)
};
const TIPOS: Record<string, string> = {
  'online': 'Individual online', 'presencial': 'Individual presencial',
  'pareja-online': 'Pareja online', 'pareja-presencial': 'Pareja presencial',
};
const sesiones: Sesion[] = reservas.filter((b) => b.session_date !== '2099-12-31' && b.session_time).map((b) => ({
  id: b.id,
  fecha: b.session_date,
  hora: String(b.session_time).slice(0, 5),
  dur: b.duration_min ?? 50,
  paciente: b.patient_name,
  online: String(b.session_type ?? '').includes('online'),
  tipo: TIPOS[b.session_type] ?? b.session_type,
  // El pago se lee de paid_at (no del estado de la reserva): igual que el calendario.
  // Sin costo (obra social): queda con paid_at pero $0; antes salía "pagada" (auditoría 19 oct 2026).
  pago: b.paid_at ? (Number(b.amount) > 0 ? 'pagada' : 'sin-cobro') : b.debt_voided ? 'anulada' : (Number(b.amount) > 0 ? (esPagoEnConsulta(b) ? 'en-consulta' : 'por-pagar') : 'sin-cobro'),
  href: `/admin/agenda?booking=${b.id}`,
  email: b.patient_email ?? null,
}));
{
  // Una misma sesión puede estar dos veces: evento de la página y de Encuadrado
  // (intencional), a veces a HORAS DISTINTAS (ej. Encuadrado 9:00 y página
  // 10:00). Se reconoce por paciente + día, no por horario (14 oct 2026: antes
  // se contaba dos veces y la semana mostraba 10 en vez de las reales).
  const normal = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-zñ ]/g, ' ').split(/\s+/).filter((w) => w.length > 1);
  const mismaPersona = (a: string, b: string) => {
    const x = normal(a), y = normal(b);
    if (!x.length || !y.length || x[0] !== y[0]) return false; // mismo primer nombre
    const restoX = x.slice(1), restoY = y.slice(1);
    return !restoX.length || !restoY.length || restoX.some((w) => restoY.includes(w));
  };
  for (const g of google ?? []) {
    const paciente = pacienteDeTitulo(g.titulo.replace(/^\s*(Por pagar|Pagada)\s*·\s*/i, ''));
    if (sesiones.some((s) => s.fecha === g.fecha && mismaPersona(s.paciente, paciente))) continue; // ya está ese día (otro evento o reserva de la página)
    const online = /online/i.test(g.titulo);
    sesiones.push({
      id: null, fecha: g.fecha, hora: g.hora, dur: g.dur,
      paciente,
      online, tipo: `${online ? 'Online' : 'Presencial'} · Google Calendar`, pago: 'externa',
      href: `/admin/agenda?fecha=${g.fecha}&hora=${g.hora}`,
    });
  }
  sesiones.sort((a, b) => (a.fecha + a.hora).localeCompare(b.fecha + b.hora));
}
const delDia = sesiones.filter((s) => s.fecha === dia);
// "Preparar" (29 oct 2026): cada sesión del día lleva a "Para revisar hoy" de la ficha de su paciente
// (tareas y lo que quedó para trabajar, ya generados, y su última nota: sin costo). Ficha por correo (reservas del sitio) o, si no, por nombre (eventos de
// Google/Encuadrado), solo si hay UNA ficha que calce: ante la duda no se ofrece el botón.
if (delDia.length) {
  const { data: fichas } = await supabase.from('patients').select('id, name, email');
  // Por nombre (solo eventos de Google, sin correo): mismo primer nombre Y al menos un apellido en común;
  // un evento que diga solo "Luis" no abre la ficha de "Luis Medina" (auditoría 29 oct 2026).
  const palabras = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-zñ ]/g, ' ').split(/\s+/).filter((w) => w.length > 1);
  const conApellidoComun = (a: string, b: string) => {
    const x = palabras(a), y = palabras(b);
    return x.length > 1 && y.length > 1 && mismaPersonaNombre(a, b) && x.slice(1).some((w) => y.slice(1).includes(w));
  };
  for (const s of delDia) {
    const candidatas = s.email
      ? (fichas ?? []).filter((f) => String(f.email ?? '').toLowerCase() === s.email!.toLowerCase())
      : (fichas ?? []).filter((f) => f.name && conApellidoComun(String(f.name), s.paciente));
    s.fichaId = candidatas.length === 1 ? (candidatas[0].id as string) : null;
  }
}
const semana = sesiones.filter((s) => s.fecha >= lunes && s.fecha <= domingo);
const proximas = sesiones.filter((s) => s.fecha > dia && s.fecha <= fin7);
const proximasPorDia = [...proximas.reduce((m, s) => m.set(s.fecha, [...(m.get(s.fecha) ?? []), s]), new Map<string, Sesion[]>())];

// Próxima sesión: hoy, la que viene o la que está en curso (si no queda
// ninguna hoy, la siguiente de los próximos días); otro día, la primera.
let heroEnCurso = false;
let hero: Sesion | null = null;
if (esHoy) {
  for (const s of delDia) {
    const h = hoursUntilSessionCL(s.fecha, s.hora);
    if (h > 0) { hero = s; break; }
    if (h > -s.dur / 60) { hero = s; heroEnCurso = true; break; }
  }
  hero ??= proximas[0] ?? null;
} else {
  hero = delDia[0] ?? null;
}

// ── Formatos ────────────────────────────────────────────────────────────────
const DIAS = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
const DIAS_CORTOS = ['dom', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb'];
const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
const fechaLarga = (iso: string) => { const [, m, d] = iso.split('-').map(Number); return `${DIAS[diaSemana(iso)]} ${d} de ${MESES[m - 1]}`; };
const mayus = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const fechaCorta = (iso: string) => { const [, m, d] = iso.split('-').map(Number); return `${DIAS_CORTOS[diaSemana(iso)]} ${d}/${m}`; };
const clp = (n: number) => new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);
const manana = sumarDias(hoy, 1);
const ayer = sumarDias(hoy, -1);
const cuando = (fecha: string, hora?: string) => {
  const rel = fecha === hoy ? 'hoy' : fecha === manana ? 'mañana' : fecha === ayer ? 'ayer' : fechaCorta(fecha);
  return hora ? `${rel} ${hora}` : rel;
};
// Instante → "YYYY-MM-DDTHH:MM" en hora de Chile (para ordenar junto a fecha+hora).
const claveCL = (iso: string) => {
  if (Number.isNaN(Date.parse(iso))) return nowCL().toISOString().slice(0, 16); // fecha ilegible: cuenta como "ahora"
  const p = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Santiago', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date(iso));
  const v = (t: string) => p.find((x) => x.type === t)?.value ?? '00';
  return `${v('year')}-${v('month')}-${v('day')}T${v('hour')}:${v('minute')}`;
};
const ahoraClave = nowCL().toISOString().slice(0, 16);

// ── Para hacer (ordenado por plazo) ─────────────────────────────────────────
type Accion =
  | { tipo: 'wa'; url: string | null; id: string }
  | { tipo: 'form'; action: string; campos: Record<string, string>; texto: string }
  | { tipo: 'link'; url: string; texto: string }
  | { tipo: 'folio'; bookingId: string; sugerido: number | null };
type Tarea = {
  clave: string;         // plazo "YYYY-MM-DDTHH:MM" (hora de Chile) para ordenar; '9999' = sin plazo
  chip: string;
  titulo: string;
  detalle: string;
  href: string | null;
  externo?: boolean;
  accion?: Accion;
};
const vuelta = (() => { const u = new URL(Astro.url); u.searchParams.delete('error'); return u.pathname + u.search; })();
const tareas: Tarea[] = [];
const { cobros, box, comprobanteAlerts, boletaAlerts, consentAlerts, rebotes, tarifas, impuestos, pagosPorDevolver, transferenciasPorRevisar } = avisos;

// Pago por devolver o reagendar (19 oct 2026, ver src/lib/pagosPorDevolver.ts): queda hasta "Resuelto".
for (const p of pagosPorDevolver ?? []) {
  tareas.push({
    clave: ahoraClave,
    chip: 'pago por devolver',
    titulo: textoPagoPorDevolver(p),
    detalle: `${p.estado === 'expired' ? 'Pagó después de que venciera la reserva' : 'La sesión estaba pagada y se anuló'} · devuélvele el pago o pásala a otra hora`,
    href: p.href,
    accion: { tipo: 'form', action: '/api/admin/pago-resuelto', campos: { id: p.id, redirect: vuelta }, texto: 'Resuelto' },
  });
}
if (pagosPorDevolver === null) {
  tareas.push({ clave: ahoraClave, chip: 'revisar', titulo: 'No se pudieron revisar los pagos por devolver', detalle: 'Recarga en un rato.', href: null });
}

for (const c of cobros ?? []) {
  // Paga en consulta (19 oct 2026, ver src/lib/pagoEnConsulta.ts): sin plazo de 24 h, sin box ni link.
  if (c.enConsulta) {
    tareas.push({
      clave: `${c.fecha}T${c.hora}`,
      chip: `sesión ${cuando(c.fecha, c.hora)}`,
      titulo: `${ETIQUETA_PAGO_EN_CONSULTA}: ${c.paciente}`,
      detalle: `${c.presencial ? 'Presencial' : 'Online'} · ${clp(c.monto)} · cóbrale en la sesión y márcala pagada`,
      href: `/admin/agenda?booking=${c.id}`,
    });
    continue;
  }
  const plazo = sumarDias(c.fecha, -1); // el pago debe quedar 24 h antes
  const vencido = hoursUntilSessionCL(plazo, c.hora) <= 0;
  tareas.push({
    clave: `${plazo}T${c.hora}`,
    chip: vencido ? `sesión ${cuando(c.fecha, c.hora)}` : `pago vence ${cuando(plazo, c.hora)}`,
    titulo: `Cobrar a ${c.paciente}`,
    detalle: `${c.presencial ? 'Presencial' : 'Online'} · ${clp(c.monto)}${c.presencial ? ' · si no paga, mueve el box' : ''}${c.sinLink ? ' · sin link de pago: cóbrale por transferencia (o en la consulta si es presencial) y márcala pagada' : ''}`,
    href: `/admin/agenda?booking=${c.id}&accion=cobrar`,
    accion: { tipo: 'wa', url: c.waUrl, id: c.id },
  });
}
if (cobros === null) {
  tareas.push({ clave: ahoraClave, chip: 'revisar', titulo: 'No se pudieron revisar los pagos pendientes', detalle: 'Recarga en un rato o mira la lista de por cobrar.', href: '/admin/por-cobrar' });
}
for (const b of box.liberar) {
  tareas.push({
    clave: `${b.fecha}T${b.hora}`,
    chip: `liberar antes de ${cuando(b.fecha, b.hora)}`,
    titulo: `Liberar box de ${b.paciente}`,
    detalle: 'Espacio Cala · la sesión ya no está en tu calendario (se canceló o se movió)',
    href: `/admin/agenda?fecha=${b.fecha}&hora=${b.hora}`,
    accion: { tipo: 'form', action: '/api/admin/box-cala', campos: { slot: b.slot, paciente: b.paciente, accion: 'liberado', redirect: vuelta }, texto: 'Ya lo liberé' },
  });
}
for (const b of box.pendientes) {
  tareas.push({
    clave: `${b.fecha}T${b.hora}`,
    chip: `box vence ${cuando(b.fecha, b.hora)}`,
    titulo: `Comprar box para ${b.paciente}`,
    detalle: `Espacio Cala · ${fechaLarga(b.fecha)} a las ${b.hora}`,
    href: `/admin/agenda?fecha=${b.fecha}&hora=${b.hora}`,
    accion: { tipo: 'form', action: '/api/admin/box-cala', campos: { slot: b.slot, paciente: b.paciente, accion: 'reservado', redirect: vuelta }, texto: 'Ya compré el box' },
  });
}
if (box.error) {
  tareas.push({ clave: ahoraClave, chip: 'revisar', titulo: 'No se pudo revisar tu calendario para los boxes', detalle: 'Recarga en un rato; mientras, revisa tus horas presenciales en Google Calendar.', href: null });
}
// Transferencia confirmada sola al subir el comprobante (28 oct 2026): el paciente ya recibió todo;
// falta que Valentina vea el dinero en su banco. Si no llegó: en la sesión, "Anular pago".
for (const a of transferenciasPorRevisar ?? []) {
  tareas.push({
    clave: claveCL(a.subidoEl),
    chip: `transferencia ${cuando(claveCL(a.subidoEl).slice(0, 10), claveCL(a.subidoEl).slice(11, 16))}`,
    titulo: `Revisar en tu banco la transferencia de ${a.patientName}`,
    detalle: `${clp(a.total)} · ya le llegó la confirmación · toca para ver el comprobante; si no llegó, en la sesión usa «Anular pago»`,
    href: `/api/admin/comprobante?b=${a.bookingIds[0]}`, externo: true,
    accion: { tipo: 'form', action: '/api/admin/transferencia-revisada', campos: { ids: a.bookingIds.join(','), redirect: vuelta }, texto: 'Ya la revisé' },
  });
}
if (transferenciasPorRevisar === null) {
  tareas.push({ clave: ahoraClave, chip: 'revisar', titulo: 'No se pudieron revisar las transferencias recibidas', detalle: 'Recarga en un rato.', href: null });
}
for (const a of comprobanteAlerts) {
  tareas.push({
    clave: claveCL(a.subidoEl),
    chip: `subido ${cuando(claveCL(a.subidoEl).slice(0, 10), claveCL(a.subidoEl).slice(11, 16))}`,
    titulo: `Confirmar transferencia de ${a.patientName}`,
    detalle: `${clp(a.total)} · revisa tu banco y confirma el pago en la sesión`,
    href: `/admin/agenda?booking=${a.bookingIds[0]}`,
    accion: { tipo: 'link', url: `/api/admin/comprobante?b=${a.bookingIds[0]}`, texto: 'Ver comprobante' },
  });
}
for (const a of boletaAlerts) {
  tareas.push({
    clave: ahoraClave,
    chip: 'boleta con problemas',
    titulo: `Boleta de ${a.patientName}${a.sessionDate && a.sessionDate !== '2099-12-31' ? ` · sesión ${fechaCorta(a.sessionDate)}` : ''}`,
    detalle: a.message,
    href: a.href.startsWith('/admin/pacientes/') ? `${a.href}#s-${a.bookingId}` : a.href,
    accion: a.registrarFolio ? { tipo: 'folio', bookingId: a.bookingId, sugerido: a.registrarFolio.sugerido } : undefined,
  });
}
for (const r of rebotes) {
  tareas.push({
    clave: ahoraClave,
    chip: 'correo rebotado',
    titulo: `Correo que no llegó${r.paciente ? `: ${r.paciente.name}` : ''}`,
    detalle: `${r.correo}${r.asunto ? ` (“${r.asunto}”)` : ''} · ${r.paciente ? 'pídele su correo correcto y cámbialo en su ficha' : 'revisa ese correo con la persona'}`,
    href: r.paciente ? `/admin/pacientes/${r.paciente.id}?tab=info#email` : null,
    accion: { tipo: 'form', action: '/api/admin/rebotes', campos: { correo: r.correo, redirect: vuelta }, texto: 'Listo' },
  });
}
// Tarifas: van por nombre (la paciente puede no tener ficha); se busca la ficha
// con el mismo nombre (sin tildes ni mayúsculas) para llevar a sus sesiones.
const normalizar = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/\s+/g, ' ').trim();
const fichaPorNombre = new Map<string, string>();
if (tarifas.length) {
  const { data } = await supabase.from('patients').select('id, name');
  for (const p of data ?? []) if (p.name) fichaPorNombre.set(normalizar(String(p.name)), p.id);
}
for (const t of tarifas) {
  const ficha = fichaPorNombre.get(normalizar(t.nombre));
  const monto = `${t.anterior ? `${clp(t.anterior)} → ` : ''}${clp(t.nuevo)} desde el ${fechaLarga(t.desde)}`;
  const montoAntiguo = t.sesionesConMontoAntiguo > 0 ? ` · ⚠ ${t.sesionesConMontoAntiguo} ${t.sesionesConMontoAntiguo === 1 ? 'sesión agendada' : 'sesiones agendadas'} con el monto antiguo` : '';
  tareas.push({
    clave: t.fase === 'avisar' ? (t.atrasado ? ahoraClave : `${sumarDias(t.desde, -1)}T23:59`) : t.fase === 'vigente' ? ahoraClave : `${t.desde}T00:00`,
    chip: t.fase === 'avisar' ? (t.atrasado ? 'urgente: ya rige' : `avisar antes del ${cuando(t.desde)}`) : t.fase === 'proxima' ? `rige ${cuando(t.desde)}` : 'ya rige',
    titulo: t.fase === 'avisar' ? `Avisar cambio de tarifa a ${t.nombre}` : `Tarifa nueva de ${t.nombre}`,
    detalle: monto + montoAntiguo + (t.fase === 'vigente' ? ' · al agendarle usa el monto nuevo' : ''),
    href: ficha ? `/admin/pacientes/${ficha}?tab=sesiones` : '/admin/pacientes',
    accion: t.fase === 'proxima' ? undefined : { tipo: 'form', action: '/api/admin/cambios-tarifa', campos: { id: t.id, campo: t.fase === 'avisar' ? 'avisado' : 'aplicado', redirect: vuelta }, texto: t.fase === 'avisar' ? 'Ya le avisé' : 'Listo' },
  });
}
for (const i of impuestos) {
  tareas.push({
    clave: ahoraClave,
    chip: 'pendiente',
    titulo: `Pagar impuestos de ${i.nombre}`,
    detalle: 'En el SII (se abre en otra pestaña)',
    href: URL_SII, externo: true,
    accion: { tipo: 'form', action: '/api/admin/impuestos-ok', campos: { mes: i.mes, redirect: vuelta }, texto: 'Ya lo hice' },
  });
}
for (const a of consentAlerts) {
  tareas.push({
    clave: '9999',
    chip: a.sentAt ? 'enviado, sin firmar' : 'sin enviar',
    titulo: `Consentimiento de datos: ${a.name}`,
    detalle: 'Ley 21.719 · envíaselo desde su ficha',
    href: `/admin/pacientes/${a.patientId}#consentimiento`,
  });
}
tareas.sort((a, b) => a.clave.localeCompare(b.clave));
// Color del plazo: rojo si vence en menos de 24 h (o ya venció), ámbar hasta 3 días.
const tono = (clave: string) => {
  if (clave === '9999') return 'gris';
  const [f, h] = clave.split('T');
  const horas = hoursUntilSessionCL(f, h ?? '00:00');
  return horas < 24 ? 'rojo' : horas < 72 ? 'ambar' : 'gris';
};
const VISIBLES = 6;
const hayBox = box.pendientes.length > 0 || box.liberar.length > 0;

// ── Números ─────────────────────────────────────────────────────────────────
const porCobrarTotal = (porCobrar ?? []).reduce((s, b) => s + (Number(b.amount) || 0), 0);
const avanceSemana = Math.min(100, Math.round((semana.length / META_SEMANA) * 100));

// ── Reservas por origen ─────────────────────────────────────────────────────
const porCanal = new Map<string, { n: number; monto: number }>();
let sinOrigen = 0;
for (const b of recientesRes.data ?? []) {
  const canal = b.origen?.canal as string | undefined;
  if (!canal) { sinOrigen++; continue; }
  const acc = porCanal.get(canal) ?? { n: 0, monto: 0 };
  acc.n++; acc.monto += Number(b.amount) || 0;
  porCanal.set(canal, acc);
}
const origenes = [...porCanal.entries()].sort((a, b) => b[1].n - a[1].n);

const chevron = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>';
const PAGO_TXT: Record<Sesion['pago'], string> = { 'pagada': 'pagada', 'por-pagar': 'por pagar', 'en-consulta': 'paga en consulta', 'anulada': 'deuda anulada', 'sin-cobro': 'sin costo', 'externa': 'Encuadrado' };
---

<AdminLayout title="Inicio" current="/admin" avisos={avisos} ocultarAvisosDeInicio>
  <div class="inicio">

    <!-- Día que se mira -->
    <nav class="ini-dia" aria-label="Cambiar de día">
      <a href={`/admin?dia=${sumarDias(dia, -1)}`} class="ini-flecha" aria-label="Día anterior">‹</a>
      <div class="ini-dia-txt">
        <p class="ini-dia-rel">{esHoy ? 'Hoy' : dia === manana ? 'Mañana' : dia === ayer ? 'Ayer' : ' '}</p>
        <h2>{mayus(fechaLarga(dia))}</h2>
      </div>
      <a href={`/admin?dia=${sumarDias(dia, 1)}`} class="ini-flecha" aria-label="Día siguiente">›</a>
      {!esHoy && <a href="/admin" class="btn btn-outline btn-sm ini-hoy">Hoy</a>}
    </nav>

    {errorReservas && (
      <p class="alert-error">⚠ No se pudieron leer las sesiones. Recarga en un rato.</p>
    )}

    <!-- Próxima sesión -->
    <section class="card ini-hero">
      <p class="label">{hero ? (heroEnCurso ? 'En curso' : esHoy ? 'Próxima sesión' : 'Primera sesión del día') : (esHoy ? 'Próxima sesión' : 'Sesiones del día')}</p>
      {hero ? (
        <>
          <a href={hero.href} class="ini-hero-main">
            <span class="ini-hero-hora">{hero.hora}</span>
            <span class="ini-hero-txt">
              <strong>{hero.paciente}</strong>
              <span>{hero.fecha !== dia ? `${cuando(hero.fecha)} · ` : ''}{hero.tipo}</span>
            </span>
            <span class={`ini-pago ini-pago-${hero.pago}`}>{PAGO_TXT[hero.pago]}</span>
          </a>
          <div class="ini-hero-botones">
            <a href={hero.href} class="btn btn-dark ini-btn">Ver en el calendario</a>
            {/* Sala online abre el Meet de la sesión de la página en curso o por
                empezar: solo se ofrece si esta sesión es de la página (las de
                Encuadrado no tienen Meet aquí) y es la que viene hoy. */}
            {hero.online && hero.id && hero.fecha === hoy && (
              <a href="/admin/sala-online" target="_blank" rel="noopener" class="btn btn-primary ini-btn">Entrar a Meet</a>
            )}
          </div>
        </>
      ) : (
        <p class="ini-vacio">{errorReservas ? 'No se pudieron leer las sesiones.' : esHoy ? 'No quedan sesiones hoy ni en los próximos 7 días.' : 'Sin sesiones este día.'}</p>
      )}
    </section>

    <!-- Números -->
    <section class="ini-stats" aria-label="Resumen">
      <a href={`/admin/agenda?fecha=${dia}`} class="ini-stat">
        <span class="stat-label">{esHoy ? 'Hoy' : 'Día'}</span>
        <span class="stat-value">{delDia.length}</span>
        <span class="stat-sub">{delDia.length === 1 ? 'sesión' : 'sesiones'}</span>
      </a>
      <a href={`/admin/agenda?fecha=${lunes}`} class="ini-stat">
        <span class="stat-label">Semana</span>
        <span class="stat-value">{semana.length}<small>/{META_SEMANA}</small></span>
        <span class="ini-barra" aria-hidden="true"><span style={`width:${avanceSemana}%`}></span></span>
        <span class="stat-sub">lun {Number(lunes.slice(8))} – dom {Number(domingo.slice(8))}{google === null ? ' · sin Google' : ''}</span>
      </a>
      <a href="/admin/por-cobrar" class="ini-stat">
        <span class="stat-label">Por cobrar</span>
        <span class="stat-value">{porCobrar === null ? '—' : porCobrar.length}</span>
        <span class="stat-sub">{porCobrar === null ? 'no se pudo leer' : clp(porCobrarTotal)}</span>
      </a>
      <a href="/admin/deudas" class="ini-stat">
        <span class="stat-label">Te deben</span>
        <span class="stat-value">{deben === null ? '—' : deben.personas}</span>
        <span class="stat-sub">{deben === null ? 'no se pudo leer' : `${clp(deben.total)} en total`}</span>
      </a>
    </section>

    <div class="ini-cols">
      <!-- Para hacer -->
      <section class="card ini-lista">
        <div class="section-header">
          <p class="label">Para hacer{tareas.length ? ` (${tareas.length})` : ''}</p>
          {hayBox && <a href="https://espaciocala.cl" target="_blank" rel="noopener" class="ini-link-sec">espaciocala.cl ↗</a>}
        </div>
        {!tareas.length ? (
          <p class="ini-ok">Todo al día ✓</p>
        ) : (
          <>
            {[tareas.slice(0, VISIBLES), tareas.slice(VISIBLES)].map((grupo, gi) => {
              const lista = (
                <ul class="ini-tareas">
                  {grupo.map((t) => (
                    <li class="ini-tarea">
                      {t.href ? (
                        <a href={t.href} class="ini-tarea-link" {...(t.externo ? { target: '_blank', rel: 'noopener' } : {})}>
                          <span class="ini-tarea-txt">
                            <span class={`ini-chip ini-chip-${tono(t.clave)}`}>{t.chip}</span>
                            <strong>{t.titulo}</strong>
                            <span class="ini-det">{t.detalle}</span>
                          </span>
                          <span class="ini-chev" set:html={chevron}></span>
                        </a>
                      ) : (
                        <div class="ini-tarea-link">
                          <span class="ini-tarea-txt">
                            <span class={`ini-chip ini-chip-${tono(t.clave)}`}>{t.chip}</span>
                            <strong>{t.titulo}</strong>
                            <span class="ini-det">{t.detalle}</span>
                          </span>
                        </div>
                      )}
                      {t.accion && (
                        <div class="ini-tarea-accion">
                          {t.accion.tipo === 'wa' && (t.accion.url
                            ? <>
                                <a href={t.accion.url} target="_blank" rel="noopener" data-cobro-wa={t.accion.id} data-tomar-cobro={t.accion.id} class="btn ini-btn ini-btn-wa">WhatsApp</a>
                                <span data-cobro-enviado={t.accion.id} hidden class="ini-hecho">✓ abierto</span>
                              </>
                            : <span class="ini-hecho">sin teléfono válido</span>)}
                          {t.accion.tipo === 'form' && (
                            <form method="POST" action={t.accion.action}
                              onsubmit={t.accion.action === '/api/admin/pago-resuelto' ? "return confirm('¿Marcar como resuelto? (ya devolviste el pago o la pasaste a otra hora). El aviso desaparece; la sesión y su pago no cambian.')" : undefined}>
                              {Object.entries(t.accion.campos).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
                              <button type="submit" class="btn btn-outline ini-btn">{t.accion.texto}</button>
                            </form>
                          )}
                          {t.accion.tipo === 'link' && (
                            <a href={t.accion.url} target="_blank" rel="noopener" class="btn btn-outline ini-btn">{t.accion.texto}</a>
                          )}
                          {t.accion.tipo === 'folio' && (
                            <button type="button" class="btn btn-outline ini-btn btn-registrar-folio" data-booking={t.accion.bookingId} data-folio={t.accion.sugerido ?? ''}>Registrar folio</button>
                          )}
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
              );
              if (!grupo.length) return null;
              return gi === 0 ? lista : (
                <details class="ini-mas">
                  <summary><span class="ini-mas-abrir">Ver todo ({tareas.length})</span><span class="ini-mas-cerrar">Ver menos</span></summary>
                  {lista}
                </details>
              );
            })}
          </>
        )}
      </section>

      <!-- Sesiones del día -->
      <section class="card ini-lista">
        <div class="section-header">
          <p class="label">Sesiones · {esHoy ? 'hoy' : fechaCorta(dia)}</p>
          <a href={`/admin/agenda?fecha=${dia}`} class="ini-link-sec">Ver en calendario</a>
        </div>
        {!delDia.length ? (
          <p class="ini-vacio">Sin sesiones este día.</p>
        ) : (
          <ul class="ini-sesiones">
            {delDia.map((s) => (
              <li class="ini-sesion-fila">
                <a href={s.href} class="ini-sesion">
                  <span class="ini-sesion-hora">{s.hora}</span>
                  <span class="ini-tarea-txt">
                    <strong>{s.paciente}</strong>
                    <span class="ini-det">{s.tipo}</span>
                  </span>
                  <span class={`ini-pago ini-pago-${s.pago}`}>{PAGO_TXT[s.pago]}</span>
                  <span class="ini-chev" set:html={chevron}></span>
                </a>
                {s.fichaId && (
                  <a href={`/admin/pacientes/${s.fichaId}?tab=notas#para-revisar`} class="ini-preparar" title={`Tareas y lo que quedó para trabajar con ${s.paciente}`}>✦ Preparar</a>
                )}
              </li>
            ))}
          </ul>
        )}
        {google === null && <p class="ini-nota">No se pudo leer Google Calendar: faltan las sesiones de Encuadrado.</p>}
      </section>
    </div>

    <!-- Próximos 7 días -->
    <section class="card ini-lista">
      <div class="section-header">
        <p class="label">Próximos 7 días</p>
        <a href={`/admin/agenda?fecha=${sumarDias(dia, 1)}`} class="ini-link-sec">Calendario</a>
      </div>
      {!proximasPorDia.length ? (
        <p class="ini-vacio">Sin sesiones agendadas en los próximos 7 días.</p>
      ) : (
        <div class="ini-dias">
          {proximasPorDia.map(([fecha, lista]) => (
            <div class="ini-dia-card">
              <a href={`/admin?dia=${fecha}`} class="ini-dia-card-tit">{mayus(cuando(fecha) === fechaCorta(fecha) ? fechaCorta(fecha) : `${cuando(fecha)} · ${fechaCorta(fecha)}`)} <span>{lista.length}</span></a>
              <ul>
                {lista.map((s) => (
                  <li>
                    <a href={s.href} class="ini-mini">
                      <span class="ini-mini-hora">{s.hora}</span>
                      <span class="ini-mini-nom">{s.paciente}</span>
                      <span class={`ini-punto ini-pago-${s.pago}`} title={PAGO_TXT[s.pago]}></span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- Reservas por origen -->
    <details class="card ini-origen">
      <summary class="label">Reservas por origen (últimos 90 días)</summary>
      {!origenes.length ? (
        <p class="ini-vacio">Aún no hay reservas confirmadas con origen registrado.</p>
      ) : (
        <table>
          <thead><tr><th>Origen</th><th>Reservas</th><th>Monto</th></tr></thead>
          <tbody>
            {origenes.map(([canal, v]) => (
              <tr><td style="font-weight:500;">{canal}</td><td>{v.n}</td><td>{clp(v.monto)}</td></tr>
            ))}
          </tbody>
        </table>
      )}
      {sinOrigen > 0 && (
        <p class="ini-nota">{sinOrigen} {sinOrigen === 1 ? 'reserva confirmada' : 'reservas confirmadas'} sin origen registrado (creadas en el panel o antes de activar esto).</p>
      )}
    </details>
  </div>
</AdminLayout>

<style>
  .inicio { display: flex; flex-direction: column; gap: 1rem; max-width: 1100px; }

  /* Día */
  .ini-dia { display: flex; align-items: center; gap: 0.5rem; }
  .ini-dia-txt { flex: 1; min-width: 0; text-align: center; }
  .ini-dia-txt h2 { font-size: 1.15rem; font-weight: 700; color: var(--enc-text-1); }
  .ini-dia-rel { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--enc-text-3); font-weight: 600; min-height: 1em; }
  .ini-flecha { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 10px; border: 1px solid var(--enc-border); background: white; color: var(--enc-text-2); font-size: 1.5rem; line-height: 1; text-decoration: none; flex-shrink: 0; }
  .ini-flecha:active { transform: scale(0.95); }
  .ini-hoy { min-height: 44px; }

  /* Próxima sesión */
  .ini-hero { display: flex; flex-direction: column; gap: 0.75rem; }
  .ini-hero-main { display: flex; align-items: center; gap: 0.9rem; text-decoration: none; color: inherit; min-height: 44px; }
  .ini-hero-hora { font-size: 1.8rem; font-weight: 700; color: var(--enc-text-1); line-height: 1; }
  .ini-hero-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .ini-hero-txt strong { font-size: 1rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ini-hero-txt span { font-size: 0.8rem; color: var(--enc-text-3); }
  .ini-hero-botones { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .ini-btn { min-height: 44px; }
  .ini-hero-botones .ini-btn { flex: 1; min-width: 140px; }

  /* Pago */
  .ini-pago { font-size: 0.7rem; font-weight: 600; padding: 0.2rem 0.55rem; border-radius: 99px; border: 1px solid; white-space: nowrap; flex-shrink: 0; }
  .ini-pago-pagada { color: #15803d; border-color: #86efac; background: #f0fdf4; }
  .ini-pago-por-pagar { color: #b91c1c; border-color: #fca5a5; background: #fef2f2; }
  .ini-pago-en-consulta { color: #78350f; border-color: #b45309; border-style: dashed; background: #fef3c7; }
  .ini-pago-anulada, .ini-pago-sin-cobro, .ini-pago-externa { color: var(--enc-text-3); border-color: var(--enc-border); background: var(--enc-body-bg); }

  /* Números */
  .ini-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; }
  .ini-stat { display: flex; flex-direction: column; gap: 0.15rem; background: white; border: 1px solid var(--enc-border); border-radius: var(--enc-radius-lg); padding: 0.9rem 1rem; box-shadow: var(--enc-shadow); text-decoration: none; color: inherit; min-height: 44px; transition: border-color .15s; }
  .ini-stat:hover { border-color: #9ca3af; }
  .ini-stat:active { transform: scale(0.98); }
  .ini-stat .stat-label { font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--enc-text-3); font-weight: 600; }
  .ini-stat .stat-value { font-size: 1.7rem; font-weight: 700; color: var(--enc-text-1); line-height: 1.1; }
  .ini-stat .stat-value small { font-size: 0.95rem; font-weight: 600; color: var(--enc-text-3); }
  .ini-stat .stat-sub { font-size: 0.75rem; color: var(--enc-text-3); }
  .ini-barra { display: block; height: 4px; border-radius: 99px; background: var(--enc-border-2); overflow: hidden; margin: 0.15rem 0; }
  .ini-barra span { display: block; height: 100%; background: #4f5ce8; border-radius: 99px; }

  /* Listas */
  .ini-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: start; }
  .ini-lista .section-header { margin-bottom: 0.5rem; }
  .ini-link-sec { font-size: 0.8rem; color: var(--enc-nav-active-text); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.25rem; }
  .ini-tareas, .ini-sesiones { list-style: none; display: flex; flex-direction: column; }
  .ini-tarea { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.5rem; border-top: 1px solid var(--enc-border-2); padding: 0.15rem 0; }
  .ini-tareas > .ini-tarea:first-child, .ini-sesiones > li:first-child > .ini-sesion { border-top: none; }
  .ini-tarea-link { flex: 1 1 220px; min-width: 0; display: flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0.45rem 0.25rem; text-decoration: none; color: inherit; border-radius: 8px; }
  a.ini-tarea-link:hover, .ini-sesion:hover { background: var(--enc-body-bg); }
  .ini-tarea-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.1rem; }
  .ini-tarea-txt strong { font-size: 0.88rem; font-weight: 600; color: var(--enc-text-1); }
  .ini-det { font-size: 0.76rem; color: var(--enc-text-3); }
  .ini-chev { color: var(--enc-text-4); display: inline-flex; flex-shrink: 0; }
  .ini-tarea-accion { display: flex; align-items: center; gap: 0.4rem; padding: 0 0.25rem 0.35rem; }
  .ini-tarea-accion form { display: inline; }
  .ini-btn-wa { background: #25D366 !important; color: white !important; border-color: #25D366 !important; }
  .ini-hecho { font-size: 0.75rem; color: var(--enc-text-3); }
  .ini-chip { align-self: flex-start; font-size: 0.68rem; font-weight: 600; padding: 0.1rem 0.5rem; border-radius: 99px; margin-bottom: 0.1rem; }
  .ini-chip-rojo { background: #fee2e2; color: #b91c1c; }
  .ini-chip-ambar { background: #fef3c7; color: #92400e; }
  .ini-chip-gris { background: var(--enc-border-2); color: var(--enc-text-3); }
  .ini-ok { font-size: 0.95rem; font-weight: 600; color: var(--enc-green-dark); padding: 0.75rem 0; }
  .ini-vacio { font-size: 0.875rem; color: var(--enc-text-3); padding: 0.5rem 0; }
  .ini-nota { font-size: 0.75rem; color: var(--enc-text-3); margin-top: 0.5rem; }
  .ini-mas summary { cursor: pointer; list-style: none; font-size: 0.82rem; font-weight: 600; color: var(--enc-nav-active-text); min-height: 44px; display: flex; align-items: center; border-top: 1px solid var(--enc-border-2); }
  .ini-mas summary::-webkit-details-marker { display: none; }
  .ini-mas[open] summary .ini-mas-abrir, .ini-mas:not([open]) summary .ini-mas-cerrar { display: none; }

  .ini-sesion-fila { display: flex; align-items: center; gap: 0.4rem; border-top: 1px solid var(--enc-border-2); }
  .ini-sesiones > li.ini-sesion-fila:first-child { border-top: none; }
  .ini-sesion-fila > .ini-sesion { flex: 1; min-width: 0; border-top: none; }
