---
export const prerender = false;
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabase } from '../../lib/supabase';
import { nowCL, todayCL } from '../../lib/dateUtils';
import { manualChargeLabel } from '../../lib/debt';

const MONTHS_LONG = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
const MONTHS_SHORT = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];

// Mes seleccionado (YYYY-MM), por defecto el actual
const now      = nowCL();
const curYM    = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
const selYM    = Astro.url.searchParams.get('mes') ?? curYM;
const todayStr = todayCL();
const SIN_FECHA = '2099-12-31'; // cobros manuales sin fecha de sesión

// Reservas que existen de verdad: sin canceladas ni vencidas (una reserva web
// abandonada queda 'expired' y no es ni ingreso ni deuda).
const { data: all } = await supabase
  .from('bookings')
  .select('id, patient_name, patient_email, amount, status, payment_method, payment_note, session_type, session_date, session_time, paid_at, debt_voided, custom_title, notes, created_by_admin')
  .not('status', 'in', '(cancelled,expired)');
const bookings = all ?? [];

// REGLA (Valentina, 3 oct 2026): ingreso = solo lo que tiene fecha de pago
// (paid_at). Antes contaba toda sesión 'confirmed', pagada o no, e incluía
// deudas anuladas: la misma sesión salía como ingreso y como deuda.
const pagada  = (b: any) => !!b.paid_at && b.debt_voided !== true;
const anulada = (b: any) => b.debt_voided === true;
const sinPagar = (b: any) => !b.paid_at && !anulada(b) && (b.amount ?? 0) > 0;
const fechaChile = (iso: string) => nowCL(new Date(iso)).toISOString().slice(0, 10);

// ── Ingresos del mes: lo pagado, por el MES EN QUE SE PAGÓ ──────────────────
const pagosMes = bookings.filter(b => pagada(b) && fechaChile(b.paid_at).slice(0, 7) === selYM);
const ingresosMes = pagosMes.reduce((s, b) => s + (b.amount ?? 0), 0);

// Medio de pago real (payment_note guarda cómo se pagó; payment_method es cómo se reservó)
const medio = (b: any) => {
  const n = String(b.payment_note ?? '').toLowerCase();
  if (n.includes('flow')) return 'Flow (Webpay)';
  if (n.includes('transfer')) return 'Transferencia';
  if (n.includes('efectivo')) return 'Efectivo';
  if (b.payment_note) return String(b.payment_note);
  return ({ manual: 'Pago en consulta', transferencia: 'Transferencia', flow: 'Flow (Webpay)' } as Record<string, string>)[b.payment_method] ?? 'Otro';
};
const byMethod: Record<string, { count: number; total: number }> = {};
pagosMes.forEach(b => {
  const k = medio(b);
  (byMethod[k] ??= { count: 0, total: 0 });
  byMethod[k].count++;
  byMethod[k].total += b.amount ?? 0;
});

// ── Lo que se adeuda (para cobrar): sesiones ya realizadas sin pagar ────────
// Confirmadas, con fecha de hoy o anterior, sin pago y sin deuda anulada.
// Los cobros manuales sin fecha (2099) pendientes también se deben.
// También las sesiones ya realizadas que quedaron "esperando pago" con un link
// enviado por Valentina (o con comprobante sin confirmar): esas nunca vencen
// solas y antes no salían ni aquí ni en "Por cobrar".
const esperandoLink = (b: any) => b.status === 'pending_payment' &&
  (b.created_by_admin === true || String(b.notes ?? '').includes('ComprobanteTransferencia'));
const deudas = bookings.filter(b => sinPagar(b) && (
  ((b.status === 'confirmed' || esperandoLink(b)) && b.session_date !== SIN_FECHA && b.session_date <= todayStr) ||
  (b.session_date === SIN_FECHA)
));
const totalAdeudado = deudas.reduce((s, b) => s + (b.amount ?? 0), 0);

// ── Por cobrar: sesiones futuras agendadas que aún no se pagan ──────────────
const porCobrar = bookings.filter(b => sinPagar(b) && b.session_date !== SIN_FECHA && b.session_date > todayStr);
const totalPorCobrar = porCobrar.reduce((s, b) => s + (b.amount ?? 0), 0);

// Quién debe y desde cuándo, agrupado por paciente (más antiguo primero)
const { data: fichas } = await supabase.from('patients').select('id, email');
const fichaDe = new Map((fichas ?? []).map((p: { id: string; email: string }) => [String(p.email ?? '').toLowerCase(), p.id]));
const ST_LABEL: Record<string, string> = {
  'online': 'Individual Online', 'presencial': 'Individual Presencial',
  'pareja-online': 'Pareja Online', 'pareja-presencial': 'Pareja Presencial',
  'individual': 'Individual', 'pareja': 'Pareja',
};
const etiqueta = (b: any) => b.custom_title || manualChargeLabel(b.notes) || ST_LABEL[b.session_type] || b.session_type || 'Sesión';
const fmtFecha = (iso: string) => {
  if (!iso || iso === SIN_FECHA) return 'sin fecha';
  const [y, m, d] = iso.split('-').map(Number);
  return `${d} ${MONTHS_SHORT[m - 1]}${y !== now.getFullYear() ? ' ' + y : ''}`;
};
type Deudor = { nombre: string; email: string; fichaId?: string; total: number; desde: string; sesiones: any[] };
const deudoresMap = new Map<string, Deudor>();
for (const b of deudas) {
  const key = String(b.patient_email ?? b.patient_name ?? '').toLowerCase();
  const d = deudoresMap.get(key) ?? { nombre: b.patient_name ?? '(sin nombre)', email: b.patient_email ?? '', fichaId: fichaDe.get(String(b.patient_email ?? '').toLowerCase()), total: 0, desde: b.session_date, sesiones: [] };
  d.total += b.amount ?? 0;
  if (b.session_date < d.desde) d.desde = b.session_date;
  d.sesiones.push(b);
  deudoresMap.set(key, d);
}
const deudores = [...deudoresMap.values()].sort((a, b) => a.desde.localeCompare(b.desde));
deudores.forEach(d => d.sesiones.sort((a: any, b: any) => a.session_date.localeCompare(b.session_date)));

// ── Sesiones del mes seleccionado (por fecha de sesión) ─────────────────────
const inMonth = bookings.filter(b => (b.session_date ?? '').slice(0, 7) === selYM && b.status === 'confirmed');
const pendienteMes = inMonth.filter(sinPagar);
const byType: Record<string, number> = {};
inMonth.forEach(b => { const k = ST_LABEL[b.session_type] ?? b.session_type ?? 'otro'; byType[k] = (byType[k] ?? 0) + 1; });
const totalAtenciones = inMonth.length;

// Lista de meses para el selector (12 hacia atrás)
const monthOptions = Array.from({ length: 12 }, (_, i) => {
  const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
  const ym = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  return { value: ym, label: `${MONTHS_LONG[d.getMonth()].charAt(0).toUpperCase() + MONTHS_LONG[d.getMonth()].slice(1)} ${d.getFullYear()}` };
});
const mesLabel = monthOptions.find(m => m.value === selYM)?.label ?? selYM;

const formatCLP = (n: number) =>
  new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);
---

<AdminLayout title="Finanzas" current="/admin/finanzas" fullHeight={true}>

  <div class="fin-wrap">
    <div class="fin-head">
      <h1>Finanzas</h1>
    </div>

    <div class="fin-scroll">

      <!-- Tarjetas superiores -->
      <div class="fin-top">
        <div class="fin-card">
          <div class="fin-card-label">Ingresos pagados · {mesLabel}</div>
          <div class="fin-card-value">{formatCLP(ingresosMes)}</div>
          <div class="fin-card-foot">
            <span class="fin-muted">{pagosMes.length} pago{pagosMes.length !== 1 ? 's' : ''} recibido{pagosMes.length !== 1 ? 's' : ''} en el mes</span>
          </div>
        </div>

        <div class="fin-card fin-card-due">
          <div class="fin-card-label" style="color:#dc2626;">Te deben (sesiones ya realizadas)</div>
          <div class="fin-card-value">{formatCLP(totalAdeudado)}</div>
          <div class="fin-card-foot">
            <span class="fin-muted">{deudores.length} paciente{deudores.length !== 1 ? 's' : ''} · </span>
            <a href="#deudores" class="btn btn-outline btn-sm">Ver quiénes →</a>
          </div>
        </div>

        <div class="fin-card">
          <div class="fin-card-label" style="color:#b45309;">Por cobrar · sesiones futuras sin pagar</div>
          <div class="fin-card-value">{formatCLP(totalPorCobrar)}</div>
          <div class="fin-card-foot">
            <a href="/admin/por-cobrar" class="btn btn-outline btn-sm">Ver pendientes →</a>
          </div>
        </div>
      </div>

      <!-- Quién debe y desde cuándo -->
      <div class="fin-section-head" id="deudores"><span>Quién te debe y desde cuándo</span></div>
      <div class="fin-table-wrap" style="margin-bottom:1.5rem;">
        {deudores.length === 0 ? (
          <p class="fin-muted" style="padding:1.5rem;text-align:center;">Nadie te debe sesiones realizadas. 🎉</p>
        ) : (
          <table class="fin-table">
            <thead><tr><th>Paciente</th><th>Debe desde</th><th>Sesiones sin pagar</th><th style="text-align:right;">Total</th><th></th></tr></thead>
            <tbody>
              {deudores.map(d => (
                <tr>
                  <td><strong>{d.nombre}</strong></td>
                  <td class="fin-muted">{fmtFecha(d.desde)}</td>
                  <td class="fin-muted">{d.sesiones.map((b: any) => `${fmtFecha(b.session_date)} (${etiqueta(b)})`).join(' · ')}</td>
                  <td style="text-align:right;font-weight:600;color:#dc2626;">{formatCLP(d.total)}</td>
                  <td style="text-align:right;">
                    {d.fichaId
                      ? <a href={`/admin/pacientes/${d.fichaId}?tab=sesiones`} class="btn btn-outline btn-sm">Cobrar →</a>
                      : <a href="/admin/deudas" class="btn btn-outline btn-sm">Cobrar →</a>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>

      <!-- Resumen del mes -->
      <div class="fin-section-head">
        <span>Resumen de</span>
        <form method="GET" action="/admin/finanzas" id="mes-form">
          <select name="mes" onchange="document.getElementById('mes-form').submit()">
            {monthOptions.map(m => (
              <option value={m.value} selected={m.value === selYM}>{m.label}</option>
            ))}
          </select>
        </form>
      </div>

      <div class="fin-tabs">
        <button class="fin-tab active" data-tab="pagos">Pagos</button>
        <button class="fin-tab" data-tab="atenciones">Atenciones</button>
      </div>

      <!-- Pagos -->
      <div class="fin-grid" id="tab-pagos">
        <div class="fin-panel">
          <div class="fin-panel-value" style="color:#4f5ce8;">{formatCLP(ingresosMes)}</div>
          <p class="fin-panel-note">Ingresos pagados en el mes, por medio de pago</p>
          <div class="fin-breakdown">
            {Object.keys(byMethod).length === 0 ? (
              <p class="fin-muted" style="padding:0.5rem 0;">Sin pagos recibidos este mes.</p>
            ) : Object.entries(byMethod).map(([k, v]) => (
              <div class="fin-break-row">
                <span>{k} <span class="fin-muted">· {v.count}</span></span>
                <strong>{formatCLP(v.total)}</strong>
              </div>
            ))}
          </div>
        </div>

        <div class="fin-panel">
          <div class="fin-panel-label">Sesiones del mes sin pagar</div>
          <div class="fin-panel-value">
            {formatCLP(pendienteMes.reduce((s, b) => s + (b.amount ?? 0), 0))}
          </div>
          <p class="fin-panel-note">{pendienteMes.length} sesión(es) del mes sin pago</p>
        </div>
      </div>

      <!-- Atenciones -->
      <div class="fin-grid" id="tab-atenciones" style="display:none;">
        <div class="fin-panel">
          <div class="fin-panel-value">{totalAtenciones}</div>
          <p class="fin-panel-note">Sesiones agendadas del mes</p>
          <div class="fin-breakdown">
            {totalAtenciones === 0 ? (
              <p class="fin-muted" style="padding:0.5rem 0;">Sin sesiones este mes.</p>
            ) : Object.entries(byType).map(([k, n]) => (
              <div class="fin-break-row">
                <span>{k}</span>
                <strong>{n}</strong>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Detalle -->
      <div class="fin-section-head" style="margin-top:1.5rem;"><span>Sesiones del mes</span></div>
      <div class="fin-table-wrap">
        {inMonth.length === 0 ? (
          <p class="fin-muted" style="padding:1.5rem;text-align:center;">Sin sesiones este mes.</p>
        ) : (
          <table class="fin-table">
            <thead><tr><th>Fecha</th><th>Paciente</th><th>Tipo</th><th>Medio</th><th>Estado</th><th style="text-align:right;">Monto</th></tr></thead>
            <tbody>
              {inMonth.sort((a, b) => (b.session_date ?? '').localeCompare(a.session_date ?? '')).map(b => (
                <tr>
                  <td class="fin-muted">{fmtFecha(b.session_date)}</td>
                  <td>{b.patient_name}</td>
                  <td>{etiqueta(b)}</td>
                  <td class="fin-muted">{pagada(b) ? medio(b) : '—'}</td>
                  <td>
                    <span class={`fin-badge ${pagada(b) ? 'ok' : anulada(b) ? 'void' : 'due'}`}>
                      {pagada(b) ? 'Pagado' : anulada(b) ? 'Deuda anulada' : 'Por pagar'}
                    </span>
                  </td>
                  <td style="text-align:right;font-weight:600;">{formatCLP(b.amount ?? 0)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>

    </div>
  </div>

</AdminLayout>

<style>
.fin-wrap { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: white; }
.fin-head { padding: 1.25rem 1.5rem 0.5rem; }
.fin-head h1 { font-size: 1.6rem; font-weight: 700; color: #111827; }
.fin-scroll { flex: 1; min-height: 0; overflow-y: auto; padding: 0.5rem 1.5rem 2rem; }

.fin-top { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; }
@media (max-width: 1000px) { .fin-top { grid-template-columns: 1fr 1fr; } }
@media (max-width: 720px) { .fin-top { grid-template-columns: 1fr; } }
.fin-card { border: 1px solid #e5e7eb; border-radius: 12px; padding: 1.25rem 1.5rem; }
.fin-card-label { font-size: 0.85rem; color: #6b7280; margin-bottom: 0.5rem; }
.fin-card-value { font-size: 2rem; font-weight: 700; color: #111827; line-height: 1; }
.fin-card-foot { margin-top: 1rem; }
.fin-muted { color: #9ca3af; }

.fin-section-head { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
.fin-section-head span { font-size: 1.05rem; font-weight: 600; color: #111827; }
.fin-section-head select { width: auto; min-width: 160px; }

.fin-tabs { display: inline-flex; background: #f3f4f6; border-radius: 9px; padding: 3px; margin-bottom: 1rem; }
.fin-tab { padding: 0.45rem 1.5rem; font-size: 0.85rem; font-weight: 500; color: #6b7280; background: none; border: none; border-radius: 7px; cursor: pointer; }
.fin-tab.active { background: white; color: #111827; font-weight: 600; box-shadow: 0 1px 2px rgba(0,0,0,.08); }

.fin-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
@media (max-width: 720px) { .fin-grid { grid-template-columns: 1fr; } }
.fin-panel { border: 1px solid #e5e7eb; border-radius: 12px; padding: 1.5rem; }
.fin-panel-label { font-size: 0.8rem; color: #6b7280; margin-bottom: 0.5rem; }
.fin-panel-value { font-size: 1.75rem; font-weight: 700; color: #111827; line-height: 1; }
.fin-panel-note { font-size: 0.8rem; color: #6b7280; margin-top: 0.4rem; }
.fin-breakdown { margin-top: 1rem; border-top: 1px solid #f3f4f6; padding-top: 0.75rem; }
.fin-break-row { display: flex; justify-content: space-between; padding: 0.4rem 0; font-size: 0.875rem; color: #374151; }

.fin-table-wrap { border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }
.fin-table { width: 100%; border-collapse: collapse; }
.fin-table th { text-align: left; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: #6b7280; font-weight: 600; padding: 0.7rem 1rem; background: #f9fafb; border-bottom: 1px solid #e5e7eb; }
.fin-table td { padding: 0.75rem 1rem; border-bottom: 1px solid #f3f4f6; font-size: 0.85rem; }
.fin-table tr:last-child td { border-bottom: none; }
.fin-badge { display: inline-flex; padding: 2px 9px; border-radius: 99px; font-size: 0.72rem; font-weight: 600; }
.fin-badge.ok  { background: #f0fdf4; color: #15803d; }
.fin-badge.due { background: #fef2f2; color: #dc2626; }
.fin-badge.void { background: #f3f4f6; color: #6b7280; }
.fin-table-wrap { overflow-x: auto; }
</style>

<script>
  document.querySelectorAll('.fin-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.fin-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const which = tab.dataset.tab;
      document.getElementById('tab-pagos').style.display      = which === 'pagos' ? 'grid' : 'none';
      document.getElementById('tab-atenciones').style.display = which === 'atenciones' ? 'grid' : 'none';
    });
  });
</script>
