---
export const prerender = false;
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { supabase } from '../../../lib/supabase';
import { nowCL, todayCL } from '../../../lib/dateUtils';
import { vigente, type ConsentRow } from '../../../lib/consent';
import { origenTexto } from '../../../lib/origen';
import {
  AVISO_RESPUESTA, ROTULO_RESUMEN, duracionTexto, estadoVisible, fechaCorta, fechaLarga, resumenAHtml, resumenATexto,
  sePuedeReintentar, textoProblema, tipoTexto,
} from '../../../lib/transcriptor/panel';
import { avisoAnexoResumen } from '../../../lib/transcriptor/resumen';
import { conContenidoClaro } from '../../../lib/transcriptor/resumenCifrado';
import { auditarObligatorio } from '../../../lib/transcriptor/auditoria';
import { identidadFirmante } from '../../../lib/transcriptor/consentimiento';

const { id } = Astro.params;
// Datos de prueba del transcriptor SOLO en `astro dev` (import.meta.env.DEV es false en el build):
// /admin/pacientes/<cualquier-id>?tab=notas&demo=ia para la revisión visual sin base de datos.
const demoIA = import.meta.env.DEV && Astro.url.searchParams.get('demo') === 'ia';

let [{ data: patient }, { data: notasTodas }, { data: bookings }, { data: allSvc }] = await Promise.all([
  supabase.from('patients').select('*').eq('id', id!).single(),
  supabase.from('session_notes').select('*').eq('patient_id', id!).order('session_date', { ascending: false }),
  supabase.from('bookings').select('*').eq('patient_email', '').order('session_date', { ascending: false }).limit(0),
  supabase.from('services_catalog')
    .select('id, name, price, price_online, price_presencial, modality, type, duration_min')
    .eq('visible', true).order('sort_order'),
]);
const allServices = allSvc ?? [];
// Las notas archivadas no se muestran, pero se conservan (ficha clínica, 15 años).
let notes = (notasTodas ?? []).filter((n: { deleted_at?: string | null }) => !n.deleted_at);

// Buscar reservas por email del paciente si tiene email
let patientBookings: any[] = [];
if (patient?.email) {
  const { data } = await supabase
    .from('bookings')
    .select('*')
    .eq('patient_email', patient.email)
    .order('session_date', { ascending: false });
  patientBookings = data ?? [];
}

// ── Transcriptor IA (P7): grabaciones de esta ficha y sus resúmenes ──────────
// El resumen es un ANEXO rotulado, separado de la nota de evolución (session_notes): nunca se
// mezcla ni la reemplaza. Si la migración 0014 aún no está aplicada, la consulta falla y la
// ficha se ve igual que siempre (sin la sección).
type GrabFicha = {
  id: string; booking_id: string | null; origen: 'presencial' | 'online'; tipo: 'individual' | 'pareja' | 'sin_tipo';
  estado: string; estado_antes_error: string | null; session_date: string; inicio_at: string | null;
  duracion_seg: number | null; nota_sistema: string | null; created_at: string; excluir_ia_at?: string | null;
};
type ResFicha = { id: string; grabacion_id: string; version: number; autor: 'ia' | 'vale'; estado: string; rotulo: string | null; contenido: string | null; contenido_cifrado?: unknown; modelo?: string | null; listo_at: string | null; created_at: string };
let iaGrabaciones: GrabFicha[] = [];
let iaResumenes: ResFicha[] = [];
let iaTranscritas = new Set<string>();
const OCULTAS_EN_FICHA = new Set(['creada', 'cancelada', 'sin_consentimiento', 'bot_no_admitido']);
if (import.meta.env.DEV && demoIA) {
  // Ficha de prueba (nombres y contenido inventados).
  patient = { id: id!, name: 'Camila Rojas', email: 'camila@example.com', phone: null, active: true, birthdate: '1993-04-02', rut: null, notes: '' };
  notasTodas = [
    { id: 'n1', patient_id: id, booking_id: 'b1', session_date: '2026-10-15', session_type: 'presencial', content: 'Buena adherencia. Trabajar asertividad con la jefa. Retomar registro de pensamientos.', deleted_at: null },
    { id: 'n2', patient_id: id, booking_id: 'b0', session_date: '2026-10-01', session_type: 'presencial', content: 'Primera sesión. Motivo de consulta: ansiedad laboral.', deleted_at: null },
  ];
  patientBookings = [
    { id: 'b1', session_date: '2026-10-15', session_time: '16:00:00', session_type: 'presencial', status: 'confirmed', amount: 45000, paid_at: '2026-10-15T19:00:00Z', notes: '', patient_email: 'camila@example.com' },
    { id: 'b2', session_date: '2026-10-08', session_time: '16:00:00', session_type: 'presencial', status: 'confirmed', amount: 45000, paid_at: '2026-10-08T19:00:00Z', notes: '', patient_email: 'camila@example.com' },
  ];
  iaGrabaciones = [
    { id: '00000000-0000-4000-8000-0000000000a1', booking_id: 'b1', origen: 'presencial', tipo: 'individual', estado: 'lista', estado_antes_error: null, session_date: '2026-10-15', inicio_at: '2026-10-15T19:00:00Z', duracion_seg: 3012, nota_sistema: null, created_at: '2026-10-15T19:00:00Z' },
    { id: '00000000-0000-4000-8000-0000000000a2', booking_id: 'b2', origen: 'presencial', tipo: 'individual', estado: 'resumiendo', estado_antes_error: null, session_date: '2026-10-08', inicio_at: '2026-10-08T19:00:00Z', duracion_seg: 2950, nota_sistema: null, created_at: '2026-10-08T19:00:00Z' },
    { id: '00000000-0000-4000-8000-0000000000a3', booking_id: null, origen: 'online', tipo: 'individual', estado: 'error', estado_antes_error: 'resumiendo', session_date: '2026-10-03', inicio_at: '2026-10-03T22:00:00Z', duracion_seg: 2700, nota_sistema: null, created_at: '2026-10-03T22:00:00Z' },
  ];
  iaResumenes = [{
    id: 'r1', grabacion_id: '00000000-0000-4000-8000-0000000000a1', version: 1, autor: 'ia', estado: 'listo', rotulo: null, modelo: 'claude-sonnet-5-5', listo_at: '2026-10-15T20:10:00Z', created_at: '2026-10-15T20:00:00Z',
    contenido: '## Resumen automático (IA)\n*Sesión individual · 15 oct 2026 · presencial · 50 min · Generado automáticamente a partir de la transcripción. No revisado. No constituye la evolución clínica.*\n\n### Atención\n- Se habló de no dar más con el trabajo — Dicho por: Camila — [23:40]\n  «a veces siento que no doy más»\n_Mención consignada automáticamente. No es una evaluación de riesgo; revisar la transcripción completa._\n\n### Temas tratados\n- Conflicto con su jefa.\n- Sueño.\n\n### Puntos clave\n- Refiere dormir mejor desde que deja el celular fuera de la pieza [05:12].\n- La conversación pendiente con su jefa sigue siendo lo que más le preocupa.\n\n### Tareas y acuerdos\n- Camila: registro de pensamientos 3 veces — antes de la próxima sesión.\n\n### Para revisar la próxima sesión\n- Cómo le fue con la conversación con su jefa.',
  }];
  iaTranscritas = new Set(['00000000-0000-4000-8000-0000000000a1', '00000000-0000-4000-8000-0000000000a2']);
  notes = notasTodas as typeof notes;
} else if (patient) {
  try {
    const { data: gs, error: eg } = await supabase.from('grabaciones')
      .select('id, booking_id, origen, tipo, estado, estado_antes_error, session_date, inicio_at, duracion_seg, nota_sistema, created_at, excluir_ia_at')
      .eq('patient_id', id!).order('session_date', { ascending: false }).order('created_at', { ascending: false }).limit(200);
    if (!eg && gs?.length) {
      iaGrabaciones = (gs as GrabFicha[]).filter((g) => !OCULTAS_EN_FICHA.has(g.estado));
      const ids = iaGrabaciones.map((g) => g.id);
      if (ids.length) {
        const [{ data: rs }, { data: ts }] = await Promise.all([
          supabase.from('resumenes_ia').select('id, grabacion_id, version, autor, estado, rotulo, contenido, contenido_cifrado, modelo, listo_at, created_at')
            .in('grabacion_id', ids).is('oculto_at', null).order('version', { ascending: false }),
          supabase.from('transcripciones').select('grabacion_id').in('grabacion_id', ids).is('deleted_at', null),
        ]);
        iaResumenes = (rs ?? []) as ResFicha[];
        iaTranscritas = new Set((ts ?? []).map((t: { grabacion_id: string }) => t.grabacion_id));
      }
    }
  } catch (e) {
    console.warn('[ficha/transcriptor]', e instanceof Error ? e.message : e);
  }
}
// H6 + H7 (81-revision-etica-clinica): los resúmenes solo se muestran en la pestaña Notas. Antes de
// descifrarlos se registra el acceso (`ver_resumen`, una fila por vista de ficha); si la bitácora
// falla, no se muestran (igual que la transcripción).
let iaAvisoResumenes: string | null = null;
const tabActual = Astro.url.searchParams.get('tab') ?? 'info';
const hayResumenListo = iaResumenes.some((r) => r.estado === 'listo' && (r.contenido || r.contenido_cifrado));
if (!(import.meta.env.DEV && demoIA) && patient && hayResumenListo) {
  if (tabActual !== 'notas') {
    // Fuera de Notas no se muestra texto: no se descifra nada.
    iaResumenes = iaResumenes.map((r) => ({ ...r, contenido: r.estado === 'listo' && (r.contenido || r.contenido_cifrado) ? '' : r.contenido }));
  } else {
    let registrado = true;
    try {
      let clientAddress: string | null = null;
      try { clientAddress = Astro.clientAddress ?? null; } catch { /* sin IP */ }
      await auditarObligatorio('vale', 'ver_resumen', {
        patientId: id!, request: Astro.request, clientAddress,
        detalle: { resumenes: iaResumenes.filter((r) => r.estado === 'listo').length, vista: 'ficha' },
      });
    } catch {
      registrado = false;
      iaAvisoResumenes = 'No se pudo registrar el acceso en la bitácora. Por seguridad, los resúmenes automáticos no se muestran. Intenta de nuevo en un momento.';
    }
    if (registrado) {
      const r = await conContenidoClaro(iaResumenes);
      // Un resumen listo que no se pudo abrir queda con texto vacío: la tarjeta muestra el aviso.
      iaResumenes = (r.filas as ResFicha[]).map((x) => (x.estado === 'listo' && x.contenido == null && x.contenido_cifrado ? { ...x, contenido: '' } : x));
      if (r.fallidas) iaAvisoResumenes = 'Algún resumen cifrado no se pudo abrir en este momento. Está guardado a salvo; intenta de nuevo en unos minutos.';
    } else {
      iaResumenes = iaResumenes.map((r) => ({ ...r, contenido: r.estado === 'listo' ? '' : null }));
    }
  }
}
const fmtHoraCL = (iso: string | null) => iso ? new Date(iso).toLocaleTimeString('es-CL', { timeZone: 'America/Santiago', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }) : '';
// Por grabación: versión vigente (la de número más alto que esté lista), si hay otra en camino
// y si el último intento de la IA falló.
const iaTarjetas = iaGrabaciones.map((g) => {
  const versiones = iaResumenes.filter((r) => r.grabacion_id === g.id).sort((a, b) => b.version - a.version);
  const vigente = versiones.find((r) => r.estado === 'listo' && r.contenido != null) ?? null;
  const generando = versiones.some((r) => (r.estado === 'pendiente' || r.estado === 'en_batch') && (!vigente || r.version > vigente.version));
  const estado = estadoVisible(g.estado);
  return {
    g, vigente, generando, estado,
    problema: textoProblema(g as never),
    reintentable: sePuedeReintentar(g as never),
    transcrita: iaTranscritas.has(g.id),
    hora: fmtHoraCL(g.inicio_at),
    html: vigente?.contenido ? resumenAHtml(vigente.contenido, (s) => `/admin/pacientes/${id}/sesion/${g.id}?t=${s}`) : '',
    texto: vigente?.contenido ? resumenATexto(vigente.contenido) : '',
    aviso: vigente ? avisoAnexoResumen(vigente) : '',
    excluida: !!g.excluir_ia_at,
  };
});
const iaPorBooking = new Map(iaTarjetas.filter((t) => t.g.booking_id).map((t) => [t.g.booking_id as string, t]));
// Sesiones que la IA puede leer para responder (con transcripción o con resumen listo).
const iaConsultables = iaTarjetas.filter((t) => (t.transcrita || t.vigente) && !t.excluida); // H5
// Pestaña Notas clínicas: resúmenes y notas intercalados por fecha (el resumen, sobre la nota del mismo día).
const itemsNotas = [
  ...iaTarjetas.map((t) => ({ tipo: 'ia' as const, fecha: t.g.session_date, orden: 0, t })),
  ...(notes ?? []).map((n: any) => ({ tipo: 'nota' as const, fecha: String(n.session_date ?? ''), orden: 1, n })),
].sort((a, b) => b.fecha.localeCompare(a.fecha) || a.orden - b.orden);

if (!patient) return Astro.redirect('/admin/pacientes');

// Consentimiento de datos (Ley 21.719): el vigente, o el último envío pendiente.
let { data: consentRows } = await supabase.from('consents').select('*')
  .eq('patient_id', id!).order('created_at', { ascending: false });
if (import.meta.env.DEV && demoIA) {
  // Firmas de prueba (solo `astro dev`): una vigente con grabación y otra con la grabación retirada.
  consentRows = [
    { id: '00000000-0000-4000-8000-0000000000c1', patient_id: id, token: 't1', version: '2026-10-v3', created_at: '2026-10-01T12:00:00Z', signed_at: '2026-10-01T12:05:00Z', signer_name: 'Camila Rojas', signer_rut: '12.345.678-5', accept_treatment: true, accept_recording: true, accept_case_review: false, revoked_at: null, recording_revoked_at: null },
    { id: '00000000-0000-4000-8000-0000000000c2', patient_id: id, token: 't2', version: '2026-10-v2', created_at: '2026-09-20T12:00:00Z', signed_at: '2026-09-20T12:05:00Z', signer_name: 'Tomás Fuentes', signer_rut: '15.555.555-5', accept_treatment: true, accept_recording: true, accept_case_review: true, revoked_at: null, recording_revoked_at: '2026-10-12T15:00:00Z', recording_revoked_via: 'whatsapp' },
  ] as never;
}
const consentimiento = vigente((consentRows ?? []) as ConsentRow[]);
const ultimoRetiro = (consentRows ?? []).find((c: any) => c.revoked_at) as ConsentRow | undefined;
const envioPendiente = (consentRows ?? []).find((c: any) => !c.signed_at && c.sent_at) as ConsentRow | undefined;
const firmadosHist = (consentRows ?? []).filter((c: any) => c.signed_at)
  .sort((a: any, b: any) => b.signed_at.localeCompare(a.signed_at));
const fmtCL = (iso: string) => new Date(iso).toLocaleString('es-CL', { timeZone: 'America/Santiago', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
// H1: firma vigente de CADA persona (en pareja, dos), para retirar solo la grabación de quien lo pidió.
const CANAL_RETIRO: Record<string, string> = { correo: 'correo', whatsapp: 'WhatsApp', presencial: 'en persona', otro: 'otro medio' };
const firmasPersona = (() => {
  const ultimas = new Map<string, any>();
  for (const c of firmadosHist as any[]) {
    const k = identidadFirmante(c);
    if (!ultimas.has(k)) ultimas.set(k, c); // firmadosHist viene de la más reciente a la más antigua
  }
  return [...ultimas.values()].filter((c) => !c.revoked_at);
})();

const tab  = Astro.url.searchParams.get('tab') ?? 'info';
const saved = Astro.url.searchParams.get('saved') === '1';
// Códigos de error que llegan desde acciones de la agenda → texto legible.
const ERRORES_ACCION: Record<string, string> = {
  cambio_servicio: 'No se pudo cambiar el servicio de la sesión. No se le avisó nada a la paciente. Intenta de nuevo.',
  conflict: 'Esa sesión se cruza con otra reserva: no se guardó el cambio.',
  service_not_found: 'No se encontró ese servicio.',
  missing_migration: 'Falta actualizar la base de datos para hacer este cambio.',
  anular_deuda: 'No se pudo anular la deuda. Sigue como pendiente — intenta de nuevo.',
  // Errores que antes volvían como si se hubiera guardado (8 oct 2026).
  invalid_amount: 'El monto no es válido (debe ser un número mayor que 0). No se cambió nada.',
  guardar_reserva: 'No se pudo guardar el cambio en la sesión. No se tocó el calendario ni se avisó a nadie — intenta de nuevo.',
  cancelar: 'No se pudo cancelar la sesión. Sigue agendada — intenta de nuevo.',
  // Estos ya los muestra el AdminLayout arriba: aquí van vacíos para no repetirlos.
  tarifa_guardar: '', rebote_guardar: '', feriado: '',
  insert_failed: 'No se pudo guardar en la base de datos. Intenta de nuevo.',
  boleta_failed: 'El pago se registró, pero la boleta NO se emitió. Emítela manualmente.',
  flow_error: 'No se pudo generar el link de pago. Revisa en la agenda que no hayan quedado sesiones "esperando pago" de este intento antes de reintentar.',
};
const errorCrudo = Astro.url.searchParams.get('error') ?? '';
const errorFicha = ERRORES_ACCION[errorCrudo] ?? errorCrudo;
// Sesión futura pagada por adelantado: la boleta sale sola ese día (8 oct 2026).
const boletaProgramadaParam = Astro.url.searchParams.get('boleta_programada') ?? '';
const boletaProgramadaMsg = /^\d{4}-\d{2}-\d{2}$/.test(boletaProgramadaParam)
  ? `Pago registrado. La boleta se emitirá automáticamente el día de la sesión (${boletaProgramadaParam.slice(8, 10)}-${boletaProgramadaParam.slice(5, 7)}).`
  : '';
const hoyCL = todayCL();

function formatDate(iso: string) {
  return new Date(iso + 'T00:00:00').toLocaleDateString('es-CL', { day:'2-digit', month:'long', year:'numeric' });
}
function formatDateTime(iso: string) {
  return new Date(iso).toLocaleDateString('es-CL', { day:'2-digit', month:'short', year:'numeric' });
}
function age(iso: string | null) {
  if (!iso) return null;
  const d = new Date(iso);
  const today = nowCL();
  let a = today.getFullYear() - d.getFullYear();
  if (today.getMonth() < d.getMonth() || (today.getMonth() === d.getMonth() && today.getDate() < d.getDate())) a--;
  return a;
}
function initials(name: string) {
  return name.split(' ').slice(0,2).map(w => w[0]).join('').toUpperCase();
}

const SESSION_LABELS: Record<string, string> = {
  'online': 'Ind. Online', 'presencial': 'Ind. Presencial',
  'pareja-online': 'Pareja Online', 'pareja-presencial': 'Pareja Presencial',
};

const redirectBase = `/admin/pacientes/${id}`;

// Indexar notas por booking_id (primary) y por session_date como fallback
const notesByBooking: Record<string, any> = {};
const notesByDate: Record<string, any> = {};
(notes ?? []).forEach(n => {
  if (n.booking_id) notesByBooking[n.booking_id] = n;
  // fallback por fecha solo si no hay booking_id
  else if (!notesByDate[n.session_date]) notesByDate[n.session_date] = n;
});

const formatCLP = (n: number) =>
  new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);

// Datos mínimos de la ficha (Valentina, 4 oct 2026): se avisa si faltan.
const sinRutFicha = patient?.sin_rut === true && !patient?.rut;
const faltanDatos = patient ? [
  !patient.email && 'correo',
  !patient.phone && 'teléfono',
  !patient.address && 'dirección',
  !patient.comuna && 'comuna',
  sinRutFicha ? (!patient.doc_numero && 'documento') : (!patient.rut && 'RUT'),
].filter(Boolean) as string[] : [];
---

<AdminLayout title={patient.name} current="/admin/pacientes">

  {saved && !errorFicha && <div class="alert-success">✓ Cambios guardados.</div>}
  {boletaProgramadaMsg && !errorFicha && <div class="alert-success">✓ {boletaProgramadaMsg}</div>}
  {errorFicha && <div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:0.65rem 1rem;border-radius:6px;font-size:0.85rem;margin-bottom:1rem;">✕ {errorFicha}</div>}

  <!-- Header paciente -->
  <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:2rem;flex-wrap:wrap;">
    <div style="display:flex;align-items:center;gap:1rem;">
      <a href="/admin/pacientes" style="color:var(--stone);font-size:0.85rem;text-decoration:none;">← Pacientes</a>
      <div style="width:52px;height:52px;border-radius:50%;background:var(--forest);color:white;display:flex;align-items:center;justify-content:center;font-size:1rem;font-weight:700;flex-shrink:0;">
        {initials(patient.name)}
      </div>
      <div>
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:1.6rem;font-weight:400;">{patient.name}</h2>
        <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.2rem;">
          <span class={`badge ${patient.active ? 'badge-confirmed' : 'badge-cancelled'}`}>
            {patient.active ? 'Activo' : 'Archivado'}
          </span>
          {patient.birthdate && <span style="font-size:0.78rem;color:var(--stone);">{age(patient.birthdate)} años</span>}
          {patient.rut && <span style="font-size:0.78rem;color:var(--stone);">RUT {patient.rut}</span>}
        </div>
      </div>
    </div>

    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
      {patient.phone && (
        <a href={`https://wa.me/${patient.phone.replace(/\D/g,'')}`} target="_blank"
           class="btn btn-outline btn-sm">WhatsApp</a>
      )}
      {patient.email && (
        <>
          <button type="button" class="btn btn-outline btn-sm send-mail-btn"
            data-mail-action="steps" data-email={patient.email} data-name={patient.name}>Pasos a seguir</button>
          <button type="button" class="btn btn-outline btn-sm send-mail-btn"
            data-mail-action="review_request" data-email={patient.email} data-name={patient.name}>Solicitar reseña</button>
        </>
      )}
      <a href={`/admin/pacientes/${patient.id}/certificado`} target="_blank" class="btn btn-outline btn-sm">Certificado</a>
      <span id="mail-status" style="font-size:0.78rem;"></span>
      <button id="open-agenda-modal" class="btn btn-dark btn-sm">+ Agendar sesión</button>
      <form method="POST" action="/api/admin/patients" style="margin:0;">
        <input type="hidden" name="action" value="archive" />
        <input type="hidden" name="id" value={patient.id} />
        <input type="hidden" name="active" value={String(patient.active)} />
        <input type="hidden" name="redirect" value={redirectBase} />
        <button type="submit" class="btn btn-outline btn-sm">
          {patient.active ? 'Archivar' : 'Restaurar'}
        </button>
      </form>
    </div>
  </div>

  <!-- Consentimiento de datos (Ley 21.719) -->
  {consentimiento ? (
    <div id="consentimiento" class="card anclado" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem;border-left:4px solid var(--enc-green-dark);">
      <div style="font-size:0.85rem;">
        <p style="font-weight:600;color:var(--enc-green-dark);">✓ Consentimiento de datos firmado</p>
        <p style="color:var(--stone);font-size:0.78rem;margin-top:0.2rem;">
          {consentimiento.signer_name} · RUT {consentimiento.signer_rut} · {fmtCL(consentimiento.signed_at!)} · versión {consentimiento.version}
        </p>
        <p style="font-size:0.78rem;margin-top:0.35rem;">
          Grabación de sesiones: <strong style={`color:${consentimiento.accept_recording ? 'var(--enc-green-dark)' : 'var(--red)'}`}>{consentimiento.accept_recording ? 'Sí autoriza' : 'NO autoriza — no grabar'}</strong>
          &nbsp;·&nbsp; Revisión anónima con psicólogos: <strong style={`color:${consentimiento.accept_case_review ? 'var(--enc-green-dark)' : 'var(--red)'}`}>{consentimiento.accept_case_review ? 'Sí autoriza' : 'NO autoriza'}</strong>
        </p>
      </div>
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
        <a href={`/admin/pacientes/${patient.id}/consentimiento/${consentimiento.id}`} target="_blank" class="btn btn-outline btn-sm">Ver constancia / PDF</a>
      </div>
    </div>
  ) : (
    <div id="consentimiento" class="card anclado" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem;border-left:4px solid #b45309;background:#fffbeb;">
      <div style="font-size:0.85rem;">
        <p style="font-weight:600;color:#b45309;">⚠ Falta el consentimiento de datos (Ley 21.719)</p>
        <p style="color:var(--stone);font-size:0.78rem;margin-top:0.2rem;">
          {envioPendiente ? `Enviado por ${envioPendiente.sent_via === 'email' ? 'correo' : 'WhatsApp'} el ${fmtCL(envioPendiente.sent_at!)} — aún sin firmar.` : 'Todavía no se le ha enviado.'}
          {ultimoRetiro && ` Retiró su consentimiento anterior el ${fmtCL(ultimoRetiro.revoked_at!)}${ultimoRetiro.revoked_note ? ` (${ultimoRetiro.revoked_note})` : ''}.`}
        </p>
      </div>
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
        <button type="button" class="btn btn-dark btn-sm consent-btn" data-consent-action="whatsapp" disabled={!patient.phone} title={patient.phone ? '' : 'Falta el teléfono en la ficha'}>Enviar por WhatsApp</button>
        <button type="button" class="btn btn-outline btn-sm consent-btn" data-consent-action="email" disabled={!patient.email} title={patient.email ? '' : 'Falta el correo en la ficha'}>Enviar por correo</button>
        <button type="button" class="btn btn-outline btn-sm consent-btn" data-consent-action="link">Copiar link</button>
      </div>
    </div>
  )}
  {firmadosHist.length > 0 && (
    <details style="margin:-0.75rem 0 1.5rem;font-size:0.78rem;color:var(--stone);">
      <summary style="cursor:pointer;">Historial de consentimientos firmados ({firmadosHist.length})</summary>
      <ul style="margin:0.4rem 0 0 1.1rem;">
        {firmadosHist.map((c: any) => (
          <li style="margin:0.2rem 0;">
            {fmtCL(c.signed_at)} · {c.signer_name} · versión {c.version} · {c.revoked_at ? `retirado el ${fmtCL(c.revoked_at)}` : 'vigente'} ·{' '}
            <a href={`/admin/pacientes/${patient.id}/consentimiento/${c.id}`} target="_blank" style="color:var(--enc-blue-dark);">ver constancia</a>
          </li>
        ))}
      </ul>
    </details>
  )}
  {firmasPersona.length > 0 && (
    <section class="card firmas-persona" aria-labelledby="firmas-persona-titulo">
      <p id="firmas-persona-titulo" class="fp-titulo">Autorizaciones por persona</p>
      <ul class="fp-lista">
        {firmasPersona.map((c: any) => {
          const nombre = String(c.signer_name ?? '').trim() || 'Sin nombre';
          const pila = nombre.split(/\s+/)[0];
          const grabacionRetirada = !!c.recording_revoked_at;
          return (
            <li class="fp-item" data-consent-id={c.id}>
              <div class="fp-datos">
                <p class="fp-nombre">{nombre}</p>
                <p class="fp-sub">Versión {c.version} · firmado el {fmtCL(c.signed_at)}</p>
                <p class="fp-sub">
                  Grabación:{' '}
                  {grabacionRetirada
                    ? <strong class="fp-no">retirada el {fmtCL(c.recording_revoked_at)}{c.recording_revoked_via ? ` (por ${CANAL_RETIRO[c.recording_revoked_via] ?? c.recording_revoked_via})` : ''}</strong>
                    : c.accept_recording ? <strong class="fp-si">sí autoriza</strong> : <strong class="fp-no">no autoriza</strong>}
                </p>
              </div>
              <div class="fp-botones">
                {c.accept_recording && !grabacionRetirada && (
                  <button type="button" class="btn btn-outline btn-sm fp-abrir" data-panel={`fp-grab-${c.id}`}>Retirar solo la grabación</button>
                )}
                <button type="button" class="btn btn-outline btn-sm fp-abrir" data-panel={`fp-todo-${c.id}`}>Registrar retiro del consentimiento</button>
              </div>
              {c.accept_recording && !grabacionRetirada && (
                <div class="fp-confirmar" id={`fp-grab-${c.id}`} hidden>
                  <p class="fp-texto">Desde ahora no se graban las sesiones de {pila}. Lo ya transcrito queda en la ficha con la misma confidencialidad. Su consentimiento para la atención sigue vigente.</p>
                  <label class="fp-label" for={`fp-via-${c.id}`}>¿Cómo lo pidió?</label>
                  <select id={`fp-via-${c.id}`} class="fp-via">
                    <option value="">Elige…</option>
                    <option value="whatsapp">WhatsApp</option>
                    <option value="correo">Correo</option>
                    <option value="presencial">En persona</option>
                    <option value="otro">Otro</option>
                  </select>
                  <label class="fp-label" for={`fp-nota-${c.id}`}>Nota (opcional: cuándo y qué pidió)</label>
                  <input id={`fp-nota-${c.id}`} class="fp-nota" type="text" maxlength="500" />
                  <div class="fp-acciones">
                    <button type="button" class="btn btn-dark btn-sm fp-enviar" data-accion="revoke_recording" data-consent-id={c.id}>Confirmar: retirar solo la grabación</button>
                    <button type="button" class="btn btn-outline btn-sm fp-cancelar">Cancelar</button>
                  </div>
                </div>
              )}
              <div class="fp-confirmar" id={`fp-todo-${c.id}`} hidden>
                <p class="fp-texto">Se registra que {pila} retiró su consentimiento de datos completo (atención, grabación y revisión de casos). Lo hecho antes no cambia. Si solo pidió dejar de grabar, usa "Retirar solo la grabación".</p>
                <label class="fp-label" for={`fp-notatodo-${c.id}`}>Nota (opcional: cómo y cuándo lo pidió)</label>
                <input id={`fp-notatodo-${c.id}`} class="fp-nota" type="text" maxlength="500" />
                <div class="fp-acciones">
                  <button type="button" class="btn btn-danger btn-sm fp-enviar" data-accion="revoke" data-consent-id={c.id}>Confirmar retiro del consentimiento</button>
                  <button type="button" class="btn btn-outline btn-sm fp-cancelar">Cancelar</button>
                </div>
              </div>
              <p class="fp-msg" role="status" aria-live="polite"></p>
            </li>
          );
        })}
      </ul>
    </section>
  )}
  <p id="consent-status" data-patient-id={patient.id} style="font-size:0.78rem;margin:-1rem 0 1rem;"></p>

  <!-- Tabs -->
  <div class="patient-tabs" style="display:flex;gap:0;border-bottom:2px solid var(--dust);margin-bottom:1.75rem;">
    {[
      { key: 'info',     label: 'Información' },
      { key: 'sesiones', label: `Sesiones (${patientBookings.length})` },
      { key: 'notas',    label: `Notas clínicas (${notes?.length ?? 0})` },
    ].map(t => (
      <a href={`${redirectBase}?tab=${t.key}`}
         style={`padding:0.6rem 1.25rem;font-size:0.8rem;letter-spacing:0.06em;text-transform:uppercase;font-weight:600;text-decoration:none;border-bottom:2px solid ${tab===t.key ? 'var(--ink)' : 'transparent'};color:${tab===t.key ? 'var(--ink)' : 'var(--stone)'};margin-bottom:-2px;transition:color .15s;`}>
        {t.label}
      </a>
    ))}
  </div>

  <!-- ── TAB: INFORMACIÓN ────────────────────────────────────────────────────── -->
  {tab === 'info' && (
    <div style="max-width:580px;">
      {faltanDatos.length > 0 && (
        <p style="background:#fef3c7;border:1px solid #fcd34d;color:#92400e;border-radius:6px;padding:0.6rem 0.85rem;font-size:0.82rem;margin:0 0 1rem;">
          Faltan datos de la ficha: {faltanDatos.join(', ')}.
        </p>
      )}
      <form method="POST" action="/api/admin/patients" style="display:flex;flex-direction:column;gap:1.25rem;">
        <input type="hidden" name="action" value="update" />
        <input type="hidden" name="id" value={patient.id} />
        <input type="hidden" name="redirect" value={`${redirectBase}?tab=info&saved=1`} />

        <div class="card">
          <p class="label" style="margin-bottom:1.25rem;">Datos personales</p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div style="grid-column:1/-1;">
              <label class="label" style="display:block;margin-bottom:0.3rem;">Nombre completo *</label>
              <input type="text" name="name" value={patient.name} required />
            </div>
            <div>
              <label class="label" style="display:block;margin-bottom:0.3rem;">Email</label>
              <input type="email" id="email" class="anclado" name="email" value={patient.email ?? ''} />
            </div>
            <div>
              <label class="label" style="display:block;margin-bottom:0.3rem;">Teléfono</label>
              <input type="tel" name="phone" data-validar-telefono value={patient.phone ?? ''} />
            </div>
            <div>
              <label class="label" style="display:block;margin-bottom:0.3rem;">RUT</label>
              <input type="text" name="rut" id="pf-rut" data-rut maxlength="12" value={patient.rut ?? ''} placeholder="12.345.678-9" disabled={patient.sin_rut === true && !patient.rut} />
              <label style="display:flex;align-items:center;gap:0.4rem;margin-top:0.4rem;font-size:0.78rem;color:var(--stone);cursor:pointer;">
                <input type="checkbox" name="sin_rut" id="pf-sin-rut" value="1" checked={patient.sin_rut === true && !patient.rut} style="width:auto;" /> No tiene RUT (extranjera/o)
              </label>
            </div>
            <div>
              <label class="label" style="display:block;margin-bottom:0.3rem;">Fecha de nacimiento</label>
              <input type="date" name="birthdate" value={patient.birthdate ?? ''} />
            </div>
            <div id="pf-doc" style={`grid-column:1/-1;display:${patient.sin_rut === true && !patient.rut ? 'grid' : 'none'};grid-template-columns:1fr 1fr 1fr;gap:1rem;`}>
              <div>
                <label class="label" style="display:block;margin-bottom:0.3rem;">Documento</label>
                <select name="doc_tipo">
                  {['Pasaporte', 'Documento de identidad', 'Otro'].map((t) => <option selected={patient.doc_tipo === t}>{t}</option>)}
                </select>
              </div>
              <div>
                <label class="label" style="display:block;margin-bottom:0.3rem;">Número</label>
                <input type="text" name="doc_numero" value={patient.doc_numero ?? ''} />
              </div>
              <div>
                <label class="label" style="display:block;margin-bottom:0.3rem;">País</label>
                <input type="text" name="doc_pais" value={patient.doc_pais ?? ''} />
              </div>
            </div>
            <div>
              <label class="label" style="display:block;margin-bottom:0.3rem;">Dirección</label>
              <input type="text" name="address" value={patient.address ?? ''} />
            </div>
            <div>
              <label class="label" style="display:block;margin-bottom:0.3rem;">Comuna</label>
              <input type="text" name="comuna" value={patient.comuna ?? ''} />
            </div>
          </div>
        </div>

        <div class="card">
          <p class="label" style="margin-bottom:1.25rem;">Contacto de emergencia</p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div>
              <label class="label" style="display:block;margin-bottom:0.3rem;">Nombre</label>
              <input type="text" name="emergency_name" value={patient.emergency_name ?? ''} />
            </div>
            <div>
              <label class="label" style="display:block;margin-bottom:0.3rem;">Teléfono</label>
              <input type="tel" name="emergency_phone" data-validar-telefono value={patient.emergency_phone ?? ''} />
            </div>
          </div>
        </div>

        <div class="card">
          <p class="label" style="margin-bottom:1rem;">Notas generales</p>
          <textarea name="notes" rows="5" placeholder="Motivo de consulta, antecedentes relevantes, observaciones generales..."
            style="resize:vertical;">{patient.notes ?? ''}</textarea>
        </div>

        <button type="submit" class="btn btn-dark btn-lg" style="width:100%;justify-content:center;">
          Guardar cambios
        </button>
      </form>
    </div>
  )}

  <!-- ── TAB: SESIONES ──────────────────────────────────────────────────────── -->
  {tab === 'sesiones' && (
    <div>
      {!patientBookings.length ? (
        <div class="card" style="text-align:center;padding:3rem;">
          <p style="color:var(--stone);font-size:0.9rem;margin-bottom:1rem;">No hay sesiones registradas.</p>
          <a href="/admin/agenda" class="btn btn-dark btn-sm">Agendar sesión</a>
        </div>
      ) : (
        <div style="display:flex;flex-direction:column;gap:0.75rem;">
          {patientBookings.map((b, i) => {
            const nota = notesByBooking[b.id] ?? notesByDate[b.session_date] ?? null;
            const badgeClass = b.status === 'confirmed' ? 'badge-confirmed' : b.status === 'cancelled' ? 'badge-cancelled' : 'badge-pending';
            const badgeLabel = b.status === 'confirmed' ? 'Confirmada' : b.status === 'cancelled' ? 'Cancelada' : 'Pendiente';
            // Toma la ÚLTIMA línea "Boleta Folio N..." (por si se anuló y se
            // volvió a emitir) — mismo criterio que ya usa el panel del
            // calendario, para que ambas pantallas muestren lo mismo.
            const boletaLines  = [...(b.notes ?? '').matchAll(/Boleta\s+Folio\s+(\d+)[^\n]*/gi)];
            const lastBoleta   = boletaLines.length ? boletaLines[boletaLines.length - 1] : null;
            const boletaFolio  = lastBoleta ? lastBoleta[1] : null;
            const boletaAnulada = lastBoleta ? /ANULADA/i.test(lastBoleta[0]) : false;
            // Pagada por adelantado y sin boleta: sale sola el día de la sesión (8 oct 2026).
            const boletaProgramada = !boletaFolio && !!b.paid_at && /BoletaProgramada/.test(b.notes ?? '')
              && b.session_date !== '2099-12-31' && b.session_date > hoyCL;
            // Estado de pago real, separado del estado de la reserva (ver migración
            // 0001, sección 5): una reserva puede estar "Confirmada" sin haber sido
            // pagada todavía (ej. "Pago en consulta").
            const isPaid     = !!b.paid_at;
            const isVoided    = !!b.debt_voided;
            // CORREGIDO: una reserva cancelada mostraba igual el badge "Por
            // pagar" y los botones de cobro/boleta, como si todavía se le
            // debiera esa sesión — una sesión cancelada no se cobra, punto.
            const isCancelled = b.status === 'cancelled';
            const payBadgeClass = isVoided ? 'badge-cancelled' : isPaid ? 'badge-confirmed' : 'badge-pending';
            const payBadgeLabel = isVoided ? 'Deuda anulada' : isPaid ? (b.payment_note ? `Pagado · ${b.payment_note}` : 'Pagado') : 'Por pagar';
            return (
              <div id={`s-${b.id}`} class="card anclado" style="padding:0;overflow:hidden;">
                <div style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;gap:1rem;flex-wrap:wrap;">
                  <div style="display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;">
                    <div>
                      {b.session_date === '2099-12-31' ? (
                        <>
                          <p style="font-weight:600;font-size:0.9rem;">Cobro manual</p>
                          <p style="font-size:0.78rem;color:var(--stone);">Sin fecha de sesión · {b.custom_title || (SESSION_LABELS[b.session_type] ?? b.session_type)}</p>
                        </>
                      ) : (
                        <>
                          <p style="font-weight:600;font-size:0.9rem;">{formatDate(b.session_date)}</p>
                          <p style="font-size:0.78rem;color:var(--stone);">{b.session_time.slice(0,5)} · {b.custom_title || (SESSION_LABELS[b.session_type] ?? b.session_type)}</p>
                        </>
                      )}
                      {origenTexto(b.origen) && <p style="font-size:0.72rem;color:var(--stone);margin-top:0.15rem;">Origen: {origenTexto(b.origen)}</p>}
                    </div>
                    <button type="button" class="btn-rename-session" data-bid={b.id} data-title={b.custom_title ?? ''} title="Cambiar nombre de la sesión"
                      style="background:none;border:none;cursor:pointer;color:var(--stone);padding:2px;">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    </button>
                    <span class={`badge ${badgeClass}`}>{badgeLabel}</span>
                    {!isCancelled && <span class={`badge ${payBadgeClass}`}>{payBadgeLabel}</span>}
                    {iaPorBooking.has(b.id) && (
                      <a href={`${redirectBase}?tab=notas#ia-${iaPorBooking.get(b.id)!.g.id}`} class="badge ia-badge-sesion"
                        title="Esta sesión se grabó. Ver el resumen automático en Notas clínicas.">
                        {iaPorBooking.get(b.id)!.vigente ? 'Grabada · resumen IA' : 'Grabada · ' + iaPorBooking.get(b.id)!.estado.texto.toLowerCase()}
                      </a>
                    )}
                    {(b.notes ?? '').includes('ComprobanteTransferencia') && (
                      <a href={`/api/admin/comprobante?b=${b.id}`} target="_blank" rel="noopener" class="btn btn-outline btn-sm">
                        {isPaid ? 'Ver comprobante' : 'Comprobante por confirmar'}
                      </a>
                    )}
                    <span style="font-size:0.82rem;color:var(--stone);display:flex;align-items:center;gap:0.2rem;">
                      {formatCLP(b.amount)}
                      <button type="button" class="btn-edit-amount" data-bid={b.id} data-amount={b.amount} title="Editar monto"
                        style="background:none;border:none;cursor:pointer;color:var(--stone);padding:2px;">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                      </button>
                    </span>
                  </div>
                  <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                    <span class="bol-status" data-bid={b.id} style="font-size:0.75rem;"></span>
                    {boletaFolio && !boletaAnulada ? (
                      <>
                        <span class="badge badge-confirmed">✓ Boleta {boletaFolio}</span>
                        <button type="button" class="btn btn-outline btn-sm bol-pdf" data-bid={b.id}>PDF</button>
                        <button type="button" class="btn btn-outline btn-sm bol-email" data-bid={b.id}>Email</button>
                        <select class="bol-causal" data-bid={b.id} style="font-size:0.75rem;padding:0.3rem 0.4rem;">
                          <option value="error_digitacion">Error en la digitación</option>
                          <option value="no_pago">No se efectuó el pago</option>
                          <option value="no_prestacion">No se efectuó la prestación de servicios</option>
                        </select>
                        <button type="button" class="btn btn-outline btn-sm bol-anular" data-bid={b.id} style="color:#b45309;">
                          Anular boleta
                        </button>
                      </>
                    ) : boletaFolio && boletaAnulada ? (
                      <>
                        <span class="badge badge-cancelled">✕ Boleta {boletaFolio} anulada</span>
                        {isPaid && (
                          <button type="button" class="btn btn-outline btn-sm bol-emitir" data-bid={b.id} data-rut={patient.rut ?? (sinRutFicha ? '44444446-0' : '')}>
                            Emitir nueva boleta
                          </button>
                        )}
                      </>
                    ) : boletaProgramada ? (
                      <span class="badge badge-pending" title="La boleta se emite el día de la sesión, con esa fecha.">🗓 Boleta el {b.session_date.slice(8, 10)}-{b.session_date.slice(5, 7)}</span>
                    ) : isPaid ? (
                      <button type="button" class="btn btn-outline btn-sm bol-emitir" data-bid={b.id} data-rut={patient.rut ?? (sinRutFicha ? '44444446-0' : '')}>
                        Emitir boleta
                      </button>
                    ) : null}
                    {!isPaid && !isVoided && !isCancelled && (
                      <>
                        <button type="button" class="btn btn-outline btn-sm"
                          onclick={`toggleNota('pay-${i}')`}>💰 Marcar pagado</button>
                        {/* Separado de "Marcar pagado" (auditoría 15 oct 2026): a la derecha de la fila, para no apretarlo por error. Pide confirmación. */}
                        <button type="button" class="btn btn-outline btn-sm btn-void-debt" data-bid={b.id}
                          style="color:var(--stone);margin-left:auto;order:99;">Anular deuda</button>
                      </>
                    )}
                    {!isCancelled && b.session_date !== '2099-12-31' && b.patient_email && (
                      <>
                        <button type="button" class="btn btn-outline btn-sm resend-mail" data-action="confirmation" data-bid={b.id}
                          title="Reenviar el correo de confirmación de esta sesión">✉ Confirmación</button>
                        <button type="button" class="btn btn-outline btn-sm resend-mail" data-action="reminder" data-bid={b.id}
                          title="Enviar el recordatorio de esta sesión">✉ Recordatorio</button>
                        <button type="button" class="btn btn-outline btn-sm resend-mail" data-action="steps" data-bid={b.id}
                          title="Enviar el correo de pasos a seguir">✉ Pasos</button>
                      </>
                    )}
                    {!isCancelled && (
                      <select class="chg-svc-select" data-bid={b.id} title="Cambiar el servicio agendado"
                        style="font-size:0.75rem;padding:0.3rem 0.4rem;max-width:180px;">
                        <option value="">Cambiar servicio…</option>
                        {allServices.map((s: any) => <option value={s.id} selected={s.id === b.service_id}>{s.name}</option>)}
                      </select>
                    )}
                    <button type="button" class="btn btn-outline btn-sm"
                      onclick={`toggleNota('nota-${i}')`}
                      style={nota ? 'border-color:var(--forest);color:var(--forest);' : ''}>
                      {nota ? '📝 Ver nota' : '+ Agregar nota'}
                    </button>
                  </div>
                </div>

                {!isPaid && !isVoided && (
                  <div id={`pay-${i}`} style="display:none;border-top:1px solid var(--warm);background:var(--sand);padding:1rem 1.25rem;">
                    <form method="POST" action="/api/admin/bookings" style="margin:0;display:flex;align-items:flex-end;gap:0.75rem;flex-wrap:wrap;">
                      <input type="hidden" name="action" value="mark_paid" />
                      <input type="hidden" name="id" value={b.id} />
                      <input type="hidden" name="redirect" value={`${redirectBase}?tab=sesiones`} />
                      <input type="hidden" name="rut" value={patient.rut ?? ''} />
                      <div class="bp-field" style="margin:0;">
                        <label style="font-size:0.68rem;">Medio de pago</label>
                        <select name="medio">
                          <option value="Efectivo">Efectivo</option>
                          <option value="Transferencia">Transferencia</option>
                          <option value="Tarjeta">Tarjeta (fuera de Flow)</option>
                          <option value="Otro">Otro</option>
                        </select>
                      </div>
                      <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.78rem;cursor:pointer;">
                        <input type="checkbox" name="emitir_boleta" />
                        Emitir y enviar boleta
                      </label>
                      <button type="submit" class="btn btn-dark btn-sm">✓ Marcar como pagado</button>
                    </form>
                  </div>
                )}

                <div id={`nota-${i}`} style="display:none;border-top:1px solid var(--warm);background:var(--sand);padding:1.25rem;">
                  {nota ? (
                    <div>
                      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;">
                        <p class="label">Nota de evolución</p>
                        <div style="display:flex;gap:0.5rem;">
                          <button type="button" class="btn btn-outline btn-sm"
                            onclick={`toggleEdit('edit-${i}','view-${i}')`}>Editar</button>
                          <form method="POST" action="/api/admin/patients" style="margin:0;">
                            <input type="hidden" name="action" value="delete_note" />
                            <input type="hidden" name="id" value={nota.id} />
                            <input type="hidden" name="redirect" value={`${redirectBase}?tab=sesiones`} />
                            <button type="submit" class="btn btn-danger btn-sm"
                              onclick="return confirm('¿Archivar esta nota? Deja de verse en la ficha, pero se conserva (la ficha clínica se guarda 15 años).')">Archivar</button>
                          </form>
                        </div>
                      </div>
                      <div id={`view-${i}`}>
                        <p style="font-size:0.88rem;line-height:1.7;white-space:pre-wrap;color:var(--ink);">{nota.content}</p>
                      </div>
                      <form id={`edit-${i}`} method="POST" action="/api/admin/patients" style="display:none;flex-direction:column;gap:0.75rem;">
                        <input type="hidden" name="action" value="update_note" />
                        <input type="hidden" name="id" value={nota.id} />
                        <input type="hidden" name="redirect" value={`${redirectBase}?tab=sesiones`} />
                        <textarea name="content" rows="5" style="resize:vertical;">{nota.content}</textarea>
                        <div style="display:flex;gap:0.5rem;">
                          <button type="submit" class="btn btn-dark btn-sm">Guardar</button>
                          <button type="button" class="btn btn-outline btn-sm"
                            onclick={`toggleEdit('edit-${i}','view-${i}')`}>Cancelar</button>
                        </div>
                      </form>
                    </div>
                  ) : (
                    <form method="POST" action="/api/admin/patients" style="display:flex;flex-direction:column;gap:0.75rem;">
                      <input type="hidden" name="action" value="add_note" />
                      <input type="hidden" name="patient_id" value={patient.id} />
                      <input type="hidden" name="booking_id" value={b.id} />
                      <input type="hidden" name="session_date" value={b.session_date} />
                      <input type="hidden" name="session_type" value={b.session_type} />
                      <input type="hidden" name="redirect" value={`${redirectBase}?tab=sesiones`} />
                      <p class="label" style="margin-bottom:0.25rem;">Nota de evolución</p>
                      <textarea name="content" rows="5" required
                        placeholder="Describe la evolución del paciente, temas trabajados, tareas asignadas..."
                        style="resize:vertical;background:white;"></textarea>
                      <button type="submit" class="btn btn-dark btn-sm" style="width:fit-content;">
                        Guardar nota
                      </button>
                    </form>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  )}

  <!-- ── TAB: NOTAS CLÍNICAS ────────────────────────────────────────────────── -->
  {tab === 'notas' && (
    <div class="notas-grid">

      <!-- Lista: notas de Vale + resúmenes automáticos (IA) intercalados por fecha.
           El resumen va SOBRE la nota de esa fecha y en tarjeta propia: nunca se mezclan. -->
      <div style="display:flex;flex-direction:column;gap:1rem;min-width:0;">
        {!itemsNotas.length ? (
          <div class="card" style="text-align:center;padding:3rem;">
            <p style="color:var(--stone);font-size:0.9rem;">Sin notas clínicas aún.</p>
          </div>
        ) : itemsNotas.map(it => it.tipo === 'ia' ? (
          <article id={`ia-${it.t.g.id}`} class={`card ia-card anclado${it.t.vigente ? '' : ' ia-card-gris'}`} aria-label={`Resumen automático (IA) del ${fechaLarga(it.t.g.session_date)}`}>
            <div class="ia-cab">
              <span class="ia-badge"><span aria-hidden="true">✦</span> {it.t.vigente?.rotulo || ROTULO_RESUMEN}</span>
              {it.t.estado.tono !== 'listo' && <span class={`ia-estado ia-estado-${it.t.estado.tono}`}>{it.t.estado.texto}</span>}
            </div>
            <p class="ia-fecha">{fechaLarga(it.t.g.session_date)}{it.t.hora ? ` · ${it.t.hora}` : ''}</p>
            <p class="ia-sub">{tipoTexto(it.t.g)}{it.t.g.duracion_seg ? ` · ${duracionTexto(it.t.g.duracion_seg)} grabados` : ''}{it.t.vigente && it.t.vigente.version > 1 ? ` · versión ${it.t.vigente.version}` : ''}</p>
            {it.t.vigente && !it.t.html && iaAvisoResumenes ? (
              <p class="ia-texto">{iaAvisoResumenes}</p>
            ) : it.t.vigente ? (
              <div class="ia-cuerpo" set:html={it.t.html} />
            ) : it.t.problema ? (
              <p class="ia-texto">{it.t.problema}</p>
            ) : (
              <p class="ia-texto">Resumen automático (IA): en proceso. Aparecerá aquí solo.</p>
            )}
            {it.t.vigente && it.t.problema && <p class="ia-nota">{it.t.problema}</p>}
            {it.t.generando && it.t.vigente && <p class="ia-nota">Se está escribiendo una versión nueva; esta sigue visible mientras tanto.</p>}
            {it.t.g.nota_sistema && <p class="ia-nota">{it.t.g.nota_sistema}</p>}
            {it.t.excluida && <p class="ia-nota">Excluida de las preguntas a la IA a pedido del paciente.</p>}
            {it.t.vigente && <p class="ia-aviso">{it.t.aviso}</p>}
            <div class="ia-acciones">
              {it.t.transcrita && (
                <a class="btn btn-outline btn-sm" href={`/admin/pacientes/${patient.id}/sesion/${it.t.g.id}`}>Ver transcripción</a>
              )}
              {it.t.vigente && it.t.texto && (
                <button type="button" class="btn btn-outline btn-sm ia-copiar" data-texto={it.t.texto} data-fecha={it.t.g.session_date}
                  data-tipo={it.t.g.tipo === 'pareja' ? `pareja-${it.t.g.origen}` : it.t.g.origen}>Copiar a mi nota</button>
              )}
              {it.t.reintentable && (
                <button type="button" class="btn btn-outline btn-sm ia-reintentar" data-gid={it.t.g.id}>Reintentar</button>
              )}
              <span class="ia-msg" data-gid={it.t.g.id} role="status" aria-live="polite"></span>
            </div>
          </article>
        ) : (
          <div class="card">
            <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:0.75rem;">
              <div>
                <p style="font-weight:600;font-size:0.9rem;">{formatDate(it.n.session_date)}</p>
                {it.n.session_type && (
                  <span style="font-size:0.72rem;background:var(--warm);color:var(--stone);padding:0.15rem 0.5rem;border-radius:99px;">
                    {SESSION_LABELS[it.n.session_type] ?? it.n.session_type}
                  </span>
                )}
              </div>
              <form method="POST" action="/api/admin/patients" style="margin:0;">
                <input type="hidden" name="action" value="delete_note" />
                <input type="hidden" name="id" value={it.n.id} />
                <input type="hidden" name="redirect" value={`${redirectBase}?tab=notas`} />
                <button type="submit" class="btn btn-danger btn-sm"
                  onclick="return confirm('¿Archivar esta nota? Deja de verse en la ficha, pero se conserva (la ficha clínica se guarda 15 años).')" title="Archivar">✕</button>
              </form>
            </div>
            <p style="font-size:0.88rem;line-height:1.7;color:var(--ink);white-space:pre-wrap;">{it.n.content}</p>
          </div>
        ))}
      </div>

      <div class="notas-lateral">
      <!-- Agregar nota -->
      <div class="card" id="nueva-nota">
        <p class="label" style="margin-bottom:1.25rem;">+ Nueva nota</p>
        <form method="POST" action="/api/admin/patients" style="display:flex;flex-direction:column;gap:1rem;">
          <input type="hidden" name="action" value="add_note" />
          <input type="hidden" name="patient_id" value={patient.id} />
          <input type="hidden" name="redirect" value={`${redirectBase}?tab=notas`} />

          <div>
            <label class="label" style="display:block;margin-bottom:0.3rem;">Fecha de sesión</label>
            <input type="date" name="session_date" id="nueva-nota-fecha"
              value={nowCL().toISOString().slice(0,10)} required />
          </div>
          <div>
            <label class="label" style="display:block;margin-bottom:0.3rem;">Tipo de sesión</label>
            <select name="session_type" id="nueva-nota-tipo">
              <option value="">— Sin especificar</option>
              <option value="presencial">Ind. Presencial</option>
              <option value="online">Ind. Online</option>
              <option value="pareja-presencial">Pareja Presencial</option>
              <option value="pareja-online">Pareja Online</option>
            </select>
          </div>
          <div>
            <label class="label" style="display:block;margin-bottom:0.3rem;">Notas de sesión</label>
            <textarea name="content" id="nueva-nota-content" rows="8" required
              placeholder="Temas abordados, evolución del paciente, tareas asignadas..."
              style="resize:vertical;"></textarea>
          </div>
          <button type="submit" class="btn btn-dark" style="width:100%;justify-content:center;">
            Guardar nota
          </button>
        </form>
      </div>

      {iaTarjetas.length > 0 && (
        <section class="card ia-preguntar" id="preguntar-ia" data-patient-id={patient.id}
          data-sesiones={JSON.stringify(iaConsultables.map((t) => ({ id: t.g.id, fecha: fechaCorta(t.g.session_date) })))}>
          <p class="ia-preg-titulo">Preguntar a la IA</p>
          <p class="ia-sub" style="margin-bottom:0.85rem;">Sobre las sesiones grabadas de {patient.name}</p>
          {iaConsultables.length ? (
            <div style="display:flex;flex-direction:column;gap:0.6rem;">
              <div>
                <label class="label" for="ia-alcance" style="display:block;margin-bottom:0.3rem;">Sesiones</label>
                <select id="ia-alcance">
                  <option value="todas">Todas las sesiones ({iaConsultables.length})</option>
                  {iaConsultables.length > 1 && <option value="ultima">Solo la última</option>}
                  {iaConsultables.map((t) => <option value={t.g.id}>Sesión del {fechaCorta(t.g.session_date)}</option>)}
                </select>
              </div>
              <div>
                <label class="label" for="ia-pregunta" style="display:block;margin-bottom:0.3rem;">Tu pregunta</label>
                <textarea id="ia-pregunta" rows="3" maxlength="4000" style="resize:vertical;"
                  placeholder="Ej.: ¿Qué dijo sobre su mamá en las últimas sesiones?"></textarea>
              </div>
              <div class="ia-chips" aria-label="Ideas de preguntas">
                {['¿Qué tareas quedaron pendientes?', '¿Cómo ha cambiado el sueño?', 'Temas que se repiten'].map((c) => (
                  <button type="button" class="ia-chip" data-pregunta={c}>{c}</button>
                ))}
              </div>
              <button type="button" id="ia-preguntar-btn" class="btn btn-dark" style="width:100%;justify-content:center;">Preguntar</button>
              <p id="ia-preg-estado" class="ia-sub" role="status" aria-live="polite"></p>
              <div id="ia-respuesta" class="ia-respuesta" hidden>
                <p class="label" style="margin-bottom:0.35rem;"><span aria-hidden="true">✦</span> Respuesta generada por IA</p>
                <div id="ia-respuesta-texto" class="ia-respuesta-texto"></div>
                <p id="ia-respuesta-extra" class="ia-sub" style="margin-top:0.5rem;"></p>
                <p class="ia-aviso">{AVISO_RESPUESTA}</p>
              </div>
            </div>
          ) : (
            <p class="ia-texto">Aún no hay sesiones grabadas listas de este paciente.</p>
          )}
        </section>
      )}
      </div>

    </div>
  )}

  {tab === 'notas' && (
    <script>
      // En celular el formulario queda abajo (después de las notas y resúmenes): enfocarlo
      // saltaría la página hasta el final y abriría el teclado. Solo en pantallas anchas o
      // si se llegó con #nueva-nota (botón "Escribir evolución" de la agenda).
      if (location.hash === '#nueva-nota' || window.matchMedia('(min-width: 901px)').matches) {
        document.getElementById('nueva-nota-content')?.focus();
      }
    </script>
  )}

</AdminLayout>

<!-- Modal agendar sesión para este paciente -->
<div id="modal-agenda" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:100;align-items:center;justify-content:center;padding:1rem;">
  <div style="background:white;width:100%;max-width:460px;max-height:90vh;overflow-y:auto;padding:2rem;border-radius:6px;">

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;">
      <div>
        <p style="font-family:'Cormorant Garamond',serif;font-size:1.3rem;">Nueva sesión</p>
        <p style="font-size:0.82rem;color:var(--stone);">{patient.name}</p>
      </div>
      <button id="close-agenda-modal" style="background:none;border:none;font-size:1.4rem;cursor:pointer;color:var(--stone);">✕</button>
    </div>

    <form method="POST" action="/api/admin/bookings" style="display:flex;flex-direction:column;gap:1rem;" id="pt-bp-form">
      <input type="hidden" name="action" value="create-admin" />
      <input type="hidden" name="patient_id" value={patient.id} />
      <input type="hidden" name="redirect" value={`${redirectBase}?tab=sesiones&saved=1`} />

      <div>
        <label class="label" style="display:block;margin-bottom:0.3rem;">Servicio</label>
        <select name="service_id" id="pt-bp-service" required>
          <option value="">Selecciona un servicio...</option>
          {allServices.map((s: any) => (
            <option
              value={s.id}
              data-price={s.price}
              data-price-online={s.price_online ?? s.price}
              data-price-pres={s.price_presencial ?? s.price}
              data-modality={s.modality}
            >
              {s.name}
            </option>
          ))}
        </select>
      </div>

      <!-- Modalidad (solo si el servicio permite ambas) -->
      <div id="pt-bp-modality-row" style="display:none;">
        <label class="label" style="display:block;margin-bottom:0.3rem;">Modalidad</label>
        <label style="margin-right:1rem;font-size:0.85rem;">
          <input type="radio" name="modality_choice" value="presencial" id="pt-bp-mod-pres" checked /> Presencial
        </label>
        <label style="font-size:0.85rem;">
          <input type="radio" name="modality_choice" value="online" id="pt-bp-mod-online" /> Online
        </label>
      </div>

      <div>
        <label class="label" style="display:block;margin-bottom:0.3rem;">Fecha</label>
        <input type="date" name="session_date" id="agenda-date" required
          min={nowCL().toISOString().slice(0,10)} />
      </div>

      <div>
        <label class="label" style="display:block;margin-bottom:0.3rem;">Hora</label>
        <select name="session_time" id="agenda-time-select" required>
          <option value="">— Elige una fecha primero</option>
          <option value="custom">— Horario personalizado</option>
        </select>
        <p id="slots-loading" style="display:none;font-size:0.75rem;color:var(--stone);margin-top:0.3rem;">Cargando horarios...</p>
      </div>

      <div id="custom-time-wrap" style="display:none;">
        <label class="label" style="display:block;margin-bottom:0.3rem;">Horario personalizado</label>
        <input type="time" name="session_time_custom" id="pt-bp-custom-time" step="300" />
      </div>

      <div id="pt-bp-price" style="font-size:0.82rem;color:var(--stone);"></div>

      <div>
        <label class="label" style="display:block;margin-bottom:0.3rem;">Precio manual (opcional — en blanco usa el precio del servicio)</label>
        <input type="number" name="amount_override" min="0" step="1" placeholder="Ej: 65000" />
      </div>

      <!-- Modo de pago: el fix — antes esta ficha SIEMPRE creaba la sesión como
           "pago en consulta" sin dar la opción de enviar un link de pago (Flow,
           por correo y WhatsApp si está conectado), a diferencia del panel del
           calendario. Ahora usa el mismo action=create-admin que el calendario,
           que ya soporta ambos modos. -->
      <div>
        <label class="label" style="display:block;margin-bottom:0.3rem;">Pago</label>
        <label style="margin-right:1rem;font-size:0.85rem;">
          <input type="radio" name="payment_mode" value="manual" checked /> Pago en consulta
        </label>
        <label style="font-size:0.85rem;">
          <input type="radio" name="payment_mode" value="link" /> Enviar link de pago
        </label>
        <p style="font-size:0.72rem;color:var(--stone);margin-top:0.35rem;">
          "En consulta" confirma la cita de inmediato. "Link de pago" la deja pendiente y le envía al paciente
          un enlace de Flow por correo (y por WhatsApp si ya lo conectaste en Configuración).
        </p>
      </div>

      <div>
        <label class="label" style="display:block;margin-bottom:0.5rem;">Comunicaciones al paciente</label>
        <label style="display:flex;align-items:flex-start;gap:0.5rem;font-size:0.82rem;margin-bottom:0.4rem;">
          <input type="checkbox" name="send_confirmation" value="on" checked style="margin-top:0.2rem;" />
          <span>Enviar correo de confirmación</span>
        </label>
        <label style="display:flex;align-items:flex-start;gap:0.5rem;font-size:0.82rem;margin-bottom:0.4rem;">
          <input type="checkbox" name="reminder_email_enabled" value="on" checked style="margin-top:0.2rem;" />
          <span>Correo de recordatorio (el día anterior)</span>
        </label>
        <label style="display:flex;align-items:flex-start;gap:0.5rem;font-size:0.82rem;margin-bottom:0.4rem;">
          <input type="checkbox" name="whatsapp_reminder_enabled" value="on" style="margin-top:0.2rem;" />
          <span>WhatsApp de recordatorio (4 h antes) — requiere WhatsApp conectado</span>
        </label>
        <label style="display:flex;align-items:flex-start;gap:0.5rem;font-size:0.82rem;margin-bottom:0.4rem;">
          <input type="checkbox" name="evaluation_email_enabled" value="on" style="margin-top:0.2rem;" />
          <span>Correo de evaluación al terminar la sesión</span>
        </label>
        <label style="display:flex;align-items:flex-start;gap:0.5rem;font-size:0.82rem;">
          <input type="checkbox" name="review_email_enabled" value="on" style="margin-top:0.2rem;" />
          <span>Solicitud de reseña de Google al terminar</span>
        </label>
      </div>

      <div>
        <label class="label" style="display:block;margin-bottom:0.3rem;">Notas (opcional)</label>
        <textarea name="notes" rows="2" placeholder="Motivo, observaciones..."></textarea>
      </div>

      <button type="submit" class="btn btn-dark" style="width:100%;justify-content:center;margin-top:0.5rem;">
        Agendar sesión
      </button>
    </form>
  </div>
</div>

<style>
  /* Enlaces directos desde el Inicio del panel (#consentimiento, #s-<sesión>, #email):
     el elemento queda bajo la barra superior fija y se resalta un momento. */
  .anclado { scroll-margin-top: 72px; }
  .anclado:target { outline: 3px solid #4f5ce8; outline-offset: 2px; animation: anclaPulso 2.4s ease-out 1; }
  @keyframes anclaPulso { 0% { box-shadow: 0 0 0 8px rgba(79,92,232,.25); } 100% { box-shadow: 0 0 0 0 rgba(79,92,232,0); } }

  /* ── Notas clínicas: lista + columna lateral (una sola columna en celular) ── */
  .notas-grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 1.5rem; align-items: start; }
  .notas-lateral { position: sticky; top: 90px; display: flex; flex-direction: column; gap: 1rem; max-height: calc(100vh - 110px); overflow-y: auto; }
  @media (max-width: 900px) {
    .notas-grid { grid-template-columns: minmax(0, 1fr); }
    .notas-lateral { position: static; max-height: none; overflow: visible; }
  }

  /* ── Resumen automático (IA): anexo con rótulo dorado oscuro #7A6544 (5,57:1 sobre blanco);
     el dorado de marca #A8906C solo como borde. "Atención" se ve igual que las demás secciones. */
  .ia-card { border-left: 4px solid #A8906C; background: #fffdf9; }
  .ia-card-gris { background: var(--warm); border-left-color: #d9cdb8; }
  .ia-cab { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; justify-content: space-between; }
  .ia-badge { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.74rem; font-weight: 700; color: #7A6544; background: #f7f1e6; border: 1px solid #e6d9c2; border-radius: 99px; padding: 0.18rem 0.65rem; line-height: 1.35; }
  .ia-estado { font-size: 0.72rem; font-weight: 600; border-radius: 99px; padding: 0.15rem 0.6rem; border: 1px solid; }
  .ia-estado-proceso, .ia-estado-neutro { color: #374151; background: #f3f4f6; border-color: #e5e7eb; }
  .ia-estado-problema { color: #92400e; background: #fffbeb; border-color: #fcd34d; }
  .ia-fecha { font-weight: 600; font-size: 0.9rem; margin-top: 0.65rem; }
  .ia-fecha::first-letter { text-transform: uppercase; }
  .ia-sub { font-size: 0.78rem; color: var(--stone); }
  .ia-texto { font-size: 0.86rem; color: var(--ink); margin-top: 0.6rem; line-height: 1.55; }
  .ia-nota { font-size: 0.78rem; color: var(--stone); margin-top: 0.6rem; }
  .ia-cuerpo { font-size: 0.88rem; line-height: 1.65; color: var(--ink); margin-top: 0.4rem; overflow-wrap: anywhere; }
  .ia-cuerpo :global(h4) { font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--stone); font-weight: 600; margin: 0.95rem 0 0.25rem; }
  .ia-cuerpo :global(ul) { padding-left: 1.15rem; list-style: disc; }
  .ia-cuerpo :global(li) { margin: 0.15rem 0; }
  .ia-cuerpo :global(p) { margin: 0.3rem 0; }
  .ia-cuerpo :global(p.ia-meta) { font-size: 0.76rem; color: var(--stone); font-style: italic; }
  .ia-cuerpo :global(a.ia-min) { color: #576352; font-weight: 600; text-decoration: underline; white-space: nowrap; }
  .ia-aviso { font-size: 0.75rem; color: var(--stone); border-top: 1px solid var(--warm); margin-top: 0.85rem; padding-top: 0.6rem; }
  /* H1: autorizaciones por persona */
  .firmas-persona { margin: -0.75rem 0 1.5rem; padding: 1rem 1.1rem; }
  .fp-titulo { font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; color: var(--stone); margin-bottom: 0.6rem; }
  .fp-lista { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .fp-item { display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: flex-start; justify-content: space-between; border-top: 1px solid var(--warm); padding-top: 0.75rem; }
  .fp-item:first-child { border-top: 0; padding-top: 0; }
  .fp-datos { min-width: 0; flex: 1 1 14rem; }
  .fp-nombre { font-weight: 600; font-size: 0.88rem; overflow-wrap: anywhere; }
  .fp-sub { font-size: 0.78rem; color: var(--stone); margin-top: 0.15rem; }
  .fp-si { color: var(--enc-green-dark); }
  .fp-no { color: var(--red); }
  .fp-botones { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .fp-confirmar { flex: 1 1 100%; background: #fffbeb; border-left: 3px solid #b45309; padding: 0.75rem 0.85rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .fp-confirmar[hidden] { display: none; }
  .fp-texto { font-size: 0.82rem; line-height: 1.5; color: var(--ink); }
  .fp-label { font-size: 0.75rem; color: var(--stone); margin-top: 0.2rem; }
  .fp-via, .fp-nota { width: 100%; max-width: 26rem; font-size: 0.85rem; }
  .fp-acciones { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.3rem; }
  .fp-msg { flex: 1 1 100%; font-size: 0.78rem; }
  .fp-msg:empty { display: none; }
  .ia-acciones { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; align-items: center; }
  .ia-msg { font-size: 0.78rem; }
  .ia-badge-sesion { color: #7A6544 !important; border-color: #e6d9c2 !important; background: #f7f1e6 !important; text-decoration: none; }
  .ia-preg-titulo { font-weight: 700; font-size: 1rem; }
  .ia-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .ia-chip { border: 1px solid var(--dust); background: var(--sand); border-radius: 99px; padding: 0.35rem 0.75rem; font-size: 0.76rem; color: var(--ink); cursor: pointer; font-family: inherit; text-align: left; }
  .ia-chip:hover { border-color: #A8906C; }
  .ia-respuesta { background: var(--sand); border: 1px solid var(--dust); border-radius: 8px; padding: 0.8rem; }
  .ia-respuesta-texto { font-size: 0.86rem; line-height: 1.6; color: var(--ink); overflow-wrap: anywhere; }
  .ia-respuesta-texto :global(ul) { padding-left: 1.1rem; list-style: disc; }
  .ia-respuesta-texto :global(p) { margin: 0.3rem 0; }
  .ia-respuesta-texto :global(a) { color: #576352; font-weight: 600; text-decoration: underline; }
  @media (max-width: 600px) {
    .ia-acciones .btn, .ia-chip { min-height: 40px; }
    .patient-tabs { overflow-x: auto; }
    .patient-tabs a { white-space: nowrap; padding-left: 0.75rem !important; padding-right: 0.75rem !important; }
  }
</style>

<script>
  // ── Boletas de honorarios (emitir / PDF / email) ──────────────────────────
  function bolStatus(bid, text, color) {
    const el = document.querySelector(`.bol-status[data-bid="${bid}"]`);
    if (el) { el.textContent = text; el.style.color = color; }
  }
  async function bolPost(payload) {
    const res = await fetch('/api/admin/apigateway', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
    });
    return res.json();
  }
  document.addEventListener('click', async (e) => {
    const emitir = e.target.closest('.bol-emitir');
    const pdf    = e.target.closest('.bol-pdf');
    const email  = e.target.closest('.bol-email');
    const anular = e.target.closest('.bol-anular');

    if (anular) {
      const bid = anular.dataset.bid;
      const causalSel = document.querySelector(`.bol-causal[data-bid="${bid}"]`);
      const causal = causalSel ? causalSel.value : 'error_digitacion';
      if (!confirm('¿Anular esta boleta de honorarios? Se anula el documento en el SII — esta acción no se puede deshacer. Después podrás emitir una nueva si corresponde.')) return;
      anular.disabled = true; bolStatus(bid, 'Anulando…', '#6b7280');
      try {
        const d = await bolPost({ action: 'anular', booking_id: bid, causal });
        if (d.ok) { bolStatus(bid, `✕ Boleta anulada (Folio ${d.folio ?? ''})`, '#b45309'); setTimeout(() => location.reload(), 900); }
        else { bolStatus(bid, '✕ ' + (d.error ?? 'No se pudo anular'), '#dc2626'); anular.disabled = false; }
      } catch { bolStatus(bid, '✕ Error de conexión', '#dc2626'); anular.disabled = false; }
    }

    if (emitir) {
      const bid = emitir.dataset.bid, rut = emitir.dataset.rut;
      if (!rut) { bolStatus(bid, 'Falta el RUT del paciente en su ficha.', '#dc2626'); return; }
      if (!confirm('¿Emitir la boleta de honorarios? Genera un documento tributario real en el SII.')) return;
      emitir.disabled = true; bolStatus(bid, 'Emitiendo…', '#6b7280');
      try {
        let d = await bolPost({ action: 'emitir', booking_id: bid, rut });
        // Emisión anterior interrumpida: solo se reemite si Valentina confirma
        // que revisó en el SII y no quedó emitida (evita boleta doble).
        if (!d.ok && /se interrumpió/.test(d.error ?? '') &&
            confirm('Una emisión anterior de esta boleta se interrumpió.\n\n¿Revisaste en el SII y la boleta NO está emitida? Aceptar emite una boleta nueva.')) {
          d = await bolPost({ action: 'emitir', booking_id: bid, rut, forzar: true });
        }
        if (d.ok && d.programada) {
          // Sesión futura: no se emitió aún, sale sola el día de la sesión (8 oct 2026).
          bolStatus(bid, `🗓 ${d.mensaje}`, '#1d4ed8');
        }
        else if (d.ok) {
          if (d.enviada) { bolStatus(bid, `✓ Emitida (Folio ${d.folio ?? ''}) y enviada a ${d.enviadaA}`, '#15803d'); setTimeout(() => location.reload(), 2500); }
          else { bolStatus(bid, `⚠ Emitida (Folio ${d.folio ?? ''}) pero el correo no salió: ${d.errorEnvio ?? 'error'}. Se reintentará solo.`, '#b45309'); }
        }
        else { bolStatus(bid, '✕ ' + (d.error ?? 'Error'), '#dc2626'); emitir.disabled = false; }
      } catch { bolStatus(bid, '✕ Error de conexión', '#dc2626'); emitir.disabled = false; }
    }

    if (pdf) {
      const bid = pdf.dataset.bid;
      bolStatus(bid, 'Generando PDF…', '#6b7280');
      try {
        const d = await bolPost({ action: 'pdf', booking_id: bid });
        if (d.ok && d.pdf) {
          const bytes = Uint8Array.from(atob(d.pdf), c => c.charCodeAt(0));
          const url = URL.createObjectURL(new Blob([bytes], { type: 'application/pdf' }));
          const a = document.createElement('a'); a.href = url; a.download = `boleta-${d.folio ?? 'honorarios'}.pdf`;
          document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
          bolStatus(bid, '✓ PDF descargado', '#15803d');
        } else { bolStatus(bid, '✕ ' + (d.error ?? 'Sin PDF'), '#dc2626'); }
      } catch { bolStatus(bid, '✕ Error', '#dc2626'); }
    }

    if (email) {
      const bid = email.dataset.bid;
      bolStatus(bid, 'Enviando email…', '#6b7280');
      try {
        const d = await bolPost({ action: 'email', booking_id: bid });
        if (d.ok) bolStatus(bid, `✓ Enviada a ${d.email}`, '#15803d');
        else bolStatus(bid, '✕ ' + (d.error ?? 'No enviada'), '#dc2626');
      } catch { bolStatus(bid, '✕ Error', '#dc2626'); }
    }
  });

  // ── Reenviar correos por sesión (confirmación / recordatorio / pasos) ───────
  const MAIL_LABELS = { confirmation: 'confirmación', reminder: 'recordatorio', steps: 'pasos a seguir' };
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.resend-mail');
    if (!btn) return;
    const bid = btn.dataset.bid;
    const act = btn.dataset.action;
    const label = MAIL_LABELS[act] ?? 'correo';
    if (!confirm(`¿Enviar el correo de ${label} de esta sesión al paciente?`)) return;
    btn.disabled = true;
    bolStatus(bid, 'Enviando…', '#6b7280');
    try {
      const res = await fetch('/api/admin/send-email', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: act, booking_id: bid }),
      });
      const d = await res.json();
      if (d.ok) bolStatus(bid, `✓ Correo de ${label} enviado`, '#15803d');
      else bolStatus(bid, '✕ ' + (d.error ?? 'No enviado'), '#dc2626');
    } catch {
      bolStatus(bid, '✕ Error de conexión', '#dc2626');
    } finally {
      btn.disabled = false;
    }
  });

  // ── Anular deuda ────────────────────────────────────────────────────────────
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.btn-void-debt');
    if (!btn) return;
    if (!confirm('¿Anular la deuda de esta sesión? No se marcará como pagada, solo dejará de aparecer como pendiente de cobro.')) return;
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/api/admin/bookings';
    form.innerHTML = `
      <input type="hidden" name="action" value="void_debt">
      <input type="hidden" name="id" value="${btn.dataset.bid}">
      <input type="hidden" name="redirect" value="${window.location.pathname}?tab=sesiones">
    `;
    document.body.appendChild(form);
    form.submit();
  });

  function submitBookingAction(fields) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/api/admin/bookings';
    form.innerHTML = Object.entries({ ...fields, redirect: `${window.location.pathname}?tab=sesiones` })
      .map(([k, v]) => `<input type="hidden" name="${k}" value="${String(v).replace(/"/g, '&quot;')}">`)
      .join('');
    document.body.appendChild(form);
    form.submit();
  }

  // ── Renombrar sesión / editar monto / cambiar servicio ─────────────────────
  document.addEventListener('click', (e) => {
    const renameBtn = e.target.closest('.btn-rename-session');
    if (renameBtn) {
      const title = prompt('Nombre de la sesión:', renameBtn.dataset.title || '');
      if (title === null) return;
      submitBookingAction({ action: 'rename_session', id: renameBtn.dataset.bid, title: title.trim() });
      return;
    }
    const amountBtn = e.target.closest('.btn-edit-amount');
    if (amountBtn) {
      const input = prompt('Nuevo monto (CLP):', amountBtn.dataset.amount || '');
      if (input === null) return;
      const amount = parseInt(input.replace(/\D/g, ''));
      if (isNaN(amount) || amount <= 0) { alert('Monto inválido.'); return; }
      submitBookingAction({ action: 'update_amount', id: amountBtn.dataset.bid, amount });
    }
  });
  document.addEventListener('change', (e) => {
    const select = e.target.closest('.chg-svc-select');
    if (!select || !select.value) return;
    if (!confirm('¿Cambiar el servicio de esta sesión? El monto se actualizará al precio del nuevo servicio y se avisará al paciente por correo.')) {
      select.selectedIndex = 0;
      return;
    }
    submitBookingAction({ action: 'change_service', id: select.dataset.bid, service_id: select.value });
  });

  // ── H1: retiro por persona (solo grabación, o consentimiento completo). Confirmación escrita en la página. ──
  document.addEventListener('click', async (e) => {
    const t = e.target;
    const abrir = t.closest('.fp-abrir');
    if (abrir) {
      const item = abrir.closest('.fp-item');
      item.querySelectorAll('.fp-confirmar').forEach((p) => { p.hidden = p.id !== abrir.dataset.panel || !p.hidden; });
      const abierto = document.getElementById(abrir.dataset.panel);
      if (abierto && !abierto.hidden) abierto.querySelector('select, input')?.focus();
      return;
    }
    if (t.closest('.fp-cancelar')) { t.closest('.fp-confirmar').hidden = true; return; }
    const enviar = t.closest('.fp-enviar');
    if (!enviar) return;
    const item = enviar.closest('.fp-item');
    const panel = enviar.closest('.fp-confirmar');
    const msg = item.querySelector('.fp-msg');
    const pinta = (txt, color) => { msg.textContent = txt; msg.style.color = color; };
    const accion = enviar.dataset.accion;
    const body = { action: accion, patient_id: document.getElementById('consent-status')?.dataset.patientId, consent_id: enviar.dataset.consentId, note: panel.querySelector('.fp-nota')?.value ?? '' };
    if (accion === 'revoke_recording') {
      body.via = panel.querySelector('.fp-via')?.value ?? '';
      if (!body.via) { pinta('Indica cómo lo pidió.', '#dc2626'); panel.querySelector('.fp-via')?.focus(); return; }
    }
    enviar.disabled = true;
    pinta('Guardando…', '#6b7280');
    try {
      const res = await fetch('/api/admin/consent', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const d = await res.json();
      if (!d.ok) throw new Error(d.error ?? 'No se pudo registrar.');
      pinta(accion === 'revoke_recording' ? '✓ Retiro de la grabación registrado.' : '✓ Retiro registrado.', '#15803d');
      setTimeout(() => location.reload(), 900);
    } catch (err) {
      pinta('✕ ' + (err instanceof Error ? err.message : 'Error de conexión'), '#dc2626');
      enviar.disabled = false;
    }
  });

  // ── Consentimiento de datos: enviar (WhatsApp / correo / link) ──
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.consent-btn');
    if (!btn) return;
    const action = btn.dataset.consentAction;
    const status = document.getElementById('consent-status');
    const setStatus = (t, c) => { if (status) { status.textContent = t; status.style.color = c; } };
    const body = { action, patient_id: status?.dataset.patientId };

    if (action === 'email' && !confirm('¿Enviar el consentimiento por correo al paciente?')) return;
    // La ventana de WhatsApp se abre antes del fetch: si se abre después, el
    // navegador la bloquea como popup.
    const waWin = action === 'whatsapp' ? window.open('about:blank', '_blank') : null;
    btn.disabled = true;
    setStatus('Procesando…', '#6b7280');
    try {
      const res = await fetch('/api/admin/consent', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
      });
      const d = await res.json();
      if (!d.ok) throw new Error(d.error ?? 'No se pudo completar.');
      if (action === 'whatsapp') {
        if (waWin) waWin.location.href = d.waUrl; else window.open(d.waUrl, '_blank');
        setStatus('✓ WhatsApp abierto con el mensaje listo — solo apreta enviar.', '#15803d');
      } else if (action === 'email') {
        setStatus('✓ Correo enviado.', '#15803d');
        setTimeout(() => location.reload(), 1200);
      } else if (action === 'link') {
        try { await navigator.clipboard.writeText(d.url); setStatus('✓ Link copiado: ' + d.url, '#15803d'); }
        catch { prompt('Copia este link:', d.url); setStatus('', ''); }
      } else {
        location.reload();
      }
    } catch (err) {
      if (waWin) waWin.close();
      setStatus('✕ ' + (err instanceof Error ? err.message : 'Error de conexión'), '#dc2626');
    } finally {
      btn.disabled = false;
    }
  });

  // ── Correos al paciente: pasos a seguir / solicitud de reseña ──────────────
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.send-mail-btn');
    if (!btn) return;
    const action = btn.dataset.mailAction;
    const status = document.getElementById('mail-status');
    const labels = { steps: 'pasos a seguir', review_request: 'solicitud de reseña' };
    const setStatus = (t, c) => { if (status) { status.textContent = t; status.style.color = c; } };

    if (!confirm(`¿Enviar el correo de "${labels[action]}" a ${btn.dataset.email}?`)) return;
    btn.disabled = true;
    setStatus('Enviando…', '#6b7280');
    try {
      const res = await fetch('/api/admin/send-email', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, email: btn.dataset.email, name: btn.dataset.name }),
      });
      const d = await res.json();
      if (d.ok) setStatus(`✓ Correo enviado a ${btn.dataset.email}`, '#15803d');
      else setStatus('✕ ' + (d.error ?? 'No se pudo enviar'), '#dc2626');
    } catch {
      setStatus('✕ Error de conexión', '#dc2626');
    } finally {
      btn.disabled = false;
    }
  });

  // Exponer funciones globalmente para que funcionen en onclick=""
  window.toggleNota = function(id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.style.display = el.style.display === 'none' ? 'block' : 'none';
  };

  window.toggleEdit = function(editId, viewId) {
    const edit = document.getElementById(editId);
    const view = document.getElementById(viewId);
    if (!edit || !view) return;
    const isEditing = edit.style.display !== 'none';
    edit.style.display = isEditing ? 'none' : 'flex';
    view.style.display = isEditing ? 'block' : 'none';
  };

  const agendaModal  = document.getElementById('modal-agenda');
  const openAgenda   = document.getElementById('open-agenda-modal');
  const closeAgenda  = document.getElementById('close-agenda-modal');
  const agendaDate   = document.getElementById('agenda-date');
  const agendaSelect = document.getElementById('agenda-time-select');
  const customWrap   = document.getElementById('custom-time-wrap');
  const slotsLoading = document.getElementById('slots-loading');

  const closeAgendaFn = () => { agendaModal.style.display = 'none'; document.body.style.overflow = ''; };
  openAgenda?.addEventListener('click', () => { agendaModal.style.display = 'flex'; document.body.style.overflow = 'hidden'; });
  closeAgenda?.addEventListener('click', closeAgendaFn);
  agendaModal?.addEventListener('click', e => { if (e.target === agendaModal) closeAgendaFn(); });

  // Cargar slots disponibles al elegir fecha
  agendaDate?.addEventListener('change', async () => {
    const date = agendaDate.value;
    if (!date) return;
    slotsLoading.style.display = 'block';
    agendaSelect.innerHTML = '<option value="">Cargando...</option>';
    try {
      const res   = await fetch(`/api/availability?date=${date}`);
      const data  = await res.json();
      const slots = data.slots ?? [];
      agendaSelect.innerHTML = slots.length
        ? slots.map(t => `<option value="${t}">${t}</option>`).join('')
        : '<option value="">Sin horarios disponibles</option>';
      agendaSelect.innerHTML += '<option value="custom">— Horario personalizado</option>';
    } catch {
      agendaSelect.innerHTML = '<option value="custom">— Horario personalizado</option>';
    }
    slotsLoading.style.display = 'none';
  });

  agendaSelect?.addEventListener('change', () => {
    customWrap.style.display = agendaSelect.value === 'custom' ? 'block' : 'none';
  });

  // ── Servicio → mostrar selector de modalidad + precio de referencia ─────────
  const ptSvcSel   = document.getElementById('pt-bp-service');
  const ptModRow   = document.getElementById('pt-bp-modality-row');
  const ptPriceBox = document.getElementById('pt-bp-price');
  function ptUpdatePrice() {
    const opt = ptSvcSel?.selectedOptions[0];
    if (!ptPriceBox) return;
    if (!opt || !opt.value) { ptPriceBox.textContent = ''; return; }
    const modality = opt.dataset.modality;
    let price;
    if (modality === 'ambos') {
      const isOnline = document.getElementById('pt-bp-mod-online')?.checked;
      price = parseInt(isOnline ? (opt.dataset.priceOnline || opt.dataset.price) : (opt.dataset.pricePres || opt.dataset.price));
    } else {
      price = parseInt(opt.dataset.price || '0');
    }
    ptPriceBox.textContent = isNaN(price) ? '' : `Precio de referencia: $${price.toLocaleString('es-CL')}`;
  }
  ptSvcSel?.addEventListener('change', () => {
    const opt = ptSvcSel.selectedOptions[0];
    if (ptModRow) ptModRow.style.display = opt?.dataset.modality === 'ambos' ? 'block' : 'none';
    ptUpdatePrice();
  });
  document.querySelectorAll('input[name="modality_choice"]').forEach(r => r.addEventListener('change', ptUpdatePrice));

  // ── Horario personalizado: al enviar, usar el valor real en vez de "custom" ─
  document.getElementById('pt-bp-form')?.addEventListener('submit', (e) => {
    if (agendaSelect?.value === 'custom') {
      const custom = document.getElementById('pt-bp-custom-time');
      if (!custom.value) {
        e.preventDefault();
        alert('Ingresa el horario personalizado.');
        return;
      }
      agendaSelect.removeAttribute('name');
      custom.setAttribute('name', 'session_time');
    }
  });
</script>

<script>
  // "No tiene RUT": se registra el documento de su país en vez del RUT.
  const pfSinRut = document.getElementById('pf-sin-rut') as HTMLInputElement | null;
  pfSinRut?.addEventListener('change', () => {
    const sin = pfSinRut.checked;
    const rut = document.getElementById('pf-rut') as HTMLInputElement;
    rut.disabled = sin;
    (document.getElementById('pf-doc') as HTMLElement).style.display = sin ? 'grid' : 'none';
  });
</script>

<script>
  // ── Transcriptor IA (P7): copiar resumen a la nota, reintentar y preguntar a la IA ──
  // Todo pedido va con X-Panel: 1 (los endpoints del transcriptor lo exigen además de la sesión).
  async function postPanel(url: string, body: unknown): Promise<{ ok: boolean; error?: string; [k: string]: unknown }> {
    const res = await fetch(url, {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'X-Panel': '1' },
      body: JSON.stringify(body),
    });
    try { return await res.json(); } catch { return { ok: false, error: 'Respuesta inesperada del servidor.' }; }
  }
  const msgDe = (gid: string) => document.querySelector<HTMLElement>(`.ia-msg[data-gid="${gid}"]`);

  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;

    // "Copiar a mi nota": pega el resumen (texto plano) en "+ Nueva nota" para que Vale lo edite.
    const copiar = t.closest<HTMLButtonElement>('.ia-copiar');
    if (copiar) {
      const area = document.getElementById('nueva-nota-content') as HTMLTextAreaElement | null;
      if (!area) return;
      const texto = `Basado en el resumen automático (IA) — revisar y editar:\n${copiar.dataset.texto ?? ''}`;
      area.value = area.value.trim() ? `${area.value.trimEnd()}\n\n${texto}` : texto;
      const fecha = document.getElementById('nueva-nota-fecha') as HTMLInputElement | null;
      const tipo = document.getElementById('nueva-nota-tipo') as HTMLSelectElement | null;
      if (fecha && copiar.dataset.fecha) fecha.value = copiar.dataset.fecha;
      if (tipo && copiar.dataset.tipo && [...tipo.options].some((o) => o.value === copiar.dataset.tipo)) tipo.value = copiar.dataset.tipo;
      area.scrollIntoView({ behavior: 'smooth', block: 'center' });
      area.focus({ preventScroll: true });
      return;
    }

    // "Reintentar" una grabación con problema.
    const re = t.closest<HTMLButtonElement>('.ia-reintentar');
    if (re) {
      const gid = re.dataset.gid ?? '';
      const msg = msgDe(gid);
      re.disabled = true;
      if (msg) { msg.textContent = 'Reintentando…'; msg.style.color = '#6b7280'; }
      try {
        const d = await postPanel('/api/admin/transcriptor/reintentar', { grabacion_id: gid });
        if (!d.ok) throw new Error(d.error ?? 'No se pudo reintentar.');
        if (msg) { msg.textContent = '✓ ' + (d.mensaje || 'Se volverá a procesar. Aparecerá aquí solo.'); msg.style.color = '#15803d'; }
        setTimeout(() => location.reload(), 1500);
      } catch (err) {
        if (msg) { msg.textContent = '✕ ' + (err instanceof Error ? err.message : 'Error de conexión'); msg.style.color = '#dc2626'; }
        re.disabled = false;
      }
      return;
    }

    // Ideas rápidas de preguntas.
    const chip = t.closest<HTMLButtonElement>('.ia-chip');
    if (chip) {
      const p = document.getElementById('ia-pregunta') as HTMLTextAreaElement | null;
      if (p) { p.value = chip.dataset.pregunta ?? ''; p.focus(); }
    }
  });

  // ── Preguntar a la IA ────────────────────────────────────────────────────────
  const caja = document.getElementById('preguntar-ia');
  const btn = document.getElementById('ia-preguntar-btn') as HTMLButtonElement | null;
  if (caja && btn) {
    const sesiones: { id: string; fecha: string }[] = JSON.parse(caja.dataset.sesiones || '[]');
    const pid = caja.dataset.patientId ?? '';
    const estado = document.getElementById('ia-preg-estado')!;
    const box = document.getElementById('ia-respuesta')!;
    const salida = document.getElementById('ia-respuesta-texto')!;
    const extra = document.getElementById('ia-respuesta-extra')!;
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    const segs = (m: string) => { const p = m.split(':').map(Number); return p.length === 3 ? p[0] * 3600 + p[1] * 60 + p[2] : p[0] * 60 + p[1]; };

    // Texto de la IA → HTML seguro: se escapa todo y recién después se enlazan las citas
    // "(12 oct 2026, [23:40])" a la transcripción de esa sesión en ese minuto.
    function formatear(texto: string, citadas: { grabacion_id: string; fecha: string }[]): string {
      const porFecha = new Map<string, string>();
      for (const s of [...sesiones.map((x) => ({ grabacion_id: x.id, fecha: x.fecha })), ...citadas]) porFecha.set(s.fecha, s.grabacion_id);
      const enlazar = (l: string) => l
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/\((\d{1,2} [a-z]{3} \d{4}),\s*\[(\d{1,2}:\d{2}(?::\d{2})?)\]\)/g, (todo, fecha: string, marca: string) => {
          const gid = porFecha.get(fecha);
          return gid ? `(<a href="/admin/pacientes/${encodeURIComponent(pid)}/sesion/${encodeURIComponent(gid)}?t=${segs(marca)}">${fecha}, [${marca}]</a>)` : todo;
        });
      const out: string[] = [];
      let lista = false;
      for (const cruda of esc(texto).split('\n')) {
        const l = cruda.trim();
        const v = /^(?:[-*•]|\d{1,2}[.)])\s+(.+)$/.exec(l);
        if (v) { if (!lista) { out.push('<ul>'); lista = true; } out.push(`<li>${enlazar(v[1])}</li>`); continue; }
        if (lista) { out.push('</ul>'); lista = false; }
        if (l) out.push(`<p>${enlazar(l)}</p>`);
      }
      if (lista) out.push('</ul>');
      return out.join('');
    }

    btn.addEventListener('click', async () => {
      const pregunta = (document.getElementById('ia-pregunta') as HTMLTextAreaElement).value.trim();
      const alcance = (document.getElementById('ia-alcance') as HTMLSelectElement).value;
      if (!pregunta) { estado.textContent = 'Escribe una pregunta.'; estado.style.color = '#dc2626'; return; }
      const ids = alcance === 'todas' ? null : alcance === 'ultima' ? [sesiones[0]?.id].filter(Boolean) : [alcance];
      btn.disabled = true;
      box.hidden = true;
      estado.style.color = '';
      estado.textContent = `Buscando en ${ids ? ids.length : sesiones.length} ${(ids ? ids.length : sesiones.length) === 1 ? 'sesión' : 'sesiones'}…`;
      try {
        const d = await postPanel('/api/admin/transcriptor/preguntar', { patient_id: pid, pregunta, ...(ids ? { grabacion_ids: ids } : {}) });
        if (!d.ok) throw new Error(d.error ?? 'No se pudo responder ahora. Intenta de nuevo en un minuto.');
        const citadas = (d.sesiones as { grabacion_id: string; fecha: string }[] | undefined) ?? [];
        salida.innerHTML = formatear(String(d.respuesta ?? ''), citadas);
        const omitidas = (d.omitidas as { fecha: string }[] | undefined) ?? [];
        const notas: string[] = [];
        if (citadas.length) notas.push(`Leyó ${citadas.length} ${citadas.length === 1 ? 'sesión' : 'sesiones'}.`);
        if (omitidas.length) notas.push(`No alcanzaron a entrar: ${omitidas.map((o) => o.fecha).join(', ')}.`);
        if (Number(d.lectura_fallida) > 0) notas.push('Alguna transcripción no se pudo leer; se usó su resumen si lo había.');
        extra.textContent = notas.join(' ');
        box.hidden = false;
        estado.textContent = '';
      } catch (err) {
        estado.textContent = '✕ ' + (err instanceof Error ? err.message : 'No se pudo responder ahora. Intenta de nuevo en un minuto.');
        estado.style.color = '#dc2626';
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
