---
export const prerender = false;
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabase } from '../../lib/supabase';
import { sumupConfigurado } from '../../lib/sumup';
import { CANALES_PANEL } from '../../lib/origen';

// Pacientes activos
const { data: patients } = await supabase
  .from('patients')
  .select('id, name, email, phone')
  .eq('active', true)
  .order('name');

// Servicios visibles
const { data: services } = await supabase
  .from('services_catalog')
  .select('id, name, price, duration_min, type, modality')
  .eq('visible', true)
  .order('sort_order');

// Pre-llenado opcional desde un link "Cobrar" de /admin/deudas (una sesión ya
// confirmada y realizada, pendiente de pago) — solo rellena el formulario,
// no genera nada por sí solo hasta que ella presione "Generar enlace de cobro".
const qp = Astro.url.searchParams;
const prefill = {
  name:  qp.get('name')  ?? '',
  email: qp.get('email') ?? '',
  phone: qp.get('phone') ?? '',
  amount: qp.get('amount') ?? '',
  desc:   qp.get('desc')   ?? '',
  date:   qp.get('date')   ?? '',
  time:   qp.get('time')   ?? '',
  modality: qp.get('modality') === 'online' ? 'online' : 'presencial',
};
const hasPrefill = !!(prefill.name && prefill.amount);
const prefillJson = JSON.stringify(prefill);

// Historial de cobros manuales (últimos 30)
const { data: cobros } = await supabase
  .from('bookings')
  .select('id, patient_name, patient_email, patient_phone, session_type, amount, status, created_at, paid_at, debt_voided')
  .like('notes', 'Cobro manual%')
  .order('created_at', { ascending: false })
  .limit(30);

const formatCLP = (n: number) =>
  new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);

const formatDate = (iso: string) => {
  const d = new Date(iso);
  return d.toLocaleDateString('es-CL', { timeZone: 'America/Santiago', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
};

// Serializar datos para el script
const patientsJson  = JSON.stringify(patients  ?? []);
const servicesJson  = JSON.stringify(services  ?? []);
---

<AdminLayout title="Cobros" current="/admin/cobros">

  <div style="display:grid;grid-template-columns:480px 1fr;gap:2rem;align-items:start;" class="cobros-grid">

    <!-- ── Panel izquierdo: formulario ──────────────────────────────────────── -->
    <div>
      <div class="card">
        <p class="label" style="margin-bottom:1.25rem;">Generar enlace de cobro</p>

        <!-- Toggle paciente registrado / personalizado -->
        <div style="display:flex;gap:0;border:1.5px solid var(--dust);border-radius:var(--radius);overflow:hidden;margin-bottom:1.5rem;">
          <button type="button" id="tab-registrado"
            style="flex:1;padding:0.6rem;font-size:0.78rem;font-family:'Inter',sans-serif;font-weight:600;letter-spacing:0.07em;text-transform:uppercase;border:none;cursor:pointer;transition:all .15s;background:var(--ink);color:white;">
            Paciente registrado
          </button>
          <button type="button" id="tab-personalizado"
            style="flex:1;padding:0.6rem;font-size:0.78rem;font-family:'Inter',sans-serif;font-weight:600;letter-spacing:0.07em;text-transform:uppercase;border:none;cursor:pointer;transition:all .15s;background:white;color:var(--stone);">
            Número personalizado
          </button>
        </div>

        <!-- Sección: paciente registrado -->
        <div id="section-registrado">
          <div style="margin-bottom:1rem;">
            <label class="label" style="display:block;margin-bottom:0.35rem;">Buscar paciente</label>
            <input type="text" id="patient-search" placeholder="Escribe nombre o email..." autocomplete="off" />
            <div id="patient-results"
              style="display:none;position:absolute;z-index:50;background:white;border:1.5px solid var(--dust);border-radius:var(--radius);max-height:200px;overflow-y:auto;box-shadow:var(--shadow);width:100%;max-width:416px;">
            </div>
          </div>
          <!-- Info del paciente seleccionado -->
          <div id="patient-selected" style="display:none;padding:0.75rem 1rem;background:var(--warm);border-radius:var(--radius);margin-bottom:1rem;font-size:0.88rem;">
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <div>
                <strong id="sel-name">—</strong>
                <p style="color:var(--stone);font-size:0.8rem;margin-top:0.15rem;" id="sel-email">—</p>
                <p style="color:var(--stone);font-size:0.8rem;" id="sel-phone">—</p>
              </div>
              <button type="button" id="clear-patient"
                style="background:none;border:none;cursor:pointer;color:var(--stone);font-size:1.1rem;padding:0.25rem;">✕</button>
            </div>
          </div>
        </div>

        <!-- Sección: personalizado -->
        <div id="section-personalizado" style="display:none;">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:1rem;">
            <div style="grid-column:1/-1;">
              <label class="label" style="display:block;margin-bottom:0.35rem;">Nombre completo *</label>
              <input type="text" id="custom-name" placeholder="María González" />
            </div>
            <div style="grid-column:1/-1;min-width:0;">
              <label class="label" style="display:block;margin-bottom:0.35rem;">Email *</label>
              <input type="email" id="custom-email" placeholder="correo@email.com" />
            </div>
            <div style="grid-column:1/-1;min-width:0;">
              <label class="label" style="display:block;margin-bottom:0.35rem;">Teléfono (WhatsApp)</label>
              <input type="tel" id="custom-phone" data-validar-telefono placeholder="+56 9 1234 5678" />
            </div>
          </div>
        </div>

        <!-- Servicio y monto -->
        <div style="margin-bottom:1rem;">
          <label class="label" style="display:block;margin-bottom:0.35rem;">Servicio (opcional)</label>
          <select id="service-select">
            <option value="">— Seleccionar servicio —</option>
            {(services ?? []).map(s => (
              <option value={s.id} data-price={s.price} data-name={s.name} data-duration={s.duration_min} data-type={s.type}>
                {s.name} · {formatCLP(s.price)}
              </option>
            ))}
          </select>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:1rem;">
          <div>
            <label class="label" style="display:block;margin-bottom:0.35rem;">Monto CLP *</label>
            <input type="number" id="cobro-amount" placeholder="55000" min="1000" step="500" />
          </div>
          <div>
            <label class="label" style="display:block;margin-bottom:0.35rem;">Descripción *</label>
            <input type="text" id="cobro-desc" placeholder="Sesión individual" />
          </div>
          <div>
            <label class="label" style="display:block;margin-bottom:0.35rem;">Fecha de sesión *</label>
            <input type="date" id="cobro-date" required />
          </div>
          <div>
            <label class="label" style="display:block;margin-bottom:0.35rem;">Hora de sesión *</label>
            <input type="time" id="cobro-time" step="60" required />
          </div>
          <div style="grid-column:1/-1;">
            <label class="label" style="display:block;margin-bottom:0.5rem;">Modalidad</label>
            <div style="display:flex;gap:0.5rem;">
              <label id="mod-presencial-wrap"
                style="flex:1;display:flex;align-items:center;gap:0.5rem;padding:0.6rem 1rem;border:1.5px solid var(--ink);border-radius:var(--radius);cursor:pointer;font-size:0.88rem;background:var(--ink);color:white;transition:all .15s;">
                <input type="radio" name="modality" id="mod-presencial" value="presencial" checked style="width:auto;accent-color:white;" />
                📍 Presencial
              </label>
              <label id="mod-online-wrap"
                style="flex:1;display:flex;align-items:center;gap:0.5rem;padding:0.6rem 1rem;border:1.5px solid var(--dust);border-radius:var(--radius);cursor:pointer;font-size:0.88rem;background:white;color:var(--stone);transition:all .15s;">
                <input type="radio" name="modality" id="mod-online" value="online" style="width:auto;accent-color:var(--forest);" />
                🎥 Online<span class="cob-meet"> (Google Meet)</span>
              </label>
            </div>
            <p id="meet-hint" style="display:none;font-size:0.76rem;color:var(--forest);margin-top:0.4rem;">
              ✓ Se generará un link de Google Meet automáticamente al completar el pago.
            </p>
          </div>
          <!-- Origen (24 nov 2026): igual que en Agendar hora, para saber de dónde llegó cada sesión cobrada. -->
          <div style="grid-column:1/-1;">
            <label class="label" for="cobro-origen" style="display:block;margin-bottom:0.35rem;">¿De dónde llegó?</label>
            <select id="cobro-origen">
              <option value="">Sin indicar</option>
              {CANALES_PANEL.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>
        </div>

        <!-- Preview mensaje WhatsApp -->
        <div id="wa-preview-wrap" style="display:none;margin-bottom:1.25rem;">
          <label class="label" style="display:block;margin-bottom:0.35rem;">Vista previa del mensaje</label>
          <div id="wa-preview"
            style="background:#e7fdb9;border-radius:8px 8px 8px 0;padding:0.85rem 1rem;font-size:0.84rem;line-height:1.5;color:#111;border:1px solid #c5e896;white-space:pre-wrap;">
          </div>
        </div>

        <!-- Botón generar -->
        <button type="button" id="btn-generar" class="btn btn-dark btn-lg" style="width:100%;justify-content:center;">
          Generar enlace de cobro
        </button>

        <!-- Aviso duplicado -->
        <div id="cobro-warning" style="display:none;background:#fffbeb;border:1px solid #fcd34d;color:#92400e;padding:0.85rem 1rem;border-radius:var(--radius);margin-top:1rem;font-size:0.88rem;">
          <p id="cobro-warning-msg" style="margin-bottom:0.75rem;line-height:1.5;"></p>
          <div style="display:flex;gap:0.5rem;">
            <button type="button" id="btn-forzar" class="btn btn-sm"
              style="background:#92400e!important;border-color:#92400e!important;color:white!important;">
              Enviar igual
            </button>
            <button type="button" id="btn-cancelar-dup" class="btn btn-outline btn-sm">
              Cancelar
            </button>
          </div>
        </div>

        <!-- Error -->
        <div id="cobro-error" style="display:none;" class="alert-error" style="margin-top:1rem;"></div>
      </div>

      <!-- Resultado -->
      <div id="cobro-result" style="display:none;" class="card" style="margin-top:1.25rem;">
        <p class="label" style="margin-bottom:1rem;color:var(--green);">✓ Enlace generado</p>

        <!-- Botón WhatsApp principal -->
        <a id="wa-btn" href="#" target="_blank"
          style="display:flex;align-items:center;justify-content:center;gap:0.6rem;width:100%;padding:0.85rem;background:#25D366;color:white;border-radius:var(--radius);font-family:'Inter',sans-serif;font-size:0.9rem;font-weight:600;letter-spacing:0.04em;text-decoration:none;transition:background .15s;margin-bottom:1rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Enviar por WhatsApp
        </a>

        <div style="display:flex;gap:0.5rem;">
          <input type="text" id="payment-url-input" readonly
            style="flex:1;font-size:0.82rem;color:var(--stone);background:var(--warm);" />
          <button type="button" id="btn-copy"
            class="btn btn-outline btn-sm" style="flex-shrink:0;white-space:nowrap;">
            Copiar URL
          </button>
        </div>

        <!-- Meet link (solo online) -->
        <div id="meet-result" style="display:none;margin-top:0.75rem;padding:0.75rem 1rem;background:#f0fdf4;border:1px solid #86efac;border-radius:var(--radius);font-size:0.85rem;">
          <p style="font-weight:600;color:var(--green);margin-bottom:0.25rem;">🎥 Google Meet generado</p>
          <a id="meet-link-a" href="#" target="_blank" style="color:var(--forest);word-break:break-all;"></a>
        </div>

        <p id="no-wa-msg" style="display:none;font-size:0.8rem;color:var(--stone);margin-top:0.75rem;text-align:center;">
          ⚠️ No hay teléfono asociado. Comparte el enlace de pago manualmente.
        </p>
      </div>
    </div>

    <!-- ── Panel derecho: historial ─────────────────────────────────────────── -->
    <div>
      <!-- Cobros con tarjeta en SumUp (18 nov 2026, src/lib/sumup.ts): cada cobro de la app de SumUp se
           asocia a su sesión (paciente y servicio) y sale la boleta y los correos como con Flow. -->
      {sumupConfigurado() && (<div class="card" id="sumup-card" style="margin-bottom:1.5rem;">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;flex-wrap:wrap;margin-bottom:0.75rem;">
          <p class="label" style="margin:0;">Cobros con tarjeta (SumUp)</p>
          <button type="button" id="sumup-revisar" class="btn btn-outline btn-sm">Revisar cobros ahora</button>
        </div>
        <p style="font-size:0.8rem;color:var(--stone);margin:0 0 0.9rem;">Cobra en la app de SumUp con el monto exacto de la sesión. La página encuentra la sesión sola y emite la boleta con los correos, igual que con Flow. Si hay más de una sesión posible, el cobro aparece aquí para que elijas la sesión. Si ese cobro ya tiene boleta por otro lado, usa "Asociar a un paciente": queda en su sesión sin emitir otra boleta.</p>
        <div id="sumup-estado" style="font-size:0.85rem;color:var(--stone);">Cargando cobros de SumUp…</div>
        <div id="sumup-por-asociar"></div>
        <div id="sumup-recientes"></div>
      </div>)}
      <div class="card" style="padding:0;overflow:hidden;">
        <div style="padding:1.25rem 1.5rem;border-bottom:1px solid var(--dust);display:flex;align-items:center;justify-content:space-between;">
          <p class="label">Historial de cobros</p>
          <span style="font-size:0.8rem;color:var(--stone);">{cobros?.length ?? 0} registros</span>
        </div>

        {!cobros?.length ? (
          <div style="padding:3rem;text-align:center;">
            <p style="color:var(--stone);font-size:0.9rem;">Aún no has generado ningún cobro.</p>
          </div>
        ) : (
          <div style="overflow-x:auto;" class="cob-hist">
            <table>
              <thead>
                <tr>
                  <th>Paciente</th>
                  <th>Descripción</th>
                  <th>Monto</th>
                  <th>Estado</th>
                  <th>Fecha</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {cobros.map(c => {
                  const phone = (c.patient_phone ?? '').replace(/\D/g, '');
                  const waPhone = phone.length === 9 ? '56' + phone : phone;
                  const waUrl = waPhone.length >= 10
                    ? `https://wa.me/${waPhone}`
                    : null;
                  return (
                    <tr>
                      <td>
                        <p style="font-weight:600;font-size:0.88rem;">{c.patient_name}</p>
                        <p style="font-size:0.75rem;color:var(--stone);">{c.patient_email}</p>
                        {c.patient_phone && (
                          <p style="font-size:0.75rem;color:var(--stone);">{c.patient_phone}</p>
                        )}
                      </td>
                      <td data-label="Detalle" style="font-size:0.84rem;color:var(--stone);max-width:160px;">
                        <span style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{c.session_type}</span>
                      </td>
                      <td data-label="Monto" style="font-weight:600;font-size:0.88rem;white-space:nowrap;">{formatCLP(c.amount)}</td>
                      <td data-label="Estado">
                        {/* Según el pago real (paid_at), no el estado: "Anular pago" deja la reserva
                            confirmada sin pago y antes seguía diciendo "Pagado" (auditoría 19 oct 2026). */}
                        {c.status === 'cancelled' ? (
                          <span class="badge badge-cancelled">Cancelado</span>
                        ) : c.paid_at ? (
                          <span class="badge badge-confirmed">Pagado</span>
                        ) : c.debt_voided ? (
                          <span class="badge badge-cancelled">Anulado</span>
                        ) : (
                          <span class="badge badge-pending">Pendiente</span>
                        )}
                      </td>
                      <td data-label="Creado" style="font-size:0.8rem;color:var(--stone);white-space:nowrap;">{formatDate(c.created_at)}</td>
                      <td class="cob-acc">
                        {waUrl ? (
                          <a href={waUrl} target="_blank"
                            style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;background:#25D366;border-radius:50%;color:white;"
                            title="Abrir WhatsApp" class="cob-wa">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                            </svg>
                          </a>
                        ) : (
                          <span style="font-size:0.75rem;color:var(--dust);">—</span>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>

  </div>

</AdminLayout>

<style>
  @media (max-width: 900px) {
    .cobros-grid { grid-template-columns: 1fr !important; }
  }
  /* Celular (rediseño 23 nov 2026): una columna, campos grandes e historial en tarjetas. */
  @media (max-width: 768px) {
    .cobros-grid { grid-template-columns: minmax(0, 1fr) !important; gap: 1rem !important; }
    #tab-registrado, #tab-personalizado { min-height: 48px; font-size: 14px !important; letter-spacing: 0 !important; text-transform: none !important; }
    #mod-presencial-wrap, #mod-online-wrap { min-height: 52px; font-size: 15px !important; padding: 0.5rem 0.6rem !important; }
    .cob-meet { display: none; }
    #btn-generar { min-height: 56px; font-size: 17px !important; }
    #wa-btn { min-height: 56px; font-size: 17px !important; }
    #clear-patient { min-width: 44px; min-height: 44px; }
    #patient-results { max-width: none !important; left: 1rem; right: 1rem; width: auto !important; }
    .cob-hist { overflow: visible !important; padding: 8px 12px; }
    .cob-hist table, .cob-hist tbody, .cob-hist tr, .cob-hist td { display: block; width: 100%; }
    .cob-hist thead { display: none; }
    .cob-hist tr { border-bottom: 1px solid #EEE9E2; padding: 10px 2px; }
    .cob-hist tr:last-child { border-bottom: 0; }
    .cob-hist td { border: 0 !important; padding: 3px 0 !important; font-size: 16px !important; max-width: none !important; display: flex; justify-content: space-between; gap: 12px; }
    .cob-hist td:first-child { display: block; }
    .cob-hist td:first-child p:first-child { font-size: 18px !important; }
    .cob-hist td[data-label]::before { content: attr(data-label); color: #5F5E57; font-size: 14px; font-weight: 600; flex-shrink: 0; }
    .cob-hist td[data-label] > span { white-space: normal !important; text-align: right; }
    .cob-hist td.cob-acc { padding-top: 8px !important; }
    .cob-hist td.cob-acc > span { display: none; }
    .cob-hist a.cob-wa { width: 100% !important; height: 48px !important; border-radius: 12px !important; gap: 8px; font-weight: 700; font-size: 16px; text-decoration: none; }
    .cob-hist a.cob-wa::after { content: 'WhatsApp'; }
  }
  #patient-results { position: absolute; }
</style>


<script>
(function () {
  const $ = (id) => document.getElementById(id);
  if (!$('sumup-card')) return; // SumUp sin conectar: la tarjeta no se muestra
  const SIN_RED = 'No se pudo conectar. Revisa tu internet e intenta de nuevo.';
  const clp = (n) => new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);
  const cuando = (iso) => new Date(iso).toLocaleString('es-CL', { timeZone: 'America/Santiago', weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });
  const fechaSesion = (s) => `${new Date(`${s.session_date}T12:00:00`).toLocaleDateString('es-CL', { weekday: 'long', day: 'numeric', month: 'long' })}, ${String(s.session_time).slice(0, 5)}`;
  const sinTildes = (t) => String(t ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const esc = (t) => String(t ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  let sesiones = [];
  let sesionesPaciente = [];

  async function post(body) {
    const r = await fetch('/api/admin/sumup', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Panel': '1' }, body: JSON.stringify(body) }).catch(() => null);
    if (!r) throw new Error(SIN_RED);
    const d = await r.json().catch(() => ({}));
    if (!r.ok || d.error) throw new Error(d.error || 'No se pudo completar. Intenta de nuevo en un minuto.');
    return d;
  }

  // Sesiones sin pagar que caben en el cobro (una sola del mismo monto, o varias que sumen el monto).
  function opciones(monto) {
    const caben = sesiones.filter((s) => Number(s.amount) <= Number(monto))
      .sort((a, b) => (Number(b.amount) === Number(monto)) - (Number(a.amount) === Number(monto)));
    if (!caben.length) return '<p style="font-size:0.8rem;color:var(--stone);margin:0 0 0.5rem;">No hay sesiones sin pagar de ese monto o menos. Si no es de una sesión, toca "No es de una sesión".</p>';
    return `<div style="max-height:180px;overflow:auto;border:1px solid var(--dust);border-radius:var(--radius);padding:0.4rem 0.6rem;margin-bottom:0.5rem;">${caben.map((s) => `
      <label style="display:flex;gap:0.45rem;align-items:center;font-size:0.82rem;padding:0.2rem 0;cursor:pointer;">
        <input type="checkbox" class="sumup-chk" value="${s.id}" data-monto="${Number(s.amount)}">
        <span>${esc(s.patient_name)} · ${fechaSesion(s)} · ${clp(s.amount)}${Number(s.amount) === Number(monto) ? ' · Mismo monto' : ''}</span>
      </label>`).join('')}</div>`;
  }

  // "Asociar a un paciente" (sin boleta): cualquier sesión de los últimos 60 días, pagada o no. Si el
  // cobro es menor que la sesión, hay que escribir de dónde vino el resto.
  function listaPaciente(c) {
    if (!sesionesPaciente.length) return '<p style="font-size:0.8rem;color:var(--stone);margin:0 0 0.5rem;">No hay sesiones de los últimos 60 días.</p>';
    return `<input type="search" class="sumup-buscar" placeholder="Buscar paciente" style="width:100%;font-size:0.85rem;padding:0.4rem 0.55rem;border:1px solid var(--dust);border-radius:var(--radius);margin-bottom:0.4rem;box-sizing:border-box;">
      <div style="max-height:200px;overflow:auto;border:1px solid var(--dust);border-radius:var(--radius);padding:0.4rem 0.6rem;margin-bottom:0.5rem;">${sesionesPaciente.map((s) => `
        <label class="sumup-op" data-nombre="${esc(sinTildes(s.patient_name))}" style="display:flex;gap:0.45rem;align-items:center;font-size:0.82rem;padding:0.2rem 0;cursor:pointer;">
          <input type="radio" name="sumup-pac-${esc(c.codigo)}" class="sumup-radio" value="${s.id}" data-monto="${Number(s.amount)}" data-pagada="${s.paid_at ? '1' : ''}">
          <span>${esc(s.patient_name)} · ${fechaSesion(s)} · ${clp(s.amount)} · ${s.paid_at ? `Pagada${s.payment_note ? ` (${esc(s.payment_note)})` : ''}` : 'Sin pagar'}</span>
        </label>`).join('')}</div>
      <p class="sumup-pac-info" style="font-size:0.78rem;color:var(--stone);margin:0 0 0.5rem;">Elige la sesión de ese paciente.</p>
      <div class="sumup-resto" hidden style="margin-bottom:0.5rem;">
        <label style="display:block;font-size:0.82rem;margin-bottom:0.3rem;">Faltan <strong class="sumup-falta"></strong>. ¿De dónde vino el resto?</label>
        <input type="text" class="sumup-resto-txt" maxlength="120" placeholder="Transferencia, Encuadrado, efectivo…" style="width:100%;font-size:0.85rem;padding:0.4rem 0.55rem;border:1px solid var(--dust);border-radius:var(--radius);box-sizing:border-box;">
      </div>
      <button type="button" class="btn btn-dark btn-sm sumup-guardar-paciente">Guardar sin boleta</button>`;
  }

  function pintar(d) {
    const estado = $('sumup-estado');
    if (!d.configurado) { estado.textContent = 'SumUp todavía no está conectado en la página.'; return; }
    sesiones = d.sesiones || [];
    sesionesPaciente = d.sesionesPaciente || [];
    const pend = d.porAsociar || [];
    estado.innerHTML = pend.length
      ? `<p style="color:var(--red);font-weight:600;margin:0 0 0.5rem;">${pend.length === 1 ? 'Hay 1 cobro sin sesión asociada' : `Hay ${pend.length} cobros sin sesión asociada`}</p>`
      : '<p style="margin:0 0 0.5rem;">Todos los cobros de SumUp están asociados a su sesión.</p>';
    $('sumup-por-asociar').innerHTML = pend.map((c) => `
      <div class="sumup-pend" data-codigo="${esc(c.codigo)}" data-monto="${Number(c.monto)}" style="border:1px solid var(--dust);border-radius:var(--radius);padding:0.75rem;margin-bottom:0.6rem;">
        <p style="margin:0 0 0.5rem;font-size:0.86rem;"><strong>${clp(c.monto)}</strong> · ${cuando(c.cuando)}${c.tarjeta ? ` · ${esc(c.tarjeta)}` : ''}</p>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
          <button type="button" class="btn btn-outline btn-sm sumup-abrir" data-panel="paciente">Asociar a un paciente</button>
          <button type="button" class="btn btn-outline btn-sm sumup-abrir" data-panel="boleta">Asociar y emitir boleta</button>
          <button type="button" class="btn btn-outline btn-sm sumup-ignorar">No es de una sesión</button>
        </div>
        <div class="sumup-panel" data-panel="paciente" hidden style="margin-top:0.6rem;">
          <p style="font-size:0.8rem;margin:0 0 0.4rem;">Queda en la sesión del paciente sin emitir boleta ni enviar correos.</p>
          ${listaPaciente(c)}
        </div>
        <div class="sumup-panel" data-panel="boleta" hidden style="margin-top:0.6rem;">
          ${opciones(c.monto)}
          <p class="sumup-suma" style="font-size:0.78rem;color:var(--stone);margin:0 0 0.5rem;">Marca la sesión (o las sesiones) que pagó con este cobro.</p>
          <button type="button" class="btn btn-dark btn-sm sumup-asociar">Confirmar y emitir boleta</button>
        </div>
        <p class="sumup-msg" style="font-size:0.78rem;margin:0.4rem 0 0;"></p>
      </div>`).join('');
    const rec = d.recientes || [];
    $('sumup-recientes').innerHTML = rec.length ? `
      <p style="font-size:0.72rem;font-weight:600;letter-spacing:0.07em;text-transform:uppercase;color:var(--stone);margin:1rem 0 0.4rem;">Últimos 14 días</p>
      <ul style="list-style:disc;padding-left:1.1rem;margin:0;font-size:0.82rem;">
        ${rec.map((c) => `<li style="margin-bottom:0.25rem;">${clp(c.monto)} · ${cuando(c.cuando)} · ${
          c.sesiones.length ? `${c.sesiones.length > 1 ? 'Pagó las sesiones de' : 'Pagó la sesión de'} ${c.sesiones.map((s) => `${esc(s.patient_name)} (${fechaSesion(s)})`).join(', ')}`
          : c.sinBoleta && c.sinBoleta.bookingId ? `Asociado a ${esc(c.sinBoleta.patient_name)} (${fechaSesion(c.sinBoleta)}), sin boleta${c.sinBoleta.resto > 0 ? `. Resto (${clp(c.sinBoleta.resto)}): ${esc(c.sinBoleta.origenResto)}` : ''}`
          : c.ignorado ? 'No es de una sesión' : 'Sin sesión asociada'}</li>`).join('')}
      </ul>` : '<p style="font-size:0.82rem;color:var(--stone);margin:0.75rem 0 0;">Sin cobros con tarjeta en los últimos 14 días.</p>';
  }

  async function cargar() {
    try {
      const r = await fetch('/api/admin/sumup').catch(() => null);
      if (!r) throw new Error(SIN_RED);
      const d = await r.json().catch(() => ({}));
      if (!r.ok || d.error) throw new Error(d.error || 'No se pudo leer SumUp. Intenta de nuevo en un minuto.');
      pintar(d);
    } catch (e) { $('sumup-estado').textContent = e.message; }
  }

  $('sumup-card').addEventListener('click', async (ev) => {
    const btn = ev.target.closest('button');
    if (!btn) return;
    const caja = btn.closest('.sumup-pend');
    const msg = caja?.querySelector('.sumup-msg');
    try {
      if (btn.id === 'sumup-revisar') {
        btn.disabled = true; btn.textContent = 'Revisando…';
        await post({ action: 'sincronizar' });
        await cargar();
        btn.disabled = false; btn.textContent = 'Revisar cobros ahora';
      } else if (btn.classList.contains('sumup-abrir')) {
        // Cada opción tiene su propio panel: se abre uno y se cierra el otro.
        const cual = btn.dataset.panel;
        caja.querySelectorAll('.sumup-panel').forEach((p) => { p.hidden = p.dataset.panel !== cual ? true : !p.hidden; });
        caja.querySelectorAll('.sumup-abrir').forEach((b) => {
          const abierto = !caja.querySelector(`.sumup-panel[data-panel="${b.dataset.panel}"]`).hidden;
          b.classList.toggle('btn-dark', abierto); b.classList.toggle('btn-outline', !abierto);
        });
        msg.textContent = '';
      } else if (btn.classList.contains('sumup-guardar-paciente')) {
        const elegida = caja.querySelector('.sumup-radio:checked');
        if (!elegida) { msg.textContent = 'Elige la sesión primero.'; return; }
        const falta = Number(elegida.dataset.monto) - Number(caja.dataset.monto);
        if (falta < 0) { msg.textContent = 'El cobro es mayor que esa sesión. Elige otra sesión.'; return; }
        const resto = (caja.querySelector('.sumup-resto-txt')?.value || '').trim();
        if (falta > 0 && !resto) { msg.textContent = `Escribe de dónde vinieron los ${clp(falta)} que faltan.`; caja.querySelector('.sumup-resto-txt')?.focus(); return; }
        if (falta === 0 && elegida.dataset.pagada && !confirm('Esa sesión ya figura pagada por el monto completo. ¿Igual quieres asociarle este cobro? Revisa que no sea un pago doble.')) return;
        btn.disabled = true; msg.textContent = 'Guardando…';
        const nombre = elegida.closest('.sumup-op')?.querySelector('span')?.textContent.split(' · ')[0] || 'el paciente';
        const r = await post({ action: 'asociar_paciente', codigo: caja.dataset.codigo, id: elegida.value, resto: falta > 0 ? resto : '' });
        await cargar();
        $('sumup-estado').insertAdjacentHTML('afterbegin', `<p style="color:var(--green);font-weight:600;margin:0 0 0.5rem;">Listo: cobro asociado a ${esc(nombre)}, sin boleta.${r.quedoPagada ? ' La sesión quedó pagada.' : ''}</p>`);
      } else if (btn.classList.contains('sumup-asociar')) {
        const marcadas = [...caja.querySelectorAll('.sumup-chk:checked')];
        const suma = marcadas.reduce((t, x) => t + Number(x.dataset.monto), 0);
        if (!marcadas.length) { msg.textContent = 'Marca la sesión primero.'; return; }
        if (suma !== Number(caja.dataset.monto)) { msg.textContent = `Las sesiones marcadas suman ${clp(suma)} y el cobro es de ${clp(Number(caja.dataset.monto))}.`; return; }
        btn.disabled = true; msg.textContent = 'Asociando y emitiendo la boleta…';
        await post({ action: 'asociar', codigo: caja.dataset.codigo, ids: marcadas.map((x) => x.value) });
        await cargar();
        $('sumup-estado').insertAdjacentHTML('afterbegin', '<p style="color:var(--green);font-weight:600;margin:0 0 0.5rem;">Listo: sesión pagada. La boleta y los correos van saliendo.</p>');
      } else if (btn.classList.contains('sumup-ignorar')) {
        if (!confirm('¿Este cobro no corresponde a ninguna sesión? Deja de aparecer aquí y no se emite boleta.')) return;
        btn.disabled = true;
        await post({ action: 'ignorar', codigo: caja.dataset.codigo });
        await cargar();
      }
    } catch (e) {
      if (msg) msg.textContent = e.message; else $('sumup-estado').textContent = e.message;
      btn.disabled = false;
      if (btn.id === 'sumup-revisar') btn.textContent = 'Revisar cobros ahora';
    }
  });
  $('sumup-card').addEventListener('input', (ev) => {
    if (!ev.target.classList?.contains('sumup-buscar')) return;
    const q = sinTildes(ev.target.value.trim());
    const panel = ev.target.closest('.sumup-panel');
    panel.querySelectorAll('.sumup-op').forEach((l) => {
      const ver = !q || l.dataset.nombre.includes(q);
      l.style.display = ver ? 'flex' : 'none';
      // Una sesión oculta por la búsqueda no queda elegida sin que se vea.
      const r = l.querySelector('.sumup-radio');
      if (!ver && r.checked) { r.checked = false; panel.querySelector('.sumup-resto').hidden = true; panel.querySelector('.sumup-pac-info').textContent = 'Elige la sesión de ese paciente.'; }
    });
  });
  $('sumup-card').addEventListener('change', (ev) => {
    if (ev.target.classList?.contains('sumup-radio')) {
      const caja = ev.target.closest('.sumup-pend');
      const falta = Number(ev.target.dataset.monto) - Number(caja.dataset.monto);
      const bloque = caja.querySelector('.sumup-resto');
      const info = caja.querySelector('.sumup-pac-info');
      bloque.hidden = !(falta > 0);
      if (falta > 0) caja.querySelector('.sumup-falta').textContent = clp(falta);
      info.textContent = falta < 0 ? 'El cobro es mayor que esa sesión. Elige otra sesión.' : falta === 0 ? 'El cobro es igual al monto de la sesión.' : `La sesión es de ${clp(Number(ev.target.dataset.monto))} y el cobro de ${clp(Number(caja.dataset.monto))}.`;
      return;
    }
    if (!ev.target.classList?.contains('sumup-chk')) return;
    const caja = ev.target.closest('.sumup-pend');
    const suma = [...caja.querySelectorAll('.sumup-chk:checked')].reduce((t, x) => t + Number(x.dataset.monto), 0);
    const total = Number(caja.dataset.monto);
    caja.querySelector('.sumup-suma').textContent = suma === 0 ? 'Marca la sesión (o las sesiones) que pagó con este cobro.'
      : suma === total ? `Listo: suman ${clp(suma)}, igual que el cobro.` : `Marcadas: ${clp(suma)} de ${clp(total)}.`;
  });
  cargar();
})();
</script>

<script define:vars={{ patientsJson, servicesJson, prefillJson, hasPrefill }}>
(function () {
  const patients = JSON.parse(patientsJson);
  const services = JSON.parse(servicesJson);

  // ── Referencias DOM ──────────────────────────────────────────────────────
  const tabRegistrado    = document.getElementById('tab-registrado');
  const tabPersonalizado = document.getElementById('tab-personalizado');
  const secRegistrado    = document.getElementById('section-registrado');
  const secPersonalizado = document.getElementById('section-personalizado');
  const patientSearch    = document.getElementById('patient-search');
  const patientResults   = document.getElementById('patient-results');
  const patientSelected  = document.getElementById('patient-selected');
  const selName          = document.getElementById('sel-name');
  const selEmail         = document.getElementById('sel-email');
  const selPhone         = document.getElementById('sel-phone');
  const clearPatient     = document.getElementById('clear-patient');
  const customName       = document.getElementById('custom-name');
  const customEmail      = document.getElementById('custom-email');
  const customPhone      = document.getElementById('custom-phone');
  const serviceSelect    = document.getElementById('service-select');
  const cobroAmount      = document.getElementById('cobro-amount');
  const cobroDesc        = document.getElementById('cobro-desc');
  const cobroDate           = document.getElementById('cobro-date');
  const cobroTime           = document.getElementById('cobro-time');
  const modPresencial       = document.getElementById('mod-presencial');
  const modOnline           = document.getElementById('mod-online');
  const modPresencialWrap   = document.getElementById('mod-presencial-wrap');
  const modOnlineWrap       = document.getElementById('mod-online-wrap');
  const meetHint            = document.getElementById('meet-hint');
  const waPreviewWrap    = document.getElementById('wa-preview-wrap');
  const waPreview        = document.getElementById('wa-preview');
  const btnGenerar       = document.getElementById('btn-generar');
  const cobroWarning     = document.getElementById('cobro-warning');
  const cobroWarningMsg  = document.getElementById('cobro-warning-msg');
  const btnForzar        = document.getElementById('btn-forzar');
  const btnCancelarDup   = document.getElementById('btn-cancelar-dup');
  const cobroError       = document.getElementById('cobro-error');
  const cobroResult      = document.getElementById('cobro-result');
  const waBtn            = document.getElementById('wa-btn');
  const paymentUrlInput  = document.getElementById('payment-url-input');
  const btnCopy          = document.getElementById('btn-copy');
  const noWaMsg          = document.getElementById('no-wa-msg');
  const meetResult       = document.getElementById('meet-result');
  const meetLinkA        = document.getElementById('meet-link-a');

  let mode = 'registrado';   // 'registrado' | 'personalizado'
  let selectedPatient = null;

  // ── Tabs ─────────────────────────────────────────────────────────────────
  function setTab(t) {
    mode = t;
    if (t === 'registrado') {
      tabRegistrado.style.background    = 'var(--ink)';
      tabRegistrado.style.color         = 'white';
      tabPersonalizado.style.background = 'white';
      tabPersonalizado.style.color      = 'var(--stone)';
      secRegistrado.style.display    = '';
      secPersonalizado.style.display = 'none';
    } else {
      tabPersonalizado.style.background = 'var(--ink)';
      tabPersonalizado.style.color      = 'white';
      tabRegistrado.style.background    = 'white';
      tabRegistrado.style.color         = 'var(--stone)';
      secRegistrado.style.display    = 'none';
      secPersonalizado.style.display = '';
    }
    updatePreview();
  }
  tabRegistrado.addEventListener('click',    () => setTab('registrado'));
  tabPersonalizado.addEventListener('click', () => setTab('personalizado'));

  // ── Búsqueda de pacientes ─────────────────────────────────────────────────
  patientSearch.addEventListener('input', function () {
    const q = this.value.trim().toLowerCase();
    patientResults.innerHTML = '';
    if (!q) { patientResults.style.display = 'none'; return; }

    const matches = patients.filter(p =>
      p.name.toLowerCase().includes(q) || (p.email ?? '').toLowerCase().includes(q)
    ).slice(0, 8);

    if (!matches.length) { patientResults.style.display = 'none'; return; }

    matches.forEach(p => {
      const item = document.createElement('div');
      item.style.cssText = 'padding:0.65rem 1rem;cursor:pointer;font-size:0.88rem;border-bottom:1px solid var(--warm);';
      // textContent (no innerHTML): el nombre y el teléfono los escribe la paciente
      // en la agenda pública y no deben interpretarse como HTML.
      const nombre = document.createElement('strong');
      nombre.textContent = p.name ?? '';
      const datos = document.createElement('span');
      datos.style.cssText = 'color:var(--stone);font-size:0.78rem;';
      datos.textContent = `${p.email ?? '—'} · ${p.phone ?? '—'}`;
      item.append(nombre, document.createElement('br'), datos);
      item.addEventListener('mouseenter', () => item.style.background = 'var(--warm)');
      item.addEventListener('mouseleave', () => item.style.background = '');
      item.addEventListener('click', () => selectPatient(p));
      patientResults.appendChild(item);
    });
    patientResults.style.display = 'block';
  });

  document.addEventListener('click', e => {
    if (!patientSearch.contains(e.target) && !patientResults.contains(e.target)) {
      patientResults.style.display = 'none';
    }
  });

  function selectPatient(p) {
    selectedPatient = p;
    patientSearch.value          = '';
    patientResults.style.display = 'none';
    selName.textContent          = p.name;
    selEmail.textContent         = p.email  ?? '—';
    selPhone.textContent         = p.phone  ?? '—';
    patientSelected.style.display = '';
    patientSearch.style.display   = 'none';
    updatePreview();
  }

  clearPatient.addEventListener('click', () => {
    selectedPatient               = null;
    patientSelected.style.display = 'none';
    patientSearch.style.display   = '';
    patientSearch.value           = '';
    updatePreview();
  });

  // ── Autocompletar desde servicio ─────────────────────────────────────────
  let selectedServiceType = 'individual';
  let selectedModality    = 'presencial';

  function updateModalityUI() {
    selectedModality = modOnline.checked ? 'online' : 'presencial';
    if (selectedModality === 'online') {
      modOnlineWrap.style.background    = 'var(--ink)';
      modOnlineWrap.style.color         = 'white';
      modOnlineWrap.style.borderColor   = 'var(--ink)';
      modPresencialWrap.style.background = 'white';
      modPresencialWrap.style.color      = 'var(--stone)';
      modPresencialWrap.style.borderColor = 'var(--dust)';
      meetHint.style.display = '';
    } else {
      modPresencialWrap.style.background = 'var(--ink)';
      modPresencialWrap.style.color      = 'white';
      modPresencialWrap.style.borderColor = 'var(--ink)';
      modOnlineWrap.style.background    = 'white';
      modOnlineWrap.style.color         = 'var(--stone)';
      modOnlineWrap.style.borderColor   = 'var(--dust)';
      meetHint.style.display = 'none';
    }
    updatePreview();
  }

  modPresencial.addEventListener('change', updateModalityUI);
  modOnline.addEventListener('change', updateModalityUI);

  // ── Pre-llenado desde /admin/deudas (botón "Cobrar" de una sesión puntual) ──
  // Solo rellena los campos — no genera ni envía nada por sí solo.
  if (hasPrefill) {
    const prefill = JSON.parse(prefillJson);
    setTab('personalizado');
    customName.value  = prefill.name;
    customEmail.value = prefill.email;
    customPhone.value = prefill.phone;
    cobroAmount.value = prefill.amount;
    cobroDesc.value   = prefill.desc;
    cobroDate.value   = prefill.date;
    cobroTime.value   = prefill.time;
    if (prefill.modality === 'online') {
      modOnline.checked = true;
    } else {
      modPresencial.checked = true;
    }
    updateModalityUI();
  }

  serviceSelect.addEventListener('change', function () {
    const opt = this.options[this.selectedIndex];
    const price = opt.dataset.price;
    const name  = opt.dataset.name;
    const type  = opt.dataset.type;
    if (price) cobroAmount.value  = price;
    if (name)  cobroDesc.value    = name;
    if (type)  selectedServiceType = type;
    updatePreview();
  });

  // ── Preview en tiempo real ────────────────────────────────────────────────
  [cobroAmount, cobroDesc, cobroDate, cobroTime, customName, customPhone].forEach(el =>
    el?.addEventListener('input', updatePreview)
  );

  function getFormData() {
    if (mode === 'registrado') {
      return {
        name:  selectedPatient?.name  ?? '',
        email: selectedPatient?.email ?? '',
        phone: selectedPatient?.phone ?? '',
      };
    } else {
      return {
        name:  customName.value.trim(),
        email: customEmail.value.trim(),
        phone: window.telefonoDe?.(customPhone) || customPhone.value.trim(),
      };
    }
  }

  function formatDateLabel(dateStr, timeStr) {
    if (!dateStr) return null;
    const [y, m, d] = dateStr.split('-');
    const months = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
    let label = `${parseInt(d)} de ${months[parseInt(m) - 1]}`;
    if (timeStr) label += ` a las ${timeStr}`;
    return label;
  }

  function updatePreview() {
    const { name } = getFormData();
    const amount = parseInt(cobroAmount.value ?? '0');
    const desc   = cobroDesc.value.trim();
    const date   = cobroDate.value;
    const time   = cobroTime.value;

    if (!name || !amount || !desc) {
      waPreviewWrap.style.display = 'none';
      return;
    }

    const firstName   = name.split(' ')[0];
    const amountFmt   = new Intl.NumberFormat('es-CL').format(amount);
    const dateLabel   = formatDateLabel(date, time);
    const dateLineFmt = dateLabel ? `📅 ${dateLabel}\n` : '';
    const modalityFmt = selectedModality === 'online' ? '🎥 Sesión online (Meet)\n' : '📍 Sesión presencial\n';
    const meetLineFmt = selectedModality === 'online' ? '🔗 Link de Meet: se enviará al confirmar el pago\n' : '';
    const previewMsg  = `Hola ${firstName} 👋 Te comparto el enlace de pago para tu sesión:\n\n*${desc}*\n${modalityFmt}${dateLineFmt}💰 $${amountFmt} CLP\n\n🔗 [enlace de pago]${meetLineFmt ? '\n' + meetLineFmt : ''}\nCualquier consulta, escríbeme. ¡Hasta pronto! 🌿`;
    waPreview.textContent       = previewMsg;
    waPreviewWrap.style.display = '';
  }

  // ── Generar cobro ─────────────────────────────────────────────────────────
  async function generarCobro(force = false) {
    const { name, email, phone } = getFormData();
    const amount = cobroAmount.value;
    const desc   = cobroDesc.value.trim();

    // Validación cliente
    if (!name) { showError('Selecciona un paciente o ingresa un nombre.'); return; }
    if (!email) { showError('El email es requerido para generar el cobro en Flow.'); return; }
    if (mode !== 'registrado' && customPhone.value.trim() && !window.telefonoDe?.(customPhone)) {
      customPhone.dispatchEvent(new Event('blur'));
      showError('Revisa el teléfono: elige el país y escribe solo el número (en Chile son 9 dígitos).'); return;
    }
    if (!amount || parseInt(amount) < 1000) { showError('Ingresa un monto válido (mínimo $1.000 CLP).'); return; }
    if (!desc) { showError('Ingresa una descripción del cobro.'); return; }
    if (!cobroDate.value) { showError('Selecciona la fecha de la sesión para que quede agendada.'); return; }
    if (!cobroTime.value) { showError('Selecciona la hora de la sesión.'); return; }

    cobroError.style.display   = 'none';
    cobroWarning.style.display = 'none';
    cobroResult.style.display  = 'none';
    btnGenerar.textContent     = 'Generando…';
    btnGenerar.disabled        = true;

    try {
      const res  = await fetch('/api/admin/payment-link', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({
          name, email, phone,
          amount:       parseInt(amount),
          description:  desc,
          serviceType:  selectedServiceType,
          sessionDate:  cobroDate.value || null,
          sessionTime:  cobroTime.value || null,
          modality:     selectedModality,
          origen_canal: document.getElementById('cobro-origen')?.value || null,
          force,
        }),
      });
      const data = await res.json();

      // Cobro duplicado reciente → mostrar aviso
      if (data.warning) {
        cobroWarningMsg.textContent  = data.message;
        cobroWarning.style.display   = '';
        cobroWarning.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }

      if (!res.ok || !data.ok) {
        showError(data.error ?? 'Error al generar el cobro.');
        return;
      }

      // Mostrar resultado
      paymentUrlInput.value     = data.paymentUrl;
      cobroResult.style.display = '';

      if (data.whatsappUrl) {
        waBtn.href             = data.whatsappUrl;
        waBtn.style.display    = 'flex';
        noWaMsg.style.display  = 'none';
      } else {
        waBtn.style.display    = 'none';
        noWaMsg.style.display  = '';
      }

      // Mostrar Meet link si se generó
      if (data.meetLink) {
        meetLinkA.href          = data.meetLink;
        meetLinkA.textContent   = data.meetLink;
        meetResult.style.display = '';
      } else {
        meetResult.style.display = 'none';
      }

      cobroResult.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    } catch (e) {
      showError('Error de conexión. Intenta nuevamente.');
    } finally {
      btnGenerar.textContent = 'Generar enlace de cobro';
      btnGenerar.disabled    = false;
    }
  }

  btnGenerar.addEventListener('click', () => generarCobro(false));

  // Forzar envío ignorando el aviso de duplicado
  btnForzar.addEventListener('click', () => {
    cobroWarning.style.display = 'none';
    generarCobro(true);
  });

  btnCancelarDup.addEventListener('click', () => {
    cobroWarning.style.display = 'none';
  });

  // ── Copiar URL ────────────────────────────────────────────────────────────
  btnCopy.addEventListener('click', () => {
    navigator.clipboard.writeText(paymentUrlInput.value).then(() => {
      btnCopy.textContent = '¡Copiado!';
      setTimeout(() => { btnCopy.textContent = 'Copiar URL'; }, 2000);
    });
  });

  function showError(msg) {
    cobroError.textContent    = msg;
    cobroError.style.display  = '';
    cobroError.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

})();
</script>
