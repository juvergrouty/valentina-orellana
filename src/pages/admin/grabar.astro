---
export const prerender = false;
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabase } from '../../lib/supabase';
import { todayCL, hoursUntilSessionCL } from '../../lib/dateUtils';
import { getValidAccessToken } from '../../lib/syncCalendar';
import { pacienteDeTitulo } from '../../lib/boxCala';
import { mismaPersona } from '../../lib/mismaPersona';
import { tipoDesdeSessionType } from '../../lib/transcriptor/reglas';
import { evaluarEnBase, motivoVisible, transcriptorActivo, textoMotivo } from '../../lib/transcriptor/consentimiento';
import { preseleccion } from '../../lib/transcriptor/preseleccion';

// Grabador presencial del transcriptor IA (paquete P4). Diseño: docs/transcriptor/40-ux-diseno.md
// y mockup-grabador.html. Única ruta con micrófono permitido (vercel.json).
// Principio: en sesión Vale no mira el teléfono. 1 toque para empezar, "Mantén para terminar"
// (1 s) para terminar, y cualquier cosa rara cambia la pantalla entera de color.
//
// El servidor solo arma la lista de sesiones: presenciales EN CURSO o que empiezan en los
// próximos 20 min, de las reservas del sitio y de Google Calendar (Encuadrado solo existe
// ahí), deduplicadas por persona y día (misma regla del Inicio). El consentimiento que se
// muestra es informativo: el bloqueo real lo hace /api/admin/transcriptor/grabacion-iniciar.

const VENTANA_MIN = 20;
const hoy = todayCL();
const paramSesion = Astro.url.searchParams.get('sesion') ?? Astro.url.searchParams.get('booking') ?? '';
// ?evento=<googleEventId> (panel lateral del calendario) y ?paciente=<id> (botón de la ficha).
const paramEvento = (Astro.url.searchParams.get('evento') ?? '').slice(0, 1024);
const paramPaciente = Astro.url.searchParams.get('paciente') ?? '';
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

type Tipo = 'individual' | 'pareja';
interface Candidata {
  clave: string; fuente: 'reserva' | 'calendario'; bookingId: string | null; googleEventId: string | null;
  patientId: string | null; nombre: string; fecha: string; hora: string; dur: number; tipo: Tipo | null;
  faltaMin: number; consentOk: boolean | null; consentTexto: string | null; firmantes: string[];
}
interface Paciente { id: string; name: string; email: string | null; active: boolean | null }

async function eventosGoogleHoy(): Promise<{ id: string; hora: string; dur: number; titulo: string }[] | null> {
  const auth = await getValidAccessToken();
  if (!auth) return null;
  const tMin = new Date(Date.parse(hoy + 'T00:00:00Z') - 86400000).toISOString();
  const tMax = new Date(Date.parse(hoy + 'T00:00:00Z') + 2 * 86400000).toISOString();
  const url = `https://www.googleapis.com/calendar/v3/calendars/${encodeURIComponent(auth.calendarId)}/events`
    + `?timeMin=${tMin}&timeMax=${tMax}&singleEvents=true&orderBy=startTime&maxResults=250&timeZone=America%2FSantiago`;
  const res = await fetch(url, { headers: { Authorization: `Bearer ${auth.token}` }, signal: AbortSignal.timeout(5000) });
  if (!res.ok) return null;
  const data = await res.json();
  const out: { id: string; hora: string; dur: number; titulo: string }[] = [];
  for (const ev of (data.items ?? []) as Array<{ id?: string; summary?: string; status?: string; start?: { dateTime?: string }; end?: { dateTime?: string } }>) {
    const inicio = ev.start?.dateTime, titulo = ev.summary ?? '';
    if (!inicio || ev.status === 'cancelled') continue;
    // El evento pedido por ?evento= entra aunque su título no diga "presencial" (p. ej. online sin Meet).
    if ((!/presencial/i.test(titulo) || !/sesi[oó]n/i.test(titulo)) && !(paramEvento && ev.id === paramEvento)) continue;
    if (inicio.slice(0, 10) !== hoy) continue; // con timeZone=America/Santiago viene en hora de Chile
    const dur = ev.end?.dateTime ? Math.max(20, Math.round((Date.parse(ev.end.dateTime) - Date.parse(inicio)) / 60000)) : 50;
    out.push({ id: String(ev.id ?? ''), hora: inicio.slice(11, 16), dur, titulo });
  }
  return out;
}

let activo = false;
let errorLectura = false;
let candidatas: Candidata[] = [];
let pacientes: { id: string; name: string }[] = [];
let recientes: string[] = [];
let demo: string | null = null;
const aliasEvento: Record<string, string> = {};

// Datos de prueba SOLO en `astro dev` (import.meta.env.DEV es false en el build de producción):
// /admin/grabar?demo=<vista> para la revisión visual sin base de datos.
if (import.meta.env.DEV && Astro.url.searchParams.get('demo')) {
  demo = Astro.url.searchParams.get('demo');
  activo = true;
  const sin = demo === 'sin-consentimiento';
  candidatas = demo === 'elegir' ? [
    { clave: 'a', fuente: 'reserva', bookingId: '00000000-0000-4000-8000-000000000001', googleEventId: null, patientId: 'p1', nombre: 'Camila Rojas', fecha: hoy, hora: '16:00', dur: 50, tipo: 'individual', faltaMin: 8, consentOk: true, consentTexto: null, firmantes: ['Camila Rojas'] },
    { clave: 'b', fuente: 'calendario', bookingId: null, googleEventId: 'evdemo', patientId: 'p2', nombre: 'Diego Pérez y Ana Soto', fecha: hoy, hora: '16:00', dur: 60, tipo: 'pareja', faltaMin: 8, consentOk: false, consentTexto: textoMotivo('falta_segunda_firma'), firmantes: ['Diego Pérez'] },
  ] : [
    { clave: 'a', fuente: 'reserva', bookingId: '00000000-0000-4000-8000-000000000001', googleEventId: null, patientId: 'p1', nombre: sin ? 'Diego Pérez' : 'Camila Rojas', fecha: hoy, hora: '16:00', dur: 50, tipo: sin ? 'pareja' : 'individual', faltaMin: 2, consentOk: !sin, consentTexto: sin ? textoMotivo('falta_segunda_firma') : null, firmantes: sin ? ['Diego Pérez'] : ['Camila Rojas'] },
  ];
  pacientes = [{ id: 'p1', name: 'Camila Rojas' }, { id: 'p2', name: 'Diego Pérez' }, { id: 'p3', name: 'Josefa Muñoz' }, { id: 'p4', name: 'Tomás Fuentes' }];
  recientes = ['p1', 'p2', 'p3'];
} else {
  try {
    const [act, resReservas, resPacientes, resRecientes, google, resParam] = await Promise.all([
      transcriptorActivo(),
      supabase.from('bookings')
        .select('id, patient_name, patient_email, session_type, session_date, session_time, duration_min, status')
        .eq('session_date', hoy).in('session_type', ['presencial', 'pareja-presencial'])
        .not('status', 'in', '(cancelled,expired)').order('session_time'),
      supabase.from('patients').select('id, name, email, active').order('name').limit(2000),
      supabase.from('bookings').select('patient_email').lte('session_date', hoy)
        .not('status', 'in', '(cancelled,expired)').order('session_date', { ascending: false }).limit(80),
      eventosGoogleHoy().catch(() => null),
      UUID.test(paramSesion)
        ? supabase.from('bookings').select('id, patient_name, patient_email, session_type, session_date, session_time, duration_min, status').eq('id', paramSesion).maybeSingle()
        : Promise.resolve({ data: null, error: null }),
    ]);
    activo = act;
    errorLectura = !!resReservas.error || !!resPacientes.error;
    const todos = (resPacientes.data ?? []) as Paciente[];
    const porEmail = new Map(todos.filter((p) => p.email).map((p) => [String(p.email).trim().toLowerCase(), p]));
    pacientes = todos.filter((p) => p.active !== false || p.id === paramPaciente).map((p) => ({ id: p.id, name: p.name }));
    for (const r of resRecientes.data ?? []) {
      const p = porEmail.get(String(r.patient_email ?? '').trim().toLowerCase());
      if (p && !recientes.includes(p.id)) recientes.push(p.id);
      if (recientes.length >= 5) break;
    }

    type Reserva = { id: string; patient_name: string; patient_email: string | null; session_type: string; session_date: string; session_time: string | null; duration_min: number | null; status: string };
    const reservas = [...((resReservas.data ?? []) as Reserva[])];
    const pedida = resParam.data as Reserva | null;
    if (pedida && !['cancelled', 'expired'].includes(pedida.status) && !reservas.some((r) => r.id === pedida.id)) reservas.push(pedida);
    for (const b of reservas) {
      if (!b.session_time) continue;
      const hora = String(b.session_time).slice(0, 5);
      const p = porEmail.get(String(b.patient_email ?? '').trim().toLowerCase()) ?? null;
      const t = tipoDesdeSessionType(b.session_type);
      candidatas.push({
        clave: `r:${b.id}`, fuente: 'reserva', bookingId: b.id, googleEventId: null, patientId: p?.id ?? null,
        nombre: p?.name ?? b.patient_name, fecha: b.session_date, hora, dur: Number(b.duration_min) || 50,
        tipo: t === 'sin_tipo' ? null : t, faltaMin: Math.round(hoursUntilSessionCL(b.session_date, hora) * 60),
        consentOk: null, consentTexto: null, firmantes: [],
      });
    }
    for (const ev of google ?? []) {
      const nombre = pacienteDeTitulo(ev.titulo.replace(/^\s*(Por pagar|Pagada)\s*·\s*/i, ''));
      const ya = candidatas.find((c) => c.fecha === hoy && mismaPersona(c.nombre, nombre));
      if (ya) { if (ev.id) aliasEvento[ev.id] = ya.clave; continue; } // ya está (evento de la página o duplicado de Encuadrado)
      const coinciden = todos.filter((p) => p.active !== false && mismaPersona(p.name, nombre));
      candidatas.push({
        clave: `g:${ev.id}`, fuente: 'calendario', bookingId: null, googleEventId: ev.id || null,
        patientId: coinciden.length === 1 ? coinciden[0].id : null, nombre: coinciden.length === 1 ? coinciden[0].name : nombre,
        fecha: hoy, hora: ev.hora, dur: ev.dur,
        tipo: /pareja/i.test(ev.titulo) ? 'pareja' : /individual/i.test(ev.titulo) ? 'individual' : null,
        faltaMin: Math.round(hoursUntilSessionCL(hoy, ev.hora) * 60), consentOk: null, consentTexto: null, firmantes: [],
      });
    }
    candidatas.sort((a, b) => a.hora.localeCompare(b.hora));
    // Consentimiento (informativo) de cada sesión con ficha y tipo conocidos.
    await Promise.all(candidatas.map(async (c) => {
      if (!c.patientId || !c.tipo) return;
      try {
        const v = await evaluarEnBase(c.patientId, c.tipo);
        c.consentOk = v.puede; c.firmantes = v.firmantes;
        if (v.parejaDeducida) c.tipo = 'pareja'; // H2: la ficha es de pareja (lo decide el servidor)
        c.consentTexto = v.puede ? null : textoMotivo(motivoVisible(v), c.nombre);
      } catch { /* se verifica igual al preparar */ }
    }));
  } catch (e) {
    console.warn('[admin/grabar]', e instanceof Error ? e.message : e);
    errorLectura = true;
  }
}

// Qué preseleccionar según ?sesion= / ?evento= / ?paciente= (lógica en preseleccion.ts, con pruebas).
const pre = preseleccion(candidatas, { sesion: paramSesion, evento: paramEvento, paciente: UUID.test(paramPaciente) || demo ? paramPaciente : '' }, aliasEvento);
const clavePedida = pre?.modo === 'sesion' ? pre.clave : null;
// En curso o empieza en ≤ 20 min (la pedida siempre entra).
const ahoraVentana = candidatas.filter((c) => (c.faltaMin <= VENTANA_MIN && c.faltaMin > -c.dur) || c.clave === clavePedida);
const otrasHoy = candidatas.filter((c) => !ahoraVentana.includes(c) && c.faltaMin > -c.dur);
const pacientePedido = pre?.modo === 'ficha' && pacientes.some((p) => p.id === pre.patientId) ? pre.patientId : null;
const datos = { activo, errorLectura, hoy, ventana: ahoraVentana, otras: otrasHoy, pacientes, recientes, demo, pedida: clavePedida, pacientePedido };
---

<AdminLayout title="Grabar sesión" current="/admin/grabar">
  <div id="grabador" class="gr" data-vista="cargando">
    <div class="gr-col">
      {!activo && (
        <div class="gr-alerta gr-alerta-ambar" role="status">
          <b>El grabador está apagado.</b> Se activa en la configuración del transcriptor cuando todo esté listo (consentimientos, almacenamiento y pruebas).
        </div>
      )}
      {errorLectura && <div class="gr-alerta gr-alerta-roja" role="alert">No se pudieron leer las sesiones de hoy. Puedes buscar al paciente abajo.</div>}
      <div id="gr-pendientes" hidden></div>
      <div id="gr-espacio" class="gr-alerta gr-alerta-ambar" hidden>
        <b>Hay poco espacio en el iPhone.</b> Una sesión ocupa unos 25 MB. Libera espacio antes de grabar.
      </div>

      <!-- Cargando -->
      <section data-v="cargando"><p class="gr-grande">Preparando el grabador…</p></section>

      <!-- Elegir sesión -->
      <section data-v="elegir" class="gr-pila">
        <h1 class="gr-h1">¿Qué sesión vas a grabar?</h1>
        <p class="gr-sub">Abre esta página con internet; recién después activa el modo avión.</p>
        <div id="gr-lista-ventana" class="gr-pila"></div>
        <details id="gr-otras-wrap" class="gr-card" hidden>
          <summary class="gr-summary">Otras sesiones presenciales de hoy</summary>
          <div id="gr-lista-otras" class="gr-pila" style="margin-top:12px"></div>
        </details>
        <div class="gr-card gr-pila">
          <label for="gr-buscar" class="gr-label">Busca al paciente</label>
          <input id="gr-buscar" class="gr-input" type="search" autocomplete="off" placeholder="Nombre del paciente" />
          <p id="gr-buscar-ayuda" class="gr-sub">Atendidos recientemente:</p>
          <div id="gr-lista-pacientes" class="gr-pila"></div>
        </div>
      </section>

      <!-- Listo -->
      <section data-v="listo" class="gr-pila">
        <div class="gr-card">
          <div class="gr-fila">
            <p class="gr-label" id="gr-sel-cuando">Sesión</p>
            <button type="button" class="gr-link" id="gr-cambiar">Cambiar</button>
          </div>
          <p class="gr-paciente" id="gr-sel-nombre"></p>
          <p class="gr-sub" id="gr-sel-tipo"></p>
          <p class="gr-consent" id="gr-sel-consent" hidden></p>
        </div>

        <div class="gr-card gr-pila" id="gr-tipo" hidden>
          <p class="gr-label">¿Es individual o de pareja?</p>
          <p class="gr-sub">Define cómo se transcribe y quiénes deben haber firmado.</p>
          <div class="gr-dos">
            <button type="button" class="gr-btn gr-btn-out" data-tipo="individual">Individual</button>
            <button type="button" class="gr-btn gr-btn-out" data-tipo="pareja">Pareja</button>
          </div>
        </div>

        <div id="gr-bloqueo" class="gr-alerta gr-alerta-roja" role="alert" hidden>
          <p class="gr-alerta-titulo" id="gr-bloqueo-titulo"></p>
          <p id="gr-bloqueo-texto"></p>
          <div class="gr-dos" style="margin-top:10px">
            <a id="gr-bloqueo-ficha" class="gr-btn gr-btn-out" href="/admin/pacientes" hidden>Enviar consentimiento</a>
            <button type="button" id="gr-bloqueo-reintentar" class="gr-btn gr-btn-out" hidden>Reintentar</button>
          </div>
        </div>

        <div class="gr-card">
          <p class="gr-label" style="margin-bottom:4px">Antes de grabar</p>
          <p class="gr-sub" id="gr-orden-avion"><b>Abre esta página con internet</b>; recién después activa el modo avión. Si la abres ya en modo avión, el iPhone no puede cargarla ni verificar el consentimiento.</p>
          <ul class="gr-check">
            <li><span class="gr-tick" id="gr-ck-avion" aria-hidden="true">!</span><span id="gr-ck-avion-t">Modo avión</span></li>
            <li><span class="gr-tick" id="gr-ck-wifi" aria-hidden="true">!</span><span>Wi-Fi apagado</span></li>
            <li>
              <span class="gr-tick" id="gr-ck-mic" aria-hidden="true">?</span>
              <span style="flex:1">Micrófono funcionando</span>
              <span class="gr-medidor" id="gr-medidor-prueba" aria-label="Nivel del micrófono"><i></i><i></i><i></i><i></i><i></i></span>
            </li>
            <li class="gr-li-boton"><button type="button" class="gr-btn gr-btn-out gr-btn-chico" id="gr-probar-mic">Probar micrófono</button></li>
            <li>
              <label class="gr-ck-label">
                <input type="checkbox" id="gr-ck-bateria" />
                <span>Modo de bajo consumo apagado</span>
              </label>
            </li>
          </ul>
          <div class="gr-toggle">
            <div>
              <b id="gr-ruido-label">Lugar con ruido</b>
              <p class="gr-sub" style="font-size:14px">Actívalo si hay ruido de calle u obras</p>
            </div>
            <button type="button" class="gr-switch" id="gr-ruido" role="switch" aria-checked="false" aria-labelledby="gr-ruido-label"></button>
          </div>
        </div>

        <p id="gr-estado-prep" class="gr-sub" aria-live="polite"></p>
        <button type="button" class="gr-btn gr-btn-rec" id="gr-grabar" disabled><span class="gr-dot" aria-hidden="true"></span>Grabar</button>
        <p class="gr-hint">Deja el teléfono sobre la mesa, pantalla hacia arriba. Usa esta página en una pestaña de Safari (no como ícono en la pantalla de inicio).</p>
      </section>

      <!-- Después de grabar: guardada / subiendo / procesando / listo -->
      <section data-v="subir" class="gr-pila">
        <div class="gr-card">
          <p class="gr-ok-grande" id="gr-guardada-t">Sesión guardada en este teléfono ✓</p>
          <p class="gr-sub" id="gr-guardada-sub"></p>
        </div>
        <div class="gr-card" id="gr-progreso" aria-live="polite">
          <p class="gr-progreso-t" id="gr-progreso-t">Desactiva el modo avión para subirla.</p>
          <div class="gr-barra" id="gr-barra" hidden><i id="gr-barra-i"></i></div>
          <p class="gr-sub" id="gr-progreso-sub">Puedes dejar esta página abierta y seguir con tu día.</p>
          <button type="button" class="gr-btn gr-btn-out" id="gr-reintentar-subida" hidden style="margin-top:12px">Reintentar ahora</button>
          <button type="button" class="gr-btn gr-btn-out" id="gr-descartar" hidden style="margin-top:12px">Descartar del teléfono</button>
        </div>
        <div class="gr-card" id="gr-pasos" hidden>
          <ul class="gr-pasos">
            <li id="gr-paso-subida"><span class="gr-tick ok">✓</span>Subida</li>
            <li id="gr-paso-trans"><span class="gr-spin" aria-hidden="true"></span><b>Transcribiendo…</b></li>
            <li id="gr-paso-res"><span class="gr-tick gr-tick-no" aria-hidden="true"></span>Resumen automático (IA)</li>
          </ul>
          <p class="gr-sub" style="margin-top:12px">Listo: ya puedes cerrar esta página y seguir con tu día (agendar, cobrar, atender). El resumen se hace en nuestros servidores, no en tu teléfono, y aparece solo en la ficha en unos minutos.</p>
        </div>
        <div class="gr-card gr-card-ok" id="gr-listo" hidden>
          <p class="gr-ok-grande">Listo ✓</p>
          <p style="margin:4px 0 12px">El resumen está en la ficha de <b id="gr-listo-nombre"></b>.</p>
          <a class="gr-btn gr-btn-rec gr-btn-medio" id="gr-ver-ficha" href="/admin/pacientes">Ver ficha</a>
        </div>
        <div class="gr-alerta gr-alerta-ambar" id="gr-aviso-cerrar">Si cierras Safari ahora no se pierde nada: se sube la próxima vez que abras esta página con internet.</div>
        <button type="button" class="gr-btn gr-btn-out" id="gr-otra">Grabar otra sesión</button>
      </section>
    </div>

    <!-- Hoja: todavía hay conexión -->
    <div class="gr-velo" id="gr-hoja" hidden>
      <div class="gr-hoja" role="dialog" aria-modal="true" aria-labelledby="gr-hoja-t">
        <h2 id="gr-hoja-t">Todavía tienes conexión</h2>
        <p>Si entra una llamada, el iPhone corta el micrófono aunque no contestes. Activa <b>Modo avión</b> y deja el <b>Wi-Fi apagado</b>.</p>
        <button type="button" class="gr-btn gr-btn-rec gr-btn-medio" id="gr-hoja-avion">Primero activo modo avión</button>
        <button type="button" class="gr-btn gr-btn-out" id="gr-hoja-igual">Grabar igual</button>
      </div>
    </div>

    <!-- Grabando (pantalla oscura) -->
    <div class="gr-pantalla gr-oscura" id="gr-rec" hidden>
      <div class="gr-banda" id="gr-banda-silencio" role="alert" hidden>No se escucha nada hace 1 minuto. Revisa que nada tape el micrófono.</div>
      <div class="gr-banda" id="gr-banda-pantalla" role="status" hidden>La pantalla podría apagarse. Tócala de vez en cuando o enchufa el cargador.</div>
      <div class="gr-rec-centro">
        <div class="gr-rec-estado"><span class="gr-pulso" aria-hidden="true"></span><span id="gr-rec-titulo">Grabando</span></div>
        <div class="gr-crono" id="gr-crono" role="timer" aria-label="Tiempo grabado">00:00:00</div>
        <span class="gr-medidor gr-medidor-grande" id="gr-medidor-rec" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
        <p class="gr-quien" id="gr-rec-quien"></p>
        <div class="gr-stat">
          <span id="gr-stat-pantalla">☀︎ Pantalla encendida</span>
          <span>✓ Guardando en este teléfono</span>
          <span id="gr-stat-ruido" hidden>Lugar con ruido activado</span>
        </div>
      </div>
      <div class="gr-rec-acciones">
        <button type="button" class="gr-btn gr-btn-fantasma" id="gr-pausar">❙❙ Pausar</button>
        <button type="button" class="gr-btn gr-hold" data-hold><span class="gr-hold-relleno" aria-hidden="true"></span><span class="gr-hold-t">■ Mantén para terminar</span></button>
      </div>
    </div>

    <!-- En pausa por ella (ámbar) -->
    <div class="gr-pantalla gr-ambar" id="gr-pausa" hidden>
      <div class="gr-rojo-top" role="status" aria-live="assertive">
        <h2>❙❙ En pausa</h2>
        <p id="gr-pausa-texto">Pausaste la grabación. Lo que se diga ahora no se graba.</p>
      </div>
      <button type="button" class="gr-tocar gr-tocar-ambar" id="gr-pausa-seguir"><span class="gr-tocar-circulo"><i></i></span>Tocar para seguir grabando</button>
      <div class="gr-rec-acciones">
        <button type="button" class="gr-btn gr-hold gr-hold-claro" data-hold><span class="gr-hold-relleno" aria-hidden="true"></span><span class="gr-hold-t">■ Mantén para terminar</span></button>
      </div>
    </div>

    <!-- Pausada por interrupción (rojo pantalla completa) -->
    <div class="gr-pantalla gr-roja" id="gr-int" hidden>
      <div class="gr-rojo-top" role="alert" aria-live="assertive">
        <h2>⚠ La grabación se pausó</h2>
        <p id="gr-int-causa"></p>
        <p id="gr-int-hasta" class="gr-rojo-chico"></p>
      </div>
      <button type="button" class="gr-tocar" id="gr-int-seguir"><span class="gr-tocar-circulo"><i></i></span>Tocar para seguir grabando</button>
      <div class="gr-rec-acciones">
        <button type="button" class="gr-btn gr-btn-rojo-out" id="gr-int-terminar">Terminar aquí</button>
      </div>
    </div>

    <!-- Guardando -->
    <div class="gr-pantalla gr-oscura" id="gr-guardando" hidden>
      <div class="gr-rec-centro"><p class="gr-rec-estado">Guardando…</p><p class="gr-quien">No cierres esta página.</p></div>
    </div>
