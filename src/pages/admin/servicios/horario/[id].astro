---
export const prerender = false;
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { supabase } from '../../../../lib/supabase';

const { id } = Astro.params;

// Servicio actual (con degradación si aún no existen las columnas nuevas)
async function loadService() {
  const full = await supabase.from('services_catalog')
    .select('id, name, duration_min, break_min, slot_interval_min, booking_window_days').eq('id', id!).maybeSingle();
  if (full.error?.code === '42703') {
    return await supabase.from('services_catalog').select('id, name, duration_min').eq('id', id!).maybeSingle();
  }
  return full;
}
const { data: service } = await loadService();
if (!service) return Astro.redirect('/admin/servicios');

const duration   = (service as { duration_min?: number }).duration_min ?? 50;
const breakMin   = (service as { break_min?: number }).break_min ?? 10;
const frecuencia = (service as { slot_interval_min?: number }).slot_interval_min ?? (duration + breakMin);
const windowDays = (service as { booking_window_days?: number }).booking_window_days ?? 60;

// Otros servicios (para "copiar horario de")
const { data: others } = await supabase
  .from('services_catalog').select('id, name').neq('id', id!).order('name');

// Franjas actuales de este servicio
let existing: Array<{ day_of_week: number; start_time: string }> = [];
{
  const res = await supabase.from('availability_slots')
    .select('day_of_week, start_time').eq('service_id', id!).eq('active', true);
  if (!res.error) existing = (res.data ?? []).map(s => ({ day_of_week: s.day_of_week, start_time: String(s.start_time).slice(0, 5) }));
}

const config = {
  serviceId:  service.id,
  duration, breakMin, frecuencia, windowDays,
  selected:   existing.map(s => `${s.day_of_week}|${s.start_time}`),
};

const saved = Astro.url.searchParams.get('saved') === '1';
---

<AdminLayout title={`Horario · ${service.name}`} current="/admin/servicios">

  <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1rem;">
    <div>
      <a href="/admin/servicios" style="color:var(--stone);font-size:0.85rem;text-decoration:none;">← Servicios</a>
      <h2 style="font-family:'Cormorant Garamond',serif;font-size:1.5rem;margin-top:0.3rem;">Horarios de atención</h2>
      <p style="font-size:0.85rem;color:var(--stone);">{service.name}</p>
    </div>
    <button id="btn-save" class="btn btn-dark btn-sm" type="button">Guardar horario</button>
  </div>

  {saved && <div class="alert-success" style="margin-bottom:1rem;">✓ Horario guardado.</div>}
  <div id="save-status" style="font-size:0.82rem;margin-bottom:0.75rem;"></div>

  <div style="display:grid;grid-template-columns:230px 1fr;gap:1.5rem;align-items:start;">

    <!-- ── Panel de configuración (estilo Encuadrado) ─────────────────────── -->
    <div class="card" style="padding:1.1rem;">
      <p class="label" style="margin-bottom:1rem;">Configuración general</p>

      {others && others.length > 0 && (
        <div style="margin-bottom:1rem;">
          <label class="label" style="display:block;margin-bottom:0.3rem;font-size:0.72rem;">Copiar horario de otro servicio</label>
          <select id="copy-from" style="width:100%;font-size:0.82rem;padding:0.45rem;">
            <option value="">— Elegir —</option>
            {others.map(o => <option value={o.id}>{o.name}</option>)}
          </select>
        </div>
      )}

      <div style="margin-bottom:1rem;">
        <label class="label" style="display:block;margin-bottom:0.3rem;font-size:0.72rem;">Duración</label>
        <select id="cfg-duration" style="width:100%;font-size:0.82rem;padding:0.45rem;">
          {[30,40,45,50,60,75,80,90,120].map(v => <option value={v} selected={v===duration}>{v} minutos</option>)}
        </select>
      </div>

      <div style="margin-bottom:1rem;">
        <label class="label" style="display:block;margin-bottom:0.3rem;font-size:0.72rem;">Descanso entre sesiones</label>
        <select id="cfg-break" style="width:100%;font-size:0.82rem;padding:0.45rem;">
          {[0,5,10,15,20,30].map(v => <option value={v} selected={v===breakMin}>{v} minutos</option>)}
        </select>
      </div>

      <div style="margin-bottom:1rem;">
        <label class="label" style="display:block;margin-bottom:0.3rem;font-size:0.72rem;">Días visibles hacia el futuro</label>
        <input type="number" id="cfg-window" value={windowDays} min="1" max="365" style="width:100%;font-size:0.82rem;padding:0.45rem;" />
        <p style="font-size:0.66rem;color:var(--stone);margin-top:0.25rem;">Hasta cuántos días adelante puede agendar el paciente.</p>
      </div>

      <div style="border-top:1px solid var(--warm);padding-top:0.85rem;">
        <p class="label" style="margin-bottom:0.5rem;font-size:0.68rem;">Reglas avanzadas</p>
        <label class="label" style="display:block;margin-bottom:0.3rem;font-size:0.72rem;">Frecuencia de atención</label>
        <select id="cfg-freq" style="width:100%;font-size:0.82rem;padding:0.45rem;">
          {[30,40,45,50,60,75,80,90,120].map(v => <option value={v} selected={v===frecuencia}>{v} minutos</option>)}
        </select>
        <p style="font-size:0.66rem;color:var(--stone);margin-top:0.25rem;">Cada cuánto empieza un cupo. Normalmente = duración + descanso.</p>
      </div>
    </div>

    <!-- ── Grilla ──────────────────────────────────────────────────────────── -->
    <div>
      <p style="font-size:0.8rem;color:var(--stone);margin-bottom:0.6rem;">
        <strong>Arrastra</strong> para pintar varias horas · clic en un <strong>día</strong> (arriba) para toda la columna · clic en la <strong>hora</strong> (izquierda) para toda la fila. Cada bloque es un cupo (inicio – fin).
      </p>
      <div style="overflow-x:auto;border:1px solid var(--dust);border-radius:8px;">
        <table id="hgrid" class="hgrid" style="border-collapse:collapse;width:100%;min-width:640px;user-select:none;-webkit-user-select:none;"></table>
      </div>
    </div>
  </div>

  <script id="hgrid-config" type="application/json" set:html={JSON.stringify(config)}></script>
</AdminLayout>

<style>
  .slot-cell.on { background: #4f5ce8 !important; color: #fff; }
  .slot-cell:hover { background: #eef0fe; }
  .slot-cell.on:hover { background: #4048c8 !important; }
  .day-head:hover, .time-lbl:hover { background: #eef0fe; }
  .slot-cell { font-size: 0.6rem; line-height: 1; }
</style>

<script>
  const cfg = JSON.parse(document.getElementById('hgrid-config').textContent);
  const DAYS = [
    { dow: 1, label: 'Lun' }, { dow: 2, label: 'Mar' }, { dow: 3, label: 'Mié' },
    { dow: 4, label: 'Jue' }, { dow: 5, label: 'Vie' }, { dow: 6, label: 'Sáb' }, { dow: 0, label: 'Dom' },
  ];
  const START_MIN = 7 * 60;   // 07:00
  const END_MIN   = 22 * 60;   // 22:00
  const status = document.getElementById('save-status');
  const setStatus = (t, c) => { if (status) { status.textContent = t; status.style.color = c; } };

  let selected = new Set(cfg.selected);           // claves "dow|HH:MM"
  let duration = cfg.duration;
  let freq      = cfg.frecuencia;

  const pad = (n) => String(n).padStart(2, '0');
  const toHM = (min) => `${pad(Math.floor(min / 60))}:${pad(min % 60)}`;

  // ── Construir/re-construir la grilla según la frecuencia y duración ──────
  function renderGrid() {
    const table = document.getElementById('hgrid');
    let head = '<thead><tr><th style="width:56px;"></th>';
    DAYS.forEach(d => {
      head += `<th class="day-head" data-dow="${d.dow}" title="Clic: seleccionar/limpiar todo el día"
        style="padding:0.5rem;font-size:0.78rem;color:var(--ink);border-bottom:1px solid var(--dust);cursor:pointer;">${d.label}</th>`;
    });
    head += '</tr></thead>';

    let bodyRows = '';
    for (let m = START_MIN; m + duration <= END_MIN + 1; m += freq) {
      const start = toHM(m);
      const end   = toHM(m + duration);
      bodyRows += `<tr><td class="time-lbl" data-time="${start}" title="Clic: seleccionar/limpiar esta hora en todos los días"
        style="font-size:0.66rem;color:var(--stone);text-align:right;padding:0 0.4rem;white-space:nowrap;cursor:pointer;">${start}</td>`;
      DAYS.forEach(d => {
        const key = `${d.dow}|${start}`;
        const on  = selected.has(key) ? ' on' : '';
        bodyRows += `<td style="padding:0;border:1px solid #f0ede8;">
          <button type="button" class="slot-cell${on}" data-dow="${d.dow}" data-time="${start}"
            style="width:100%;height:30px;border:none;background:transparent;cursor:pointer;display:block;">${start.slice(0,5)}–${end}</button>
        </td>`;
      });
      bodyRows += '</tr>';
    }
    table.innerHTML = head + '<tbody>' + bodyRows + '</tbody>';
    attachHandlers();
  }

  // ── Selección: arrastrar + día + hora ────────────────────────────────────
  let painting = false, paintOn = true;
  const setCell = (cell, on) => {
    cell.classList.toggle('on', on);
    const key = `${cell.dataset.dow}|${cell.dataset.time}`;
    if (on) selected.add(key); else selected.delete(key);
  };

  function attachHandlers() {
    document.querySelectorAll('#hgrid .slot-cell').forEach(cell => {
      cell.addEventListener('mousedown', (e) => { e.preventDefault(); painting = true; paintOn = !cell.classList.contains('on'); setCell(cell, paintOn); });
      cell.addEventListener('mouseenter', () => { if (painting) setCell(cell, paintOn); });
      cell.addEventListener('touchstart', (e) => { e.preventDefault(); setCell(cell, !cell.classList.contains('on')); }, { passive: false });
    });
    document.querySelectorAll('#hgrid .day-head').forEach(h => h.addEventListener('click', () => {
      const cells = Array.from(document.querySelectorAll(`#hgrid .slot-cell[data-dow="${h.dataset.dow}"]`));
      const allOn = cells.length > 0 && cells.every(c => c.classList.contains('on'));
      cells.forEach(c => setCell(c, !allOn));
    }));
    document.querySelectorAll('#hgrid .time-lbl').forEach(l => l.addEventListener('click', () => {
      const cells = Array.from(document.querySelectorAll(`#hgrid .slot-cell[data-time="${l.dataset.time}"]`));
      const allOn = cells.length > 0 && cells.every(c => c.classList.contains('on'));
      cells.forEach(c => setCell(c, !allOn));
    }));
  }
  document.addEventListener('mouseup', () => { painting = false; });
  document.addEventListener('mouseleave', () => { painting = false; });

  // ── Controles de configuración → re-render en vivo ───────────────────────
  document.getElementById('cfg-duration')?.addEventListener('change', (e) => { duration = parseInt(e.target.value); renderGrid(); });
  document.getElementById('cfg-freq')?.addEventListener('change', (e) => { freq = parseInt(e.target.value); renderGrid(); });

  // ── Copiar horario de otro servicio ──────────────────────────────────────
  document.getElementById('copy-from')?.addEventListener('change', async (e) => {
    const fromId = e.target.value;
    if (!fromId) return;
    setStatus('Copiando…', '#6b7280');
    try {
      const res = await fetch('/api/admin/slots/service', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'copy', from_service_id: fromId }),
      });
      const d = await res.json();
      if (!d.ok) { setStatus('✕ ' + (d.error ?? 'Error'), '#dc2626'); return; }
      selected = new Set(d.slots.map(s => `${s.day_of_week}|${s.start_time}`));
      renderGrid();
      setStatus(`✓ ${d.slots.length} franjas copiadas (recuerda Guardar)`, '#15803d');
      e.target.value = '';
    } catch { setStatus('✕ Error de conexión', '#dc2626'); }
  });

  // ── Guardar (franjas + configuración del servicio) ───────────────────────
  document.getElementById('btn-save')?.addEventListener('click', async (ev) => {
    const btn = ev.currentTarget;
    const slots = Array.from(selected).map(k => { const [dow, time] = k.split('|'); return { day_of_week: parseInt(dow), start_time: time }; });
    const settings = {
      duration_min:        parseInt(document.getElementById('cfg-duration').value),
      break_min:           parseInt(document.getElementById('cfg-break').value),
      slot_interval_min:   parseInt(document.getElementById('cfg-freq').value),
      booking_window_days: parseInt(document.getElementById('cfg-window').value),
    };
    btn.disabled = true;
    setStatus('Guardando…', '#6b7280');
    try {
      const res = await fetch('/api/admin/slots/service', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'save', service_id: cfg.serviceId, slots, settings }),
      });
      const d = await res.json();
      if (d.ok) { window.location.href = '/admin/servicios/horario/' + cfg.serviceId + '?saved=1'; }
      else { setStatus('✕ ' + (d.error ?? 'Error'), '#dc2626'); btn.disabled = false; }
    } catch { setStatus('✕ Error de conexión', '#dc2626'); btn.disabled = false; }
  });

  renderGrid();
</script>
