---
export const prerender = false;
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabase } from '../../lib/supabase';

const { data: rows } = await supabase.from('settings').select('key, value')
  .in('key', ['whatsapp_access_token', 'whatsapp_waba_id', 'whatsapp_phone_number_id', 'whatsapp_connected_at']);
const cfg: Record<string, string> = {};
(rows ?? []).forEach((r: { key: string; value: string }) => { cfg[r.key] = r.value; });

const connected = !!cfg['whatsapp_access_token'];
const appId    = import.meta.env.PUBLIC_META_APP_ID ?? '';
const configId = import.meta.env.PUBLIC_META_WHATSAPP_CONFIG_ID ?? '';
---

<AdminLayout title="Conectar WhatsApp" current="/admin/whatsapp-conectar">

  <div class="card" style="max-width:560px;margin:0 auto;padding:2.5rem;">
    <p class="label" style="margin-bottom:0.75rem;">WhatsApp Business</p>
    <h1 style="font-family:'Cormorant Garamond',serif;font-size:1.6rem;margin-bottom:1rem;">
      Conectar tu WhatsApp (modo Coexistence)
    </h1>
    <p style="font-size:0.88rem;color:var(--stone);line-height:1.6;margin-bottom:1.5rem;">
      Este modo conecta tu número de WhatsApp actual (+56 9 7273 5696) al sitio para poder enviar
      recordatorios automáticos, <strong>sin desconectarlo de la app de tu teléfono</strong> — sigues
      usando WhatsApp normal para hablar con tus pacientes exactamente igual que hoy.
    </p>

    {!appId || !configId ? (
      <div style="background:#fef2f2;border:1px solid #fecaca;padding:1rem;border-radius:6px;font-size:0.85rem;color:#991b1b;">
        Falta configurar <code>PUBLIC_META_APP_ID</code> / <code>PUBLIC_META_WHATSAPP_CONFIG_ID</code> en Vercel.
      </div>
    ) : connected ? (
      <div style="background:#f0fdf4;border:1px solid #86efac;padding:1.25rem;border-radius:6px;">
        <p style="font-size:0.9rem;color:#166534;font-weight:600;margin-bottom:0.5rem;">✓ WhatsApp conectado</p>
        <p style="font-size:0.8rem;color:#166534;">Conectado el {new Date(cfg['whatsapp_connected_at']).toLocaleString('es-CL')}</p>
        <button id="btn-reconnect" class="btn btn-outline btn-sm" style="margin-top:1rem;">Volver a conectar</button>
      </div>
    ) : (
      <button id="btn-connect" class="btn btn-dark" style="width:100%;justify-content:center;padding:0.9rem;">
        Conectar WhatsApp
      </button>
    )}

    <p id="wa-status" style="display:none;font-size:0.82rem;margin-top:1rem;padding:0.85rem;border-radius:6px;"></p>
  </div>

  {connected && (
    <div class="card" style="max-width:560px;margin:1.5rem auto 0;padding:2.5rem;">
      <p class="label" style="margin-bottom:0.75rem;">Plantilla de recordatorio</p>
      <h2 style="font-family:'Cormorant Garamond',serif;font-size:1.3rem;margin-bottom:1rem;">
        Necesaria para el recordatorio automático por WhatsApp
      </h2>
      <p style="font-size:0.85rem;color:var(--stone);line-height:1.6;margin-bottom:1.25rem;">
        Meta exige una plantilla pre-aprobada para cualquier mensaje que el sitio le mande primero
        al paciente (fuera de una conversación ya abierta). Elige un texto — pensados para no sonar
        clínicos por si alguien más ve la notificación en el teléfono del paciente — y lo mando a
        revisión. La aprobación suele tardar minutos a un día; mientras tanto queda "Pendiente".
      </p>
      {!cfg['whatsapp_waba_id'] ? (
        <div style="background:#fef2f2;border:1px solid #fecaca;padding:0.85rem;border-radius:6px;font-size:0.82rem;color:#991b1b;">
          Falta el ID de tu cuenta de WhatsApp Business (waba_id) — vuelve a conectar arriba para que quede guardado.
        </div>
      ) : (
        <div style="display:flex;flex-direction:column;gap:0.85rem;">
          <label class="tpl-opt" style="display:flex;gap:0.6rem;align-items:flex-start;cursor:pointer;">
            <input type="radio" name="tpl-choice" value="0" checked style="margin-top:3px;">
            <span style="font-size:0.85rem;">Hola {'{{1}}'}, te recordamos tu hora de hoy a las {'{{2}}'} hrs. Cualquier cambio, respóndenos por este medio. — Valentina Orellana</span>
          </label>
          <label class="tpl-opt" style="display:flex;gap:0.6rem;align-items:flex-start;cursor:pointer;">
            <input type="radio" name="tpl-choice" value="1" style="margin-top:3px;">
            <span style="font-size:0.85rem;">Hola {'{{1}}'}, te recordamos tu sesión de hoy a las {'{{2}}'} hrs con Ps. Valentina Orellana. Cualquier cambio, respóndenos por este medio.</span>
          </label>
          <label class="tpl-opt" style="display:flex;gap:0.6rem;align-items:flex-start;cursor:pointer;">
            <input type="radio" name="tpl-choice" value="2" style="margin-top:3px;">
            <span style="font-size:0.85rem;">Hola {'{{1}}'}, este es un recordatorio de tu hora de hoy a las {'{{2}}'} hrs. Si necesitas reagendar o cancelar, respóndenos por este medio.</span>
          </label>
          <label class="tpl-opt" style="display:flex;gap:0.6rem;align-items:flex-start;cursor:pointer;">
            <input type="radio" name="tpl-choice" value="custom" style="margin-top:3px;">
            <span style="font-size:0.85rem;">Otro texto (usa {'{{1}}'} para el nombre y {'{{2}}'} para la hora):</span>
          </label>
          <textarea id="tpl-custom" rows="2" placeholder="Escribe tu propio texto con {{1}} y {{2}}…" style="font-size:0.85rem;padding:0.6rem;border:1px solid var(--dust);border-radius:6px;resize:vertical;"></textarea>

          <button id="btn-create-tpl" class="btn btn-dark" style="margin-top:0.5rem;">Enviar plantilla a revisión</button>
          <p id="tpl-status" style="display:none;font-size:0.82rem;padding:0.85rem;border-radius:6px;"></p>
        </div>
      )}
    </div>
  )}

</AdminLayout>

<script define:vars={{ appId, configId }}>
  window.fbAsyncInit = function () {
    FB.init({ appId, autoLogAppEvents: true, xfbml: true, version: 'v21.0' });
  };
  (function (d, s, id) {
    if (d.getElementById(id)) return;
    const js = d.createElement(s);
    js.id = id;
    js.src = 'https://connect.facebook.net/es_LA/sdk.js';
    d.body.appendChild(js);
  })(document, 'script', 'facebook-jssdk');

  let capturedWaba = null;
  let capturedPhone = null;

  window.addEventListener('message', (event) => {
    if (!event.origin.endsWith('facebook.com')) return;
    try {
      const data = JSON.parse(event.data);
      if (data.type !== 'WA_EMBEDDED_SIGNUP') return;
      if (data.event === 'FINISH' || data.event === 'FINISH_WHATSAPP_BUSINESS_APP_ONBOARDING') {
        capturedWaba = data.data?.waba_id ?? capturedWaba;
        capturedPhone = data.data?.phone_number_id ?? capturedPhone;
      }
    } catch { /* mensajes de otro origen, ignorar */ }
  });

  function showStatus(msg, ok) {
    const el = document.getElementById('wa-status');
    el.textContent = msg;
    el.style.display = 'block';
    el.style.background = ok ? '#f0fdf4' : '#fef2f2';
    el.style.color = ok ? '#166534' : '#991b1b';
    el.style.border = ok ? '1px solid #86efac' : '1px solid #fecaca';
  }

  async function launchSignup() {
    showStatus('Abriendo la ventana de Meta…', true);
    FB.login((response) => {
      if (response.authResponse && response.authResponse.code) {
        showStatus('Conectando…', true);
        fetch('/api/admin/whatsapp/exchange-token', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code: response.authResponse.code, wabaId: capturedWaba, phoneNumberId: capturedPhone }),
        })
          .then((r) => r.json())
          .then((data) => {
            if (data.ok) {
              showStatus('✓ WhatsApp conectado correctamente. Recarga la página para ver el estado.', true);
            } else {
              showStatus('Error: ' + (data.error ?? 'no se pudo conectar.'), false);
            }
          })
          .catch(() => showStatus('Error de conexión al guardar.', false));
      } else {
        showStatus('Se cerró la ventana sin completar la conexión.', false);
      }
    }, {
      config_id: configId,
      response_type: 'code',
      override_default_response_type: true,
      extras: { setup: {} },
    });
  }

  document.getElementById('btn-connect')?.addEventListener('click', launchSignup);
  document.getElementById('btn-reconnect')?.addEventListener('click', launchSignup);

  // ── Crear plantilla de recordatorio ───────────────────────────────────────
  const TPL_TEXTS = [
    'Hola {{1}}, te recordamos tu hora de hoy a las {{2}} hrs. Cualquier cambio, respóndenos por este medio. — Valentina Orellana',
    'Hola {{1}}, te recordamos tu sesión de hoy a las {{2}} hrs con Ps. Valentina Orellana. Cualquier cambio, respóndenos por este medio.',
    'Hola {{1}}, este es un recordatorio de tu hora de hoy a las {{2}} hrs. Si necesitas reagendar o cancelar, respóndenos por este medio.',
  ];

  function showTplStatus(msg, ok) {
    const el = document.getElementById('tpl-status');
    if (!el) return;
    el.textContent = msg;
    el.style.display = 'block';
    el.style.background = ok ? '#f0fdf4' : '#fef2f2';
    el.style.color = ok ? '#166534' : '#991b1b';
    el.style.border = ok ? '1px solid #86efac' : '1px solid #fecaca';
  }

  document.getElementById('btn-create-tpl')?.addEventListener('click', async () => {
    const choice = document.querySelector('input[name="tpl-choice"]:checked')?.value;
    const bodyText = choice === 'custom'
      ? (document.getElementById('tpl-custom')?.value ?? '').trim()
      : TPL_TEXTS[Number(choice)];

    if (!bodyText || !bodyText.includes('{{1}}')) {
      showTplStatus('El texto debe incluir al menos {{1}} (nombre del paciente).', false);
      return;
    }

    showTplStatus('Enviando a revisión…', true);
    try {
      const res = await fetch('/api/admin/whatsapp/create-template', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: 'recordatorio_sesion_' + Date.now(),
          bodyText,
          sampleValues: ['María', '16:00'],
        }),
      });
      const data = await res.json();
      if (data.ok) {
        showTplStatus('✓ Enviada a revisión (estado: ' + (data.status ?? 'PENDING') + '). Meta suele tardar minutos a un día en aprobarla — revisa en tu Business Manager, sección WhatsApp Manager → Plantillas de mensaje.', true);
      } else {
        showTplStatus('Error: ' + (data.error ?? 'no se pudo crear la plantilla.'), false);
      }
    } catch {
      showTplStatus('Error de conexión al enviar la plantilla.', false);
    }
  });
</script>
