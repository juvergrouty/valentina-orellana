---
export const prerender = false;
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabase } from '../../lib/supabase';

// "Por cobrar" (distinto de "deuda", ver /admin/deudas): sesiones que TODAVÍA
// no ocurren y cuyo link de pago (Flow) sigue sin pagarse. No es dinero que se
// deba — es dinero que debería entrar cuando el paciente pague el link.
const { data: rows } = await supabase
  .from('bookings')
  .select('id, patient_name, patient_email, patient_phone, session_type, session_date, session_time, amount, mp_preference_id, created_at')
  .eq('status', 'pending_payment')
  .neq('session_date', '2099-12-31') // cobros manuales sin fecha se gestionan desde /admin/cobros
  .gt('amount', 0)
  .order('session_date', { ascending: true });

const { data: settingsRows } = await supabase.from('settings').select('key, value').eq('key', 'flow_env');
const flowEnv = settingsRows?.[0]?.value;
const flowCheckoutBase = flowEnv === 'production' ? 'https://www.flow.cl/app/web/pay.php' : 'https://sandbox.flow.cl/app/web/pay.php';
const siteUrl = Astro.url.origin;

// Igual que en /admin/deudas: si el paciente tiene ficha, el link a mandar es
// el combinado /pagar/[id] (cobra TODO lo pendiente, no solo esta sesión —
// así se comporta Encuadrado). Sin ficha, se cae al link individual de Flow.
const { data: patientsRows } = await supabase.from('patients').select('id, email');
const patientIdByEmail: Record<string, string> = {};
(patientsRows ?? []).forEach((p: { id: string; email: string | null }) => {
  if (p.email) patientIdByEmail[p.email.toLowerCase()] = p.id;
});

const SESSION_LABELS: Record<string, string> = {
  'online': 'Individual Online', 'presencial': 'Individual Presencial',
  'pareja-online': 'Pareja Online', 'pareja-presencial': 'Pareja Presencial',
};

const formatCLP = (n: number) =>
  new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);
function formatDate(iso: string) {
  return new Date(iso + 'T00:00:00').toLocaleDateString('es-CL', { day: '2-digit', month: 'short', year: 'numeric' });
}

const pending = rows ?? [];
const grandTotal = pending.reduce((s, b) => s + (b.amount ?? 0), 0);

const debtEmailSent = Astro.url.searchParams.get('debt_email_sent') === '1';
const errorParam    = Astro.url.searchParams.get('error');
const errorDetail   = Astro.url.searchParams.get('detail') ?? '';
---

<AdminLayout title="Por cobrar" current="/admin/finanzas">

  <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.5rem;flex-wrap:wrap;">
    <div>
      <a href="/admin/finanzas" style="color:var(--stone);font-size:0.85rem;text-decoration:none;">← Finanzas</a>
      <h1 style="margin-top:0.5rem;">Por cobrar — links de pago pendientes</h1>
      <p style="color:var(--stone);font-size:0.88rem;">Sesiones agendadas cuyo link de pago aún no se paga. No son deudas — nadie ha prestado el servicio todavía.</p>
    </div>
    <div style="text-align:right;">
      <p class="label" style="color:#b45309;">Total pendiente</p>
      <p style="font-size:1.4rem;font-weight:700;">{formatCLP(grandTotal)}</p>
    </div>
  </div>

  {debtEmailSent && (
    <div class="card" style="background:#f0fdf4;border-color:#bbf7d0;color:#15803d;padding:0.85rem 1.2rem;margin-bottom:1rem;font-size:0.85rem;">
      ✓ Link de pago enviado por correo al paciente.
    </div>
  )}
  {errorParam === 'patient_no_email' && (
    <div class="card" style="background:#fef2f2;border-color:#fecaca;color:#dc2626;padding:0.85rem 1.2rem;margin-bottom:1rem;font-size:0.85rem;">
      ⚠ Este paciente no tiene correo guardado en su ficha — no se pudo enviar el link.
    </div>
  )}
  {errorParam === 'no_debt' && (
    <div class="card" style="background:#fef2f2;border-color:#fecaca;color:#dc2626;padding:0.85rem 1.2rem;margin-bottom:1rem;font-size:0.85rem;">
      ⚠ Este paciente ya no tiene nada pendiente (puede que se haya pagado justo ahora).
    </div>
  )}
  {errorParam === 'email_failed' && (
    <div class="card" style="background:#fef2f2;border-color:#fecaca;color:#dc2626;padding:0.85rem 1.2rem;margin-bottom:1rem;font-size:0.85rem;">
      ⚠ No se pudo enviar el correo{errorDetail ? `: ${errorDetail}` : '.'}
    </div>
  )}
  {!pending.length ? (
    <div class="card" style="text-align:center;padding:3rem;">
      <p style="color:var(--stone);font-size:0.9rem;">No hay links de pago pendientes. 🎉</p>
    </div>
  ) : (
    <div class="card" style="padding:0;overflow:hidden;">
      <table>
        <thead>
          <tr>
            <th>Paciente</th>
            <th>Sesión</th>
            <th>Fecha</th>
            <th>Monto</th>
            <th>Link enviado</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          {pending.map((b) => {
            const waPhone = (b.patient_phone ?? '').replace(/\D/g, '');
            const waNumber = waPhone.length === 9 ? '56' + waPhone : waPhone;
            const patientId = b.patient_email ? patientIdByEmail[b.patient_email.toLowerCase()] : null;
            const payUrl = patientId
              ? `${siteUrl}/pagar/${patientId}`
              : (b.mp_preference_id ? `${flowCheckoutBase}?token=${b.mp_preference_id}` : null);
            const firstName = b.patient_name.split(' ')[0];
            const waMsg = payUrl ? encodeURIComponent(
              patientId
                ? `Hola ${firstName}, te recuerdo el link de pago pendiente: ${payUrl}`
                : `Hola ${firstName}, te recuerdo el link de pago para tu sesión (${formatCLP(b.amount)}): ${payUrl}`
            ) : '';
            const waUrl = payUrl && waNumber.length >= 11 ? `https://wa.me/${waNumber}?text=${waMsg}` : null;
            return (
              <tr>
                <td>
                  <p style="font-weight:600;font-size:0.88rem;">{b.patient_name}</p>
                  {b.patient_email && <p style="font-size:0.75rem;color:var(--stone);">{b.patient_email}</p>}
                </td>
                <td style="font-size:0.84rem;">{SESSION_LABELS[b.session_type] ?? b.session_type}</td>
                <td style="font-size:0.84rem;color:var(--stone);">{formatDate(b.session_date)}{b.session_time ? ` · ${b.session_time.slice(0,5)}` : ''}</td>
                <td style="font-weight:600;font-size:0.88rem;white-space:nowrap;">{formatCLP(b.amount)}</td>
                <td style="font-size:0.8rem;color:var(--stone);">{formatDate(b.created_at?.slice(0,10) ?? b.session_date)}</td>
                <td style="white-space:nowrap;">
                  {patientId ? (
                    <div class="cobrar-dropdown" style="position:relative;display:inline-block;">
                      <button type="button" class="btn btn-dark btn-sm cobrar-toggle">💳 Cobrar ▾</button>
                      <div class="cobrar-menu" style="display:none;position:absolute;top:100%;left:0;z-index:20;background:white;border:1px solid var(--dust);border-radius:var(--radius);box-shadow:0 4px 14px rgba(0,0,0,0.12);min-width:190px;margin-top:0.3rem;overflow:hidden;text-align:left;">
                        {waUrl ? (
                          <a href={waUrl} target="_blank" class="cobrar-menu-item" style="display:block;padding:0.6rem 0.9rem;font-size:0.82rem;color:var(--ink);text-decoration:none;">📱 Enviar por WhatsApp</a>
                        ) : (
                          <span style="display:block;padding:0.6rem 0.9rem;font-size:0.82rem;color:var(--stone);">📱 Sin teléfono guardado</span>
                        )}
                        {b.patient_email ? (
                          <button type="button" class="cobrar-menu-item btn-send-debt-email" data-patient={patientId}
                            style="display:block;width:100%;text-align:left;padding:0.6rem 0.9rem;font-size:0.82rem;background:none;border:none;cursor:pointer;color:var(--ink);">✉️ Enviar por correo</button>
                        ) : (
                          <span style="display:block;padding:0.6rem 0.9rem;font-size:0.82rem;color:var(--stone);">✉️ Sin correo guardado</span>
                        )}
                      </div>
                    </div>
                  ) : waUrl ? (
                    <a href={waUrl} target="_blank" class="btn btn-dark btn-sm">Reenviar por WhatsApp</a>
                  ) : (
                    <span style="font-size:0.75rem;color:var(--stone);">Sin link guardado</span>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}

</AdminLayout>

<script>
(function () {
  document.addEventListener('click', (e) => {
    // Menú "Cobrar" (WhatsApp / correo) — cerrar cualquier otro abierto primero
    const cobrarToggle = e.target.closest('.cobrar-toggle');
    document.querySelectorAll('.cobrar-menu').forEach((m) => {
      if (!cobrarToggle || m.previousElementSibling !== cobrarToggle) m.style.display = 'none';
    });
    if (cobrarToggle) {
      const menu = cobrarToggle.nextElementSibling;
      menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
      return;
    }

    const sendDebtEmailBtn = e.target.closest('.btn-send-debt-email');
    if (sendDebtEmailBtn) {
      if (!confirm('¿Enviar el link de pago al correo del paciente?')) return;
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/api/admin/bookings';
      form.innerHTML = `
        <input type="hidden" name="action" value="send_debt_email">
        <input type="hidden" name="patient_id" value="${sendDebtEmailBtn.dataset.patient}">
        <input type="hidden" name="redirect" value="/admin/por-cobrar">
      `;
      document.body.appendChild(form);
      form.submit();
    }
  });
})();
</script>
