---
export const prerender = false;
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { supabase } from '../../lib/supabase';
import { frasePlazoPago, AVISO_REAGENDAR, FORMAS_DE_PAGO } from '../../lib/cobrosProximos';
import { hoursUntilSessionCL } from '../../lib/dateUtils';
import { sesionesPorCobrar } from '../../lib/porCobrar';
import { esPagoEnConsulta, ETIQUETA_PAGO_EN_CONSULTA } from '../../lib/pagoEnConsulta';

// "Por cobrar" (distinto de "deuda", ver /admin/deudas): sesiones que TODAVÍA
// no ocurren y siguen sin pagar. No es dinero que se deba — es dinero que
// debería entrar cuando el paciente pague el link. Misma definición que la
// tarjeta "Por cobrar" del Inicio (ver src/lib/porCobrar.ts).
const rows = await sesionesPorCobrar().catch(() => null);

const { data: settingsRows } = await supabase.from('settings').select('key, value').eq('key', 'flow_env');
const flowEnv = settingsRows?.[0]?.value;
const flowCheckoutBase = flowEnv === 'production' ? 'https://www.flow.cl/app/web/pay.php' : 'https://sandbox.flow.cl/app/web/pay.php';
const siteUrl = Astro.url.origin;

// Igual que en /admin/deudas: si el paciente tiene ficha, el link a mandar es
// el combinado /pagar/[id] (cobra TODO lo pendiente, no solo esta sesión —
// así se comporta Encuadrado). Sin ficha, se cae al link individual de Flow.
const { data: patientsRows } = await supabase.from('patients').select('id, email');
const patientIdByEmail: Record<string, string> = {};
(patientsRows ?? []).forEach((p: { id: string; email: string | null }) => {
  if (p.email) patientIdByEmail[p.email.toLowerCase()] = p.id;
});

const SESSION_LABELS: Record<string, string> = {
  'online': 'Individual Online', 'presencial': 'Individual Presencial',
  'pareja-online': 'Pareja Online', 'pareja-presencial': 'Pareja Presencial',
};

const formatCLP = (n: number) =>
  new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);
function formatDate(iso: string) {
  return new Date(iso + 'T00:00:00').toLocaleDateString('es-CL', { day: '2-digit', month: 'short', year: 'numeric' });
}

const pending = rows ?? [];
const errorLectura = rows === null;
const grandTotal = pending.reduce((s, b) => s + (b.amount ?? 0), 0);

const debtEmailSent = Astro.url.searchParams.get('debt_email_sent') === '1';
const errorParam    = Astro.url.searchParams.get('error');
const errorDetail   = Astro.url.searchParams.get('detail') ?? '';
---

<AdminLayout title="Sesiones por pagar" current="/admin/finanzas">

  <div class="pc-head" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.5rem;flex-wrap:wrap;">
    <div>
      <a href="/admin/finanzas" style="color:var(--stone);font-size:0.85rem;text-decoration:none;">← Pagos</a>
      <h1 style="margin-top:0.5rem;">Sesiones por pagar</h1>
      <p style="color:var(--stone);font-size:0.88rem;">Sesiones que todavía no ocurren y aún no se pagan. Aquí puedes mandarles el link de pago.</p>
    </div>
    <div style="text-align:right;">
      <p class="label" style="color:#b45309;">Total pendiente</p>
      <p style="font-size:1.4rem;font-weight:700;">{formatCLP(grandTotal)}</p>
    </div>
  </div>

  {debtEmailSent && (
    <div class="card" style="background:#f0fdf4;border-color:#bbf7d0;color:#15803d;padding:0.85rem 1.2rem;margin-bottom:1rem;font-size:0.85rem;">
      ✓ Link de pago enviado por correo al paciente.
    </div>
  )}
  {errorParam === 'patient_no_email' && (
    <div class="card" style="background:#fef2f2;border-color:#fecaca;color:#dc2626;padding:0.85rem 1.2rem;margin-bottom:1rem;font-size:0.85rem;">
      ⚠ Este paciente no tiene correo guardado en su ficha — no se pudo enviar el link.
    </div>
  )}
  {errorParam === 'no_debt' && (
    <div class="card" style="background:#fef2f2;border-color:#fecaca;color:#dc2626;padding:0.85rem 1.2rem;margin-bottom:1rem;font-size:0.85rem;">
      ⚠ Este paciente ya no tiene nada pendiente (puede que se haya pagado justo ahora).
    </div>
  )}
  {errorParam === 'email_failed' && (
    <div class="card" style="background:#fef2f2;border-color:#fecaca;color:#dc2626;padding:0.85rem 1.2rem;margin-bottom:1rem;font-size:0.85rem;">
      ⚠ No se pudo enviar el correo{errorDetail ? `: ${errorDetail}` : '.'}
    </div>
  )}
  {errorLectura && (
    <div class="card" style="background:#fef2f2;border-color:#fecaca;color:#dc2626;padding:0.85rem 1.2rem;margin-bottom:1rem;font-size:0.85rem;">
      ⚠ No se pudieron leer las sesiones por cobrar. Recarga en un rato.
    </div>
  )}
  {!pending.length ? (
    <div class="card" style="text-align:center;padding:3rem;">
      <p style="color:var(--stone);font-size:0.9rem;">{errorLectura ? 'Sin datos por ahora.' : 'No hay sesiones por cobrar.'}</p>
    </div>
  ) : (
    <div class="card tabla-cobro" style="padding:0;">
      <table>
        <thead>
          <tr>
            <th>Paciente</th>
            <th>Sesión</th>
            <th>Fecha</th>
            <th>Monto</th>
            <th>Link enviado</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          {pending.map((b) => {
            const waPhone = (b.patient_phone ?? '').replace(/\D/g, '');
            const waNumber = waPhone.length === 9 ? '56' + waPhone : waPhone;
            const patientId = b.patient_email ? patientIdByEmail[b.patient_email.toLowerCase()] : null;
            const payUrl = patientId
              ? `${siteUrl}/pagar/${patientId}`
              : (b.mp_preference_id ? `${flowCheckoutBase}?token=${b.mp_preference_id}` : null);
            const firstName = b.patient_name.split(' ')[0];
            // Sesión aún por venir: el recordatorio dice el plazo (24 h antes, 14 oct 2026).
            const hora = String(b.session_time ?? '').slice(0, 5);
            const plazo = b.session_date && /^\d{2}:\d{2}$/.test(hora) && hoursUntilSessionCL(b.session_date, hora) > 0
              ? `, ${frasePlazoPago(b.session_date, hora)}` : '';
            const extraPres = plazo ? `\n${AVISO_REAGENDAR}` : '';
            const waMsg = payUrl ? encodeURIComponent(
              patientId
                ? `Hola ${firstName}, te recuerdo el link de pago pendiente${plazo}: ${payUrl}\n${FORMAS_DE_PAGO}${extraPres}`
                : `Hola ${firstName}, te recuerdo el link de pago para tu sesión (${formatCLP(b.amount)})${plazo}: ${payUrl}${extraPres}`
            ) : '';
            // Paga en consulta (19 oct 2026): sin link de pago ni plazo de 24 h; se cobra en la sesión.
            const enConsulta = esPagoEnConsulta(b);
            const waUrl = !enConsulta && payUrl && waNumber.length >= 10 ? `https://wa.me/${waNumber}?text=${waMsg}` : null;
            return (
              <tr>
                <td class="pc-nom-td">
                  <p style="font-weight:600;font-size:0.88rem;">{b.patient_name}</p>
                  {b.patient_email && <p style="font-size:0.75rem;color:var(--stone);">{b.patient_email}</p>}
                </td>
                <td style="font-size:0.84rem;" data-label="Sesión">{SESSION_LABELS[b.session_type] ?? b.session_type}</td>
                <td style="font-size:0.84rem;color:var(--stone);" data-label="Fecha">{formatDate(b.session_date)}{b.session_time ? ` · ${b.session_time.slice(0,5)}` : ''}</td>
                <td style="font-weight:600;font-size:0.88rem;white-space:nowrap;" data-label="Monto">{formatCLP(b.amount)}</td>
                <td style="font-size:0.8rem;color:var(--stone);" data-label="Link enviado">{formatDate(b.created_at?.slice(0,10) ?? b.session_date)}</td>
                <td style="white-space:nowrap;" class="pc-acc-td">
                  {/* Igual que Encuadrado: dos íconos directos, sin desplegable. */}
                  {enConsulta && <span class="badge badge-consulta">{ETIQUETA_PAGO_EN_CONSULTA}</span>}
                  {waUrl && (
                    <a href={waUrl} target="_blank" title="Enviar por WhatsApp" class="icon-btn" data-tomar-cobro={b.status === 'pending_payment' ? b.id : undefined}
                      style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;background:#25D366;border-radius:6px;color:white;margin-right:0.35rem;">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                      </svg>
                    </a>
                  )}
                  {!enConsulta && patientId && b.patient_email && (
                    <button type="button" class="btn-send-debt-email icon-btn" data-patient={patientId} title="Enviar por correo"
                      style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;background:var(--ink);border-radius:6px;color:white;border:none;cursor:pointer;">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
                    </button>
                  )}
                  {!enConsulta && !waUrl && !(patientId && b.patient_email) && (
                    <span style="font-size:0.75rem;color:var(--stone);">Sin link guardado</span>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}

</AdminLayout>

<style>
  /* Celular (28 oct 2026): la tabla se desliza hacia el lado y la columna de
     acciones (WhatsApp, correo) queda fija a la derecha; antes quedaba cortada. */
  .tabla-cobro { overflow-x: auto; }
  @media (max-width: 768px) {
    .tabla-cobro > table > thead > tr > th:last-child,
    .tabla-cobro > table > tbody > tr > td:last-child:not([colspan]) {
      position: sticky; right: 0; background: white; box-shadow: -6px 0 6px -6px rgba(0,0,0,.18);
    }
  }
  /* Celular (rediseño 23 nov 2026): cada sesión es una tarjeta, con botones grandes de WhatsApp y correo. */
  @media (max-width: 768px) {
    .pc-head { margin-bottom: 12px !important; gap: 10px !important; }
    .pc-head > div:first-child > a { display: inline-flex; align-items: center; min-height: 44px; font-size: 16px !important; color: #2E332A !important; font-weight: 600; }
    .pc-head h1 { font: 700 28px/1.15 'Domine', Georgia, serif !important; color: #2E332A; margin-top: 0 !important; }
    .pc-head > div:first-child > p { font-size: 15px !important; }
    .pc-head > div:last-child { width: 100%; text-align: left !important; justify-content: space-between; }
    .pc-head > div:last-child > div { text-align: left !important; }
    .pc-head .btn { min-height: 44px; font-size: 15px !important; display: inline-flex; align-items: center; }
    .tabla-cobro { background: transparent !important; border: 0 !important; box-shadow: none !important; overflow: visible; }
    .tabla-cobro > table, .tabla-cobro > table > tbody, .tabla-cobro > table > tbody > tr, .tabla-cobro > table > tbody > tr > td { display: block; width: 100%; }
    .tabla-cobro > table > thead { display: none; }
    .tabla-cobro > table > tbody > tr { background: #fff; border-radius: 16px; box-shadow: 0 1px 2px rgba(46,51,42,.06), 0 4px 14px rgba(46,51,42,.06); padding: 12px 14px; margin-bottom: 10px; }
    .tabla-cobro > table > tbody > tr > td { border: 0 !important; padding: 3px 0 !important; font-size: 16px !important; position: static !important; box-shadow: none !important; white-space: normal !important; display: flex; justify-content: space-between; gap: 12px; }
    .tabla-cobro > table > tbody > tr > td.pc-nom-td { display: block; }
    .tabla-cobro > table > tbody > tr > td.pc-nom-td p:first-child { font-size: 18px !important; }
    .tabla-cobro td[data-label]::before { content: attr(data-label); color: #5F5E57; font-size: 14px; font-weight: 600; flex-shrink: 0; }
    .tabla-cobro td.pc-acc-td { display: flex; gap: 8px; padding-top: 10px !important; flex-wrap: wrap; }
    .tabla-cobro td.pc-acc-td .icon-btn { margin: 0 !important; width: auto !important; flex: 1; min-height: 48px; height: 48px !important; border-radius: 12px !important; gap: 8px; font-weight: 700; font-size: 16px; }
    .tabla-cobro td.pc-acc-td a.icon-btn::after { content: 'WhatsApp'; }
    .tabla-cobro td.pc-acc-td button.icon-btn::after { content: 'Correo'; }
  }
  .icon-btn { transition: transform .08s ease-out, filter .08s ease-out, opacity .1s; }
  .icon-btn:hover { filter: brightness(1.1); }
  .icon-btn:active { transform: scale(0.9); filter: brightness(0.85); }
</style>

<script>
(function () {
  document.addEventListener('click', (e) => {
    const sendDebtEmailBtn = e.target.closest('.btn-send-debt-email');
    if (sendDebtEmailBtn) {
      if (!confirm('¿Enviar el link de pago al correo del paciente?')) return;
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/api/admin/bookings';
      form.innerHTML = `
        <input type="hidden" name="action" value="send_debt_email">
        <input type="hidden" name="patient_id" value="${sendDebtEmailBtn.dataset.patient}">
        <input type="hidden" name="redirect" value="/admin/por-cobrar">
      `;
      document.body.appendChild(form);
      form.submit();
    }
  });
})();
</script>
