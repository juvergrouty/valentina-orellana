document.querySelectorAll('.cal-event').forEach(el => {
  el.addEventListener('click', e => {
    e.stopPropagation();
    try { openSessionDetail(JSON.parse(el.dataset.booking || '{}')); }
    catch {}
  });
});

// Cualquier acción del panel de sesión (marcar pagado, cobrar, reagendar,
// renombrar, etc.) recarga la página entera al enviarse — antes eso cerraba
// el panel sin dar ninguna señal de si funcionó, y había que volver a buscar
// y abrir la misma sesión para comprobarlo. Ahora: (1) el botón que se apretó
// muestra "Guardando…" al instante, para que el clic se sienta reconocido, y
// (2) el redirect lleva la sesión que estaba abierta, así la página vuelve a
// abrir ese mismo panel ya actualizado — se ve el resultado sin buscar nada.
document.getElementById('session-panel')?.addEventListener('submit', (e) => {
  const form = e.target;
  const redirectInput = form.querySelector('input[name="redirect"]');
  if (redirectInput && window.__currentSessionBookingId) {
    const sep = redirectInput.value.includes('?') ? '&' : '?';
    redirectInput.value += `${sep}booking=${window.__currentSessionBookingId}`;
  }
  const submitBtn = form.querySelector('button[type="submit"]');
  if (submitBtn) {
    submitBtn.dataset.originalText = submitBtn.textContent;
    submitBtn.textContent = 'Guardando…';
    submitBtn.disabled = true;
  }
});

// Al cargar la página, si venimos de una acción del panel (?booking=<id>),
// reabrirlo automáticamente con los datos ya actualizados.
{
  const reopenId = new URLSearchParams(location.search).get('booking');
  if (reopenId) {
    const match = document.querySelector(`.cal-event[data-booking*="${reopenId}"]`);
    if (match) {
      try {
        const parsed = JSON.parse(match.dataset.booking || '{}');
        if (parsed.id === reopenId) {
          openSessionDetail(parsed);
          match.scrollIntoView({ block: 'center', behavior: 'smooth' });
        }
      } catch {}
    }
  }
}

function openSessionDetail(b) {
  window.__currentSessionBookingId = b.id;
  document.getElementById('sp-service').textContent = b.service_label || b.session_type;

  // sessionConfirmed: la CITA está agendada/confirmada (no cancelada, no en
  // espera de un link de pago). isPaid: el PAGO se recibió de verdad — son dos
  // cosas distintas. Antes se usaba solo el status de la reserva para ambas,
  // por eso "Pago en consulta" quedaba mostrado como si ya estuviera pagado
  // apenas se agendaba, sin que la psicóloga hubiera cobrado todavía.
  const sessionConfirmed = b.status === 'confirmed';
  const isPaid    = !!b.paid_at;
  const isVoided  = !!b.debt_voided;
  const isNoShow  = !!b.no_show;
  const statusEl = document.getElementById('sp-status');
  if (isNoShow) {
    statusEl.textContent = 'Inasistencia';
    statusEl.className   = 'sp-status status-pending';
  } else {
    statusEl.textContent = sessionConfirmed ? 'Confirmada' : 'Pendiente de pago';
    statusEl.className   = 'sp-status ' + (sessionConfirmed ? 'status-confirmed' : 'status-pending');
  }

  document.getElementById('sp-patient-name').textContent = b.patient_name;
  // Email y teléfono son clicables (correo / WhatsApp directo, sin plantilla) —
  // igual que en Encuadrado, donde el panel de la cita permite contactar al
  // paciente sin salir de ahí.
  const infoDiv = document.getElementById('sp-patient-info');
  infoDiv.innerHTML = '';
  const infoWaDigits = (b.patient_phone || '').replace(/\D/g, '');
  const infoWaPhone  = infoWaDigits.length === 9 ? '56' + infoWaDigits : infoWaDigits;
  if (b.patient_email) {
    const a = document.createElement('a');
    a.href = `mailto:${b.patient_email}`;
    a.textContent = b.patient_email;
    a.className = 'sp-contact-link';
    infoDiv.appendChild(a);
  }
  if (b.patient_phone) {
    const a = document.createElement('a');
    a.href = infoWaPhone.length >= 11 ? `https://wa.me/${infoWaPhone}` : `tel:${b.patient_phone}`;
    a.target = '_blank'; a.rel = 'noopener';
    a.textContent = b.patient_phone;
    a.className = 'sp-contact-link';
    infoDiv.appendChild(a);
  }

  // Meet (stored as "Meet: https://..." in notes). Igual que Encuadrado:
  // "Ingresar a Google Meet" siempre visible en una sesión online, sin importar
  // si ya pagó — si el link no existe todavía, se genera al instante al hacer
  // clic (ver ensureMeetLink más abajo), y con ?authuser=<cuenta del negocio>
  // para que no dependa de cuál cuenta de Google esté activa en el navegador.
  const meetMatch = b.notes?.match(/Meet:\s*(https:\/\/\S+)/);
  const meetDiv   = document.getElementById('sp-meet-link');
  const isOnlineSession = b.session_type?.includes('online');
  if (isOnlineSession) {
    meetDiv.style.display = 'block';
    window.__currentMeetBookingId = b.id;
    window.__currentMeetUrl = meetMatch ? meetMatch[1] : null;
    const waDigits2 = (b.patient_phone || '').replace(/\D/g, '');
    const waPhone2  = waDigits2.length === 9 ? '56' + waDigits2 : waDigits2;
    window.__currentMeetWaPhone = waPhone2.length >= 11 ? waPhone2 : null;
    window.__currentMeetPatientFirstName = b.patient_name.split(' ')[0];
  } else {
    meetDiv.style.display = 'none';
  }

  // Marcar / quitar inasistencia
  document.getElementById('sp-no-show-id').value = b.id;
  document.getElementById('sp-no-show-action').value = isNoShow ? 'unmark_no_show' : 'mark_no_show';
  document.getElementById('sp-btn-no-show-label').textContent = isNoShow ? 'Quitar marca de inasistencia' : 'Marcar inasistencia';

  // Ver ficha link
  const fichaBtn = document.getElementById('sp-btn-ficha');
  const fichaFallback = b.patient_email
    ? `/admin/pacientes?q=${encodeURIComponent(b.patient_email)}`
    : `/admin/pacientes?q=${encodeURIComponent(b.patient_name)}`;
  fichaBtn.href = fichaFallback;

  // Escribir evolución: si ya tiene ficha, va directo al formulario de nota;
  // si no, cae en la misma búsqueda (la ficha aún no existe — se crea sola
  // en cuanto el paciente pague, o se crea a mano desde ahí).
  const evolBtn = document.getElementById('sp-btn-evolucion');
  evolBtn.href = b.patient_id ? `/admin/pacientes/${b.patient_id}?tab=notas#nueva-nota` : fichaFallback;

  // Recordar sesión por WhatsApp (manual — abre WhatsApp con el mensaje ya armado)
  const remWaBtn = document.getElementById('sp-btn-remind-wa');
  const waDigits = (b.patient_phone || '').replace(/\D/g, '');
  const waPhone  = waDigits.length === 9 ? '56' + waDigits : waDigits;
  const remTime  = b.session_time.slice(0, 5);
  if (waPhone.length >= 11) {
    const isOnlineRem = b.session_type?.includes('online');
    const whereLine = isOnlineRem
      ? 'Es una sesión online — te paso el link de la videollamada apenas se acerque la hora.'
      : (clinicAddress ? `Te espero en: ${clinicAddress}` : 'Es una sesión presencial en mi consulta.');
    const msg = `Hola ${b.patient_name.split(' ')[0]} 👋 Te recuerdo tu sesión del ${isoToLabel(b.session_date)} a las ${remTime}. ${whereLine}`;
    remWaBtn.href = `https://wa.me/${waPhone}?text=${encodeURIComponent(msg)}`;
    remWaBtn.style.display = '';
  } else {
    remWaBtn.style.display = 'none';
  }

  // Pedir reseña en Google (manual — abre WhatsApp con el link de reseña YA armado
  // para el PACIENTE, no para la psicóloga. Antes este botón abría reviewUrl en el
  // propio navegador de la admin, lo que la mandaba a ella a escribir la reseña.)
  const reviewBtn = document.getElementById('sp-btn-review-wa');
  if (reviewBtn) {
    if (waPhone.length >= 11 && typeof reviewUrl === 'string' && reviewUrl) {
      const reviewMsg = `Hola ${b.patient_name.split(' ')[0]} 👋 Si te sirvió nuestra sesión, me encantaría que me dejaras una reseña en Google (toma menos de un minuto): ${reviewUrl}`;
      reviewBtn.href = `https://wa.me/${waPhone}?text=${encodeURIComponent(reviewMsg)}`;
      reviewBtn.style.display = '';
    } else {
      reviewBtn.style.display = 'none';
    }
  }

  // "Cobrar" — una sola caja para CUALQUIER sesión sin pagar (recién reservada
  // con link ya generado, o ya confirmada/atendida y pendiente = deuda). Si el
  // paciente ya tiene ficha, se manda el link combinado /pagar/[id] — igual que
  // Encuadrado, cobra TODO lo pendiente (esta sesión + cualquier otra deuda),
  // no solo la sesión que se está mirando. Sin ficha, se cae al link individual
  // de esta sesión (solo existe si ya se había generado uno antes).
  const paylinkBox = document.getElementById('sp-paylink-box');
  const canSendPaylink = !isPaid && !isVoided && (b.patient_id || b.mp_preference_id);
  if (canSendPaylink) {
    const payUrl = b.patient_id ? `${window.location.origin}/pagar/${b.patient_id}` : `${flowCheckoutBase}?token=${b.mp_preference_id}`;
    const payMsg = `Hola ${b.patient_name.split(' ')[0]} 👋 Te comparto el link de pago: ${payUrl}`;
    const waPayBtn = document.getElementById('sp-paylink-wa');
    if (waPhone.length >= 11) {
      waPayBtn.href = `https://wa.me/${waPhone}?text=${encodeURIComponent(payMsg)}`;
      waPayBtn.style.display = '';
    } else {
      waPayBtn.style.display = 'none';
    }
    // El correo se manda de verdad desde el servidor (no un mailto: — eso solo
    // abre un borrador que hay que enviar a mano). Requiere ficha del paciente
    // (id) porque la acción recalcula ahí todo lo pendiente para incluirlo.
    const mailBtn = document.getElementById('sp-paylink-mail');
    if (b.patient_id && b.patient_email) {
      document.getElementById('sp-paylink-mail-patient').value = b.patient_id;
      mailBtn.onclick = () => {
        if (confirm('¿Enviar el link de pago al correo del paciente?')) {
          document.getElementById('sp-paylink-mail-form').submit();
        }
      };
      mailBtn.style.display = '';
    } else {
      mailBtn.style.display = 'none';
    }
    paylinkBox.style.display = 'block';
  } else {
    paylinkBox.style.display = 'none';
  }
  document.getElementById('sp-cobrar-menu').style.display = 'none';

  // Recordatorio automático (interruptor por reserva)
  const remEmail = document.getElementById('sp-rem-email');
  remEmail.checked = b.reminder_email_enabled !== false;
  remEmail.dataset.bookingId = b.id;
  const remReview = document.getElementById('sp-rem-review');
  remReview.checked = b.review_email_enabled === true;
  remReview.dataset.bookingId = b.id;
  document.getElementById('sp-rem-msg').style.display = 'none';

  // Amount & badge — refleja el pago REAL (paid_at), no el estado de la reserva.
  document.getElementById('sp-amount').textContent = formatCLP(b.amount);
  const badge = document.getElementById('sp-pay-badge');
  if (isVoided)     { badge.textContent = 'Deuda anulada'; badge.className = 'sp-pay-badge badge-manual'; }
  else if (isPaid)  { badge.textContent = b.payment_note ? `Pagado · ${b.payment_note}` : 'Pagado'; badge.className = 'sp-pay-badge badge-paid'; }
  else              { badge.textContent = 'Por pagar'; badge.className = 'sp-pay-badge badge-pending'; }

  const showMarkPaid = !isPaid && !isVoided;
  document.getElementById('sp-confirm-form').style.display = showMarkPaid ? 'block' : 'none';
  document.getElementById('sp-confirm-id').value    = b.id;
  document.getElementById('sp-void-debt-id').value  = b.id;
  document.getElementById('sp-mark-paid-rut').value = b.patient_rut || '';

  // "Anular pago" — deshacer un "Marcar como pagado" hecho por error.
  document.getElementById('sp-unmark-paid-box').style.display = (isPaid && !isVoided) ? 'block' : 'none';
  document.getElementById('sp-unmark-paid-id').value = b.id;

  // Date / time
  const dur  = b.duration_min ?? 50;
  const t5   = b.session_time.slice(0, 5);
  document.getElementById('sp-datetime').textContent = isoToLong(b.session_date);
  document.getElementById('sp-duration').textContent = `${t5} – ${addMins(t5, dur)} · ${dur} min`;

  const isOnline = b.session_type?.includes('online');
  // Dirección real de Configuración (antes decía "Las Condes" fijo, sin
  // reflejar la dirección configurada — igual bug que ya se corrigió en el
  // mensaje de WhatsApp de recordatorio, acá quedaba pendiente).
  const locLabel = clinicAddress || 'En mi consulta';
  document.getElementById('sp-location').innerHTML = isOnline
    ? '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;vertical-align:middle;margin-right:3px"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>Sesión online'
    : `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;vertical-align:middle;margin-right:3px"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>${locLabel}`;

  // Enviar la dirección presencial por WhatsApp — mismo patrón que el link de Meet.
  const locWaBtn = document.getElementById('sp-location-wa');
  if (!isOnline && locLabel) {
    const locWaDigits = (b.patient_phone || '').replace(/\D/g, '');
    const locWaPhone  = locWaDigits.length === 9 ? '56' + locWaDigits : locWaDigits;
    if (locWaPhone.length >= 11) {
      const locMsg = `Hola ${b.patient_name.split(' ')[0]} 👋 Te espero en: ${locLabel}`;
      locWaBtn.href = `https://wa.me/${locWaPhone}?text=${encodeURIComponent(locMsg)}`;
      locWaBtn.style.display = 'inline-flex';
    } else {
      locWaBtn.style.display = 'none';
    }
  } else {
    locWaBtn.style.display = 'none';
  }

  // Reagendar pre-fill
  document.getElementById('sp-rsc-id').value   = b.id;
  document.getElementById('sp-rsc-date').value = b.session_date;
  document.getElementById('sp-rsc-time').value = t5;
  document.getElementById('sp-rsc-notify').checked = false;
  document.getElementById('sp-rsc-form').style.display = 'none';

  // Cambiar servicio pre-fill
  document.getElementById('sp-svc-id').value = b.id;
  const svcSelect = document.getElementById('sp-svc-select');
  if (svcSelect && b.service_id) svcSelect.value = b.service_id;
  document.getElementById('sp-svc-form').style.display = 'none';

  // Renombrar / editar monto — guardan el id de la reserva actual
  document.getElementById('sp-rename-id').value      = b.id;
  document.getElementById('sp-edit-amount-id').value = b.id;

  // Cancel
  document.getElementById('sp-cancel-id').value = b.id;

  // Boleta de honorarios
  currentBookingId = b.id;
  const boletaRut = document.getElementById('sp-boleta-rut');
  if (boletaRut) boletaRut.value = b.patient_rut || '';
  document.getElementById('sp-boleta-form').style.display = 'none';
  const boletaResult  = document.getElementById('sp-boleta-result');
  const boletaActions = document.getElementById('sp-boleta-actions');
  if (boletaResult) { boletaResult.textContent = ''; boletaResult.style.color = ''; }
  if (boletaActions) boletaActions.style.display = 'none';
  const anularBoletaBox = document.getElementById('sp-anular-boleta-box');
  if (anularBoletaBox) anularBoletaBox.style.display = 'none';
  // Si ya se emitió (queda registrado en notes), avisar y mostrar acciones.
  // Toma la última línea "Boleta Folio N..." por si se anuló y se re-emitió.
  const boletaLines = [...(b.notes ?? '').matchAll(/Boleta\s+Folio\s+(\d+)[^\n]*/gi)];
  const lastBoleta = boletaLines.length ? boletaLines[boletaLines.length - 1][0] : null;
  const lastFolio  = boletaLines.length ? boletaLines[boletaLines.length - 1][1] : null;
  const boletaAnulada = lastBoleta ? /ANULADA/i.test(lastBoleta) : false;
  if (lastBoleta && boletaAnulada) {
    if (boletaResult) { boletaResult.textContent = `✕ Boleta anulada (Folio ${lastFolio}) — puedes emitir una nueva.`; boletaResult.style.color = '#b45309'; }
    document.getElementById('sp-boleta-form').style.display = 'block';
    if (boletaActions) boletaActions.style.display = 'none';
    const emitBtn = document.getElementById('sp-btn-emitir');
    if (emitBtn) emitBtn.style.display = '';   // se anuló — permite emitir una corregida
  } else if (lastBoleta) {
    if (boletaResult) { boletaResult.textContent = `✓ Ya emitida (Folio ${lastFolio})`; boletaResult.style.color = '#15803d'; }
    document.getElementById('sp-boleta-form').style.display = 'block';
    if (boletaActions) boletaActions.style.display = 'flex';
    if (anularBoletaBox) anularBoletaBox.style.display = 'block';
    const emitBtn = document.getElementById('sp-btn-emitir');
    if (emitBtn) emitBtn.style.display = 'none';   // ya emitida, ocultar re-emitir
  } else {
    const emitBtn = document.getElementById('sp-btn-emitir');
    if (emitBtn) emitBtn.style.display = '';
  }

  openSessionPanel();
}

// ── Recordatorios: guardar el interruptor al cambiarlo ────────────────────────
async function saveReminderToggle(input) {
  const bookingId = input.dataset.bookingId;
  const field = input.dataset.field;
  const msg = document.getElementById('sp-rem-msg');
  if (!bookingId) return;
  try {
    const fd = new FormData();
    fd.set('action', 'update-reminders');
    fd.set('id', bookingId);
    fd.set('field', field);
    fd.set('value', input.checked ? 'true' : 'false');
    const res = await fetch('/api/admin/bookings', { method: 'POST', body: fd });
    const data = await res.json().catch(() => ({}));
    if (res.ok && data.ok) {
      msg.textContent = '✓ Guardado';
      msg.style.color = '#15803d';
    } else {
      msg.textContent = data.error ?? 'No se pudo guardar (falta actualizar la base de datos).';
      msg.style.color = '#dc2626';
      input.checked = !input.checked; // revertir visualmente
    }
  } catch {
    msg.textContent = 'Error de conexión.';
    msg.style.color = '#dc2626';
    input.checked = !input.checked;
  }
  msg.style.display = 'block';
}
document.getElementById('sp-rem-email')?.addEventListener('change', (e) => saveReminderToggle(e.target));
document.getElementById('sp-rem-review')?.addEventListener('change', (e) => saveReminderToggle(e.target));

