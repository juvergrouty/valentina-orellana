// ── Anular boleta ya emitida ──────────────────────────────────────────────────
document.getElementById('sp-btn-anular-boleta')?.addEventListener('click', async () => {
  const btn    = document.getElementById('sp-btn-anular-boleta');
  const result = document.getElementById('sp-boleta-result');
  if (!currentBookingId) return;
  if (!confirm('¿Anular esta boleta de honorarios? Se anula el documento en el SII — esta acción no se puede deshacer. Después podrás emitir una nueva si corresponde.')) return;

  const causal = document.getElementById('sp-anular-causal')?.value || 'error_digitacion';
  btn.disabled = true;
  result.textContent = 'Anulando…'; result.style.color = '#6b7280';
  try {
    const res = await fetch('/api/admin/apigateway', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'anular', booking_id: currentBookingId, causal }),
    });
    const data = await res.json();
    if (data.ok) {
      result.textContent = `✕ Boleta anulada (Folio ${data.folio ?? ''}) — puedes emitir una nueva. Verifica en sii.cl que haya quedado anulada.`;
      result.style.color = '#b45309';
      document.getElementById('sp-boleta-actions').style.display = 'none';
      document.getElementById('sp-anular-boleta-box').style.display = 'none';
      document.getElementById('sp-btn-emitir').style.display = '';
    } else {
      result.textContent = '✕ ' + (data.error ?? 'No se pudo anular'); result.style.color = '#dc2626';
    }
  } catch {
    result.textContent = '✕ Error de conexión'; result.style.color = '#dc2626';
  } finally {
    btn.disabled = false;
  }
});

