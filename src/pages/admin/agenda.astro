// Genera el link de Meet la primera vez que se necesita (si aún no existe) y
// lo cachea — así "Ingresar", "Copiar" y "Enviar por WhatsApp" siempre usan el
// MISMO link, sin importar cuál se haya usado primero.
async function ensureMeetLink() {
  if (window.__currentMeetUrl) return window.__currentMeetUrl;
  const id = window.__currentMeetBookingId;
  if (!id) return null;
  try {
    const res = await fetch('/api/admin/generate-meet', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }),
    });
    const data = await res.json().catch(() => ({}));
    if (data.ok && data.meetLink) {
      window.__currentMeetUrl = data.meetLink;
      return data.meetLink;
    }
  } catch {}
  return null;
}

document.getElementById('sp-meet-href')?.addEventListener('click', async (e) => {
  e.preventDefault();
  const label = document.getElementById('sp-meet-href-label');
  const original = label.textContent;
  label.textContent = 'Generando…';
  const link = await ensureMeetLink();
  label.textContent = original;
  if (!link) { alert('No se pudo generar el link de Meet. Intenta de nuevo.'); return; }
  const business = `${link}${link.includes('?') ? '&' : '?'}authuser=vinculosquesostienen@gmail.com`;
  window.open(business, '_blank');
});

document.getElementById('sp-meet-share-toggle')?.addEventListener('click', (e) => {
  e.stopPropagation();
  const menu = document.getElementById('sp-meet-share-menu');
  menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
});
document.addEventListener('click', (e) => {
  const menu = document.getElementById('sp-meet-share-menu');
  if (menu && menu.style.display !== 'none' && !e.target.closest('#sp-meet-link')) menu.style.display = 'none';
});

document.getElementById('sp-meet-copy')?.addEventListener('click', async () => {
  const btn = document.getElementById('sp-meet-copy');
  const original = btn.textContent;
  btn.textContent = 'Generando…';
  const link = await ensureMeetLink();
  if (!link) { btn.textContent = 'Error'; setTimeout(() => { btn.textContent = original; }, 1500); return; }
  navigator.clipboard.writeText(link).then(() => {
    btn.textContent = '✓ Copiado';
    setTimeout(() => { btn.textContent = original; }, 1500);
  });
});

document.getElementById('sp-meet-wa')?.addEventListener('click', async (e) => {
  e.preventDefault();
  const link = await ensureMeetLink();
  if (!link) { alert('No se pudo generar el link de Meet. Intenta de nuevo.'); return; }
  const phone = window.__currentMeetWaPhone;
  if (!phone) { alert('El paciente no tiene un teléfono válido guardado.'); return; }
  const msg = `Hola ${window.__currentMeetPatientFirstName} 👋 Te comparto el link de Google Meet para tu sesión: ${link}`;
  window.open(`https://wa.me/${phone}?text=${encodeURIComponent(msg)}`, '_blank');
});

// ── Emitir boleta ───────────────────────────────────────────────────────────
let currentBookingId = null;
document.getElementById('sp-toggle-boleta')?.addEventListener('click', () => {
  const form = document.getElementById('sp-boleta-form');
  form.style.display = form.style.display === 'none' ? 'block' : 'none';
});
document.getElementById('sp-btn-emitir')?.addEventListener('click', async () => {
  const btn    = document.getElementById('sp-btn-emitir');
  const rut    = document.getElementById('sp-boleta-rut').value.trim();
  const result = document.getElementById('sp-boleta-result');
  if (!currentBookingId) return;
  if (!rut) { result.textContent = 'Ingresa el RUT del paciente.'; result.style.color = '#dc2626'; return; }
  // Confirmación en la misma página en vez de confirm() nativo — el diálogo
  // nativo bloquea el hilo del navegador hasta que alguien lo cierra a mano,
  // lo que además de verse feo puede dejar la página aparentemente "colgada".
  if (btn.dataset.confirming !== 'true') {
    btn.dataset.confirming = 'true';
    btn.textContent = '¿Confirmar? Genera un documento real en el SII — clic de nuevo';
    result.textContent = '';
    setTimeout(() => {
      if (btn.dataset.confirming === 'true') { btn.dataset.confirming = 'false'; btn.textContent = 'Emitir boleta'; }
    }, 8000);
    return;
  }
  btn.dataset.confirming = 'false';
  btn.textContent = 'Emitir boleta';

  btn.disabled = true;
  result.textContent = 'Emitiendo…'; result.style.color = '#6b7280';
  try {
    const res = await fetch('/api/admin/apigateway', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'emitir', booking_id: currentBookingId, rut }),
    });
    const data = await res.json();
    if (data.ok) {
      const folio = data.folio ? ` · Folio ${data.folio}` : '';
      result.textContent = `✓ Boleta emitida${folio}`; result.style.color = '#15803d';
      document.getElementById('sp-boleta-actions').style.display = 'flex';
      btn.style.display = 'none';
    } else {
      result.textContent = '✕ ' + (data.error ?? 'Error al emitir'); result.style.color = '#dc2626';
    }
  } catch {
    result.textContent = '✕ Error de conexión'; result.style.color = '#dc2626';
  } finally {
    btn.disabled = false;
  }
});

// ── Descargar PDF de la boleta ────────────────────────────────────────────────
document.getElementById('sp-btn-pdf')?.addEventListener('click', async () => {
  const result = document.getElementById('sp-boleta-result');
  if (!currentBookingId) return;
  result.textContent = 'Generando PDF…'; result.style.color = '#6b7280';
  try {
    const res  = await fetch('/api/admin/apigateway', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'pdf', booking_id: currentBookingId }),
    });
    const data = await res.json();
    if (data.ok && data.pdf) {
      // base64 → blob → descarga
      const bytes = Uint8Array.from(atob(data.pdf), c => c.charCodeAt(0));
      const url   = URL.createObjectURL(new Blob([bytes], { type: 'application/pdf' }));
      const a     = document.createElement('a');
      a.href = url; a.download = `boleta-${data.folio ?? 'honorarios'}.pdf`;
      document.body.appendChild(a); a.click(); a.remove();
      URL.revokeObjectURL(url);
      result.textContent = '✓ PDF descargado'; result.style.color = '#15803d';
    } else {
      result.textContent = '✕ ' + (data.error ?? 'No se pudo obtener el PDF'); result.style.color = '#dc2626';
    }
  } catch {
    result.textContent = '✕ Error al descargar'; result.style.color = '#dc2626';
  }
});

// ── Enviar boleta por email ─────────────────────────────────────────────────
document.getElementById('sp-btn-email')?.addEventListener('click', async (e) => {
  const btn = e.currentTarget;
  // Antes: sin bloqueo del botón, un doble/triple clic (o un clic mientras
  // "parecía" no responder) disparaba varios envíos reales del mismo correo
  // al paciente — esto es lo que causó el caso de la boleta enviada 3 veces.
  if (btn.disabled) return;
  btn.disabled = true;
  const result = document.getElementById('sp-boleta-result');
  if (!currentBookingId) { btn.disabled = false; return; }
  result.textContent = 'Enviando email…'; result.style.color = '#6b7280';
  try {
    const res  = await fetch('/api/admin/apigateway', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'email', booking_id: currentBookingId }),
    });
    const data = await res.json();
    if (data.ok) {
      result.textContent = `✓ Enviada a ${data.email}`; result.style.color = '#15803d';
    } else {
      result.textContent = '✕ ' + (data.error ?? 'No se pudo enviar'); result.style.color = '#dc2626';
    }
  } catch {
    result.textContent = '✕ Error al enviar'; result.style.color = '#dc2626';
  } finally {
    // Reactivado después de un momento, no de inmediato — evita que un
    // segundo clic accidental justo al terminar dispare otro envío real.
    setTimeout(() => { btn.disabled = false; }, 3000);
  }
});
</script>
