---
export const prerender = false;
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { CALENDARIO_COLEGIO } from '../../lib/calendarioColegio';
import { todayCL } from '../../lib/dateUtils';

// Página "Más" del rediseño (aprobada por Valentina el 22 nov 2026): todo lo que se usa menos,
// ordenado en grupos. Lo que no funciona quedó en "En pausa (proyectos futuros)": las páginas
// siguen existiendo, solo salieron del menú principal.

const hoy = todayCL();
const DIAS = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
const fecha = (iso: string) => { const [y, m, d] = iso.split('-').map(Number); const t = `${DIAS[new Date(Date.UTC(y, m - 1, d)).getUTCDay()]} ${d} de ${MESES[m - 1]}`; return t.charAt(0).toUpperCase() + t.slice(1); };
const colegio = CALENDARIO_COLEGIO.filter((d) => d.hasta >= hoy);

type Item = { href: string; titulo: string; desc: string; icono: string; nueva?: boolean };
const ic = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const grupos: Array<{ titulo: string; items: Item[] }> = [
  { titulo: 'Sesiones', items: [
    { href: '/admin/transcriptor', titulo: 'Transcriptor', desc: 'Grabaciones, resúmenes y gasto del mes', icono: ic('<rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v4"/>') },
    { href: '/admin/grabar', titulo: 'Grabar sesión', desc: 'Grabar una sesión presencial', icono: ic('<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3" fill="currentColor"/>') },
    { href: '/admin/sala-online', titulo: 'Sala online', desc: 'Tu sala de Meet para las sesiones online', icono: ic('<rect x="2" y="6" width="14" height="12" rx="2"/><path d="M16 10l6-3v10l-6-3"/>'), nueva: true },
  ] },
  { titulo: 'Tu consulta', items: [
    { href: '/admin/servicios', titulo: 'Servicios y precios', desc: 'Lo que se puede agendar en tu página', icono: ic('<path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>') },
    { href: '/admin/horarios', titulo: 'Feriados y días cerrados', desc: 'Cerrar fechas y decidir los feriados', icono: ic('<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M9 14l6 4M15 14l-6 4"/>') },
    { href: '#colegio', titulo: 'Calendario del colegio', desc: 'Avisos un mes antes de vacaciones y feriados', icono: ic('<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M8 14h3"/>') },
    { href: '/admin/comunicaciones', titulo: 'Correos automáticos', desc: 'Confirmación, recordatorio y Pasos a seguir', icono: ic('<path d="M4 4h16v12H5l-1 4z"/>') },
    { href: '/admin/evaluaciones', titulo: 'Reseñas en tu página', desc: 'Las reseñas de Google que se muestran', icono: ic('<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>') },
  ] },
  { titulo: 'Números', items: [
    { href: '/admin/reportes', titulo: 'Reportes', desc: 'Sesiones e ingresos por mes', icono: ic('<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>') },
    { href: '/admin/whatsapp-codigos', titulo: 'De dónde llegan tus pacientes', desc: 'Google, Instagram, anuncios y otros', icono: ic('<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/>') },
  ] },
  { titulo: 'Ajustes', items: [
    { href: '/admin/configuracion', titulo: 'Configuración', desc: 'Conexiones de Flow, emisión de boletas, Google Calendar y SumUp', icono: ic('<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>') },
    { href: '/admin/seguridad', titulo: 'Seguridad', desc: 'Entrar con Face ID o huella', icono: ic('<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>') },
  ] },
  { titulo: 'Soporte técnico', items: [
    { href: '/admin/logs', titulo: 'Errores de la página', desc: 'Fallas que revisa Claude. No tienes que hacer nada.', icono: ic('<path d="M12 9v4M12 17h.01M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>') },
  ] },
];
const pausa: Array<{ titulo: string; desc: string; href?: string }> = [
  { titulo: 'Vitrina de talleres', desc: 'Apagada y sin talleres creados.', href: '/admin/vitrina' },
  { titulo: 'Seguimientos automáticos', desc: 'Apagados. Nunca han enviado un mensaje.', href: '/admin/seguimientos' },
  { titulo: 'WhatsApp automático', desc: 'Tu WhatsApp Business no está conectado.', href: '/admin/whatsapp-conectar' },
  { titulo: 'Interesados y Plantillas', desc: 'Todavía no se construyeron.' },
  { titulo: 'Verificación contra robots', desc: 'Para el formulario de agenda. Todavía no se activa.' },
];
---

<AdminLayout title="Más" current="/admin/mas">
  <div class="mas">
    {grupos.map((g) => (
      <section>
        <h2>{g.titulo}</h2>
        <div class="grupo">
          {g.items.map((it) => (
            <a class="item" href={it.href} {...(it.nueva ? { target: '_blank', rel: 'noopener' } : {})}>
              <span class="ico" set:html={it.icono}></span>
              <span class="txt"><b>{it.titulo}</b><span>{it.desc}</span></span>
              <span class="flecha" aria-hidden="true">›</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section id="colegio">
      <h2>Calendario del colegio de tu hijo</h2>
      <div class="grupo">
        {colegio.map((d) => (
          <div class="item fijo">
            <span class="txt"><b>{fecha(d.desde)}{d.hasta !== d.desde ? ` al ${fecha(d.hasta).toLowerCase()}` : ''}</b><span>{d.que}{d.preliminar ? ' · versión preliminar del colegio' : ''}</span></span>
          </div>
        ))}
      </div>
      <p class="nota">Fuente: calendario oficial en lafase.cl. Te aviso en Hoy un mes antes de cada fecha. El de 2027 es una primera versión y puede cambiar.</p>
    </section>

    <details class="pausa">
      <summary><span><b>En pausa (proyectos futuros)</b><small>No están funcionando. Quedan aquí para retomarlos.</small></span><span class="flecha" aria-hidden="true">›</span></summary>
      {pausa.map((p) => p.href
        ? <a class="p-item" href={p.href}><b>{p.titulo}</b><span>{p.desc}</span></a>
        : <div class="p-item"><b>{p.titulo}</b><span>{p.desc}</span></div>)}
    </details>
  </div>
</AdminLayout>

<style>
  .mas { max-width: 760px; margin: 0 auto; font-size: 17px; color: #2E332A; }
  h2 { font-size: 15px; font-weight: 800; color: #5F5E57; margin: 20px 0 8px; }
  section:first-child h2 { margin-top: 0; }
  .grupo { background: #fff; border-radius: 18px; box-shadow: 0 1px 2px rgba(46,51,42,.06), 0 4px 14px rgba(46,51,42,.06); overflow: hidden; }
  .item { display: grid; grid-template-columns: 40px 1fr auto; gap: 12px; align-items: center; min-height: 64px; padding: 10px 14px; border-top: 1px solid #EFEBE5; text-decoration: none; color: inherit; }
  .item:first-child { border-top: 0; }
  .item:hover { background: #FAF7F4; }
  .item.fijo { grid-template-columns: 1fr; }
  .item.fijo:hover { background: none; }
  .ico { width: 40px; height: 40px; border-radius: 12px; background: #E6EBE3; color: #3F4A3B; display: grid; place-items: center; }
  .ico :global(svg) { width: 22px; height: 22px; }
  .txt b { display: block; font-size: 17px; }
  .txt span { display: block; font-size: 15px; color: #5F5E57; }
  .flecha { font-size: 22px; font-weight: 700; color: #5F5E57; }
  .nota { font-size: 14px; color: #5F5E57; margin-top: 8px; }
  .pausa { margin-top: 20px; background: #F3F0EB; border-radius: 18px; overflow: hidden; }
  .pausa summary { list-style: none; min-height: 60px; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 16px; cursor: pointer; }
  .pausa summary::-webkit-details-marker { display: none; }
  .pausa summary b { display: block; font-size: 16px; }
  .pausa summary small { display: block; font-size: 14px; color: #5F5E57; font-weight: 600; }
  .p-item { display: grid; gap: 2px; padding: 12px 16px; border-top: 1px solid #E4DED6; color: inherit; text-decoration: none; min-height: 48px; }
  .p-item b { font-size: 16px; }
  .p-item span { font-size: 15px; color: #5F5E57; }
</style>
