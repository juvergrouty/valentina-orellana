---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero   from '../../components/sections/PageHero.astro';
import Icon       from '../../components/ui/Icon.astro';
import { supabase } from '../../lib/supabase';
import { getStepsPageKey } from '../../lib/stepsPage';

// Página que Valentina manda por WhatsApp desde el panel del calendario
// ("Pasos a seguir" → WhatsApp). Mismo contenido que el correo de pasos a
// seguir (src/lib/email.ts::sendStepsEmail): si cambia uno, cambiar el otro.
// Genérica a propósito: sin nombre ni datos del paciente en la URL.
// Oculta (pedido de Valentina): solo se ve con la clave secreta del link que
// ella manda; sin la clave correcta responde "página no encontrada". Tampoco
// está en el menú ni en el sitemap, y no se indexa.
if (Astro.params.key !== await getStepsPageKey()) {
  return Astro.rewrite('/404');
}
const { data: addr } = await supabase.from('settings').select('value').eq('key', 'clinic_address').maybeSingle();
const clinicAddress = addr?.value?.trim() ?? '';

const pasos = [
  {
    icon: 'calendar',
    titulo: 'Confirmación de tu sesión',
    texto: 'Te llega un correo con la fecha, la hora y la modalidad de tu reserva. Revisa también tu carpeta de spam o promociones.',
  },
  {
    icon: 'video',
    titulo: 'Si tu sesión es online',
    texto: 'Se realiza por Google Meet. El enlace te llega en la invitación de tu calendario; solo tienes que entrar a la hora de la sesión desde un lugar tranquilo y privado.',
  },
  {
    icon: 'map-pin',
    titulo: 'Si tu sesión es presencial',
    texto: clinicAddress
      ? `La dirección de la consulta es ${clinicAddress}. Te recomiendo llegar unos minutos antes.`
      : 'Te confirmo la dirección exacta de la consulta por WhatsApp antes de tu primera sesión.',
  },
  {
    icon: 'shield',
    titulo: 'Boleta y reembolso',
    texto: 'Después de cada sesión te llega por correo tu boleta de honorarios electrónica emitida ante el SII. Guárdala: con ella puedes pedir el reembolso en tu prestador o seguro de salud, si corresponde.',
  },
  {
    icon: 'clock',
    titulo: 'Si necesitas reagendar',
    texto: 'Avísame con al menos 24 horas de anticipación. Con menos aviso puede no ser posible y la sesión se considera realizada.',
  },
  {
    icon: 'check',
    titulo: 'Valores de las sesiones',
    texto: 'Los valores pueden reajustarse hasta dos veces al año. Si estás en proceso, te aviso con al menos 30 días de anticipación.',
  },
];
---

<BaseLayout
  title="Pasos a seguir"
  description="Todo lo que necesitas saber antes de tu primera sesión con Ps. Valentina Orellana."
  noindex
>

  <PageHero label="Bienvenida/o a tu proceso" title="Pasos a seguir" />

  <section class="py-section bg-sand">
    <div class="container-site max-w-4xl">

      <p class="font-body text-base text-stone leading-relaxed max-w-2xl mb-12">
        Aquí tienes todo lo que necesitas saber para empezar tranquila/o: qué vas a recibir,
        cómo son las sesiones y qué hacer si necesitas cambiar algo.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-dust">
        {pasos.map((p, i) => (
          <div class="bg-white p-8 md:p-10">
            <div class="flex items-center gap-4 mb-5">
              <span class="label text-gold">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-stone"><Icon name={p.icon} size={24} /></span>
            </div>
            <h2 class="font-heading font-light text-xl text-ink mb-3 leading-snug">{p.titulo}</h2>
            <div class="divider mb-4"></div>
            <p class="font-body text-sm font-light text-stone leading-relaxed">{p.texto}</p>
          </div>
        ))}
      </div>

      <div class="mt-16 pt-10 border-t border-dust text-center">
        <p class="font-heading font-light text-2xl text-ink mb-3">¿Te quedó alguna duda?</p>
        <p class="font-body text-sm text-stone mb-8">Escríbeme y lo vemos antes de tu sesión.</p>
        <a href="https://wa.me/56972735696" target="_blank" rel="noopener noreferrer"
           class="btn-dark text-[10px] py-3.5 px-8">
          Escribir por WhatsApp
        </a>
        <p class="font-body text-xs text-stone mt-8">
          Revisa también las <a href="/condiciones" class="underline">condiciones del servicio y la política de privacidad</a>.
        </p>
      </div>

    </div>
  </section>

</BaseLayout>
