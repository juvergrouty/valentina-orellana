---
export const prerender = false;
import Layout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';
import { getTotalOwedByEmail, manualChargeLabel } from '../../lib/debt';

// Página pública (sin login) que el paciente abre desde el link que Valentina
// le manda por WhatsApp/email. A diferencia de un link de pago con monto fijo,
// esta página consulta la deuda REAL en el momento en que se abre — si el
// paciente ya pagó parte por otro medio, o si Valentina le mandó un link viejo,
// siempre muestra lo que realmente falta, nunca un monto atrasado.
const { id } = Astro.params;

const { data: patient } = await supabase
  .from('patients').select('id, name, email').eq('id', id!).maybeSingle();

const pending = patient?.email ? await getTotalOwedByEmail(patient.email) : [];
const total = pending.reduce((s, b) => s + b.amount, 0);

const SESSION_LABELS: Record<string, string> = {
  'online': 'Sesión individual online', 'presencial': 'Sesión individual presencial',
  'pareja-online': 'Sesión de pareja online', 'pareja-presencial': 'Sesión de pareja presencial',
};
const formatCLP = (n: number) =>
  new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);
function formatDate(iso: string) {
  if (iso === '2099-12-31') return '';
  return new Date(iso + 'T00:00:00').toLocaleDateString('es-CL', { day: '2-digit', month: 'long', year: 'numeric' });
}

const pendingJson = JSON.stringify({ patientId: patient?.id ?? null });

// Datos para transferir (Configuración → Pagos). Transferencia = excepción
// para quien no puede pagar con tarjeta: sube su comprobante y Valentina lo
// confirma desde el panel (ver src/lib/comprobantes.ts).
const { data: trRows } = await supabase.from('settings').select('key, value').like('key', 'transfer_%');
const tr: Record<string, string> = Object.fromEntries((trRows ?? []).map((r: { key: string; value: string }) => [r.key, (r.value ?? '').trim()]));
const datosTransferencia = [
  ['Titular', tr['transfer_account_holder']],
  ['RUT', tr['transfer_rut']],
  ['Banco', tr['transfer_bank_name']],
  ['Tipo de cuenta', tr['transfer_account_type']],
  ['N° de cuenta', tr['transfer_account_number']],
  ['Correo', tr['transfer_email']],
].filter(([, v]) => v) as [string, string][];
const datosCompletos = !!tr['transfer_account_number'];
const waDatos = `https://wa.me/56972735696?text=${encodeURIComponent('Hola Valentina, no puedo pagar con tarjeta. ¿Me envías los datos para transferir?')}`;
---

<Layout title="Pagar sesiones pendientes" description="Revisa y paga tus sesiones pendientes con Ps. Valentina Orellana." noindex>
  <section class="max-w-xl mx-auto px-5 py-16 md:py-24">
    {!patient ? (
      <div class="text-center">
        <p class="font-heading text-2xl mb-3">Link no válido</p>
        <p class="text-stone">Este link de pago no es correcto. Escríbele a Valentina para que te mande uno nuevo.</p>
      </div>
    ) : !pending.length ? (
      <div class="text-center">
        <p class="font-heading text-2xl mb-3">Hola {patient.name.split(' ')[0]} 🎉</p>
        <p class="text-stone">No tienes pagos pendientes en este momento.</p>
      </div>
    ) : (
      <>
        <p class="label text-stone mb-1">Hola {patient.name.split(' ')[0]}</p>
        <h1 class="font-heading text-2xl md:text-3xl mb-2">Sesiones por pagar</h1>
        <p class="text-stone text-sm mb-8">Revisa y paga las sesiones que tienes con Ps. Valentina Orellana.</p>

        <div class="border border-dust rounded-lg divide-y divide-dust mb-6">
          {pending.map((b) => (
            <div class="flex items-center justify-between px-5 py-4">
              <div>
                <p class="font-medium text-sm">{manualChargeLabel(b.notes) ?? SESSION_LABELS[b.session_type] ?? b.session_type}</p>
                {formatDate(b.session_date) && (
                  <p class="text-xs text-stone mt-0.5">{formatDate(b.session_date)}{b.session_time ? ` a las ${b.session_time.slice(0,5)}` : ''}</p>
                )}
              </div>
              <p class="font-medium text-sm whitespace-nowrap">{formatCLP(b.amount)}</p>
            </div>
          ))}
          <div class="flex items-center justify-between px-5 py-4 bg-sand">
            <p class="font-medium text-sm">Total a pagar</p>
            <p class="font-heading text-xl font-semibold">{formatCLP(total)}</p>
          </div>
        </div>

        <button type="button" id="btn-pagar" class="btn-dark w-full justify-center text-center">Ir a pagar</button>
        <p id="pagar-error" class="hidden text-sm text-red-600 text-center mt-3"></p>

        <!-- Transferencia (excepción) -->
        <div class="mt-6 text-center">
          <button type="button" id="btn-transfer-toggle" aria-expanded="false" aria-controls="transfer-box"
            class="text-sm text-stone underline underline-offset-4 hover:text-ink">
            ¿No puedes pagar con tarjeta de débito o crédito?
          </button>
        </div>
        <div id="transfer-box" hidden class="mt-5 border border-dust rounded-lg p-5 text-left">
          <p class="font-medium text-sm mb-1">Puedes pagar por transferencia</p>
          <p class="text-xs text-stone mb-4">1. Transfiere <strong>{formatCLP(total)}</strong> a esta cuenta. 2. Sube aquí la foto o captura del comprobante.</p>
          {datosCompletos ? (
            <dl class="divide-y divide-dust text-sm mb-5">
              {datosTransferencia.map(([k, v]) => (
                <div class="flex items-center justify-between gap-3 py-2">
                  <dt class="text-stone">{k}</dt>
                  <dd class="flex items-center gap-2 min-w-0">
                    <span class="font-medium break-all">{v}</span>
                    <button type="button" class="copy-btn text-xs border border-dust rounded px-2 py-0.5 hover:border-ink" data-copy={v}>Copiar</button>
                  </dd>
                </div>
              ))}
            </dl>
          ) : (
            <p class="text-sm mb-5"><a href={waDatos} target="_blank" rel="noopener" class="underline">Escríbeme por WhatsApp y te mando los datos para transferir</a>.</p>
          )}
          <form id="transfer-form" class="flex flex-col gap-3">
            <label for="comprobante" class="text-sm font-medium">Comprobante de la transferencia</label>
            <input id="comprobante" name="comprobante" type="file" accept="image/*,application/pdf" required
              class="text-sm file:mr-3 file:border file:border-dust file:bg-white file:px-3 file:py-1.5 file:text-sm" />
            <button type="submit" id="btn-comprobante" class="btn-dark w-full justify-center text-center">Enviar comprobante</button>
            <p id="transfer-msg" class="hidden text-sm text-center" role="status" aria-live="polite"></p>
          </form>
        </div>
        <p class="text-xs text-stone text-center mt-6">Si tienes dudas sobre los montos o las sesiones, escríbele directamente a Valentina.</p>
      </>
    )}
  </section>
</Layout>

<script define:vars={{ pendingJson }}>
// Transferencia: mostrar datos, copiar y subir el comprobante.
(function () {
  const toggle = document.getElementById('btn-transfer-toggle');
  const box = document.getElementById('transfer-box');
  if (!toggle || !box) return;
  toggle.addEventListener('click', () => {
    box.hidden = !box.hidden;
    toggle.setAttribute('aria-expanded', String(!box.hidden));
  });
  document.querySelectorAll('.copy-btn').forEach((b) => {
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy); b.textContent = 'Copiado'; }
      catch { b.textContent = 'Mantén presionado para copiar'; }
      setTimeout(() => { b.textContent = 'Copiar'; }, 2000);
    });
  });

  // Fotos grandes del celular: se achican antes de subir (máx. 4 MB en el servidor).
  async function achicar(file) {
    if (!file.type.startsWith('image/') || file.size <= 3.5 * 1024 * 1024) return file;
    try {
      const img = await createImageBitmap(file);
      const escala = Math.min(1, 1800 / Math.max(img.width, img.height));
      const c = document.createElement('canvas');
      c.width = Math.round(img.width * escala); c.height = Math.round(img.height * escala);
      c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
      const blob = await new Promise((r) => c.toBlob(r, 'image/jpeg', 0.82));
      return blob ? new File([blob], 'comprobante.jpg', { type: 'image/jpeg' }) : file;
    } catch { return file; }
  }

  const form = document.getElementById('transfer-form');
  const msg = document.getElementById('transfer-msg');
  const btn = document.getElementById('btn-comprobante');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = document.getElementById('comprobante');
    if (!input.files || !input.files[0]) return;
    btn.disabled = true; btn.textContent = 'Enviando…';
    msg.classList.add('hidden');
    try {
      const fd = new FormData();
      fd.set('patientId', JSON.parse(pendingJson).patientId);
      fd.set('comprobante', await achicar(input.files[0]));
      const res = await fetch('/api/comprobante-transferencia', { method: 'POST', body: fd });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.ok) {
        form.innerHTML = '<p class="text-sm text-center leading-relaxed"><strong>¡Listo! Recibí tu comprobante.</strong><br>Apenas confirme la transferencia te llegará la boleta a tu correo. No necesitas hacer nada más.</p>';
        return;
      }
      msg.textContent = data.error ?? 'No se pudo enviar el comprobante. Intenta de nuevo.';
    } catch {
      msg.textContent = 'Error de conexión. Intenta de nuevo.';
    }
    msg.className = 'text-sm text-center text-red-600';
    btn.disabled = false; btn.textContent = 'Enviar comprobante';
  });
})();

(function () {
  const btn = document.getElementById('btn-pagar');
  if (!btn) return;
  const { patientId } = JSON.parse(pendingJson);
  const errEl = document.getElementById('pagar-error');

  btn.addEventListener('click', async () => {
    btn.disabled = true;
    btn.textContent = 'Preparando pago…';
    errEl.classList.add('hidden');
    try {
      const res = await fetch('/api/pagar-deuda', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ patientId }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        errEl.textContent = data.error ?? 'No se pudo iniciar el pago. Intenta de nuevo.';
        errEl.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Ir a pagar';
        return;
      }
      window.location.href = data.paymentUrl;
    } catch {
      errEl.textContent = 'Error de conexión. Intenta de nuevo.';
      errEl.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Ir a pagar';
    }
  });
})();
</script>
