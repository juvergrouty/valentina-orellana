---
// /hora/<token> (22 nov 2026): el link que recibe la paciente. El código va a una cookie corta
// (solo para /hora) y se redirige a /hora sin nada en la URL, como /confirmacion (8 oct 2026):
// así Google Tag Manager (que mide en /hora) nunca recibe un enlace que abra los datos de la paciente.
// El #datos del final, si viene, el navegador lo conserva en la redirección.
export const prerender = false;
import { tokenValido } from '../../lib/horaLinkUtil';
import { COOKIE_HORA } from '../../lib/horaLink';

const { token } = Astro.params;
Astro.response.headers.set('Cache-Control', 'private, no-store');
if (!tokenValido(token)) return Astro.redirect('/hora', 302);
Astro.cookies.set(COOKIE_HORA, token, {
  path: '/', httpOnly: true, secure: import.meta.env.PROD, sameSite: 'lax', maxAge: 60 * 60 * 24 * 30,
});
const vista = Astro.url.searchParams.get('vista') === 'vale' ? '?vista=vale' : '';
return Astro.redirect(`/hora${vista}`, 302);
---
