---
import BaseLayout   from '../layouts/BaseLayout.astro';
import PageHero     from '../components/sections/PageHero.astro';
import Testimonials from '../components/sections/Testimonials.astro';
// Se arma en cada visita (como la portada): si no, las reseñas de Google
// quedaban congeladas en las del último deploy.
export const prerender = false;
---

<BaseLayout title="Opiniones de pacientes" description="Reseñas reales en Google de pacientes de la Ps. Valentina Orellana, psicóloga de adultos y parejas en Las Condes y online.">

  <!-- Banner: detalle de la sala de la consulta (foto propia, 12 oct 2026); antes
       usaba la imagen genérica por defecto de PageHero. -->
  <PageHero label="Experiencias reales" title="Opiniones" image="/images/consulta-detalle-ancho-1600.webp" imageMobile="/images/consulta-detalle-800.webp" />

  <Testimonials />

  <!-- CTA (14 oct 2026, pedido de Vale): quien llega desde el enlace "Reseñas"
       del anuncio de Google pasa a Servicios, donde elige individual o pareja. -->
  <section class="py-14 md:py-20 bg-ink text-center">
    <div class="container-site max-w-lg">
      <p class="font-heading font-light text-3xl md:text-4xl text-sand mb-3">
        ¿Quieres dar<br />el primer paso?
      </p>
      <p class="font-body text-sm text-sand/60 font-light">Terapia individual o de pareja · Online o en Las Condes</p>
      <div class="divider-center bg-sand/20 my-7"></div>
      <a href="/servicios" data-cta="opiniones_reservar" class="btn bg-sand text-ink hover:bg-gold hover:text-white text-[10px] tracking-widest2 uppercase py-3.5 px-8 transition-all duration-300">
        Reservar mi hora
      </a>
    </div>
  </section>

</BaseLayout>
