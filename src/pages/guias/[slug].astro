---
// Guías gratuitas para seguidores (9 nov 2026). Quien comenta la palabra en Instagram (PAUSA, HIJOS,
// SOLTAR, FRASES) recibe por mensaje privado el enlace a esta página con UTM (utm_source=instagram,
// utm_medium=dm, utm_campaign=guia_<slug>). Los botones llevan data-cta para GTM y el WhatsApp usa el
// código de seguimiento de BaseLayout, así se mide guía → WhatsApp → sesión.
import BaseLayout from '../../layouts/BaseLayout.astro';
import guias from '../../data/guias.json';

export function getStaticPaths() {
  return Object.keys(guias).map((slug) => ({ params: { slug } }));
}

type Guia = { palabra: string; titulo: string; sub: string; secciones: { titulo: string; intro: string; puntos: string[] }[]; cierre: string };
const { slug } = Astro.params;
const g = (guias as Record<string, Guia>)[slug!];
const textoWa = encodeURIComponent(`Hola Valentina, leí tu guía "${g.titulo}" y me gustaría conversar.`);
---

<BaseLayout title={`${g.titulo} · Guía gratuita`} description={`${g.sub}. Guía gratuita de Valentina Orellana, psicóloga de adultos y parejas.`}>
  <section class="bg-forest text-white py-16 md:py-24">
    <div class="container-site max-w-3xl">
      <p class="label mb-4 !text-white/80">Guía gratuita</p>
      <h1 class="font-heading text-3xl md:text-5xl leading-tight mb-5">{g.titulo}</h1>
      <p class="body-text !text-white/90 font-normal mb-8">{g.sub}</p>
      <a href={`/guias/${slug}.pdf`} download class="btn bg-white text-forest px-8 py-3.5 hover:bg-sand justify-center" data-cta={`guia_${slug}_pdf`}>Descargar en PDF</a>
    </div>
  </section>

  <section class="bg-sand py-14 md:py-20">
    <div class="container-site max-w-3xl space-y-12">
      {g.secciones.map((s, i) => (
        <article>
          <p class="label mb-2">{String(i + 1).padStart(2, '0')} / {String(g.secciones.length).padStart(2, '0')}</p>
          <h2 class="card-title text-2xl md:text-3xl mb-3">{s.titulo}</h2>
          {s.intro && <p class="body-text text-[#4a4842] font-normal mb-4">{s.intro}</p>}
          <ul class="space-y-3">
            {s.puntos.map((p) => (
              <li class="flex gap-4 body-text text-ink"><span aria-hidden="true" class="mt-3 h-2 w-2 shrink-0 rounded-full bg-gold"></span><span>{p}</span></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-white border-t border-dust py-14 md:py-20">
    <div class="container-site max-w-3xl">
      <p class="font-heading text-xl md:text-2xl leading-snug text-ink mb-8">{g.cierre}</p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href={`https://wa.me/56972735696?text=${textoWa}`} target="_blank" rel="noopener" class="btn-dark justify-center" data-cta={`guia_${slug}_whatsapp`}>Escribir por WhatsApp</a>
        <a href="/agenda" class="btn-outline justify-center" data-cta={`guia_${slug}_agenda`}>Ver horarios</a>
      </div>
      <p class="body-sm text-stone font-normal mt-6">Online o presencial en Las Condes. Sesiones de 50 minutos.</p>
    </div>
  </section>
</BaseLayout>
