---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero   from '../components/sections/PageHero.astro';
import AgendaOpciones from '../components/landing/AgendaOpciones.astro';
import { DIRECCION } from '../data/consulta';

// Página de destino de terapia individual (14 oct 2026): los anuncios de Google
// llevaban a la agenda de 4 pasos; el anuncio promete "Respondo personalmente tu
// WhatsApp" y esta página ofrece eso o agendar directo en el calendario.
// También es la página SEO para "terapia individual adultos" (plan SEO 8 oct).

const senales = [
  'Entiendes de dónde viene lo que te pasa, pero lo sigues repitiendo.',
  'La ansiedad o el estrés te están ocupando más espacio del que quisieras.',
  'Tus relaciones se repiten: cómo eliges, cómo reaccionas, qué toleras.',
  'Estás pasando por un duelo, una separación o un cambio grande.',
  'Quieres conocerte mejor y decidir con más claridad.',
];

const pasos = [
  { n: '01', t: 'Escucharte', d: 'En la primera sesión me cuentas qué te pasa y qué esperas. Definimos juntos por dónde empezar.' },
  { n: '02', t: 'Entender el patrón', d: 'Miramos qué se repite en tu vida y qué lo sostiene, desde tu historia y tu presente.' },
  { n: '03', t: 'Construir otra respuesta', d: 'Trabajamos de forma concreta para que puedas responder distinto, a tu ritmo.' },
];

const faq = [
  { q: '¿La sesión es online o presencial?', a: `Como prefieras: online por Google Meet desde cualquier lugar de Chile, o presencial en ${DIRECCION.calle}, Las Condes. Las dos modalidades duran 50 minutos y tienen el mismo valor.` },
  { q: '¿Puedo pedir reembolso en mi Isapre o seguro?', a: 'Por cada sesión recibes boleta de honorarios para pedir reembolso en tu Isapre o seguro complementario, según tu plan. No trabajo con convenios ni bonos.' },
  { q: '¿Qué pasa si no puedo asistir?', a: 'Puedes reagendar tu hora sin costo avisando con al menos 24 horas de anticipación.' },
  { q: '¿Cuántas sesiones voy a necesitar?', a: 'Depende de lo que quieras trabajar. En las primeras sesiones conversamos un plan y lo vamos revisando juntos.' },
  { q: '¿Atiendes urgencias?', a: 'No. Si estás en crisis, llama al *4141 (gratis, 24/7) o acude al servicio de urgencia más cercano.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
  title="Terapia individual para adultos, online y en Las Condes"
  description={`Terapia individual para adultos con la Ps. Valentina Orellana, online a todo Chile o presencial en ${DIRECCION.calle}, Las Condes. Sesiones de 50 minutos, $65.000. Boleta para reembolso Isapre.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

  <PageHero
    label="Terapia individual · Online y Las Condes"
    title="Terapia psicológica para adultos"
    description="Un espacio para entender qué te está pasando y empezar a responder distinto."
    image="/images/sala-espera-ancho-1600.webp"
    imageMobile="/images/sala-espera-800.webp"
  />

  <!-- Arriba del pliegue: las dos formas de agendar, lo que promete el anuncio. -->
  <section class="bg-warm border-b border-dust py-10 md:py-14">
    <div class="container-site grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-center">
      <div>
        <p class="body-text text-ink font-medium mb-2">Online a todo Chile o presencial en Las Condes · Sesión de 50 min · $65.000</p>
        <p class="body-sm text-[#55524b] font-normal mb-2">Boleta para reembolso en tu Isapre o seguro de salud, según tu plan. Reagendas sin costo avisando con 24 horas.</p>
        <p class="body-sm text-[#55524b] font-normal">★ 5,0 en Google · Psicóloga con registro en la Superintendencia de Salud</p>
      </div>
      <AgendaOpciones grupo="individual" lugar="individual_landing" />
    </div>
  </section>

  <section class="bg-sand py-16 md:py-24">
    <div class="container-site grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16">
      <div class="md:col-span-5">
        <p class="label mb-3">¿Cuándo consultar?</p>
        <h2 class="section-title">Puede ser el momento si…</h2>
      </div>
      <ul class="md:col-span-7 space-y-4">
        {senales.map(s => (
          <li class="flex gap-4 border-b border-dust pb-4 body-text text-[#4a4842] font-normal"><span aria-hidden="true" class="text-forest">—</span><span>{s}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-warm border-y border-dust py-16 md:py-24">
    <div class="container-site">
      <p class="label mb-3">Cómo trabajo</p>
      <h2 class="section-title mb-10 md:mb-14 max-w-2xl">Terapia con dirección, no solo un lugar para contar lo mismo</h2>
      <ol class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {pasos.map(p => (
          <li class="bg-white border border-dust rounded-[6px] p-7">
            <p class="font-heading text-3xl text-gold mb-4">{p.n}</p>
            <p class="card-title text-xl mb-3">{p.t}</p>
            <p class="body-sm text-[#55524b] font-normal">{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-sand py-16 md:py-24">
    <div class="container-site grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16">
      <div>
        <p class="label mb-3">Primera sesión</p>
        <h2 class="section-title mb-6">Cómo empezamos</h2>
        <p class="body-text text-[#4a4842] font-normal mb-4">
          Sesiones de 50 minutos, presenciales en {DIRECCION.calle}, {DIRECCION.detalle}, {DIRECCION.comuna}, u online por Google Meet.
          En la primera sesión te escucho y definimos juntos cómo seguir. Sin presión ni compromisos.
        </p>
        <p class="body-text text-ink font-medium mb-2">Valor: $65.000 por sesión.</p>
        <p class="body-sm text-[#55524b] font-normal">Por cada sesión recibes boleta de honorarios para pedir reembolso en tu Isapre o seguro complementario, según tu plan.</p>
      </div>
      <div class="flex flex-col justify-center md:items-start">
        <AgendaOpciones grupo="individual" lugar="individual_fin" />
      </div>
    </div>
  </section>

  <section class="bg-warm border-t border-dust py-16 md:py-24">
    <div class="container-site max-w-3xl">
      <p class="label mb-3">Preguntas frecuentes</p>
      <h2 class="section-title mb-8">Lo que suelen preguntarme</h2>
      <div class="divide-y divide-dust border-y border-dust">
        {faq.map(f => (
          <details class="group py-5">
            <summary class="cursor-pointer list-none flex justify-between gap-4 font-body text-base text-ink font-medium">
              {f.q}<span aria-hidden="true" class="text-forest transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="body-sm text-[#55524b] font-normal mt-3">{f.a}</p>
          </details>
        ))}
      </div>
      <p class="body-sm mt-8">Este espacio no atiende urgencias. Si estás en crisis, llama al *4141 (gratis, 24/7) o acude al servicio de urgencia más cercano.</p>
    </div>
  </section>
</BaseLayout>
