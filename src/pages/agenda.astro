---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import CamposContacto from '../components/CamposContacto.astro';
import { supabase } from '../lib/supabase';

const formatCLP = (n: number) =>
  new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);

// Verificar si el pago en consulta está habilitado
const { data: settingsRows } = await supabase.from('settings').select('key, value');
const settings: Record<string, string> = {};
(settingsRows ?? []).forEach(({ key, value }: { key: string; value: string }) => { settings[key] = value; });
// Pago en consulta y transferencia NO se ofrecen en la web (Valentina, 3 oct
// 2026): pago en consulta hasta tener tap to pay; la transferencia queda como
// excepción que ella coordina por WhatsApp. Ambos confirmaban la hora sin
// ningún pago. Los ajustes de Configuración ya no los muestran aquí.
const manualPaymentEnabled    = false && settings['manual_payment_enabled'] !== 'false';
const transferPaymentEnabled  = false && settings['transfer_payment_enabled'] === 'true';
const recaptchaSiteKey        = settings['recaptcha_site_key'] ?? '';

// Pre-selección de grupo desde URL (ej: /agenda?grupo=individual)
const grupoParam    = Astro.url.searchParams.get('grupo')    ?? null;
const servicioParam = Astro.url.searchParams.get('servicio') ?? null;

const { data: catalogServices } = await supabase
  .from('services_catalog')
  .select('id, name, description, type, modality, price, duration_min, price_online, price_presencial, duration_min_online, duration_min_presencial')
  .eq('visible', true)
  .order('sort_order')
  .order('created_at');
---

<BaseLayout
  title="Psicóloga Las Condes | Adultos y Parejas"
  description="Reserva tu hora con Ps. Valentina Orellana: terapia para adultos y parejas, presencial en Las Condes u online. Agenda y paga en línea de forma simple y segura."
>
  <section class="relative overflow-hidden min-h-[300px] md:min-h-[360px] flex items-end border-b border-dust">
    <img src="/images/hero-paginas.jpg" alt="" class="absolute inset-0 w-full h-full object-cover object-center" aria-hidden="true" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/30 to-ink/10"></div>
    <div class="relative z-10 container-site py-14 md:py-20 w-full">
      <p class="label text-white/60 mb-3">Agenda en línea</p>
      <div class="w-10 h-0.5 bg-white/30 mb-5"></div>
      <h1 class="font-heading font-semibold text-white leading-tight mb-4" style="font-size:clamp(2rem,5vw,3.8rem);letter-spacing:-0.02em;">
        Reserva tu sesión
      </h1>
      <p class="font-body text-white/75 font-light text-lg max-w-lg leading-relaxed">Elige tu horario y paga de forma segura con Flow.</p>
    </div>
  </section>

  <!-- Indicador de pasos -->
  <div id="booking-bar" class="bg-white border-b border-dust sticky top-[72px] md:top-[80px] z-40">
    <div class="container-site py-4">
      <div class="flex items-center gap-2 md:gap-4">
        {['Tipo de sesión', 'Fecha y hora', 'Tus datos', 'Pago'].map((label, i) => (
          <div class="flex items-center gap-2 flex-1">
            <div
              id={`step-indicator-${i + 1}`}
              class="w-6 h-6 flex items-center justify-center text-[10px] tracking-widest font-body flex-shrink-0 transition-all duration-200 step-indicator border border-dust text-stone"
              data-step={i + 1}
            >
              {i + 1}
            </div>
            <span
              id={`step-label-${i + 1}`}
              class="hidden md:block font-body text-[10px] tracking-widest uppercase step-label text-stone"
              data-step={i + 1}
            >
              {label}
            </span>
            {i < 3 && <div class="flex-1 h-px bg-dust ml-1"></div>}
          </div>
        ))}
      </div>
    </div>
  </div>

  <section class="py-section bg-sand">
    <div class="container-site">

      <!-- Resumen del servicio elegido (visible en pasos 2-4) -->
      <div id="service-summary" class="hidden mb-8 flex items-center gap-3 border border-dust bg-white px-5 py-4 rounded-sm max-w-2xl">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#576352" stroke-width="1.75" class="flex-shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/>
        </svg>
        <div class="min-w-0">
          <p id="summary-name" class="font-heading font-semibold text-base text-ink leading-tight"></p>
          <p id="summary-detail" class="font-body text-sm text-stone"></p>
        </div>
      </div>

      <!-- ── PASO 1: Tipo de sesión ─────────────────────────────────────── -->
      <div id="step-1" class="booking-step">
        <p class="label text-stone mb-4">Paso 1</p>
        <div class="divider mb-6"></div>
        <h2 class="font-heading font-light text-3xl text-ink mb-8">¿Para quién es la sesión?</h2>

        <!-- 1a: Elegir grupo (Individual / Pareja) -->
        <div id="group-selection" class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl">
          <button type="button" class="group-card bg-white border border-dust text-left p-8 hover:bg-warm hover:border-forest/40 transition-all duration-200 cursor-pointer" data-group="individual">
            <div class="icon-circle mb-5 pointer-events-none">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/></svg>
            </div>
            <p class="font-heading font-semibold text-2xl text-ink mb-2">Individual</p>
            <p class="font-body text-sm text-stone font-light">Sesión de psicología para ti</p>
          </button>
          <button type="button" class="group-card bg-white border border-dust text-left p-8 hover:bg-warm hover:border-forest/40 transition-all duration-200 cursor-pointer" data-group="pareja">
            <div class="icon-circle mb-5 pointer-events-none">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg>
            </div>
            <p class="font-heading font-semibold text-2xl text-ink mb-2">Pareja</p>
            <p class="font-body text-sm text-stone font-light">Sesión para ambos</p>
          </button>
        </div>

        <!-- 1b: Elegir servicio — aparece al elegir grupo -->
        <div id="service-selection" class="hidden mt-10">
          <button type="button" id="back-to-group" class="label text-stone hover:text-ink transition-colors mb-6 flex items-center gap-2">← Volver</button>
          <h2 class="font-heading font-light text-3xl text-ink mb-2">¿Qué tipo de sesión necesitas?</h2>
          <p id="service-subtitle" class="font-body text-sm text-stone mb-8"></p>
          <div id="service-cards" class="flex flex-col gap-4 max-w-2xl"></div>
        </div>

        <!-- 1c: Modalidad para servicio pre-seleccionado (viene de /servicios) -->
        <div id="modality-for-service" class="hidden mt-4">
          <button type="button" id="back-to-servicios" class="label text-stone hover:text-ink transition-colors mb-8 flex items-center gap-2">← Volver a servicios</button>
          <p class="label text-stone mb-4">Paso 1</p>
          <div class="divider mb-6"></div>
          <p id="presel-service-name" class="font-heading font-semibold text-2xl text-ink mb-2"></p>
          <p id="presel-service-desc" class="font-body text-sm text-stone mb-8 leading-relaxed"></p>
          <h2 class="font-heading font-light text-3xl text-ink mb-8">¿Online o presencial?</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl">
            <button type="button" id="presel-online-btn"
              class="bg-white border border-dust text-left p-8 hover:bg-warm hover:border-forest/40 transition-all duration-200 cursor-pointer">
              <p class="label text-forest mb-3">Desde cualquier lugar</p>
              <p class="font-heading font-semibold text-2xl text-ink mb-1">Online</p>
              <p id="presel-price-online" class="font-heading font-light text-xl text-ink mb-3"></p>
              <div class="h-px bg-dust my-3"></div>
              <p class="font-body text-sm text-stone">Videollamada · Google Meet</p>
            </button>
            <button type="button" id="presel-presencial-btn"
              class="bg-white border border-dust text-left p-8 hover:bg-warm hover:border-forest/40 transition-all duration-200 cursor-pointer">
              <p class="label text-gold mb-3">Más solicitado</p>
              <p class="font-heading font-semibold text-2xl text-ink mb-1">Presencial</p>
              <p id="presel-price-presencial" class="font-heading font-light text-xl text-ink mb-3"></p>
              <div class="h-px bg-dust my-3"></div>
              <p class="font-body text-sm text-stone">Las Condes</p>
            </button>
          </div>
        </div>
      </div>

      <!-- ── PASO 2: Fecha y hora ───────────────────────────────────────── -->
      <div id="step-2" class="booking-step hidden">
        <button type="button" id="back-to-1" class="label text-stone hover:text-ink transition-colors mb-8 flex items-center gap-2">
          ← Volver
        </button>
        <p class="label text-stone mb-4">Paso 2</p>
        <div class="divider mb-6"></div>
        <h2 class="font-heading font-light text-3xl text-ink mb-8">Elige fecha y hora</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-dust">
          <!-- Calendario -->
          <div class="bg-white p-5 sm:p-8 md:p-10">
            <div class="flex items-center justify-between mb-7">
              <button id="prev-month" type="button"
                class="w-11 h-11 flex items-center justify-center hover:bg-warm transition-colors text-stone hover:text-ink text-xl rounded-sm">
                ‹
              </button>
              <p id="calendar-title" class="font-heading font-semibold text-xl text-ink tracking-wide"></p>
              <button id="next-month" type="button"
                class="w-11 h-11 flex items-center justify-center hover:bg-warm transition-colors text-stone hover:text-ink text-xl rounded-sm">
                ›
              </button>
            </div>
            <div class="grid grid-cols-7 gap-1 mb-2">
              {['Do', 'Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sá'].map((d) => (
                <div class="text-center font-body text-[11px] tracking-widest text-stone/60 py-1.5 uppercase">{d}</div>
              ))}
            </div>
            <div id="calendar-grid" class="grid grid-cols-7 gap-1"></div>

            <!-- Leyenda para orientar al cliente -->
            <div class="flex items-center justify-center gap-4 mt-5 pt-4 border-t border-dust/60">
              <span class="flex items-center gap-1.5 text-[11px] text-stone">
                <span class="inline-block w-3.5 h-3.5 rounded-full" style="box-shadow:inset 0 0 0 2px #576352;"></span>
                Hoy
              </span>
              <span class="flex items-center gap-1.5 text-[11px] text-stone/60">
                <span class="inline-block w-3.5 h-3.5 rounded-full bg-ink"></span>
                Seleccionado
              </span>
              <span class="flex items-center gap-1.5 text-[11px] text-stone/50">
                <span class="line-through">00</span>
                No disponible
              </span>
            </div>
          </div>

          <!-- Slots de hora -->
          <div class="bg-sand p-5 sm:p-8 md:p-10 flex flex-col">
            <div id="slots-placeholder" class="flex-1 flex items-center justify-center text-center py-8">
              <div>
                <p class="font-heading font-light text-2xl text-ink/30 mb-2">—</p>
                <p class="font-body text-sm text-stone/60 leading-relaxed">Selecciona un día<br />para ver los horarios</p>
              </div>
            </div>
            <div id="slots-container" class="hidden flex-col flex-1">
              <!-- Header horarios -->
              <div class="mb-6 pb-5 border-b border-dust">
                <p class="label text-stone mb-1">Horarios disponibles</p>
                <p id="slots-date-label" class="font-heading font-semibold text-2xl text-ink"></p>
              </div>
              <div id="slots-grid" class="grid grid-cols-3 gap-2.5"></div>
              <div id="no-slots-msg" class="hidden font-body text-sm text-stone/60 text-center py-8 leading-relaxed">
                <p>Sin horarios disponibles<br />para este día.</p>
                <a
                  href="https://wa.me/56972735696?text=Hola%20Valentina%2C%20estoy%20buscando%20un%20sobrecupo%20o%20un%20horario%20disponible%20distinto%20a%20los%20que%20aparecen%20en%20la%20agenda.%20%C2%BFMe%20puedes%20ayudar%3F"
                  target="_blank" rel="noopener"
                  class="inline-block mt-3 text-forest underline underline-offset-2 hover:text-ink transition-colors"
                >Escríbeme para un sobrecupo</a>
              </div>
              <p id="slots-help-msg" class="hidden font-body text-xs text-stone/60 text-center pt-4 mt-2 border-t border-dust">
                ¿Ninguna hora te acomoda?
                <a
                  href="https://wa.me/56972735696?text=Hola%20Valentina%2C%20estoy%20buscando%20un%20sobrecupo%20o%20un%20horario%20disponible%20distinto%20a%20los%20que%20aparecen%20en%20la%20agenda.%20%C2%BFMe%20puedes%20ayudar%3F"
                  target="_blank" rel="noopener"
                  class="text-forest underline underline-offset-2 hover:text-ink transition-colors"
                >Escríbeme</a>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- ── PASO 3: Datos del paciente ────────────────────────────────── -->
      <div id="step-3" class="booking-step hidden">
        <button type="button" id="back-to-2" class="label text-stone hover:text-ink transition-colors mb-8 flex items-center gap-2">
          ← Volver
        </button>
        <p class="label text-stone mb-4">Paso 3</p>
        <div class="divider mb-6"></div>
        <h2 class="font-heading font-light text-3xl text-ink mb-6">Tus datos</h2>

        <!-- Resumen de la reserva -->
        <div id="booking-summary" class="bg-warm border border-dust px-7 py-5 mb-8 font-body text-sm"></div>

        <form id="patient-form" class="bg-white border border-dust p-8 md:p-10 flex flex-col gap-7" novalidate>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-7">
            <div>
              <label class="label text-stone block mb-2" for="patient_name">Nombre completo *</label>
              <input id="patient_name" name="patient_name" type="text" required autocomplete="name"
                placeholder="Tu nombre completo" class="field" />
              <p class="field-error hidden font-body text-xs text-red-500 mt-1">Ingresa tu nombre.</p>
            </div>
            <div>
              <label class="label text-stone block mb-2" for="patient_phone">Teléfono *</label>
              <!-- Casilla de país (Chile por defecto) + número: la agrega
                   CamposContacto. Muchas pacientes chilenas usan números de otros
                   países (ej. EE.UU.); solo eligen el país y escriben su número. -->
              <input id="patient_phone" name="patient_phone" type="tel" required data-validar-telefono
                placeholder="9 1234 5678" maxlength="20" autocomplete="tel-national" inputmode="tel" class="field" />
              <p class="field-error hidden font-body text-xs text-red-500 mt-1">Revisa el número (en Chile son 9 dígitos).</p>
            </div>
          </div>
          <div>
            <label class="label text-stone block mb-2" for="patient_email">Correo electrónico *</label>
            <input id="patient_email" name="patient_email" type="email" required autocomplete="email"
              placeholder="tu@correo.cl" class="field" />
            <p class="field-error hidden font-body text-xs text-red-500 mt-1">Ingresa un correo válido.</p>
          </div>
          <div>
            <label class="label text-stone block mb-2" for="patient_rut">RUT *</label>
            <input id="patient_rut" name="patient_rut" type="text" required autocomplete="off" data-rut maxlength="12"
              placeholder="12.345.678-9" class="field" />
            <p class="field-error hidden font-body text-xs text-red-500 mt-1">Revisa tu RUT (necesario para emitir tu boleta de honorarios).</p>
            <label class="flex items-center gap-2 mt-3 font-body text-xs text-stone cursor-pointer select-none">
              <input id="sin_rut" type="checkbox" class="accent-forest" />
              No tengo RUT chileno (soy extranjera/o)
            </label>
          </div>
          <!-- Sin RUT: documento de su país (queda en su ficha; la boleta sale con
               el RUT que el SII indica para extranjeros sin RUT, con su nombre). -->
          <div id="doc-extranjero" class="hidden grid grid-cols-1 sm:grid-cols-3 gap-7">
            <div>
              <label class="label text-stone block mb-2" for="doc_tipo">Documento *</label>
              <select id="doc_tipo" class="field bg-transparent cursor-pointer">
                <option value="Pasaporte">Pasaporte</option>
                <option value="Documento de identidad">Documento de identidad</option>
                <option value="Otro">Otro</option>
              </select>
            </div>
            <div>
              <label class="label text-stone block mb-2" for="doc_numero">Número *</label>
              <input id="doc_numero" type="text" autocomplete="off" class="field" />
              <p class="field-error hidden font-body text-xs text-red-500 mt-1">Ingresa el número.</p>
            </div>
            <div>
              <label class="label text-stone block mb-2" for="doc_pais">País *</label>
              <input id="doc_pais" type="text" autocomplete="country-name" class="field" />
              <p class="field-error hidden font-body text-xs text-red-500 mt-1">Ingresa el país.</p>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-7">
            <div class="sm:col-span-2">
              <label class="label text-stone block mb-2" for="patient_address">Dirección *</label>
              <input id="patient_address" type="text" autocomplete="street-address"
                placeholder="Calle, número, depto." class="field" />
              <p class="field-error hidden font-body text-xs text-red-500 mt-1">Ingresa tu dirección.</p>
            </div>
            <div>
              <label class="label text-stone block mb-2" for="patient_comuna">Comuna *</label>
              <input id="patient_comuna" type="text" autocomplete="address-level2" class="field" />
              <p class="field-error hidden font-body text-xs text-red-500 mt-1">Ingresa tu comuna.</p>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-7">
            <div>
              <label class="label text-stone block mb-2" for="emergency_name">Contacto de emergencia *</label>
              <input id="emergency_name" type="text" placeholder="Nombre" autocomplete="section-emergencia name" class="field" />
              <p class="field-error hidden font-body text-xs text-red-500 mt-1">Ingresa un contacto de emergencia.</p>
            </div>
            <div>
              <label class="label text-stone block mb-2" for="emergency_phone">Teléfono de emergencia *</label>
              <input id="emergency_phone" type="tel" data-validar-telefono placeholder="+56 9 1234 5678" autocomplete="section-emergencia tel" class="field" />
              <p class="field-error hidden font-body text-xs text-red-500 mt-1">Ingresa un teléfono válido para tu contacto de emergencia, con código de país.</p>
            </div>
          </div>
          <div>
            <label class="label text-stone block mb-2" for="motivo_consulta">Motivo de consulta *</label>
            <select id="motivo_consulta" name="motivo_consulta" required class="field bg-transparent cursor-pointer">
              <option value="" disabled selected>Selecciona el motivo principal...</option>
            </select>
            <p class="field-error hidden font-body text-xs text-red-500 mt-1">Selecciona un motivo de consulta.</p>
          </div>
          <div>
            <label class="label text-stone block mb-2" for="patient_notes">¿Algo que quieras contarme antes? (opcional)</label>
            <textarea id="patient_notes" name="patient_notes" rows="3"
              placeholder="Puedes describir brevemente tu situación..."
              class="field resize-none"></textarea>
          </div>
          <div class="bg-warm border border-dust p-4 text-left">
            <p class="label text-stone mb-2">Condiciones del servicio</p>
            <ul class="font-body text-xs text-stone leading-relaxed space-y-1 pl-3 list-disc">
              <li>Las sesiones no se cancelan: solo puedes reagendar tu hora avisando con al menos <strong>24 horas de anticipación</strong>.</li>
              <li>Si soy yo quien debe cancelar, reagendamos tu sesión sin costo.</li>
              <li>Tu reserva se confirma solo cuando el pago es procesado.</li>
            </ul>
          </div>
          <div>
            <button type="submit" id="submit-patient" class="btn-dark text-[10px] py-3.5 px-8 w-full">
              Continuar al pago
            </button>
            <p id="form-error" class="hidden font-body text-xs text-red-500 text-center mt-3"></p>
            <p class="font-body text-xs text-stone text-center mt-3">Al continuar aceptas las <a href="/condiciones" target="_blank" class="underline underline-offset-2 hover:text-ink">condiciones del servicio y la política de privacidad</a>.</p>
          </div>
        </form>
      </div>

      <!-- ── PASO 4: Pago ───────────────────────────────────────────────── -->
      <div id="step-4" class="booking-step hidden">
        <p class="label text-stone mb-4">Paso 4</p>
        <div class="divider mb-6"></div>
        <h2 class="font-heading font-light text-3xl text-ink mb-8 text-center">Completa tu pago</h2>
        <div class="bg-white border border-dust max-w-md mx-auto p-10 text-center flex flex-col items-center gap-6">
          <div id="payment-loading" class="flex flex-col items-center gap-4 py-4">
            <div class="w-8 h-8 border border-ink border-t-transparent animate-spin"></div>
            <p class="label text-stone">Preparando el pago seguro...</p>
          </div>
          <div id="payment-ready" class="hidden w-full flex flex-col items-center gap-6">
            <div id="payment-summary" class="font-body text-sm text-stone w-full"></div>
            <div class="h-px bg-dust w-full"></div>
            <a id="mp-checkout-btn" href="#" target="_blank" rel="noopener noreferrer"
              class="btn-dark w-full text-center text-xs py-3.5">
              Pagar con Flow
            </a>
            {manualPaymentEnabled && (
              <button id="manual-pay-btn" type="button"
                class="w-full text-center font-body text-xs tracking-widest uppercase py-3.5 border border-dust text-stone hover:border-ink hover:text-ink transition-colors duration-200">
                Pagar en consulta
              </button>
            )}
            {transferPaymentEnabled && (
              <button id="transfer-pay-btn" type="button"
                class="w-full text-center font-body text-xs tracking-widest uppercase py-3.5 border border-dust text-stone hover:border-forest hover:text-forest hover:border-forest/60 transition-colors duration-200">
                Pagar por transferencia
              </button>
            )}
            <p class="label text-stone leading-relaxed text-center">
              Pago 100% seguro · Webpay, MACH,<br />tarjeta de crédito y débito.
            </p>
            <p class="font-body text-xs text-stone leading-relaxed text-center">
              Tu hora queda reservada por <strong>25 minutos</strong> mientras completas el pago. Si no se paga en ese plazo, se libera para otra persona.
            </p>
          </div>
          <div id="payment-error" class="hidden w-full">
            <p class="font-body text-sm text-red-500 mb-5" id="payment-error-msg"></p>
            <div class="flex flex-col items-center gap-3">
              <button type="button" id="payment-back" class="btn-dark text-[10px] py-3 px-6">
                Elegir otra hora
              </button>
              <a href="https://wa.me/56972735696" target="_blank" rel="noopener noreferrer" class="btn-outline text-[10px] py-3 px-6">
                Coordinar por WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Garantías -->
  <section class="bg-warm border-t border-dust">
    <div class="container-site">
      <div class="grid grid-cols-3 divide-x divide-dust">
        {[
          ['Pago seguro', 'Flow · SSL'],
          ['Reprogramación', 'Hasta 24 h antes'],
          ['Confidencialidad', '100% privado'],
        ].map(([title, sub]) => (
          <div class="text-center py-7 px-4">
            <p class="font-heading font-light text-sm text-ink">{title}</p>
            <p class="label text-stone mt-1">{sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
<CamposContacto />
</BaseLayout>

<!-- is:global: el calendario y los horarios se generan con innerHTML/createElement (JS)
     y no llevan el atributo de scoping de Astro. Acotado a sus contenedores. -->
<style is:global>
  #calendar-grid .day-btn {
    @apply w-full aspect-square text-sm font-body flex items-center justify-center transition-all duration-150 rounded-full;
  }
  #calendar-grid .day-available {
    @apply text-ink cursor-pointer;
  }
  #calendar-grid .day-available:hover { @apply bg-warm; }
  /* Días pasados: claramente NO seleccionables */
  #calendar-grid .day-past {
    @apply text-dust/40 cursor-not-allowed line-through;
  }
  /* Días sin atención para el servicio (ej. sáb/dom) o feriados: no seleccionables */
  #calendar-grid .day-off {
    @apply text-dust/50 cursor-not-allowed;
    background: repeating-linear-gradient(45deg, transparent, transparent 4px, rgba(0,0,0,0.03) 4px, rgba(0,0,0,0.03) 8px);
  }
  #calendar-grid .day-selected {
    @apply bg-ink text-sand font-semibold;
  }
  /* HOY: aro verde para ubicarse fácil */
  #calendar-grid .day-today:not(.day-selected) {
    @apply font-bold text-forest;
    box-shadow: inset 0 0 0 2px #576352;
  }
  #slots-grid .slot-btn {
    @apply py-3.5 w-full font-heading font-light text-base text-ink border border-dust bg-white
           hover:border-forest hover:text-forest transition-all duration-150 cursor-pointer;
    letter-spacing: 0.01em;
  }
  #slots-grid .slot-selected {
    @apply bg-ink text-sand border-ink font-normal;
  }
  #slots-grid .slot-selected:hover {
    @apply text-sand border-ink;
  }
</style>

<script define:vars={{ recaptchaSiteKey }}>
  window.__RECAPTCHA_SITE_KEY__ = recaptchaSiteKey;
</script>
{recaptchaSiteKey && (
  <script src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`} is:inline></script>
)}

<script define:vars={{ catalogServicesRaw: JSON.stringify(catalogServices ?? []), preselectedGroup: grupoParam, preselectedServicioId: servicioParam }}>
  // ─── Estado ───────────────────────────────────────────────────────────────
  const state = {
    step:            1,
    serviceId:       null,
    modalityChoice:  null,
    sessionTitle:    null,
    sessionPrice:    null,
    sessionDuration: null,
    selectedDate:    null,  // 'YYYY-MM-DD'
    selectedTime:    null,  // 'HH:MM'
    calendarYear:    null,
    calendarMonth:   null,
    loadedSlots:     {},    // { 'YYYY-MM-DD': ['09:00', ...] }
    availableWeekdays: null, // Set de días de semana con horario (0=Dom..6=Sáb); null = aún sin cargar
    blockedDates:      new Set(), // fechas 'YYYY-MM-DD' bloqueadas (feriados/vacaciones)
  };

  const catalogServices = JSON.parse(catalogServicesRaw);

  const MONTHS_ES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];

  // ─── Helpers ──────────────────────────────────────────────────────────────
  const $ = (id) => document.getElementById(id);
  const show = (id) => $(id)?.classList.remove('hidden');
  const hide = (id) => $(id)?.classList.add('hidden');

  function formatDateEs(iso) {
    const [y, m, d] = iso.split('-');
    return `${parseInt(d)} de ${MONTHS_ES[parseInt(m) - 1]} de ${y}`;
  }

  function formatCLP(n) {
    return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);
  }

  // ─── Indicador de pasos ───────────────────────────────────────────────────
  function updateStepIndicators(currentStep) {
    for (let i = 1; i <= 4; i++) {
      const ind   = $(`step-indicator-${i}`);
      const label = $(`step-label-${i}`);
      if (!ind) continue;
      ind.className = 'w-6 h-6 flex items-center justify-center text-[10px] tracking-widest font-body flex-shrink-0 transition-all duration-200 step-indicator';
      if (i < currentStep) {
        ind.classList.add('bg-ink', 'text-sand', 'border', 'border-ink');
        ind.textContent = '✓';
      } else if (i === currentStep) {
        ind.classList.add('border', 'border-ink', 'text-ink', 'bg-warm');
        ind.textContent = String(i);
      } else {
        ind.classList.add('border', 'border-dust', 'text-stone');
        ind.textContent = String(i);
      }
      if (label) {
        label.className = 'hidden md:block font-body text-[10px] tracking-widest uppercase step-label';
        if (i === currentStep) label.classList.add('text-ink');
        else label.classList.add('text-stone');
      }
    }
  }

  function goToStep(n) {
    state.step = n;
    document.querySelectorAll('.booking-step').forEach((el) => el.classList.add('hidden'));
    $(`step-${n}`)?.classList.remove('hidden');
    updateStepIndicators(n);
    // Resumen del servicio: visible desde el paso 2 en adelante
    const sum = $('service-summary');
    if (sum) sum.style.display = n >= 2 ? 'flex' : 'none';
    const bar = document.getElementById('booking-bar');
    if (bar) {
      const top = bar.getBoundingClientRect().top + window.scrollY - 1;
      window.scrollTo({ top, behavior: 'smooth' });
    }
  }

  // ─── PASO 1: Grupo → Servicio → Paso 2 ──────────────────────────────────
  let selectedGroup = null; // 'individual' | 'pareja'

  function renderServiceCards(group) {
    const container = $('service-cards');
    if (!container) return;
    const services = catalogServices.filter((s) => s.type === group);
    container.innerHTML = '';

    if (!services.length) {
      container.innerHTML = '<p class="font-body text-sm text-stone py-4">No hay servicios disponibles.</p>';
      return;
    }

    services.forEach((svc) => {
      const card = document.createElement('div');
      card.className = 'bg-white border border-dust p-8 transition-all duration-200';

      if (svc.modality === 'ambos') {
        const priceOnline = svc.price_online     ?? svc.price;
        const pricePres   = svc.price_presencial ?? svc.price;
        const durOnline   = svc.duration_min_online     ?? svc.duration_min ?? 50;
        const durPres     = svc.duration_min_presencial ?? svc.duration_min ?? 50;

        card.innerHTML = `
          <p class="font-heading font-semibold text-xl text-ink mb-1">${svc.name}</p>
          ${svc.description ? `<p class="font-body text-sm text-stone mb-5 leading-relaxed">${svc.description}</p>` : '<div class="mb-5"></div>'}
          <div class="h-px bg-dust mb-5"></div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <button type="button" class="svc-opt-btn text-left border border-dust p-5 bg-sand hover:bg-warm hover:border-forest/40 transition-all cursor-pointer"
                    data-svc-id="${svc.id}" data-modality="online" data-price="${priceOnline}" data-dur="${durOnline}" data-title="${svc.name}">
              <p class="label text-forest mb-2">Online</p>
              <p class="font-heading font-semibold text-xl text-ink">${formatCLP(priceOnline)}</p>
              <p class="font-body text-xs text-stone mt-1">${durOnline} min · Videollamada</p>
            </button>
            <button type="button" class="svc-opt-btn text-left border border-dust p-5 bg-sand hover:bg-warm hover:border-forest/40 transition-all cursor-pointer"
                    data-svc-id="${svc.id}" data-modality="presencial" data-price="${pricePres}" data-dur="${durPres}" data-title="${svc.name}">
              <p class="label text-gold mb-2">Presencial</p>
              <p class="font-heading font-semibold text-xl text-ink">${formatCLP(pricePres)}</p>
              <p class="font-body text-xs text-stone mt-1">${durPres} min · Las Condes</p>
            </button>
          </div>
        `;
      } else {
        const price    = svc.price;
        const dur      = svc.duration_min ?? 50;
        const tagColor = svc.modality === 'online' ? 'text-forest' : 'text-gold';
        const tagText  = svc.modality === 'online' ? 'Online' : 'Presencial';
        const modLabel = svc.modality === 'online' ? 'Videollamada · Google Meet' : 'Las Condes';

        card.className += ' cursor-pointer hover:border-forest/40 hover:bg-warm';
        card.innerHTML = `
          <p class="label ${tagColor} mb-2">${tagText}</p>
          <p class="font-heading font-semibold text-2xl text-ink mb-1">${svc.name}</p>
          ${svc.description ? `<p class="font-body text-sm text-stone mb-4 leading-relaxed">${svc.description}</p>` : '<div class="mb-4"></div>'}
          <div class="h-px bg-dust my-4"></div>
          <p class="font-heading font-light text-xl text-ink">${formatCLP(price)} · ${dur} min</p>
          <p class="font-body text-xs text-stone mt-1">${modLabel}</p>
        `;
        card.addEventListener('click', () =>
          selectService(svc.id, svc.modality, price, dur, svc.name)
        );
      }

      container.appendChild(card);
    });

    container.querySelectorAll('.svc-opt-btn').forEach((btn) => {
      btn.addEventListener('click', () =>
        selectService(btn.dataset.svcId, btn.dataset.modality, parseInt(btn.dataset.price), parseInt(btn.dataset.dur), btn.dataset.title)
      );
    });
  }

  // ── Medición de embudo para GTM (GA4 / Google Ads) ────────────────────────
  function voItem() {
    return {
      item_id:       String(state.serviceId || ''),
      // Sin repetir la modalidad cuando el nombre del servicio ya la trae
      // ("Terapia Individual Online" + " Online").
      item_name:     String(state.sessionTitle || '').replace(/\s+(online|presencial)\s+\1$/i, ' $1'),
      item_category: state.modalityChoice === 'online' ? 'online' : 'presencial',
      price:         Number(state.sessionPrice) || 0,
      quantity:      1,
    };
  }
  function voPush(eventName) {
    try {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ ecommerce: null });
      window.dataLayer.push({
        event: eventName,
        ecommerce: { currency: 'CLP', value: Number(state.sessionPrice) || 0, items: [voItem()] },
      });
    } catch (e) { /* medición no debe romper el flujo */ }
  }

  function selectService(serviceId, modality, price, duration, name) {
    state.serviceId       = serviceId;
    state.modalityChoice  = modality;
    state.sessionPrice    = price;
    state.sessionDuration = duration;
    state.sessionTitle    = name + (modality === 'online' ? ' Online' : ' Presencial');
    state.loadedSlots     = {};

    // Poblar el resumen del servicio (nombre + modalidad + precio + duración)
    const sName = $('summary-name');
    const sDet  = $('summary-detail');
    if (sName) sName.textContent = state.sessionTitle;
    if (sDet)  sDet.textContent  = `${formatCLP(price)} · ${duration} min · ${modality === 'online' ? 'Videollamada (Meet)' : 'Las Condes'}`;

    updateMotivoSelect(selectedGroup);

    const now = new Date();
    state.calendarYear  = now.getFullYear();
    state.calendarMonth = now.getMonth();

    voPush('view_item'); // el paciente "ve" el servicio elegido

    goToStep(2);
    renderCalendar();
    loadAvailabilitySummary(); // días sin horario / feriados → deshabilitar en el calendario
  }

  // Carga qué días de la semana tienen horario y qué fechas están bloqueadas
  async function loadAvailabilitySummary() {
    state.availableWeekdays = null;
    state.blockedDates = new Set();
    if (!state.serviceId) return;
    try {
      const res = await fetch(`/api/availability/summary?service_id=${encodeURIComponent(state.serviceId)}`);
      const d = await res.json();
      state.availableWeekdays = new Set(d.weekdays ?? []);
      state.blockedDates = new Set(d.blocked ?? []);
      state.extraDates = new Set(d.extra ?? []); // fechas con horas extra abiertas por Valentina
      renderCalendar(); // re-pintar ya con los días deshabilitados
    } catch { /* si falla, el calendario sigue mostrando los días (el clic dirá "sin horarios") */ }
  }

  function activateGroup(group) {
    selectedGroup = group;
    if ($('service-subtitle')) $('service-subtitle').textContent = group === 'individual'
      ? 'Sesión Individual — elige el tipo de terapia'
      : 'Sesión de Pareja — elige el tipo de terapia';
    $('group-selection')?.classList.add('hidden');
    $('service-selection')?.classList.remove('hidden');
    renderServiceCards(group);
  }

  // ── Servicio pre-seleccionado desde /servicios (?servicio=UUID) ──────────────
  // Se define aquí pero se EJECUTA al final del script (ver runPreselection()),
  // cuando ya están inicializadas todas las constantes (ej. MOTIVOS) — evita TDZ.
  function runPreselection() {
    if (preselectedServicioId) {
    const svc = catalogServices.find((s) => s.id === preselectedServicioId);
    if (svc) {
      selectedGroup = svc.type;
      if (svc.modality === 'ambos') {
        const priceOnline = svc.price_online     ?? svc.price;
        const pricePres   = svc.price_presencial ?? svc.price;
        const durOnline   = svc.duration_min_online     ?? svc.duration_min ?? 50;
        const durPres     = svc.duration_min_presencial ?? svc.duration_min ?? 50;

        $('presel-service-name').textContent  = svc.name;
        $('presel-service-desc').textContent  = svc.description ?? '';
        $('presel-price-online').textContent     = formatCLP(priceOnline) + ' · ' + durOnline + ' min';
        $('presel-price-presencial').textContent = formatCLP(pricePres)   + ' · ' + durPres   + ' min';

        $('presel-online-btn').addEventListener('click', () =>
          selectService(svc.id, 'online', priceOnline, durOnline, svc.name)
        );
        $('presel-presencial-btn').addEventListener('click', () =>
          selectService(svc.id, 'presencial', pricePres, durPres, svc.name)
        );

        $('group-selection').classList.add('hidden');
        $('modality-for-service').classList.remove('hidden');
      } else {
        // Modalidad única → saltar directo al paso 2
        selectService(svc.id, svc.modality, svc.price, svc.duration_min ?? 50, svc.name);
      }
    }
    } else if (preselectedGroup === 'individual' || preselectedGroup === 'pareja') {
      activateGroup(preselectedGroup);
    }
  }

  $('back-to-servicios')?.addEventListener('click', () => {
    window.location.href = '/servicios';
  });

  document.querySelectorAll('.group-card').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.group-card').forEach((b) => b.classList.remove('border-forest', 'bg-warm'));
      btn.classList.add('border-forest', 'bg-warm');
      activateGroup(btn.dataset.group);
    });
  });

  $('back-to-group')?.addEventListener('click', () => {
    if (preselectedGroup) {
      window.location.href = '/servicios';
    } else {
      $('service-selection').classList.add('hidden');
      $('group-selection').classList.remove('hidden');
      selectedGroup = null;
    }
  });

  $('back-to-1')?.addEventListener('click', () => {
    goToStep(1);
    // Si venía con servicio pre-seleccionado, asegurarse de mostrar 1c
    if (preselectedServicioId) {
      $('group-selection')?.classList.add('hidden');
      $('service-selection')?.classList.add('hidden');
      $('modality-for-service')?.classList.remove('hidden');
    }
  });
  $('back-to-2')?.addEventListener('click', () => goToStep(2));

  // ─── Calendario ──────────────────────────────────────────────────────────
  $('prev-month')?.addEventListener('click', () => {
    const d = new Date(state.calendarYear, state.calendarMonth - 1, 1);
    const now = new Date(); now.setHours(0,0,0,0);
    if (d < new Date(now.getFullYear(), now.getMonth(), 1)) return;
    state.calendarYear  = d.getFullYear();
    state.calendarMonth = d.getMonth();
    renderCalendar();
  });

  $('next-month')?.addEventListener('click', () => {
    const d = new Date(state.calendarYear, state.calendarMonth + 1, 1);
    // Limitar a 3 meses adelante
    const limit = new Date(); limit.setMonth(limit.getMonth() + 3);
    if (d > limit) return;
    state.calendarYear  = d.getFullYear();
    state.calendarMonth = d.getMonth();
    renderCalendar();
  });

  function isoDate(y, m, d) {
    return `${y}-${String(m + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
  }

  async function renderCalendar() {
    const y = state.calendarYear;
    const m = state.calendarMonth;
    $('calendar-title').textContent = `${MONTHS_ES[m]} ${y}`;

    const grid = $('calendar-grid');
    grid.innerHTML = '';

    const firstDay  = new Date(y, m, 1).getDay();
    const daysInMonth = new Date(y, m + 1, 0).getDate();
    const today     = new Date(); today.setHours(0,0,0,0);

    // Celdas vacías antes del primer día
    for (let i = 0; i < firstDay; i++) {
      grid.insertAdjacentHTML('beforeend', '<div></div>');
    }

    // Para saber qué días tienen slots, hacemos una consulta liviana por mes
    // Cargamos todos los días del mes de una vez usando un fetch por cada día visible
    // (optimización futura: endpoint por mes)
    const dayButtons = [];

    for (let d = 1; d <= daysInMonth; d++) {
      const iso      = isoDate(y, m, d);
      const dateObj  = new Date(iso + 'T00:00:00');
      const isPast   = dateObj < today;
      const isSelected = iso === state.selectedDate;

      // Fecha de hoy en la zona horaria de Chile (toISOString() da la fecha en UTC,
      // que se adelanta durante la tarde/noche en Chile — ver src/lib/dateUtils.ts).
      const isToday = iso === new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Santiago' }).format(new Date());
      // Día sin horario para este servicio (ej. no atiende sáb/dom) o feriado bloqueado
      const dow        = dateObj.getDay();
      const noWeekday  = state.availableWeekdays !== null && !state.availableWeekdays.has(dow) && !(state.extraDates && state.extraDates.has(iso));
      const isBlocked  = state.blockedDates.has(iso);
      const unavailable = noWeekday || isBlocked;
      const disabled   = isPast || unavailable;

      let cls = 'day-btn ';
      if (isPast) {
        cls += 'day-past';
      } else if (unavailable) {
        cls += 'day-off';
      } else if (isSelected) {
        cls += 'day-selected';
      } else {
        cls += 'day-available';
        if (isToday) cls += ' day-today';
      }

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = cls;
      btn.textContent = d;
      btn.dataset.iso = iso;
      btn.disabled = disabled;
      if (isBlocked) btn.title = 'No disponible (feriado o bloqueado)';
      else if (noWeekday) btn.title = 'Este día no hay atención para este servicio';

      if (!disabled) {
        btn.addEventListener('click', () => selectDate(iso));
      }

      grid.appendChild(btn);
      dayButtons.push({ btn, iso, isPast });
    }
  }

  async function selectDate(iso) {
    state.selectedDate = iso;
    state.selectedTime = null;

    // Actualizar estilos del calendario
    document.querySelectorAll('.day-btn').forEach((b) => {
      if (b.dataset.iso === iso) {
        b.className = b.className.replace('day-available', 'day-selected');
      } else if (!b.disabled) {
        b.className = b.className.replace('day-selected', 'day-available');
      }
    });

    // Mostrar slots
    hide('slots-placeholder');
    const sc = $('slots-container');
    if (sc) { sc.classList.remove('hidden'); sc.style.display = 'flex'; sc.style.flexDirection = 'column'; }
    $('slots-date-label').textContent = formatDateEs(iso);
    $('slots-grid').innerHTML = '<p class="col-span-3 text-xs text-stone py-2">Cargando horarios...</p>';
    hide('no-slots-msg');
    hide('slots-help-msg');

    // Fetch slots — el horario es por servicio, así que la caché incluye el service_id
    const cacheKey = `${iso}|${state.serviceId ?? ''}|${state.modalityChoice ?? ''}`;
    let slots = state.loadedSlots[cacheKey];
    if (!slots) {
      try {
        const dur = state.sessionDuration ? `&duration=${state.sessionDuration}` : '';
        const svc = state.serviceId ? `&service_id=${encodeURIComponent(state.serviceId)}` : '';
        const mod = state.modalityChoice ? `&modality=${encodeURIComponent(state.modalityChoice)}` : '';
        const res = await fetch(`/api/availability?date=${iso}${dur}${svc}${mod}`);
        const data = await res.json();
        slots = data.slots ?? [];
        state.loadedSlots[cacheKey] = slots;
      } catch {
        slots = [];
      }
    }

    renderSlots(slots);
  }

  function renderSlots(slots) {
    const grid = $('slots-grid');
    grid.innerHTML = '';

    if (!slots.length) {
      show('no-slots-msg');
      hide('slots-help-msg');
      return;
    }
    hide('no-slots-msg');
    show('slots-help-msg');

    slots.forEach((time) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `slot-btn ${state.selectedTime === time ? 'slot-selected' : ''}`;
      btn.textContent = time;
      btn.dataset.time = time;
      btn.addEventListener('click', () => selectTime(time));
      grid.appendChild(btn);
    });
  }

  function selectTime(time) {
    state.selectedTime = time;

    document.querySelectorAll('.slot-btn').forEach((b) => {
      if (b.dataset.time === time) b.className = b.className.replace('slot-btn', 'slot-btn slot-selected').replace('slot-selected slot-selected', 'slot-selected');
      else b.classList.remove('slot-selected');
    });
    // Pequeño delay para que el usuario vea la selección antes de avanzar
    setTimeout(() => {
      buildBookingSummary();
      goToStep(3);
    }, 250);
  }

  // ─── PASO 3: formulario ───────────────────────────────────────────────────
  // ─── Motivos de consulta por grupo ───────────────────────────────────────
  const MOTIVOS = {
    individual: [
      'Ansiedad o estrés',
      'Depresión o tristeza persistente',
      'Baja autoestima o inseguridad',
      'Duelo o pérdida',
      'Dificultades en relaciones personales',
      'Problemas laborales o burnout',
      'Trauma o experiencias difíciles del pasado',
      'Crisis existencial o falta de propósito',
      'Desarrollo personal y autoconocimiento',
      'Otro',
    ],
    pareja: [
      'Problemas de comunicación',
      'Infidelidad o ruptura de confianza',
      'Crisis o distanciamiento emocional',
      'Dificultades de convivencia',
      'Celos o inseguridades en la relación',
      'Decisiones importantes (hijos, matrimonio, separación)',
      'Violencia o conflictos frecuentes',
      'Retomar la conexión y el vínculo',
      'Otro',
    ],
  };

  function updateMotivoSelect(group) {
    const select = $('motivo_consulta');
    if (!select) return;
    const opciones = MOTIVOS[group] ?? MOTIVOS.individual;
    select.innerHTML = '<option value="" disabled selected>Selecciona el motivo principal...</option>';
    opciones.forEach((m) => {
      const opt = document.createElement('option');
      opt.value = m;
      opt.textContent = m;
      select.appendChild(opt);
    });
    // Datos recuperados del correo "tu hora se liberó": se repite su motivo.
    if (datosRecuperados?.motivo && opciones.includes(datosRecuperados.motivo)) select.value = datosRecuperados.motivo;
  }

  function buildBookingSummary() {
    $('booking-summary').innerHTML = `
      <div class="grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
        <span class="text-stone">Sesión:</span>     <span class="font-medium">${state.sessionTitle}</span>
        <span class="text-stone">Fecha:</span>       <span class="font-medium">${formatDateEs(state.selectedDate)}</span>
        <span class="text-stone">Hora:</span>        <span class="font-medium">${state.selectedTime}</span>
        <span class="text-stone">Valor:</span>       <span class="font-medium text-forest">${formatCLP(state.sessionPrice)}</span>
      </div>
    `;
  }

  $('patient-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hide('form-error');

    const name   = $('patient_name').value.trim();
    const email  = $('patient_email').value.trim();
    const rut    = $('patient_rut').value.trim();
    const phone  = telefonoCompleto();
    const motivo = $('motivo_consulta').value.trim();
    const notes  = motivo
      ? `Motivo: ${motivo}` + ($('patient_notes').value.trim() ? `\n\n${$('patient_notes').value.trim()}` : '')
      : $('patient_notes').value.trim();

    // Validación
    let valid = true;
    document.querySelectorAll('.field-error').forEach((el) => el.classList.add('hidden'));

    if (!name)   { $('patient_name').nextElementSibling?.classList.remove('hidden'); valid = false; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { $('patient_email').nextElementSibling?.classList.remove('hidden'); valid = false; }
    if (!phone)  { $('patient_phone').closest('div').nextElementSibling?.classList.remove('hidden'); valid = false; }
    const sinRut  = $('sin_rut').checked;
    const rutClean = rut.replace(/\./g, '').replace(/\s/g, '').toUpperCase();
    if (!sinRut && !rutValido(rutClean)) { $('patient_rut').nextElementSibling?.classList.remove('hidden'); valid = false; }
    const docNumero = $('doc_numero').value.trim();
    const docPais   = $('doc_pais').value.trim();
    if (sinRut && docNumero.length < 4) { $('doc_numero').nextElementSibling?.classList.remove('hidden'); valid = false; }
    if (sinRut && docPais.length < 2)   { $('doc_pais').nextElementSibling?.classList.remove('hidden'); valid = false; }
    const direccion = $('patient_address').value.trim();
    const comuna    = $('patient_comuna').value.trim();
    const emergNom  = $('emergency_name').value.trim();
    const emergTel  = $('emergency_phone').value.trim();
    if (direccion.length < 3) { $('patient_address').nextElementSibling?.classList.remove('hidden'); valid = false; }
    if (comuna.length < 2)    { $('patient_comuna').nextElementSibling?.classList.remove('hidden'); valid = false; }
    if (emergNom.length < 2)  { $('emergency_name').nextElementSibling?.classList.remove('hidden'); valid = false; }
    if (!/^[\d\s()+.-]{7,25}$/.test(emergTel)) { $('emergency_phone').nextElementSibling?.classList.remove('hidden'); valid = false; }
    if (!motivo) { $('motivo_consulta').nextElementSibling?.classList.remove('hidden'); valid = false; }
    if (!valid) {
      // Con un formulario largo, en el celular el error puede quedar fuera de la
      // pantalla: se lleva la vista al primer campo con problema.
      const primerError = document.querySelector('#patient-form .field-error:not(.hidden)');
      primerError?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      const previo = primerError?.previousElementSibling;
      const campo = previo?.matches('input,select,textarea') ? previo : previo?.querySelector('input, select, textarea');
      campo?.focus({ preventScroll: true });
      return;
    }

    const btn = $('submit-patient');
    btn.textContent = 'Procesando...';
    btn.disabled = true;

    goToStep(4);
    show('payment-loading');
    hide('payment-ready');
    hide('payment-error');

    voPush('begin_checkout'); // el paciente inicia el pago

    let recaptchaToken = '';
    if (window.__RECAPTCHA_SITE_KEY__ && window.grecaptcha) {
      try {
        recaptchaToken = await new Promise((resolve, reject) => {
          grecaptcha.ready(() => {
            grecaptcha.execute(window.__RECAPTCHA_SITE_KEY__, { action: 'submit_booking' })
              .then(resolve)
              .catch(reject);
          });
        });
      } catch (err) {
        console.error('[recaptcha] error obteniendo token', err);
      }
    }

    try {
      const res = await fetch('/api/bookings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          service_id:      state.serviceId,
          modality_choice: state.modalityChoice,
          session_date:    state.selectedDate,
          session_time:    state.selectedTime,
          patient_name:    name,
          patient_email:   email,
          patient_phone:   phone,
          patient_rut:     sinRut ? '' : rutClean,
          sin_rut:         sinRut,
          doc_tipo:        sinRut ? $('doc_tipo').value : '',
          doc_numero:      sinRut ? docNumero : '',
          doc_pais:        sinRut ? docPais : '',
          patient_address: direccion,
          patient_comuna:  comuna,
          emergency_name:  emergNom,
          emergency_phone: emergTel,
          notes,
          recaptcha_token: recaptchaToken,
          origen:          (() => { try { return JSON.parse(localStorage.getItem('vo_origen') || 'null'); } catch (e) { return null; } })(),
        }),
      });

      const data = await res.json();

      if (!res.ok || !data.checkoutUrl) {
        // Email inválido → volver al paso 3 y marcar el campo
        if (data.errorType === 'invalid_email') {
          goToStep(3);
          const emailInput = document.getElementById('patient_email');
          const emailErr   = emailInput?.nextElementSibling;
          if (emailErr) {
            emailErr.textContent = 'Correo no válido para el pago. Usa un correo real (ej: nombre@gmail.com).';
            emailErr.classList.remove('hidden');
          }
          emailInput?.focus();
          emailInput?.select();
          return; // finally re-habilitará el botón
        }
        // La hora se ocupó mientras completaba sus datos: se recargan los
        // horarios para que vea los que siguen libres.
        if (res.status === 409) {
          state.loadedSlots = {};
          throw new Error('Esa hora se acaba de ocupar. Elige otra hora, por favor.');
        }
        // El detalle técnico queda en la consola, no a la vista de la paciente.
        if (data.detail) console.error('[agenda] reserva:', data.detail);
        throw new Error(data.error ?? 'No se pudo preparar tu reserva. Intenta de nuevo o escríbeme por WhatsApp.');
      }

      // Guardar el bookingId para usarlo en "Pagar en consulta"
      state.bookingId = data.bookingId;

      // Mostrar botón de pago
      hide('payment-loading');
      show('payment-ready');

      $('payment-summary').innerHTML = `
        <p class="font-heading text-xl text-ink">${formatCLP(state.sessionPrice)}</p>
        <p class="text-xs text-stone mt-1">${state.sessionTitle} · ${formatDateEs(state.selectedDate)} · ${state.selectedTime}</p>
      `;

      $('mp-checkout-btn').href = data.checkoutUrl;
      // En modo local/desarrollo usar sandbox_init_point si está disponible
      // En producción usa checkoutUrl directamente

    } catch (err) {
      hide('payment-loading');
      hide('payment-ready');
      show('payment-error');
      $('payment-error-msg').textContent = err.message ?? 'Ocurrió un error. Por favor contáctanos por WhatsApp.';
    } finally {
      btn.textContent = 'Continuar al pago';
      btn.disabled = false;
    }
  });

  // ─── Volver a elegir hora (si la hora se ocupó o algo falló en el paso 4) ──
  document.getElementById('payment-back')?.addEventListener('click', () => {
    state.loadedSlots = {};
    state.selectedTime = null;
    hide('payment-error');
    show('payment-loading');
    goToStep(2);
    if (state.selectedDate && typeof selectDate === 'function') selectDate(state.selectedDate);
  });

  // ─── Pago en consulta ─────────────────────────────────────────────────────
  document.getElementById('manual-pay-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('manual-pay-btn');
    btn.textContent = 'Confirmando...';
    btn.disabled = true;

    try {
      if (!state.bookingId) throw new Error('Reserva no encontrada.');

      const res = await fetch('/api/bookings/confirm-manual', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ bookingId: state.bookingId }),
      });

      const data = await res.json();
      if (data.confirmed) {
        window.location.href = '/confirmacion?manual=1';
      } else {
        throw new Error(data.error ?? 'Error al confirmar');
      }
    } catch (err) {
      hide('payment-error');
      show('payment-error');
      $('payment-error-msg').textContent = err.message ?? 'Error al procesar. Intenta nuevamente.';
      btn.textContent = 'Pagar en consulta';
      btn.disabled = false;
    }
  });

  // ─── Pago por transferencia ───────────────────────────────────────────────
  document.getElementById('transfer-pay-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('transfer-pay-btn');
    if (!btn) return;
    btn.textContent = 'Confirmando...';
    btn.disabled = true;

    try {
      if (!state.bookingId) throw new Error('Reserva no encontrada.');

      const res = await fetch('/api/bookings/confirm-manual', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ bookingId: state.bookingId, paymentMethod: 'transferencia' }),
      });

      const data = await res.json();
      if (data.confirmed) {
        window.location.href = '/confirmacion?transferencia=1';
      } else {
        throw new Error(data.error ?? 'Error al confirmar');
      }
    } catch (err) {
      show('payment-error');
      $('payment-error-msg').textContent = err.message ?? 'Error al procesar. Intenta nuevamente.';
      btn.textContent = 'Pagar por transferencia';
      btn.disabled = false;
    }
  });

  // ─── Teléfono: código de país + número (cualquier país) ────────────────────
  // Si el número empieza con "+", se toma completo (internacional) e ignora el
  // código. Si se pegó o autocompletó con el código incluido, se quita.
  // País + número: lo arma CamposContacto (Chile por defecto). Devuelve
  // "+<código><número>" o '' si el número está mal escrito.
  function telefonoCompleto() {
    return window.telefonoDe ? window.telefonoDe($('patient_phone')) : '';
  }

  // ─── RUT: formato + dígito verificador (mismo cálculo que src/lib/rut.ts) ──
  function rutValido(r) {
    const m = /^(\d{7,8})-([\dK])$/.exec(r);
    if (!m) return false;
    let suma = 0, mult = 2;
    for (let i = m[1].length - 1; i >= 0; i--) { suma += Number(m[1][i]) * mult; mult = mult === 7 ? 2 : mult + 1; }
    const resto = 11 - (suma % 11);
    return (resto === 11 ? '0' : resto === 10 ? 'K' : String(resto)) === m[2];
  }
  // "No tengo RUT chileno": esconde el RUT y pide el documento de su país.
  $('sin_rut')?.addEventListener('change', () => {
    const sin = $('sin_rut').checked;
    $('patient_rut').disabled = sin;
    if (sin) { $('patient_rut').value = ''; $('patient_rut').nextElementSibling?.classList.add('hidden'); }
    $('doc-extranjero').classList.toggle('hidden', !sin);
  });

  // ─── Datos de una reserva que se liberó por falta de pago ─────────────────
  // Si la paciente viene del correo "tu hora se liberó" (/recuperar) y esa
  // hora ya no estaba, elige otra del mismo servicio con sus datos ya
  // escritos (Valentina, 4 oct 2026). El código del correo quedó guardado en
  // este navegador (no en el link) y se usa una sola vez.
  var datosRecuperados = null;
  (async () => {
    let tokenRec = '';
    try { tokenRec = sessionStorage.getItem('vo_recuperar') || ''; sessionStorage.removeItem('vo_recuperar'); } catch {}
    if (!tokenRec) return;
    try {
      const res = await fetch('/api/recuperar-datos', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token: tokenRec }),
      });
      const d = await res.json();
      if (!d.ok) return;
      datosRecuperados = d.datos;
      const poner = (id, v) => { const el = $(id); if (el && v) el.value = v; };
      poner('patient_name', d.datos.nombre);
      poner('patient_email', d.datos.correo);
      const telGuardado = String(d.datos.telefono || '');
      // CamposContacto separa el país y el número al recibir "+<código>…".
      if (telGuardado) { poner('patient_phone', telGuardado); $('patient_phone')?.dispatchEvent(new Event('input')); }
      poner('patient_address', d.datos.direccion);
      poner('patient_comuna', d.datos.comuna);
      poner('emergency_name', d.datos.emergNombre);
      poner('emergency_phone', d.datos.emergTelefono);
      $('emergency_phone')?.dispatchEvent(new Event('input'));
      if (d.datos.sinRut) {
        if (!$('sin_rut').checked) $('sin_rut').click();
        poner('doc_tipo', d.datos.docTipo);
        poner('doc_numero', d.datos.docNumero);
        poner('doc_pais', d.datos.docPais);
      } else {
        poner('patient_rut', d.datos.rut);
      }
      const sel = $('motivo_consulta');
      if (sel && d.datos.motivo && [...sel.options].some(o => o.value === d.datos.motivo)) sel.value = d.datos.motivo;
    } catch { /* si falla, la paciente escribe sus datos como siempre */ }
  })();

  // ─── Init ─────────────────────────────────────────────────────────────────
  updateStepIndicators(1);
  runPreselection();  // preselección de servicio/grupo (al final: todo ya inicializado)
</script>
