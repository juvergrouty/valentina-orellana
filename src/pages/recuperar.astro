---
export const prerender = false;
import Layout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabase';
import { createPaymentOrder, FLOW_URLS, PUBLIC_PAY_TIMEOUT_SECONDS } from '../lib/flow';
import { hoursUntilSessionCL } from '../lib/dateUtils';
import { tagBookingsWithPaymentToken } from '../lib/debt';
import { horaDisponible } from '../lib/disponibilidad';

// ── Recuperar una reserva liberada automáticamente por falta de pago ─────────
// El paciente llega aquí desde el botón "Pagar y mantener mi hora" del correo
// de "horario liberado". Reglas (instrucción explícita de la admin):
//   - Solo se puede recuperar si al MOMENTO DE HACER CLIC quedan más de 4 horas
//     para la sesión (si no, se le pide agendar una hora nueva).
//   - Solo si el horario sigue libre (nadie más lo tomó mientras tanto).
//   - Si se cumple, se reactiva la MISMA reserva (mismos datos del paciente) en
//     estado pending_payment y se lo redirige a pagar en Flow de inmediato.
//   - Abrir el link (GET) solo MUESTRA la hora con un botón; la reserva se
//     reactiva al apretarlo (POST). Los revisores de links de los correos
//     (ej. Outlook) abren los enlaces antes que la persona, y antes eso gastaba
//     el link y reactivaba la hora sin que nadie fuera a pagar.

const esPost = Astro.request.method === 'POST';
let token = Astro.url.searchParams.get('token') ?? '';
if (esPost) {
  try { token = (await Astro.request.formData()).get('token')?.toString() ?? ''; } catch { token = ''; }
}

const DIAS_ES = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
const MESES_ES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
let cuando = '';

type Outcome = 'not_found' | 'too_late' | 'taken' | 'flow_error' | 'confirm' | 'ok';
let outcome: Outcome = 'not_found';
let errorDetail = '';
let redirectUrl: string | null = null;
let serviceId: string | null = null;

if (token) {
  const { data: booking } = await supabase
    .from('bookings')
    .select('*')
    .eq('recovery_token', token)
    .eq('status', 'expired')
    .maybeSingle();

  if (!booking) {
    outcome = 'not_found';
  } else {
    serviceId = booking.service_id ?? null;
    const hoursLeft = hoursUntilSessionCL(booking.session_date, booking.session_time);

    if (hoursLeft < 4) {
      outcome = 'too_late';
    } else {
      // ¿Sigue libre el horario? Mismo cálculo que la agenda (otra reserva,
      // cruces, bloqueos, Google Calendar), sin contar esta misma reserva.
      const { data: conflict } = await supabase
        .from('bookings')
        .select('id')
        .eq('session_date', booking.session_date)
        .eq('session_time', booking.session_time)
        .not('status', 'in', '(cancelled,expired)')
        .neq('id', booking.id)
        .limit(1)
        .maybeSingle();
      const libre = conflict ? false : await horaDisponible({
        date: booking.session_date, time: booking.session_time, serviceId: booking.service_id,
        duration: booking.duration_min, excluirIds: [booking.id],
        modality: String(booking.session_type ?? '').includes('online') ? 'online' : 'presencial',
      });

      if (!libre) {
        outcome = 'taken';
      } else if (!esPost) {
        // Solo mostrar la hora y el botón (ver nota arriba).
        const [y, m, d] = String(booking.session_date).split('-').map(Number);
        const dia = new Date(Date.UTC(y, m - 1, d)).getUTCDay();
        cuando = `${DIAS_ES[dia]} ${d} de ${MESES_ES[m - 1]} a las ${String(booking.session_time).slice(0, 5)}`;
        outcome = 'confirm';
      } else {
        // Reactivar la MISMA fila de forma atómica: solo si sigue en 'expired'
        // (evita doble-clic / doble pago si el link se usa dos veces a la vez).
        const { data: reactivated, error: reactErr } = await supabase
          .from('bookings')
          .update({ status: 'pending_payment', created_at: new Date().toISOString(), recovery_token: null })
          .eq('id', booking.id)
          .eq('status', 'expired')
          .select()
          .maybeSingle();

        if (reactErr || !reactivated) {
          outcome = 'taken'; // alguien ganó la carrera (otro clic, u otra reserva tomó el cupo justo ahora)
        } else {
          try {
            const { data: settingsRows } = await supabase.from('settings').select('key, value').in('key', ['flow_env', 'flow_enabled']);
            const cfg: Record<string, string> = {};
            (settingsRows ?? []).forEach((r: { key: string; value: string }) => { cfg[r.key] = r.value; });

            if (cfg['flow_enabled'] === 'false') {
              outcome = 'flow_error';
              errorDetail = 'El pago online está temporalmente deshabilitado.';
              // No dejar la hora ocupada sin forma de pagarla.
              await supabase.from('bookings').update({ status: 'expired', recovery_token: crypto.randomUUID() }).eq('id', reactivated.id);
            } else {
              const baseUrl = cfg['flow_env'] === 'production' ? FLOW_URLS.production : FLOW_URLS.sandbox;
              const siteUrl = `${Astro.url.protocol}//${Astro.url.host}`;

              let subject = 'Sesión — Ps. Valentina Orellana';
              if (reactivated.service_id) {
                const { data: svc } = await supabase.from('services_catalog').select('name').eq('id', reactivated.service_id).maybeSingle();
                if (svc?.name) subject = svc.name;
              }

              const order = await createPaymentOrder({
                subject,
                amount:          reactivated.amount,
                email:           reactivated.patient_email,
                orderId:         reactivated.id,
                urlConfirmation: `${siteUrl}/api/flow/confirm`,
                urlReturn:       `${siteUrl}/api/flow/return`,
                baseUrl,
                timeoutSeconds:  PUBLIC_PAY_TIMEOUT_SECONDS,
              });

              await supabase.from('bookings').update({ mp_preference_id: order.token }).eq('id', reactivated.id);
              await tagBookingsWithPaymentToken([reactivated.id], order.token).catch(() => {});
              redirectUrl = `${order.url}?token=${order.token}`;
              outcome = 'ok';
            }
          } catch (e) {
            outcome = 'flow_error';
            errorDetail = e instanceof Error ? e.message : String(e);
            // Revertir: si Flow falló, no dejar la reserva "viva" sin forma de pagarla — se
            // vuelve a marcar como expirada con un nuevo token para que el botón del correo
            // original ya no sirva, pero el paciente pueda reintentar contactando por WhatsApp.
            await supabase.from('bookings').update({ status: 'expired', recovery_token: crypto.randomUUID() }).eq('id', reactivated.id);
          }
        }
      }
    }
  }
}

if (outcome === 'ok' && redirectUrl) {
  return Astro.redirect(redirectUrl, 302);
}
---
<Layout title="Recuperar tu hora" noindex>
  <div style="max-width:520px;margin:9rem auto 5rem;padding:0 1.5rem;font-family:'Inter',sans-serif;text-align:center;">
    {outcome === 'confirm' && (
      <>
        <h1 style="font-family:'Domine',serif;font-size:1.5rem;font-weight:500;">Tu hora sigue disponible</h1>
        <p style="color:#6B6860;line-height:1.6;margin:1rem 0 2rem;">
          Puedes mantener tu sesión del <strong style="color:#2C2B28;">{cuando}</strong>. Al continuar te llevo a pagar con Flow.
        </p>
        <form method="POST" action="/recuperar" style="margin-bottom:1.5rem;">
          <input type="hidden" name="token" value={token} />
          <button type="submit"
                  style="background:#576352;color:white;padding:0.95rem 2rem;border:none;cursor:pointer;
                         font-size:0.8rem;letter-spacing:0.1em;text-transform:uppercase;border-radius:4px;">
            Pagar y mantener mi hora
          </button>
        </form>
      </>
    )}
    {outcome === 'not_found' && (
      <>
        <h1 style="font-family:'Domine',serif;font-size:1.5rem;font-weight:500;">No encontramos esa reserva</h1>
        <p style="color:#6B6860;line-height:1.6;margin:1rem 0 2rem;">
          El enlace no es válido o ya fue utilizado. Si quieres agendar, elige un horario disponible.
        </p>
      </>
    )}
    {outcome === 'too_late' && (
      <>
        <h1 style="font-family:'Domine',serif;font-size:1.5rem;font-weight:500;">Ese horario ya no está disponible</h1>
        <p style="color:#6B6860;line-height:1.6;margin:1rem 0 2rem;">
          Quedan menos de 4 horas para esa sesión, así que ya no es posible pagarla online para mantenerla.
          Por favor agenda un nuevo horario: tus datos ya quedan completos.
        </p>
      </>
    )}
    {outcome === 'taken' && (
      <>
        <h1 style="font-family:'Domine',serif;font-size:1.5rem;font-weight:500;">Horario no disponible</h1>
        <p style="color:#6B6860;line-height:1.6;margin:1rem 0 2rem;">
          Alguien más tomó ese horario mientras tanto. Elige un nuevo horario para el mismo servicio: tus datos ya quedan completos, no tienes que escribirlos de nuevo.
        </p>
      </>
    )}
    {outcome === 'flow_error' && (
      <>
        <h1 style="font-family:'Domine',serif;font-size:1.5rem;font-weight:500;">No pudimos iniciar el pago</h1>
        <p style="color:#6B6860;line-height:1.6;margin:1rem 0 2rem;">
          Ocurrió un problema al conectar con el sistema de pago. Por favor escríbeme por WhatsApp para coordinar
          tu sesión directamente.
        </p>
      </>
    )}
    {outcome !== 'confirm' && <a href={serviceId && (outcome === 'taken' || outcome === 'too_late') ? `/agenda?servicio=${serviceId}` : '/agenda'}
       style="display:inline-block;background:#576352;color:white;padding:0.85rem 1.75rem;
              text-decoration:none;font-size:0.78rem;letter-spacing:0.1em;text-transform:uppercase;
              border-radius:4px;margin-right:0.5rem;">
      Agendar un horario
    </a>}
    <a href="https://wa.me/56972735696"
       style="display:inline-block;background:transparent;color:#576352;padding:0.85rem 1.75rem;
              text-decoration:none;font-size:0.78rem;letter-spacing:0.1em;text-transform:uppercase;
              border:1px solid #576352;border-radius:4px;">
      Escribir por WhatsApp
    </a>
  </div>
</Layout>

<script define:vars={{ tokenRecuperar: (outcome === 'taken' || outcome === 'too_late') ? token : '' }}>
  // Para precargar sus datos en la agenda (ver /api/recuperar-datos). Se
  // guarda en el navegador y no en el link, para que el código del correo no
  // quede en registros ni en la analítica de la agenda.
  if (tokenRecuperar) { try { sessionStorage.setItem('vo_recuperar', tokenRecuperar); } catch {} }
</script>
