---
export const prerender = false;
import Layout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabase';
import { createPaymentOrder, FLOW_URLS } from '../lib/flow';
import { hoursUntilSessionCL } from '../lib/dateUtils';
import { tagBookingsWithPaymentToken } from '../lib/debt';

// ── Recuperar una reserva liberada automáticamente por falta de pago ─────────
// El paciente llega aquí desde el botón "Pagar y mantener mi hora" del correo
// de "horario liberado". Reglas (instrucción explícita de la admin):
//   - Solo se puede recuperar si al MOMENTO DE HACER CLIC quedan más de 4 horas
//     para la sesión (si no, se le pide agendar una hora nueva).
//   - Solo si el horario sigue libre (nadie más lo tomó mientras tanto).
//   - Si se cumple, se reactiva la MISMA reserva (mismos datos del paciente) en
//     estado pending_payment y se lo redirige a pagar en Flow de inmediato.

const token = Astro.url.searchParams.get('token') ?? '';

type Outcome = 'not_found' | 'too_late' | 'taken' | 'flow_error' | 'ok';
let outcome: Outcome = 'not_found';
let errorDetail = '';
let redirectUrl: string | null = null;
let serviceId: string | null = null;

if (token) {
  const { data: booking } = await supabase
    .from('bookings')
    .select('*')
    .eq('recovery_token', token)
    .eq('status', 'expired')
    .maybeSingle();

  if (!booking) {
    outcome = 'not_found';
  } else {
    serviceId = booking.service_id ?? null;
    const hoursLeft = hoursUntilSessionCL(booking.session_date, booking.session_time);

    if (hoursLeft < 4) {
      outcome = 'too_late';
    } else {
      // ¿Sigue libre el horario? (alguien más pudo haberlo tomado mientras tanto)
      const { data: conflict } = await supabase
        .from('bookings')
        .select('id')
        .eq('session_date', booking.session_date)
        .eq('session_time', booking.session_time)
        .not('status', 'in', '(cancelled,expired)')
        .neq('id', booking.id)
        .maybeSingle();

      if (conflict) {
        outcome = 'taken';
      } else {
        // Reactivar la MISMA fila de forma atómica: solo si sigue en 'expired'
        // (evita doble-clic / doble pago si el link se usa dos veces a la vez).
        const { data: reactivated, error: reactErr } = await supabase
          .from('bookings')
          .update({ status: 'pending_payment', created_at: new Date().toISOString(), recovery_token: null })
          .eq('id', booking.id)
          .eq('status', 'expired')
          .select()
          .maybeSingle();

        if (reactErr || !reactivated) {
          outcome = 'taken'; // alguien ganó la carrera (otro clic, u otra reserva tomó el cupo justo ahora)
        } else {
          try {
            const { data: settingsRows } = await supabase.from('settings').select('key, value').in('key', ['flow_env', 'flow_enabled']);
            const cfg: Record<string, string> = {};
            (settingsRows ?? []).forEach((r: { key: string; value: string }) => { cfg[r.key] = r.value; });

            if (cfg['flow_enabled'] === 'false') {
              outcome = 'flow_error';
              errorDetail = 'El pago online está temporalmente deshabilitado.';
            } else {
              const baseUrl = cfg['flow_env'] === 'production' ? FLOW_URLS.production : FLOW_URLS.sandbox;
              const siteUrl = `${Astro.url.protocol}//${Astro.url.host}`;

              let subject = 'Sesión — Ps. Valentina Orellana';
              if (reactivated.service_id) {
                const { data: svc } = await supabase.from('services_catalog').select('name').eq('id', reactivated.service_id).maybeSingle();
                if (svc?.name) subject = svc.name;
              }

              const order = await createPaymentOrder({
                subject,
                amount:          reactivated.amount,
                email:           reactivated.patient_email,
                orderId:         reactivated.id,
                urlConfirmation: `${siteUrl}/api/flow/confirm`,
                urlReturn:       `${siteUrl}/api/flow/return`,
                baseUrl,
              });

              await supabase.from('bookings').update({ mp_preference_id: order.token }).eq('id', reactivated.id);
              await tagBookingsWithPaymentToken([reactivated.id], order.token).catch(() => {});
              redirectUrl = `${order.url}?token=${order.token}`;
              outcome = 'ok';
            }
          } catch (e) {
            outcome = 'flow_error';
            errorDetail = e instanceof Error ? e.message : String(e);
            // Revertir: si Flow falló, no dejar la reserva "viva" sin forma de pagarla — se
            // vuelve a marcar como expirada con un nuevo token para que el botón del correo
            // original ya no sirva, pero el paciente pueda reintentar contactando por WhatsApp.
            await supabase.from('bookings').update({ status: 'expired', recovery_token: crypto.randomUUID() }).eq('id', reactivated.id);
          }
        }
      }
    }
  }
}

if (outcome === 'ok' && redirectUrl) {
  return Astro.redirect(redirectUrl, 302);
}
---
<Layout title="Recuperar tu hora — Ps. Valentina Orellana" noindex>
  <div style="max-width:520px;margin:9rem auto 5rem;padding:0 1.5rem;font-family:'Inter',sans-serif;text-align:center;">
    {outcome === 'not_found' && (
      <>
        <h1 style="font-family:'Cormorant Garamond',serif;font-size:1.6rem;font-weight:400;">No encontramos esa reserva</h1>
        <p style="color:#6B6860;line-height:1.6;margin:1rem 0 2rem;">
          El enlace no es válido o ya fue utilizado. Si quieres agendar, elige un horario disponible.
        </p>
      </>
    )}
    {outcome === 'too_late' && (
      <>
        <h1 style="font-family:'Cormorant Garamond',serif;font-size:1.6rem;font-weight:400;">Ese horario ya no está disponible</h1>
        <p style="color:#6B6860;line-height:1.6;margin:1rem 0 2rem;">
          Quedan menos de 4 horas para esa sesión, así que ya no es posible pagarla online para mantenerla.
          Por favor agenda un nuevo horario.
        </p>
      </>
    )}
    {outcome === 'taken' && (
      <>
        <h1 style="font-family:'Cormorant Garamond',serif;font-size:1.6rem;font-weight:400;">Horario no disponible</h1>
        <p style="color:#6B6860;line-height:1.6;margin:1rem 0 2rem;">
          Alguien más tomó ese horario mientras tanto. Elige un nuevo horario para el mismo servicio a continuación.
        </p>
      </>
    )}
    {outcome === 'flow_error' && (
      <>
        <h1 style="font-family:'Cormorant Garamond',serif;font-size:1.6rem;font-weight:400;">No pudimos iniciar el pago</h1>
        <p style="color:#6B6860;line-height:1.6;margin:1rem 0 2rem;">
          Ocurrió un problema al conectar con el sistema de pago. Por favor escríbeme por WhatsApp para coordinar
          tu sesión directamente.
        </p>
      </>
    )}
    <a href={serviceId && (outcome === 'taken' || outcome === 'too_late') ? `/agenda?servicio=${serviceId}` : '/agenda'}
       style="display:inline-block;background:#576352;color:white;padding:0.85rem 1.75rem;
              text-decoration:none;font-size:0.78rem;letter-spacing:0.1em;text-transform:uppercase;
              border-radius:4px;margin-right:0.5rem;">
      Agendar un horario
    </a>
    <a href="https://wa.me/56972735696"
       style="display:inline-block;background:transparent;color:#576352;padding:0.85rem 1.75rem;
              text-decoration:none;font-size:0.78rem;letter-spacing:0.1em;text-transform:uppercase;
              border:1px solid #576352;border-radius:4px;">
      Escribir por WhatsApp
    </a>
  </div>
</Layout>
