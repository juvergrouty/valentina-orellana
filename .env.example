# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Flow.cl ───────────────────────────────────────────────────────────────────
# Obtén tus credenciales en: https://app.flow.cl → Integración → Credenciales
# Para pruebas locales usar las credenciales de SANDBOX
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_ENV=sandbox        # cambiar a "production" al hacer deploy

# ── Sitio ─────────────────────────────────────────────────────────────────────
# URL base del sitio (sin barra final)
# En local: http://localhost:4321
# Para pruebas con webhook de Flow: URL pública de ngrok (ngrok http 4321)
# En producción: https://tudominio.cl
PUBLIC_SITE_URL=http://localhost:4321

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=tu_contraseña_admin
ADMIN_SECRET=cadena_aleatoria_segura_para_la_cookie

# ── Crons ─────────────────────────────────────────────────────────────────────
# Obligatorio en producción: los endpoints /api/cron/* devuelven 401 sin este valor.
# Debe ser el mismo secreto que se usa en GitHub Actions y en el pinger externo.
CRON_SECRET=cadena_aleatoria_larga

# ── Flow.cl (sandbox, opcional) ────────────────────────────────────────────────
# Si no se definen, se usan las de arriba (FLOW_API_KEY/FLOW_SECRET_KEY) también
# para las pruebas en sandbox. Ver src/lib/flow.ts.
FLOW_SANDBOX_API_KEY=
FLOW_SANDBOX_SECRET_KEY=

# ── Correo (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Remitente de todos los correos del sitio. Debe ser un dominio verificado en Resend.
EMAIL_FROM="Valentina Orellana <notificaciones@valentinaorellana.cl>"

# ── Google Calendar (sync de reservas) ─────────────────────────────────────────
# OAuth de la cuenta de Google donde se crean/actualizan los eventos de las
# sesiones. Se conecta desde /admin (Configuración → Google Calendar).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tudominio.cl/api/admin/google/callback

# ── Google Places (reseñas) ─────────────────────────────────────────────────────
# Opcional: también se puede cargar como "google_places_api_key" en la tabla
# settings desde el panel — ahí tiene prioridad sobre esta variable.
GOOGLE_PLACES_API_KEY=

# ── Meta / WhatsApp Business ────────────────────────────────────────────────────
# De la app de Meta for Developers (developers.facebook.com/apps).
# PUBLIC_ porque el botón "Conectar WhatsApp" del panel lo usa en el navegador.
PUBLIC_META_APP_ID=
PUBLIC_META_WHATSAPP_CONFIG_ID=
META_APP_SECRET=

# ── Instagram (feed en la home) ─────────────────────────────────────────────────
# Opcional: también se puede cargar como "instagram_access_token" en la tabla
# settings desde el panel — ahí tiene prioridad sobre esta variable.
INSTAGRAM_ACCESS_TOKEN=

# ── apigateway.cl / SII (boletas de honorarios electrónicas) ───────────────────
# Igual que arriba: también configurables como "apigateway_apikey", "sii_rut" y
# "sii_clave" en la tabla settings desde el panel — esta var tiene prioridad.
APIGATEWAY_APIKEY=
APIGATEWAY_BASE_URL=https://app.apigateway.cl
SII_RUT=
SII_CLAVE=
